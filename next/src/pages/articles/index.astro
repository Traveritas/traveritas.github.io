---
/* 断章 —— 章节：一列，编号与日期挂在列外的竖线上 */
import Base from '../../layouts/Base.astro';
import ListHead from '../../components/ListHead.astro';
import { entriesOf } from '../../lib/entries';
import { plain, chars, minutes, pad, dot } from '../../lib/text';

const list = await entriesOf('articles');
---

<Base title="断章" place="list" sec="articles">
  <section class="list list--articles">
    <ListHead k="articles" n={list.length} />
    <ol class="chapters">
      {
        list.map((e, i) => {
          const n = chars(e.body);
          return (
            <li class="ch" style={`--i:${i}`}>
              <span class="ch-no mono">
                <b>{pad(list.length - i)}</b>
                {dot(e.data.date)}
              </span>
              <a class="pane pane--ch" data-glass href={`/articles/${e.id}/`}>
                <span class="t">{plain(e.data.title)}</span>
                {e.data.description && <span class="d">{plain(e.data.description)}</span>}
                <span class="meta mono">
                  {n.toLocaleString()} 字 · 约 {minutes(n)} 分钟{e.data.tags.length ? ' · ' + e.data.tags.join(' / ') : ''}
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>
</Base>
