# build output
dist/

# 正文字体：源字体缓存与自切产物（scripts/fonts.mjs 每次 dev / build 前生成）
.cache/
public/fonts/noto-serif-sc/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
pnpm-debug.log*

# environment variables
.env*

# macOS
.DS_Store

# jetbrains
.idea/

# 会话状态（ZCode / impeccable）
.zcode/
.impeccable/

# 设计稿截图产物（体积大、可随时重新生成）
design/**/.shots*
design/**/_shots*
design/**/shots*
# 开屏迭代里的那批截图目录（不叫 .shots，但同性质；由同目录的 .board-shot / .real-boot* 脚本重跑）
design/mocks/boot/iter/_ref/.accept*/
design/mocks/boot/iter/_ref/.grain-review/
design/mocks/boot/iter/_ref/.prod-*/
design/mocks/boot/iter/_ref/.real-boot*/
design/mocks/boot/iter/_ref/real-boot/
design/mocks/boot/iter/_ref/board/

# 设计稿脚本的输出日志（可随时重跑生成）
design/**/*.log

# 设计稿的一次性辅助脚本（起服务 / 探针 / CDP / 校验 / 挂起）：新写的默认不进仓库。
# 已入库的不受影响；确实要留档的用 git add -f。
# .shot-*.cjs 不在此列——它们是文档里点名的验收入口，照常入库。
design/**/.serve-*.cjs
design/**/.probe-*.cjs
design/**/.cdp-*.cjs
design/**/.verify-*.cjs
design/**/.hold-*.cjs
