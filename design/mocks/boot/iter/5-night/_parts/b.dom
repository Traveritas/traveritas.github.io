<i class="b-night" id="b-night"></i>
<i class="b-mist" id="b-mist"></i>
<i class="b-spill" id="b-spill"></i>
<div class="b-axis"><i class="b-cut" id="b-cut"></i></div>
<svg class="b-edge" id="b-edge-a" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
  <defs><linearGradient id="b-edge-grad-a" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="#e8e4f8" stop-opacity="0"/>
    <stop offset="0.26" stop-color="#e8e4f8" stop-opacity="0.5"/>
    <stop offset="0.5" stop-color="#f4f0fc" stop-opacity="1"/>
    <stop offset="0.74" stop-color="#e8e4f8" stop-opacity="0.5"/>
    <stop offset="1" stop-color="#e8e4f8" stop-opacity="0"/>
  </linearGradient></defs>
  <path stroke="url(#b-edge-grad-a)"></path>
</svg>
<svg class="b-edge" id="b-edge-b" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
  <defs><linearGradient id="b-edge-grad-b" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0" stop-color="#e8e4f8" stop-opacity="0"/>
    <stop offset="0.26" stop-color="#e8e4f8" stop-opacity="0.5"/>
    <stop offset="0.5" stop-color="#f4f0fc" stop-opacity="1"/>
    <stop offset="0.74" stop-color="#e8e4f8" stop-opacity="0.5"/>
    <stop offset="1" stop-color="#e8e4f8" stop-opacity="0"/>
  </linearGradient></defs>
  <path stroke="url(#b-edge-grad-b)"></path>
</svg>
