+  /* 合成层版波纹（home-storyboard.ts 生成字形遮罩 --pa-mask 后加 .mk）：
+     字形当静止遮罩，贴图在里层按 transform 平移 —— 流动只挪 GPU 上的一张贴图，
+     不再逐帧重绘大字及其上的模糊 / 投影。遮罩未就绪或减动效时仍是上面的 background-clip 版。 */
+  .gw .pa b {
+    display: none;
+  }
+  .gw .pa.mk {
+    background: none;
+    animation: none;
+  }
+  .gw .pa.mk b {
+    position: absolute;
+    inset: 0;
+    display: block;
+    overflow: hidden;
+    -webkit-mask: var(--pa-mask) 0 0 / 100% 100% no-repeat;
+    mask: var(--pa-mask) 0 0 / 100% 100% no-repeat;
+  }
+  .gw .pa.mk b::before {
+    content: '';
+    position: absolute;
+    top: 0;
+    bottom: 0;
+    right: 0;
+    will-change: transform;
