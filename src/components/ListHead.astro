---
/* 名录的头：这一处的晶体成了徽，另两处缩成旁边的入口 */
import { SECS, ORDER, type Sec } from '../lib/entries';
import { pad } from '../lib/text';
interface Props {
  k: Sec;
  n: number;
}
const { k, n } = Astro.props;
---

<header class="lh">
  <i class="x x--emb" data-x={k}></i>
  <div>
    <h1>{SECS[k].t}</h1>
    <p class="mono">{SECS[k].en} · {pad(n)}</p>
  </div>
  <nav class="sibs">
    {
      ORDER.filter((x) => x !== k).map((x) => (
        <a href={`/${x}/`} class="sib">
          <i class="x" data-x={x} />
          {SECS[x].t}
        </a>
      ))
    }
  </nav>
</header>
