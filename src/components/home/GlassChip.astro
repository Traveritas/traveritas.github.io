---
/* 纸间式入口卡：磨砂玻璃片浅浮于纸上（梦侧），
   hover 抬升归稳。 */
interface Props {
  href: string;
  title: string;
  desc?: string;
  meta?: string;
  compact?: boolean;
  style?: string;
}

const { href, title, desc, meta, compact = false, style = '' } = Astro.props;
---

<div class:list={['chip-slot', { compact }]} style={style}>
  <a class="chip drift" href={href}>
    <span class="chip-glass">
      <span class="chip-title">{title}</span>
      {desc && <span class="chip-desc">{desc}</span>}
      {meta && <span class="chip-meta mono">{meta}</span>}
    </span>
  </a>
</div>

<style>
  .chip-slot {
    position: relative;
    width: min(100%, 26rem);
  }

  .chip-slot.compact {
    width: min(100%, 19rem);
  }

  .chip {
    position: relative;
    z-index: 2;
    display: block;
    text-decoration: none;
    color: inherit;
    --d-amp: 9px;
    --d-x: 4px;
    --d-rot: 0.7deg;
    --d-dur: 7.5s;
  }

  .chip-slot.compact .chip {
    --d-amp: 7px;
    --d-dur: 6.5s;
  }

  .chip-glass {
    display: block;
    padding: 1.5rem 1.6rem 1.3rem;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(255, 255, 255, 0.42) 100%
    );
    -webkit-backdrop-filter: blur(16px) saturate(130%);
    backdrop-filter: blur(16px) saturate(130%);
    box-shadow:
      0 14px 34px -10px rgba(35, 40, 48, 0.08),
      inset 0 1px 2px rgba(255, 255, 255, 0.95),
      inset 0 -1px 2px rgba(35, 40, 48, 0.04);
    transform: rotate(var(--tilt, 0deg));
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1.2),
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      background 0.35s ease;
  }

  .chip:hover .chip-glass {
    transform: rotate(0deg) translateY(-5px);
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.9) 0%,
      rgba(255, 255, 255, 0.6) 100%
    );
    border-color: #ffffff;
    box-shadow:
      0 20px 46px -10px rgba(35, 40, 48, 0.12),
      inset 0 1.5px 2px rgba(255, 255, 255, 1);
  }

  /* 晶体文字：深色清润油墨，清晰悬浮 */
  .chip-title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.16rem;
    color: var(--fg, #232830);
    letter-spacing: 0.04em;
    transition: color 0.2s ease;
  }

  .chip:hover .chip-title {
    color: var(--amber, #d9a05b);
  }

  .chip-desc {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--fg-soft, #56606d);
  }

  .chip-meta {
    display: block;
    margin-top: 0.9rem;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--amber, #d9a05b);
  }

  @media (prefers-reduced-transparency: reduce) {
    .chip-glass {
      background: #1c222c;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip-glass {
      transition: none;
    }
  }
</style>
