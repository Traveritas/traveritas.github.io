---
/* 站头（入梦检验式）：一条 -4° 分段轴线从左划出，
   两端 mono 标签；结保留给缝线锚点巡行。 */
interface Props {
  title: string;
  stage: string;
  time: string;
}
const { title, stage, time } = Astro.props;
---

<header class="stitch-head">
  <div class="axis" aria-hidden="true">
    <i class="axis-line"></i>
    <span class="axis-l mono">{stage}</span>
    <span class="axis-r mono">{time}</span>
  </div>
  <h2><span class="knot" aria-hidden="true"></span>{title}</h2>
</header>

<script>
  // 轴线入场：进入视口时从左划出（无 JS 时保持可见）
  const lines = document.querySelectorAll<HTMLElement>('.stitch-head .axis-line');
  if (lines.length && 'IntersectionObserver' in window) {
    lines.forEach((l) => l.classList.add('ax-wait'));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            (e.target as HTMLElement).classList.remove('ax-wait');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.6 },
    );
    lines.forEach((l) => io.observe(l));
  }
</script>

<style>
  .stitch-head {
    margin-bottom: clamp(2rem, 5vh, 3.2rem);
  }

  /* 分段轴线：-4° 斜线（左低右高，与缝线同向），两段字分居两端——
     左字悬在低端上方、右字沉在高端下方（同入梦检验稿的错位），
     容器足够高，使斜线两端与角上的两段字错开、不重叠 */
  .axis {
    position: relative;
    height: 7rem;
    margin-bottom: 1.2rem;
  }

  .axis-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--fg-soft);
    opacity: 0.42;
    transform: rotate(-4deg) scaleX(var(--ax, 1));
    transform-origin: center;
    transition: transform 1s cubic-bezier(0.25, 0.6, 0.3, 1);
  }

  .axis-line.ax-wait {
    --ax: 0;
  }

  .axis-l,
  .axis-r {
    position: absolute;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    white-space: nowrap;
  }

  .axis-l {
    left: 0.2rem;
    top: 1.5rem;
    color: var(--umber);
  }

  .axis-r {
    right: 0.2rem;
    bottom: 1.5rem;
    color: var(--fg-soft);
  }

  .stitch-head h2 {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    margin: 0;
  }

  .knot {
    width: 9px;
    height: 9px;
    flex: none;
    background: var(--fg-soft);
    transform: rotate(45deg);
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }

  .stitch-head:hover .knot,
  .stitch-head.is-active .knot {
    background: var(--amber);
    box-shadow: 0 0 10px 1px rgba(217, 160, 91, 0.5);
  }

  @media (max-width: 760px) {
    .axis-l,
    .axis-r {
      font-size: 0.56rem;
      letter-spacing: 0.16em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .axis-line {
      transition: none;
      --ax: 1;
    }
  }
</style>
