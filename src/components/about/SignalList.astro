---
/* 关于页 · 出口名录：名称 ‖ 地址 ‖ 一句醒/梦双声轨的说明 */
interface Props {
  items: {
    name: string;
    href: string;
    /** 显示用的地址；不写时取 href 去掉协议 */
    addr?: string;
    /** 说明的醒面 / 梦面 */
    awake: string;
    dream: string;
  }[];
}

const { items } = Astro.props;
const external = (href: string) => /^https?:/.test(href);
---

<ul class="signal-list">
  {
    items.map((it) => (
      <li>
        <a
          href={it.href}
          target={external(it.href) ? '_blank' : undefined}
          rel={external(it.href) ? 'noopener noreferrer' : undefined}
        >
          <span class="sig-name">{it.name}</span>
          <span class="sig-addr mono">{it.addr ?? it.href.replace(/^https?:\/\//, '')}</span>
          <span class="sig-desc mono" data-morph data-true={it.awake} data-dream={it.dream}>{it.awake}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .signal-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .signal-list li {
    border-bottom: 1px solid var(--line);
  }

  .signal-list li:first-child {
    border-top: 1px solid var(--line);
  }

  .signal-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0.2rem;
    text-decoration: none;
    color: var(--fg);
    transition: padding-left 0.2s ease, color 0.2s ease;
  }

  .signal-list a:hover {
    padding-left: 0.4rem;
    color: var(--amber);
  }

  .sig-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .sig-addr {
    font-size: 0.78rem;
    color: var(--fg-soft);
    letter-spacing: 0.06em;
  }

  .sig-desc {
    font-size: 0.72rem;
    color: var(--fg-soft);
    letter-spacing: 0.12em;
    margin-left: auto;
  }

  @media (max-width: 38em) {
    .signal-list a {
      flex-wrap: wrap;
      gap: 0.3rem 0.8rem;
    }

    .sig-desc {
      width: 100%;
      margin-left: 0;
      opacity: 0.85;
    }
  }
</style>
