---
/* 关于页 · 截面：一枚四维晶体落在此处的切面，日后通往 NEXUS 的门（脚本见 src/scripts/nexus-slice.ts）。
   NEXUS 还没做，门暂不响应任何交互。静帧图垫底：无脚本 / 无 WebGL2 / 软件渲染时就停在它上面，
   画布第一帧画好后（.is-live）再盖上去。
   位置由外层决定（关于页的 .about-stage 把它摆在舞台正中）。 */
---

<div class="nexus-slice" aria-hidden="true">
  <span class="ns-shade"></span>
  <img class="ns-still" src="/nexus-slice/wake.webp" alt="" width="640" height="640" decoding="async" />
  <canvas></canvas>
</div>

<script>
  import { initNexusSlice } from '../../scripts/nexus-slice';
  initNexusSlice();
</script>

<style>
  .nexus-slice {
    position: relative;
    width: clamp(240px, 42vmin, 440px);
    aspect-ratio: 1;
    margin: 0 auto;
    pointer-events: none;
  }

  .ns-still,
  .nexus-slice canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* 关于页退场：外层写 --grow（0→1），静帧图与投影跟着显现；没有演出时恒为 1 */
  .ns-still,
  .ns-shade {
    opacity: var(--grow, 1);
  }

  .nexus-slice canvas {
    opacity: 0;
  }

  .nexus-slice.is-live canvas {
    opacity: 1;
  }

  .nexus-slice.is-live .ns-still {
    visibility: hidden;
  }

  /* 投影：不贴地，只是一团很淡的丁香灰 */
  .ns-shade {
    position: absolute;
    left: 22%;
    right: 22%;
    bottom: 2%;
    height: 9%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(90, 80, 110, 0.12), rgba(90, 80, 110, 0));
    filter: blur(6px);
  }
</style>
