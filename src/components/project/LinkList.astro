---
/* 项目页出口区 · 相关链接：一行一个外链；没有链接时整块不出 */
interface Props {
  links: { label: string; href: string }[];
}

const { links } = Astro.props;
---

{
  links.length > 0 && (
    <nav class="link-list" aria-label="相关链接">
      <p class="ll-head">相关链接<span class="ll-en mono">LINKS</span></p>
      {links.map((l) => (
        <a class="ll-row" href={l.href} target="_blank" rel="noopener noreferrer">
          <span class="ll-name">{l.label}</span>
          <span class="ll-href mono">{l.href.replace(/^https?:\/\//, '')}</span>
          <span class="ll-arrow">→</span>
        </a>
      ))}
    </nav>
  )
}

<style>
  .link-list {
    margin-top: 2.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .ll-head {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.14em;
    margin-bottom: 0.4rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .ll-en {
    font-size: 0.56rem;
    letter-spacing: 0.28em;
    color: var(--fg-soft);
  }

  .ll-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.2rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .ll-row .ll-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.08em;
  }

  .ll-row .ll-href {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--fg-soft);
    word-break: break-all;
  }

  .ll-row .ll-arrow {
    margin-left: auto;
    font-family: var(--font-mono);
    color: var(--fg-soft);
    transition:
      transform 0.25s,
      color 0.25s;
  }

  .ll-row:hover .ll-arrow {
    transform: translateX(5px);
    color: var(--amber);
  }
</style>
