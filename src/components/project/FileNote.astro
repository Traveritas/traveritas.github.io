---
/* 项目页 · 深眠注记：琥珀左边，醒/梦双声轨由 morph 驱动 */
interface Props {
  awake: string;
  dream: string;
}

const { awake, dream } = Astro.props;
---

<p class="file-note">
  <span class="mono">N3 · 深眠注记</span>
  <span data-morph data-true={awake} data-dream={dream}>{awake}</span>
</p>

<style>
  .file-note {
    margin: 2.4rem 0 0;
    padding-left: 1.2rem;
    border-left: 2px solid var(--amber);
    font-size: 0.85rem;
    line-height: 2;
    color: var(--fg-soft);
    letter-spacing: 0.05em;
    max-width: 34em;
  }

  .file-note .mono {
    display: block;
    font-size: 0.58rem;
    letter-spacing: 0.24em;
    color: var(--amber);
    margin-bottom: 0.3rem;
  }
</style>
