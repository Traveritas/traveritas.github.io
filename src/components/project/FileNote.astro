---
/* 项目页 · 注记：琥珀左边，醒/梦双声轨由 morph 驱动 */
interface Props {
  awake: string;
  dream: string;
}

const { awake, dream } = Astro.props;
---

<p class="file-note">
  <span data-morph data-true={awake} data-dream={dream}>{awake}</span>
</p>

<style>
  .file-note {
    margin: 2.4rem 0 0;
    padding-left: 1.2rem;
    border-left: 2px solid var(--amber);
    font-size: 0.85rem;
    line-height: 2;
    color: var(--fg-soft);
    letter-spacing: 0.05em;
    max-width: 34em;
  }
</style>
