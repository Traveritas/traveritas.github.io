---
/* 项目页 · 正文上缘的成形度行：八阶刻度（放大一档）+ 阶数 + 英文小注 */
interface Props {
  /** 已成形到第几阶（1–8） */
  pins: number;
}

const { pins } = Astro.props;
---

<div class="pin-line" aria-label={`成形度第 ${pins} 阶，共八阶`}>
  <span class="stitch-meter" aria-hidden="true">
    {Array.from({ length: 8 }).map((_, i) => <i class:list={{ on: i < pins }} />)}
  </span>
  <span class="prj-pin mono">第 {pins} 阶 / 八阶</span>
  <span class="pin-cap mono">EIGHT DEPTHS · 随构建渐显</span>
</div>

<style>
  /* ── 八阶进度：放大一档 ── */
  .pin-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem 1.1rem;
    margin: -1.4rem 0 2.2rem;
  }

  .pin-line .stitch-meter {
    gap: 7px;
  }

  .pin-line .stitch-meter i {
    width: 15px;
    height: 3px;
  }

  .prj-pin {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: var(--umber);
  }

  .pin-cap {
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    color: var(--fg-soft);
  }
</style>
