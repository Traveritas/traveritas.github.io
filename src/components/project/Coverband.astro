---
/* 项目页封面：统一磨砂树脂玻璃板 + 14° 几何线与晶体棱面 + 前置外链 + 描边幽灵编号 */
interface ProjectLink {
  label: string;
  href: string;
}

interface Props {
  /** 项目编号，如 PRJ-03 */
  code: string;
  links?: ProjectLink[];
}

const { code, links = [] } = Astro.props;
const num = code.replace('PRJ-', '');
---

<figure class="coverband" aria-label={`项目 ${num}`}>
  <svg class="coverband-geo" viewBox="0 0 1200 180" preserveAspectRatio="none" aria-hidden="true">
    <line x1="0" y1="152" x2="1200" y2="26" stroke="var(--amber)" stroke-opacity="0.34" stroke-width="1" />
    <line x1="0" y1="170" x2="1200" y2="44" stroke="currentColor" stroke-opacity="0.1" stroke-width="1" />
    <polygon points="860,18 935,90 860,162 785,90" fill="none" stroke="currentColor" stroke-opacity="0.13" stroke-width="1" />
  </svg>

  {
    links.length > 0 && (
      <div class="coverband-bar">
        <div class="coverband-links mono">
          {links.map((l) => (
            <a href={l.href} target="_blank" rel="noreferrer">
              {l.label} ↗
            </a>
          ))}
        </div>
      </div>
    )
  }

  <span class="ghostno" aria-hidden="true">{num}</span>
</figure>

<style>
  .coverband {
    position: relative;
    min-height: 148px;
    margin: 0 0 2.4rem;
    padding: 1.1rem 1.35rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: var(--chrome-radius);
    border: 1px solid var(--chrome-edge);
    overflow: clip;
    color: var(--fg);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--chrome-bg) 82%, transparent),
      color-mix(in srgb, var(--amber) 6%, var(--chrome-bg))
    );
    -webkit-backdrop-filter: blur(12px) saturate(1.08);
    backdrop-filter: blur(12px) saturate(1.08);
    box-shadow:
      inset 0 1px 0 var(--chrome-hi),
      inset 0 -1px 0 var(--chrome-edge-lo),
      0 0 0 1px color-mix(in srgb, var(--fg) 10%, transparent),
      0 14px 32px -22px var(--chrome-sh);
  }

  .coverband-geo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .coverband-bar {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .coverband-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }

  .coverband-links a {
    color: var(--fg-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.12rem;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .coverband-links a:hover,
  .coverband-links a:focus-visible {
    color: var(--fg);
    border-bottom-color: var(--amber);
    outline: none;
  }

  .coverband .ghostno {
    position: absolute;
    right: 18px;
    bottom: -18px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 112px;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--fg) 18%, transparent);
    user-select: none;
    pointer-events: none;
  }

  @media (max-width: 760px) {
    .coverband {
      min-height: 124px;
      padding: 0.95rem 1.05rem;
    }

    .coverband .ghostno {
      font-size: 78px;
      bottom: -12px;
    }
  }
</style>
