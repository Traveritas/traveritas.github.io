---
/* 项目页封面：δ 波纹底板 + 描边幽灵编号（深眠绝对静止，波纹不漂） */
interface Props {
  /** 项目编号，如 PRJ-03 */
  code: string;
}

const { code } = Astro.props;
---

<figure class="coverband" aria-hidden="true">
  <svg viewBox="0 0 2200 150" preserveAspectRatio="none">
    <path
      style="stroke:rgba(167,177,186,.42);stroke-width:1;fill:none"
      d="M0,48 Q68.75,6 137.5,48 T275,48 T550,48 T825,48 T1100,48 T1375,48 T1650,48 T1925,48 T2200,48"
    />
    <path
      style="stroke:rgba(194,163,130,.38);stroke-width:1;fill:none"
      d="M0,104 Q68.75,66 137.5,104 T275,104 T550,104 T825,104 T1100,104 T1375,104 T1650,104 T1925,104 T2200,104"
    />
  </svg>
  <span class="ghostno">{code.replace('PRJ-', '')}</span>
  <figcaption class="mono">COVER · {code} · 深眠留白 · N3 STILL</figcaption>
</figure>

<style>
  .coverband {
    position: relative;
    height: 172px;
    margin: 0 0 2.6rem;
    border: 1px solid var(--line);
    overflow: clip;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.28), rgba(225, 229, 234, 0.5));
  }

  .coverband svg {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    opacity: 0.8;
  }

  .coverband .ghostno {
    position: absolute;
    right: 18px;
    bottom: -20px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 118px;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(38, 44, 51, 0.22);
    user-select: none;
  }

  .coverband figcaption {
    position: absolute;
    left: 14px;
    bottom: 12px;
    font-size: 0.56rem;
    letter-spacing: 0.26em;
    color: var(--fg-soft);
  }

  @media (max-width: 760px) {
    .coverband {
      height: 132px;
    }

    .coverband .ghostno {
      font-size: 86px;
      bottom: -14px;
    }
  }
</style>
