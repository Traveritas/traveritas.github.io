---
/* 项目页文末导航：← 全部项目 ‖ 名录里的下一件 → */
interface Props {
  /** 「另一项」；不传（或只有一件项目）时只留返回 */
  next?: { id: string; title: string };
}

const { next } = Astro.props;
---

<nav class="pj-next" aria-label="项目导航">
  <a href="/projects/">← 全部项目</a>
  {next && <a href={`/projects/${next.id}/`}>{next.title} →</a>}
</nav>

<style>
  .pj-next {
    margin-top: 2.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pj-next a {
    font-size: 0.88rem;
  }
</style>
