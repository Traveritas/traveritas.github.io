---
import ShardMark from './ShardMark.astro';

const { pathname } = Astro.url;
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="container header-row">
    <a class="brand" href="/">
      <ShardMark />
      <span>Traveritas</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <a href="/articles/" aria-current={isCurrent('/articles/') ? 'page' : undefined}>随笔</a>
      <a href="/projects/" aria-current={isCurrent('/projects/') ? 'page' : undefined}>项目</a>
      <a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>关于</a>
    </nav>
  </div>
</header>
