---
const { pathname } = Astro.url;
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<!-- 页头 · 导航：当前项琥珀标尺——随入梦检验的醒度插值自动换色 -->
<header class="site-header">
  <div class="container header-row">
    <a class="brand is-wake" href="/" aria-label="Traveritas">Traveritas</a>
    <nav class="site-nav" aria-label="主导航">
      <a class:list={[{ 'is-current': isCurrent('/articles/') }]} href="/articles/" aria-current={isCurrent('/articles/') ? 'page' : undefined}>
        <i class="stitch" aria-hidden="true"></i><span data-morph data-true="随笔" data-dream="断章">随笔</span>
      </a>
      <a class:list={[{ 'is-current': isCurrent('/moments/') }]} href="/moments/" aria-current={isCurrent('/moments/') ? 'page' : undefined}>
        <i class="stitch" aria-hidden="true"></i><span data-morph data-true="瞬间" data-dream="闪念">瞬间</span>
      </a>
      <a class:list={[{ 'is-current': isCurrent('/projects/') }]} href="/projects/" aria-current={isCurrent('/projects/') ? 'page' : undefined}>
        <i class="stitch" aria-hidden="true"></i><span data-morph data-true="项目" data-dream="造物">项目</span>
      </a>
      <a class:list={[{ 'is-current': isCurrent('/about/') }]} href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>
        <i class="stitch" aria-hidden="true"></i><span data-morph data-true="关于" data-dream="此身">关于</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .header-row {
    padding-block: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    color: var(--fg);
    text-decoration: none !important;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
    min-width: 6.8em;
    outline: none;
    border: none;
    transition:
      opacity 0.18s cubic-bezier(0.2, 0.8, 0.3, 1),
      filter 0.18s cubic-bezier(0.2, 0.8, 0.3, 1),
      transform 0.18s cubic-bezier(0.2, 0.8, 0.3, 1),
      color 0.16s ease;
  }

  .brand:hover,
  .brand:focus,
  .brand:focus-visible,
  .brand:active,
  .brand:visited {
    color: var(--fg);
    text-decoration: none !important;
  }

  /* 双态切换溶变过渡态（如水汽融散重聚） */
  .brand.is-morphing {
    opacity: 0;
    filter: blur(2.5px);
    transform: translateY(-1px) scale(0.98);
  }

  /* 梦态衬线字形 */
  .brand.is-dream {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
  }

  /* 醒态标准衬线字形 */
  .brand.is-wake {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  :global(.brand-char) {
    position: relative;
    display: inline-block;
    will-change: transform;
    text-decoration: none !important;
    transition: none !important;
  }

  /* 琥珀灼点：同一个字的琥珀色副本叠在正上方，只动 opacity。
     原写法直接动画 color（color-mix 琥珀 16% / 32%）⇒ 主线程动画，且只要它在跑，
     全站可合成的动画（构块场 160 块）也被逐帧拉回主线程重算样式。
     琥珀副本以 p 的不透明度盖在正文色上 ＝ srgb 里 p·琥珀 + (1−p)·正文，与 color-mix 同式。
     字由 brand.ts 写进 data-ch；链接有 aria-label，伪元素文字不进可访问名。 */
  :global(.brand-char)::after {
    content: attr(data-ch);
    position: absolute;
    inset: 0;
    color: var(--amber);
    opacity: 0;
    pointer-events: none;
  }

  :global(.brand-char:nth-child(even)) {
    --drift-x: -1;
  }
  :global(.brand-char:nth-child(odd)) {
    --drift-x: 1;
  }

  /* 梦态下每个字符 Celeste 风格简谐位置量化浮动（正弦波波峰波谷滞空 + 整像素网格对齐，零 tween 瞬切）
     振幅与琥珀灼点都乘 --still：长按回醒的那 2.2s 里，AveritA 随醒度渐渐落定
     （与小节序号、正文 ((浮起)) 同一条曲线）；闩锁后 180ms 的磨砂溶变才换回
     Traveritas，那时振幅已经是 0，所以换字不带着一帧位移跳变。
     醒面不声明这条动画：醒面的 brand 根本没有 .brand-char（是整块文本），
     而且这台字不会空转 —— 上一条纪律「醒静梦动」在别处是「振幅归零」，在这里是
     「连动画都不在」，两者读数一致。 */
  :global(.brand.is-dream .brand-char),
  :global(.brand.is-dream .brand-char)::after {
    animation: brand-pixel-float 2.8s step-end infinite;
    animation-delay: calc(var(--i) * -0.4s);
  }

  :global(.brand.is-dream .brand-char)::after {
    animation-name: brand-pixel-glint;
  }

  @keyframes brand-pixel-float {
    0% {
      transform: translateY(0px);
    }
    13% {
      transform: translateY(calc(-1px * var(--still, 0)));
    }
    25% {
      transform: translateY(calc(-2px * var(--still, 0)));
    }
    37% {
      transform: translateY(calc(-3px * var(--still, 0)));
    }
    63% {
      transform: translateY(calc(-2px * var(--still, 0)));
    }
    75% {
      transform: translateY(calc(-1px * var(--still, 0)));
    }
    87%,
    100% {
      transform: translateY(0px);
    }
  }

  /* 与上面同拍同相（同一组 duration / delay / step-end）：25% 与 63% 灼 16%，37% 灼 32% */
  @keyframes brand-pixel-glint {
    0%,
    13%,
    75%,
    87%,
    100% {
      opacity: 0;
    }
    25%,
    63% {
      opacity: calc(0.16 * var(--still, 0));
    }
    37% {
      opacity: calc(0.32 * var(--still, 0));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand {
      transition: color 0.16s ease !important;
    }
    .brand.is-morphing {
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
    }
    :global(.brand-char) {
      animation: none !important;
      transform: none !important;
      color: var(--fg) !important;
    }
    :global(.brand-char)::after {
      display: none;
    }
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.15rem;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 400; /* IBM Plex Mono 只载 400：写 500 也是按 400 画，不如写实 */
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--fg-soft);
    text-decoration: none;
    padding-block: 0.3rem;
    position: relative;
    transition: color 0.16s ease;
  }

  /* 触控热区放大到约 44px 高：只扩可点范围，不动排版（横向不越过 1.15rem 的间距） */
  .site-nav a::after {
    content: '';
    position: absolute;
    inset: -0.4rem -0.55rem;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--fg);
  }

  /* 导航指示标尺：10×2、+8°、圆角；hover 被轻轻拉长 */
  .stitch {
    display: inline-block;
    flex: none;
    width: 10px;
    height: 2px;
    border-radius: 2px;
    background: rgba(38, 44, 51, 0.4);
    transform: rotate(8deg);
    transition:
      width 0.16s ease,
      background-color 0.16s ease;
  }

  .site-nav a:hover .stitch,
  .site-nav a:focus-visible .stitch {
    width: 16px;
  }

  .site-nav a.is-current {
    color: var(--fg);
  }

  .site-nav a.is-current .stitch {
    background: var(--amber);
  }
</style>
