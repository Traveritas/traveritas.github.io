---
const { pathname } = Astro.url;
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<!-- 页头 · 横排针脚（p11-h-stitchrow 终选）：名与入口被一段 14° 短缝缝在
     一起；当前入口琥珀针脚——琥珀随入梦检验的醒度插值自动换色 -->
<header class="site-header">
  <div class="container header-row">
    <a class="brand" href="/">Traveritas</a>
    <i class="seam-gap" aria-hidden="true"><span class="seam-seg"></span></i>
    <nav class="site-nav" aria-label="主导航">
      <a class:list={[{ 'is-current': isCurrent('/articles/') }]} href="/articles/" aria-current={isCurrent('/articles/') ? 'page' : undefined}>
        <i class="stitch" aria-hidden="true"></i>随笔
      </a>
      <a class:list={[{ 'is-current': isCurrent('/projects/') }]} href="/projects/" aria-current={isCurrent('/projects/') ? 'page' : undefined}>
        <i class="stitch" aria-hidden="true"></i>项目
      </a>
      <a class:list={[{ 'is-current': isCurrent('/about/') }]} href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>
        <i class="stitch" aria-hidden="true"></i>关于
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }

  .header-row {
    padding-block: 1.4rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .brand {
    color: var(--fg);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* 中段斜缝：把名与入口缝在一起的线迹 */
  .seam-gap {
    flex: 1 1 auto;
    min-width: 1.25rem;
    height: 1.5rem;
    position: relative;
  }

  .seam-seg {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: linear-gradient(90deg, var(--wake), var(--dream));
    opacity: 0.5;
    transform: rotate(14deg);
    -webkit-mask: linear-gradient(90deg, transparent, #000 24%, #000 76%, transparent);
    mask: linear-gradient(90deg, transparent, #000 24%, #000 76%, transparent);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.15rem;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--fg-soft);
    text-decoration: none;
    padding-block: 0.3rem;
    transition: color 0.16s ease;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--fg);
  }

  /* 针脚基元：10×2、+8°、圆角；hover 被轻轻拉长 */
  .stitch {
    display: inline-block;
    flex: none;
    width: 10px;
    height: 2px;
    border-radius: 2px;
    background: rgba(38, 44, 51, 0.4);
    transform: rotate(8deg);
    transition:
      width 0.16s ease,
      background-color 0.16s ease;
  }

  .site-nav a:hover .stitch,
  .site-nav a:focus-visible .stitch {
    width: 16px;
  }

  .site-nav a.is-current {
    color: var(--fg);
  }

  .site-nav a.is-current .stitch {
    background: var(--amber);
  }

  @media (max-width: 560px) {
    .seam-gap {
      display: none;
    }

    .header-row {
      gap: 1rem;
    }
  }
</style>
