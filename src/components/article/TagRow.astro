---
/* 随笔页文末 · 标签行：纸面小签，各指向 /tags/<标签>/ */
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<nav class="tag-row" aria-label="标签">
  {tags.map((t) => <a href={`/tags/${t}/`}>{t}</a>)}
</nav>

<style>
  .tag-row {
    margin-top: 3rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
  }

  .tag-row a {
    color: var(--fg-soft);
    border: 1px solid var(--line);
    padding: 0.14rem 0.5rem 0.1rem;
    border-radius: 2px;
    text-decoration: none;
    position: relative;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  /* 触控热区四周各扩一半间距（0.45rem 的一半），小签之间不重叠，外观不变 */
  .tag-row a::after {
    content: '';
    position: absolute;
    inset: -0.22rem;
  }

  .tag-row a:hover {
    color: var(--fg);
    border-color: color-mix(in srgb, var(--dream) 50%, transparent);
  }
</style>
