---
/* 随笔页文末 · 醒来卡：较早 / 较晚一篇 + 字数读时 */
interface Props {
  older?: { id: string; title: string };
  newer?: { id: string; title: string };
  chars: number;
  readMin: number;
}

const { older, newer, chars, readMin } = Astro.props;

const CN = ['零', '一', '二', '三', '四', '五', '六', '七', '八', '九', '十'];
const cn = (n: number) => CN[n] ?? String(n);
---

<footer class="wake-card">
  <div class="wc-nav">
    {
      older ? (
        <a href={`/articles/${older.id}/`}>
          <span class="wn-label mono">较早的一篇</span>
          <span class="wn-title">{older.title}</span>
        </a>
      ) : (
        <span class="wn-empty">
          <span class="wn-label mono">较早的一篇</span>
          <span class="wn-title">这是今夜最早的一篇。</span>
        </span>
      )
    }
    {
      newer ? (
        <a class="wn-right" href={`/articles/${newer.id}/`}>
          <span class="wn-label mono">较晚的一篇</span>
          <span class="wn-title">{newer.title}</span>
        </a>
      ) : (
        <span class="wn-empty wn-right">
          <span class="wn-label mono">较晚的一篇</span>
          <span class="wn-title">这是今夜最新的一篇。</span>
        </span>
      )
    }
  </div>
  <p class="wc-foot mono">
    <a href="/articles/">回到随笔</a>
    <span>全文约 {chars} 字 · 阅读约需 {cn(readMin)} 分钟</span>
  </p>
</footer>

<style>
  .wake-card {
    margin-top: 3.4rem;
    border-top: 1px solid var(--line);
    padding-top: 0.5rem;
  }

  .wc-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .wc-nav a,
  .wc-nav .wn-empty {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 0.2rem 0.5rem;
    text-decoration: none;
  }

  .wc-nav .wn-right {
    border-left: 1px solid var(--line);
    padding-left: 1.4rem;
    align-items: flex-end;
    text-align: right;
  }

  .wn-label {
    font-size: 0.58rem;
    letter-spacing: 0.3em;
    color: var(--umber);
  }

  .wn-title {
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--fg-soft);
    transition: color 0.2s;
  }

  .wc-nav a:hover .wn-title {
    color: var(--umber);
  }

  .wc-nav .wn-empty .wn-title {
    color: var(--fg-soft);
  }

  .wc-foot {
    margin: 1.2rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.4rem;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: var(--fg-soft);
  }

  .wc-foot a {
    color: var(--fg-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
  }

  .wc-foot a:hover {
    color: var(--umber);
  }

  @media (max-width: 760px) {
    .wc-nav {
      grid-template-columns: 1fr;
    }

    .wc-nav .wn-right {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-left: 0.2rem;
      align-items: flex-start;
      text-align: left;
      padding-top: 1rem;
    }
  }
</style>
