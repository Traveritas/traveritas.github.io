---
/* 目录页的分年组：一枚年份 + 一列 <IndexRow>。随笔 / 项目两个目录页共用 */
interface Props {
  year: number;
}

const { year } = Astro.props;
---

<section class="year-group">
  <h2 class="year mono" id={`y${year}`} data-g-node="major" data-g-label={String(year)}>{year}</h2>
  <ol class="index-list">
    <slot />
  </ol>
</section>

<style>
  .year-group {
    margin-bottom: 3.4rem;
  }

  .year {
    margin: 0 0 1.2rem;
    padding-left: 0.2rem;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.72rem;
    line-height: 1.6;
    letter-spacing: 0.2em;
    color: var(--umber);
  }

  .index-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
