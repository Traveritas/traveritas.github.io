---
/* 标签框：data-tag 是样式名（专属框挂在它上面），data-tag-name 是标签原文（筛选用）。
   默认 href 指向本页 ?tag=…，有 JS 时由 gauge.ts 拦下就地筛选。 */
import { tagKey } from '../data/tags';
import '../styles/tags.css';

interface Props {
  tag: string;
  href?: string;
}

const { tag, href = `?tag=${encodeURIComponent(tag)}` } = Astro.props;
---

<a class="tag-chip" href={href} data-tag={tagKey(tag)} data-tag-name={tag}>{tag}</a>
