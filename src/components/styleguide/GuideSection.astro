---
/* 预览页的章节：编号 · 标题 · 英文注 · 说明。id 供目录跳转（sg- 前缀）。 */
interface Props {
  id: string;
  n: string;
  title: string;
  en?: string;
  note?: string;
}

const { id, n, title, en, note } = Astro.props;
---

<section class="sg-sec" id={`sg-${id}`}>
  <div class="sg-sec-head">
    <span class="sg-sec-n mono">{n}</span>
    <h2>{title}</h2>
    {en && <span class="sg-sec-en mono">{en}</span>}
    {note && <p class="sg-sec-note"><span set:html={note} /></p>}
  </div>
  <div class="sg-specs"><slot /></div>
</section>
