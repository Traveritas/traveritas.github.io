---
/* 令牌色块：色票取自变量本身（梦中强调色由 reality.ts 逐帧改写，这里跟着走），
   右侧数值由页面脚本读计算值回填 —— 免得把色号抄第二处。 */
interface Props {
  token: string;
  role?: string;
}

const { token, role } = Astro.props;
---

<div class="sg-swatch">
  <span class="sg-chip" style={`background: var(${token})`} aria-hidden="true"></span>
  <span class="sg-swatch-txt">
    <code class="sg-spec-cls">{token}</code>
    <span class="sg-val" data-sg-token={token}>—</span>
  </span>
  {role && <span class="sg-role">{role}</span>}
</div>
