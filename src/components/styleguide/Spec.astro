---
/* 预览页的样张框：名称 · 类名 · 出处 · 说明，下面是实物。
   新增样张 = 在页面里把实物塞进 <Spec> 的 slot，样式一律取自真实来源。 */
interface Props {
  name: string;
  /** 被预览的类名 / 选择器，原样显示 */
  cls?: string;
  /** 这条样式写在哪个文件里（便于回去改） */
  src?: string;
  note?: string;
  /** 实物需要出血（自己带内边距的块，如 container / 名录） */
  flush?: boolean;
}

const { name, cls, src, note, flush = false } = Astro.props;
---

<div class="sg-spec">
  <div class="sg-spec-head">
    <span class="sg-spec-name">{name}</span>
    {cls && <code class="sg-spec-cls">{cls}</code>}
    {src && <span class="sg-spec-src">{src}</span>}
    {note && <span class="sg-spec-note" set:html={note} />}
  </div>
  <div class:list={['sg-spec-body', { 'sg-spec-body--flush': flush }]}>
    <slot />
  </div>
</div>
