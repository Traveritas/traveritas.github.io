---
/* ─────────────────────────────────────────────────────────────
   漫游 / 检索：主页与随笔 · 瞬间 · 项目三个目录页共用的一片空间（原型与设计说明在 design/mocks/wander/）。
   四个地址是同一页，只是进来时落在哪里（scene）：主页是这片空间还没分开的样子，往下走就分成三栏。

   · 构建期：把三个集合整理成一份数据写进页面（窗面在客户端用 canvas 画，所以要标题、日期、简介、标签、配图尺寸）；
     瞬间的配图按 720 / 1600 两档出 webp；瞬间正文（没有单独的页）直接带上渲染好的 html。
     随笔 / 项目的正文不进数据：读的时候去取它自己那一页（reader.js）。
   · 页面原来的目录（各页 slot 里的内容）留作无脚本兜底与给搜索引擎的那一份，包在 .w-fallback 里；
     有脚本时最早的一段内联脚本给 html 加 w-on，样式（styles/wander.css）据此收起目录、页头页脚，整页交给这片空间。
   · 脚本起不来（出错）就把 w-on 摘掉，目录照常回来。
   ───────────────────────────────────────────────────────────── */
import '../../styles/wander.css';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { countChars } from '../../lib/format';
import { excerpt } from '../../lib/excerpt';

interface Props {
  /* home：主页（这片空间还没分开的样子，见 wander.js 文件头） */
  scene: 'home' | 'essay' | 'moment' | 'project';
}
const { scene } = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');
const day = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
const newest = <T extends { data: { date: Date }; id: string }>(a: T, b: T) =>
  b.data.date.valueOf() - a.data.date.valueOf() || b.id.localeCompare(a.id);

const articles = (await getCollection('articles', (a) => !a.data.draft)).sort(newest).map((a) => ({
  id: a.id,
  title: a.data.title,
  desc: a.data.description ?? '',
  date: day(a.data.date),
  tags: a.data.tags,
  chars: countChars(a.body ?? ''),
  href: `/articles/${a.id}/`,
}));

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(newest).map((p) => ({
  id: p.id,
  title: p.data.title,
  desc: p.data.description ?? '',
  date: day(p.data.date),
  status: p.data.status,
  links: p.data.links,
  note: p.data.note ?? null,
  href: `/projects/${p.id}/`,
}));

type Pic = ImageMetadata | { src: ImageMetadata; alt: string };
const isMeta = (x: Pic): x is ImageMetadata => 'format' in x;
const moments = await Promise.all(
  (await getCollection('moments', (m) => !m.data.draft)).sort(newest).map(async (m) => {
    const images = await Promise.all(
      (m.data.images as Pic[]).map(async (pic) => {
        const src = isMeta(pic) ? pic : pic.src;
        const alt = isMeta(pic) ? '' : pic.alt;
        // 窗面用 720 宽的 webp；读的时候用大图——原图本来就不宽于 1600 就直接用原图（重编码反而更大）
        const mid = await getImage({ src, width: Math.min(720, src.width), format: 'webp' });
        const large = src.width > 1600 ? (await getImage({ src, width: 1600, format: 'webp' })).src : src.src;
        return { m: mid.src, l: large, w: src.width, h: src.height, alt };
      }),
    );
    // 窗面上用的纯文字：按段落，去掉双态与行内光景的记号（只取醒面）
    const text = (m.body ?? '')
      .split(/\n\s*\n/)
      .map((p) => excerpt(p, 2000))
      .filter(Boolean)
      .join('\n\n');
    return {
      id: m.id,
      title: m.data.title ?? '',
      date: day(m.data.date),
      tags: m.data.tags,
      text,
      html: m.rendered?.html ?? '',
      images,
      href: `/moments/#${m.id}`,
    };
  }),
);

// 写进 <script type="application/json">：把 < 转义，正文里的 </script> 不会提前合上标签
const data = JSON.stringify({ articles, projects, moments }).replace(/</g, '\\u003c');

const HEADS = [
  { s: 'essay', no: 'I', t: '随笔', d: '断章', en: 'ESSAYS' },
  { s: 'moment', no: 'II', t: '瞬间', d: '闪念', en: 'MOMENTS' },
  { s: 'project', no: 'III', t: '项目', d: '造物', en: 'PROJECTS' },
];
---

<script is:inline>
  document.documentElement.classList.add('w-on');
</script>

<div class="w-host" id="w-host" data-scene={scene}>
  <canvas id="w-light" aria-hidden="true"></canvas>
  <canvas id="w-wx-back" class="w-wx" aria-hidden="true"></canvas>
  <div id="w-stage" aria-label="随笔、瞬间与项目"></div>
  <canvas id="w-wx-front" class="w-wx" aria-hidden="true"></canvas>
  <div id="w-heads">
    {
      HEADS.map((h) => (
        <div class="w-rh" data-w-head={h.s} data-wscene={h.s}>
          <div class="w-rh-in">
            <span class="no">{h.no}</span>
            <b data-morph data-true={h.t} data-dream={h.d}>{h.t}</b>
            <i>{h.en}</i>
            <span class="ct"></span>
          </div>
        </div>
      ))
    }
  </div>
  <div id="w-veil" aria-hidden="true"></div>

  <div class="w-home" id="w-home">
    <i class="w-home-ln" aria-hidden="true"></i>
    <i class="w-home-ln" aria-hidden="true"></i>
    <div class="w-home-title">
      <p class="w-home-kicker"><span data-morph data-true="个人网站" data-dream="昼梦叙集">个人网站</span></p>
      {/* 大字与它上面那扇「反相窗」共用一个盒子：盒子是 transform 的落点，那扇窗只要 inset:0 就永远贴着字 */}
      <div class="w-home-brand-box">
        {scene === 'home' ? <h1 class="w-home-brand is-wake" data-brand aria-label="Traveritas">Traveritas</h1> : <p class="w-home-brand is-wake" data-brand aria-hidden="true">Traveritas</p>}
        {scene === 'home' && <i class="w-home-win" aria-hidden="true"><canvas id="w-win"></canvas></i>}
      </div>
    </div>
    <p class="w-home-clock"><time id="w-clock"></time></p>
    <nav class="w-home-exits" aria-label="别处">
      <a href="https://github.com/Traveritas" rel="noreferrer">GitHub</a>
      <a href="/rss.xml">RSS</a>
      <a class="w-home-gate" href="/gate/">
        <svg viewBox="0 0 16 22" aria-hidden="true"><path d="M8 1 15 9 8 21 1 9Z"></path><path d="M1 9h14M8 1 5 9l3 12 3-12-3-8"></path></svg>
        <span>NEXUS</span>
      </a>
    </nav>
    <p class="w-home-hint" aria-hidden="true"><span data-morph data-true="向下" data-dream="下沉">向下</span><i></i></p>
  </div>

  <div class="w-chrome">
    <a class="w-brand is-wake" href="/" data-ink data-brand aria-label="Traveritas">Traveritas</a>
    <nav class="w-scenes" aria-label="场景" data-ink>
      {
        HEADS.map((h) => (
          <button type="button" data-scene={h.s} aria-pressed={h.s === scene ? 'true' : 'false'}>
            <span data-morph data-true={h.t} data-dream={h.d}>{h.t}</span>
          </button>
        ))
      }
    </nav>
    <div class="w-views" role="group" aria-label="视图" data-ink>
      <button type="button" data-view="explore" title="漫游（V）">
        <svg viewBox="0 0 18 14" aria-hidden="true"><rect x="1" y="2" width="6" height="4"></rect><rect x="10" y="1" width="4" height="3" opacity=".55"></rect><rect x="5" y="8.5" width="8" height="4.5"></rect></svg>
        <span>漫游</span>
      </button>
      <button type="button" data-view="grid" title="检索（V）">
        <svg viewBox="0 0 18 14" aria-hidden="true"><path d="M5.2 1 3.2 13M10 1 8 13M14.8 1 12.8 13"></path></svg>
        <span>检索</span>
      </button>
    </div>
  </div>

  <script type="application/json" id="w-data" set:html={data} />
</div>

<script>
  import { initWander } from '../../scripts/wander/wander.js';
  const host = document.getElementById('w-host');
  if (host)
    initWander(host).catch((err) => {
      // 起不来：把目录还回来
      console.error(err);
      document.documentElement.classList.remove('w-on');
    });
</script>
