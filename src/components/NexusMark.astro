---
/* NEXUS 的字：取自 NEXUS 站标题用的像素字（Fusion Pixel 12px，OFL），只抽了这五个字母的格子，
   免得为五个字载一份 650KB 的字体。一格 = --nx-px（默认 2px，同 NEXUS「一个 UI 像素 ＝ 2 个屏幕像素」），
   字距 = --nx-gap（默认一格，即原字的步进）。颜色跟 currentColor。 */
interface Props {
  class?: string;
}

// [字宽（格）, 路径]；字高 9 格，原点在左上
const GLYPHS: [number, string][] = [
  [6, 'M0 0L1 0L1 1L2 1L2 2L1 2L1 9L0 9ZM5 0L6 0L6 9L5 9L5 8L4 8L4 6L5 6ZM2 2L3 2L3 4L2 4ZM3 4L4 4L4 6L3 6Z'],
  [6, 'M0 0L6 0L6 1L1 1L1 4L5 4L5 5L1 5L1 8L6 8L6 9L0 9Z'],
  [
    7,
    'M0 0L1 0L1 1L0 1ZM6 0L7 0L7 1L6 1ZM1 1L2 1L2 3L1 3ZM5 1L6 1L6 3L5 3ZM2 3L3 3L3 4L2 4ZM4 3L5 3L5 4L4 4ZM3 4L4 4L4 5L3 5ZM2 5L3 5L3 6L2 6ZM4 5L5 5L5 6L4 6ZM1 6L2 6L2 8L1 8ZM5 6L6 6L6 8L5 8ZM0 8L1 8L1 9L0 9ZM6 8L7 8L7 9L6 9Z',
  ],
  [6, 'M0 0L1 0L1 8L0 8ZM5 0L6 0L6 8L5 8ZM1 8L5 8L5 9L1 9Z'],
  [
    6,
    'M1 0L5 0L5 1L1 1ZM0 1L1 1L1 3L0 3ZM5 1L6 1L6 2L5 2ZM1 3L2 3L2 4L1 4ZM2 4L4 4L4 5L2 5ZM4 5L5 5L5 6L4 6ZM5 6L6 6L6 8L5 8ZM0 7L1 7L1 8L0 8ZM1 8L5 8L5 9L1 9Z',
  ],
];
---

<span class:list={['nx-mark', Astro.props.class]} role="img" aria-label="NEXUS">
  {
    GLYPHS.map(([w, d]) => (
      <svg viewBox={`0 0 ${w} 9`} style={`--w:${w}`} shape-rendering="crispEdges" aria-hidden="true">
        <path d={d} />
      </svg>
    ))
  }
</span>

<style>
  /* 两个变量都由外层给（继承），这里只放缺省值 */
  .nx-mark {
    display: inline-flex;
    gap: var(--nx-gap, var(--nx-px, 2px));
    vertical-align: middle;
    line-height: 0;
  }
  /* 字母不参与伸缩：放在零宽的容器里（如测量点）也不会被压扁 */
  .nx-mark svg {
    flex: none;
    display: block;
    width: calc(var(--w) * var(--nx-px, 2px));
    height: calc(9 * var(--nx-px, 2px));
    fill: currentColor;
  }
</style>
