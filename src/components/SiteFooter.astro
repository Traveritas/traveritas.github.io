---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-row">
    <span>Traveritas {year}</span>
    <span class="footer-clock mono" data-morph data-clock aria-label="当前时刻">--:--</span>
    <span>在醒与梦之间</span>
    <a href="/rss.xml">RSS</a>
    <button type="button" class="footer-cursor" data-cursor-toggle aria-pressed="false" title="换回系统指针（选择会被记住）">原生指针</button>
  </div>
</footer>
