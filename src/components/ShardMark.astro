---
interface Props {
  size?: number;
}

const { size = 18 } = Astro.props;
---

{/* 水晶碎片印记——站点的视觉母题预告 */}
<svg
  class="shard-mark"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  <path
    d="M12 1.6 19.9 8.7 16.9 22.2 7.3 22.4 4.1 9.5Z"
    stroke="currentColor"
    stroke-width="1.1"
    stroke-linejoin="round"
  ></path>
  <path
    d="M12 1.6 9.4 22.3M12 1.6l4.9 20.6M4.1 9.5l15.8-.8M4.1 9.5 9.4 22.3M19.9 8.7l-3 13.5"
    stroke="currentColor"
    stroke-width="0.55"
    stroke-opacity="0.5"
    stroke-linejoin="round"
  ></path>
</svg>
