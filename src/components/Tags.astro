---
/* 名录里的标签：一块一个小签。data-tag 是原样的标签名——要给某个标签单独的样子，
   在 site.css 里写 .tag[data-tag="知觉"] { … } 就行 */
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <span class="tags">
      {tags.map((t) => (
        <span class="tag" data-tag={t}>
          {t}
        </span>
      ))}
    </span>
  )
}
