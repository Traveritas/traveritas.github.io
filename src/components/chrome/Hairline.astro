---
/* 顶部发丝进度线：2px，醒→梦渐变，长 = 滚动百分比（chrome.ts） */
---

<div class="hairline" aria-hidden="true">
  <div class="hairline-fill"></div>
</div>

<style>
  .hairline {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 55;
    pointer-events: none;
  }

  /* 关于页退场：顶部进度线随仪器层一起先退（about-exit.ts） */
  :global(html[data-exit-on]) .hairline {
    opacity: calc(1 - var(--exit-chrome, 0));
  }

  /* 进度由 chrome.ts 写 transform: scaleX(p)（不进布局）；满宽渐变随盒子一起压缩，
     与「宽 = p」时裁出的那一截逐像素相同 */
  .hairline-fill {
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    background: linear-gradient(90deg, var(--wake), var(--amber));
  }
</style>
