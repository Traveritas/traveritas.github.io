---
/* 顶部发丝进度线：2px，醒→梦渐变，宽 = 滚动百分比（chrome.ts） */
---

<div class="hairline" aria-hidden="true">
  <div class="hairline-fill"></div>
</div>

<style>
  .hairline {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 55;
    pointer-events: none;
  }

  .hairline-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--wake), var(--amber));
  }
</style>
