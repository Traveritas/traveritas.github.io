---
/* ─────────────────────────────────────────────────────────────
   环境声 · 开关微章（音律微弦 · 悬停舒展版）
   · 固定在左下角（常驻全站）：左侧中段留给 Rail 仪表轨，首屏右下留给 RealityGuide。
   · 构型设计：
     - 常态：32×30px 的半透明磨砂树脂微体，内置 3 根极细（1.25px）光学声学微弦；
     - 动效：静音时微弦平卧为 2.5px 浅灰基线，发声时化为琥珀色流光并按质数周期上下起伏；
     - 悬停/聚焦：向右优雅舒展至 106px，浮现双态文案（醒「环境声/开启」↔ 梦「回响/让声浮起」）；
     - 梦态：微弦带有轻微泛音混响柔焦（filter: blur(0.35px)）。
   · 开关态由 html[data-sound="on"] 统一驱动，与 [data-morph] 引擎无缝协同。
   · 无 JS 时在 BaseLayout 的 noscript 下自动隐藏。
   ───────────────────────────────────────────────────────────── */
---

<button
  class="snd"
  type="button"
  data-sound-toggle
  data-nofx
  aria-label="环境声开关"
  title="环境声"
>
  <!-- 声学微弦发声核（3 根光学微线） -->
  <span class="snd-filaments" aria-hidden="true">
    <i class="snd-str snd-s1"></i>
    <i class="snd-str snd-s2"></i>
    <i class="snd-str snd-s3"></i>
  </span>

  <!-- 悬停展开区域（平滑舒展） -->
  <span class="snd-expand" aria-hidden="true">
    <!-- 文字恒定保持：醒面「环境声」↔ 梦面「回响」 -->
    <span class="snd-label" data-morph data-true="环境声" data-dream="回响">环境声</span>

    <!-- 仅徽标跟随开/关状态切换 -->
    <span class="snd-tag snd-tag-on mono">ON</span>
    <span class="snd-tag snd-tag-off mono">OFF</span>
  </span>
</button>

<style>
  .snd {
    position: fixed;
    left: 24px;
    bottom: 22px;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    width: 32px;
    height: 30px;
    padding: 0 8px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: color-mix(in srgb, var(--bg) 75%, rgba(255, 255, 255, 0.08));
    backdrop-filter: blur(16px) saturate(125%);
    -webkit-backdrop-filter: blur(16px) saturate(125%);
    box-shadow:
      0 6px 18px -4px rgba(10, 14, 20, 0.3),
      0 0 1px 1px rgba(255, 255, 255, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.32);
    color: var(--fg-soft);
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;
    overflow: hidden;
    /* 常驻构件：余光中静默退后，触碰与悬停时唤起 */
    opacity: 0.8;
    transition:
      width 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s cubic-bezier(0.2, 0.8, 0.3, 1),
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      color 0.25s ease,
      transform 0.2s cubic-bezier(0.2, 0.8, 0.3, 1);
  }

  .snd:hover,
  .snd:focus-visible {
    width: 98px;
    opacity: 1;
    color: var(--fg);
    border-color: color-mix(in srgb, var(--amber) 45%, rgba(255, 255, 255, 0.35));
    box-shadow:
      0 8px 24px -4px rgba(10, 14, 20, 0.38),
      0 0 14px 1px color-mix(in srgb, var(--amber) 22%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.45);
    outline: none;
  }

  .snd:active {
    transform: scale(0.94);
  }

  /* ── 3 根声学微弦（核心构型） ───────────────────────── */
  .snd-filaments {
    position: absolute;
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    width: 14px;
    height: 14px;
    flex: none;
  }

  .snd-str {
    display: block;
    width: 1.25px;
    border-radius: 1px;
    background: var(--fg-faint);
    opacity: 0.65;
    transition:
      height 0.35s ease,
      background 0.3s ease,
      opacity 0.3s ease,
      filter 0.3s ease;
  }

  /* 静音常态（Off）：3 根细线平卧为 2.5px 微短点 */
  .snd-s1 { height: 2.5px; }
  .snd-s2 { height: 2.5px; }
  .snd-s3 { height: 2.5px; }

  /* 发声活跃态（On）：琥珀流光，按质数周期呼吸起伏 */
  :global(html[data-sound='on']) .snd-str {
    background: var(--amber);
    opacity: 1;
  }
  :global(html[data-sound='on']) .snd-s1 {
    animation: snd-wave-1 2.4s ease-in-out infinite alternate;
  }
  :global(html[data-sound='on']) .snd-s2 {
    animation: snd-wave-2 3.1s ease-in-out infinite alternate;
  }
  :global(html[data-sound='on']) .snd-s3 {
    animation: snd-wave-3 1.9s ease-in-out infinite alternate;
  }

  /* 梦态微弦的泛音混响与柔焦（仅在梦面生效） */
  :global(html[data-reality='dream'][data-sound='on']) .snd-filaments,
  :global(html[data-face='dream'][data-sound='on']) .snd-filaments {
    filter: blur(0.35px) drop-shadow(0 0 3px color-mix(in srgb, var(--amber) 60%, transparent));
  }

  @keyframes snd-wave-1 {
    0% { height: 3.5px; }
    50% { height: 11.5px; }
    100% { height: 5px; }
  }
  @keyframes snd-wave-2 {
    0% { height: 13.5px; }
    50% { height: 6px; }
    100% { height: 14px; }
  }
  @keyframes snd-wave-3 {
    0% { height: 4.5px; }
    50% { height: 9.5px; }
    100% { height: 3px; }
  }

  /* ── 悬停展开区域（文字与状态标签） ───────────────── */
  .snd-expand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: 20px;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.22s 0.04s ease,
      transform 0.28s 0.04s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .snd:hover .snd-expand,
  .snd:focus-visible .snd-expand {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .snd-label {
    white-space: nowrap;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
  }

  .snd-tag {
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: var(--fg-faint);
  }

  /* 徽标状态切换：默认 OFF，开声时点亮 ON */
  .snd-tag-on {
    display: none;
  }
  .snd-tag-off {
    display: inline;
  }

  :global(html[data-sound='on']) .snd-tag-on {
    display: inline;
    color: var(--amber);
  }
  :global(html[data-sound='on']) .snd-tag-off {
    display: none;
  }
  :global(html[data-sound='on']) .snd {
    opacity: 0.95;
    color: var(--fg);
  }

  /* ── 阅读页整页电平退避联动 ───────────────────────── */
  :global(body[data-bgm='reading']) .snd {
    opacity: 0.48;
  }
  :global(body[data-bgm='reading']) .snd:hover,
  :global(body[data-bgm='reading']) .snd:focus-visible {
    opacity: 1;
  }

  /* ── 移动端与无障碍 ─────────────────────────────────── */
  @media (max-width: 760px) {
    .snd {
      left: 14px;
      bottom: 14px;
      /* 触屏无 hover：保持小巧微体，点击即切换 */
      width: 32px !important;
      height: 30px;
      padding: 0 8px;
    }
    .snd-expand {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .snd,
    .snd-expand,
    .snd-str {
      transition: none;
    }
    :global(html[data-sound='on']) .snd-s1,
    :global(html[data-sound='on']) .snd-s2,
    :global(html[data-sound='on']) .snd-s3 {
      animation: none;
      height: 9px;
    }
  }
</style>
