---
/* 缝线上的脑电群（全站常驻）：主波 + 三道谐波残影，同轴 14°、视口 50vh。
   一条波被两种采样率读出，就是这一件东西的两态：
     · 醒 ＝ 四条都塌回缝线上**重合**（主波逐帧连续流动，仍是线上原样：AMP 3.6 / FREQ .5 /
            SPD 2.6 / 26px 步长 / 14° 轴心视口 50vh，与线上逐字一致；残影的 dy 与
            不透明度都乘 --still ⇒ 位移 0、不可见）—— 醒面「什么都没多」，逐像素与线上相同。
     · 梦 ＝ 同一条波分四种读法，四道各错开一点点（主波留在轴线上，三道残影 dy −8 / −4 / +4，
            相位错到波周期的 26% / 54% / 82%）且**四道的摆幅同时翻倍**（`GAIN_D` 4.8 ＝
            醒态增益的两倍，梦态振幅 ＝ AMP × GAIN_D × 各道 gain，两道阶梯波再各自收两成；
            d=0 时 A 恒为 AMP，与 GAIN_D / gain 无关 ⇒ 醒态不受影响），主波按**每 0.25 秒
            采一次样**并零阶保持（连续插值：phUsed = floor(ph/T)·T + (1−f)·frac，f ＝ 梦度
            ⇒ 醒态与今天逐字一样连续，梦态每拍一采，长按过程里采样率连续收紧，不是开关）。
     四道不是复制，是三种读法（冷暖分层、步长 ×2/×3/×5）：**相位延迟、步长、量化各不同，
     位置只错开一点点**，四道因此在轴周围互相穿插，越远的一条滞后越多、起伏越浅。
       · 灰调两道（主波 / wake 残影）＝ 同一种读法：零阶保持的阶梯路径 +
         **跟拍钟**（位置每一格跳一次，一格 ＝ 0.25s）+ 阶跃游走；灰道的采样格与游走
         都**落后半格** ⇒ 两个阶梯波交错运动（这一格主线跳、下一格灰道跳）；
       · 有色两道（琥珀 / 暖沙）＝ 不采样、不量化、也不跟拍钟（JS 的 smooth）
         ⇒ 连续曲线 + 连续游走，不随节拍跳；最淡的暖沙一道作虚线。
         dy 是唯一的位置旋钮：要哪一道离开轴线单独展开，只改它自己的 dy（乘梦度，
         醒态照样塌回轴上）。
     残影延迟按拍长绑定（beats × --fld-beat ≥ 1 拍）：采样一拍一停之后，小于一拍的
     延迟会让三道残影在同一拍里与主波重合、合唱闪烁，所以延迟一律 ≥1 拍（≈0.6/1.3/2.0s，
     带微差避免三声部同相）——合唱因此比不加约束时更「展开」。
   钩子：wakeMix()（醒度的 JS 侧读数）+ onMixChange()（醒度变了才通知，给 Worker 转发）。
   算法在 src/scripts/eeg-wave.ts（只产出路径字符串），两个渲染端共用：
     · 首选 Worker 里的 OffscreenCanvas（eeg-worker.ts，Path2D 描同一串路径）：波形逐帧在变，
       放在主线程上无论写 SVG 还是画 canvas，每帧都要跑一遍主线程渲染，并把全站本可只在
       合成器上跑的动画（构块场 160 块、漂移）一起逐帧拉回主线程重算 —— 低端机上常驻卡顿
       的最后一个来源。Worker 直接向合成器提交，主线程静置时完全空闲。
     · 回退：主线程 SVG（不支持 OffscreenCanvas 或 Worker 起不来时），帧由 lib.ts 的
       onFrame30 共享帧钟驱动；两个阶梯波各自只在自己那一格走动的帧里重写。
   残影的游走（阶跃 / 连续两种）算进路径的 dy，**不用 CSS 动画**：path 上的 transform
   动画是 SVG 动画、走主线程，醒态位移为 0 也照跑。
   两端的线宽 / 不透明度 / 虚线：SVG 读下方 CSS，Worker 端在 eeg-worker.ts 里逐项照抄 ——
   改样式要两处一起改。
   减动效：只画一帧静态。 */
---

<div class="eeg-group" id="site-eeg-group" aria-hidden="true">
  <svg class="eeg" id="site-eeg">
    <g>
      <!-- 残影插在主波之前 ⇒ 主波永远压在最上 -->
      <path class="eeg-echo eeg-echo-1" />
      <path class="eeg-echo eeg-echo-2" />
      <path class="eeg-echo eeg-echo-3" />
      <path class="eeg-main" />
    </g>
  </svg>
  <!-- 首选渲染端：控制权交给 Worker（eeg-worker.ts），首帧画好才露出、SVG 随之撤掉 -->
  <canvas class="eeg" id="site-eeg-canvas" hidden></canvas>
</div>

<style>
  /* 群：fixed 视口层，与缝线同轴锁定、滚动零滞后；--fld-beat 是它唯一的拍长旋钮
     （＝阶梯波的重采样间隔：梦态「每拍采一次样」，0.25s 走一格；灰道的阶跃游走
     与残影延迟都从它派生） */
  .eeg-group {
    position: fixed;
    inset: 0;
    /* 负 z：沉到内容之下（缝线之下、构块场之上——BaseLayout 里本组件在它之后） */
    z-index: -2;
    pointer-events: none;
    overflow: hidden;
    --fld-beat: 0.25s;
  }

  /* 阅读与长文页面中央消隐：脑电曲线在正文列完全退隐，在视线余光两侧平滑浮现 */
  :global(body[data-mask-lines='true']) .eeg-group,
  :global(body[data-page-type='article']) .eeg-group {
    -webkit-mask-image: linear-gradient(
      to right,
      black 0,
      black calc(50% - var(--mask-half, 21rem) - 7rem),
      transparent calc(50% - var(--mask-half, 21rem)),
      transparent calc(50% + var(--mask-half, 21rem)),
      black calc(50% + var(--mask-half, 21rem) + 7rem),
      black 100%
    );
    mask-image: linear-gradient(
      to right,
      black 0,
      black calc(50% - var(--mask-half, 21rem) - 7rem),
      transparent calc(50% - var(--mask-half, 21rem)),
      transparent calc(50% + var(--mask-half, 21rem)),
      black calc(50% + var(--mask-half, 21rem) + 7rem),
      black 100%
    );
  }

  .eeg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* 路径两端伸出视口（沿 14° 铺满全幅），不要裁在自身盒子上 */
    overflow: visible;
  }

  /* ⚠ 以下线宽 / 不透明度 / 虚线在 eeg-worker.ts 的 MAIN_STYLE / ECHO_STYLE 里有一份照抄
     （Worker 读不到 CSS），改这里要一起改 */
  .eeg .eeg-main {
    stroke: var(--umber);
    stroke-width: 1.2;
    fill: none;
    opacity: 0.62;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── 三道谐波残影 ──────────────────────────────────────────────────────
     路径由脚本每帧重写（醒态 d 为空、不透明度为 0 ⇒ 与线上逐像素一致）；
     这里只管色与光量。游走按「读法」分成两组，由脚本算进路径（见 WALK / driftAt）：
       · 灰调 .eeg-echo-2 ＝ 与主波同一种读法：路径带零阶保持的阶梯、且跟拍钟
         （位置每一格跳一次，一格 ＝ --fld-beat），游走也是阶跃的（5 档 × 1 拍 = 1.25s）；
       · 有色 .eeg-echo-1 / .eeg-echo-3 ＝ 不跟拍钟：路径是连续曲线、每帧推进，
         游走也是连续插值（16 × 1 拍 = 4s 的线性往返）；最淡的暖沙一道作虚线。
     三道的游走都乘梦度 ⇒ 醒态位移为 0。 */
  .eeg .eeg-echo-1 {
    stroke: var(--amber);
    stroke-width: 1.15;
  }
  .eeg .eeg-echo-2 {
    stroke: var(--wake);
    stroke-width: 1.05;
  }
  .eeg .eeg-echo-3 {
    stroke: var(--dream);
    stroke-width: 0.95;
    stroke-dasharray: 5 7;
  }
  .eeg .eeg-echo {
    fill: none;
    stroke-linecap: butt;
    stroke-linejoin: miter;
    opacity: calc(var(--echo-op, 0.34) * var(--still));
  }
  .eeg .eeg-echo-2 {
    --echo-op: 0.26;
  }
  .eeg .eeg-echo-3 {
    --echo-op: 0.19;
  }
</style>

<script>
  import { onMixChange, wakeMix } from '../../scripts/reality';
  import { onFrame30, reducedMotion } from '../../scripts/lib';
  import { createEegWave, EEG_ECHO_COUNT, makeSpine, type Spine } from '../../scripts/eeg-wave';
  import { onEegSpine } from '../../scripts/eeg-spine';

  const svg = document.getElementById('site-eeg');
  const canvas = document.getElementById('site-eeg-canvas') as HTMLCanvasElement | null;
  const group = document.getElementById('site-eeg-group');
  if (svg && canvas && group) {
    /* 拍长：与 CSS 同一个源（.eeg-group 上的 --fld-beat ＝ 0.25s），阶梯波每拍采一次样、
       残影延迟也由它派生。采样一拍一停之后，延迟小于一拍 ⇒ 三道残影会在同一拍里与主波
       重合、合唱闪烁；所以延迟一律 ≥1 拍，并留一点微差免得三声部同相。 */
    const BEAT = parseFloat(getComputedStyle(group).getPropertyValue('--fld-beat')) || 0.25;
    const RM = reducedMotion();

    /* ── 回退端：主线程写 SVG 路径（不支持 OffscreenCanvas / Worker 起不来时）──
       立即画一帧（不等 rAF），再由共享的 30fps 帧钟驱动流动；
       rAF 被节流/停转的环境里由低频定时器兜底补帧 */
    const startSvg = () => {
      canvas.remove();
      const g = svg.querySelector('g');
      const main = svg.querySelector<SVGPathElement>('.eeg-main');
      const echoPaths = Array.from({ length: EEG_ECHO_COUNT }, (_, i) =>
        svg.querySelector<SVGPathElement>('.eeg-echo-' + (i + 1)),
      );
      const wave = createEegWave(BEAT);
      let lastRot = '';
      let lastDraw = 0;
      let lastPh = 0;
      /* 主页骨架（见 eeg-spine.ts）：有骨架时线沿它走、不再绕中心转 14° */
      let spine: Spine | null = null;
      let spineVer = 0;
      const tickDraw = (ph: number) => {
        lastDraw = performance.now();
        lastPh = ph;
        const rot = spine ? '' : `rotate(14 ${innerWidth / 2} ${innerHeight * 0.5})`;
        if (rot !== lastRot) {
          if (rot) g?.setAttribute('transform', rot);
          else g?.removeAttribute('transform');
          lastRot = rot;
        }
        const d = 1 - wakeMix();
        const f = spine ? wave.stepCurve(ph, d, spine, spineVer) : wave.step(ph, d, innerWidth, innerHeight);
        if (!f) return;
        if (f.main) main?.setAttribute('d', f.main);
        f.echoes.forEach((s, i) => {
          if (s) echoPaths[i]?.setAttribute('d', s);
        });
      };
      onEegSpine((st) => {
        spine = st.xy ? makeSpine(st.xy) : null;
        spineVer++;
        tickDraw(lastPh);
      });
      tickDraw(performance.now() / 1000);
      // 减动效：只留上面那一帧静态
      if (!RM) {
        onFrame30((ts) => {
          if (!document.hidden) tickDraw(ts / 1000);
        });
        setInterval(() => {
          if (!document.hidden && performance.now() - lastDraw > 500) {
            tickDraw(performance.now() / 1000);
          }
        }, 400);
      }
    };

    /* ── 首选端：Worker 里的 OffscreenCanvas（不占主线程帧，见 eeg-worker.ts 顶部注释）──
       SVG 先留在原位（路径为空、什么也不画），Worker 报 ready（首帧已画好）才撤掉；
       报 fail / 出错就收回画布、改走 SVG。 */
    const canOffscreen =
      typeof Worker === 'function' &&
      typeof Path2D === 'function' &&
      'transferControlToOffscreen' in HTMLCanvasElement.prototype;

    if (!canOffscreen) startSvg();
    else {
      let settled = false;
      const fallback = () => {
        if (settled) return;
        settled = true;
        worker.terminate();
        startSvg();
      };
      const worker = new Worker(new URL('../../scripts/eeg-worker.ts', import.meta.url), {
        type: 'module',
      });
      const root = document.documentElement;
      const cs = getComputedStyle(root);
      const baseColor = (k: string) => cs.getPropertyValue(k).trim();
      const base = {
        umber: baseColor('--umber'),
        amber: baseColor('--amber'),
        wake: baseColor('--wake'),
        dream: baseColor('--dream'),
      };
      // 强调色由 reality.ts 写在根节点的内联样式上（醒度插值）：读内联值不触发样式计算
      const inline = (k: string, fb: string) => root.style.getPropertyValue(k) || fb;
      const colors = () => ({
        umber: inline('--umber', base.umber),
        amber: inline('--amber', base.amber),
        wake: inline('--wake', base.wake),
        dream: inline('--dream', base.dream),
      });
      // DPR 封顶 2：满屏透明画布，3 倍屏上 1px 细线看不出差别，显存省一半多
      const size = () => ({ W: innerWidth, H: innerHeight, dpr: Math.min(devicePixelRatio || 1, 2) });

      worker.onmessage = (e: MessageEvent<{ type: string }>) => {
        if (e.data.type === 'ready' && !settled) {
          settled = true;
          svg.remove();
          canvas.removeAttribute('hidden');
        } else if (e.data.type === 'fail') fallback();
      };
      worker.onerror = fallback;

      try {
        const off = canvas.transferControlToOffscreen();
        worker.postMessage(
          {
            type: 'init',
            canvas: off,
            ...size(),
            beat: BEAT,
            d: 1 - wakeMix(),
            colors: colors(),
            still: RM,
            origin: performance.timeOrigin,
          },
          [off],
        );
      } catch {
        fallback();
      }
      addEventListener('resize', () => worker.postMessage({ type: 'size', ...size() }));
      onMixChange(() => worker.postMessage({ type: 'mix', d: 1 - wakeMix(), colors: colors() }));
      document.addEventListener('visibilitychange', () =>
        worker.postMessage({ type: 'hidden', hidden: document.hidden }),
      );
      onEegSpine((st) =>
        worker.postMessage({ type: 'spine', xy: st.xy, dark: st.dark, reveal: st.reveal, dot: st.dot }),
      );
    }
  }
</script>
