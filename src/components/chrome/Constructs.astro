---
/* 构块场：一片由方块拼接成的背景场，全站常驻（落地自 design/mocks/p18-constructs-and-echo.html
   的 BG SLOT，几何与参数逐字搬来，实测见 design/mocks/p18-notes.md）。
   两态差不是「换一件东西」，而是同一片流动被两种速率读出：
     · 醒 ＝ 整片场沿 14° 朝右下连续匀速流动（三档视差 104/84/66s ＝ 23–36px/s），
            块与块之间恒留 1–2px 缝，读得出「拼接」；
     · 梦 ＝ 同一片场**停在当前进度**（animation-play-state: paused，不归位到生成原点），
            只剩原地整数像素阶跃浮动、接缝裂开；
            整片场朝 14° 反方向恒退 260px —— 定距回溯，与已经漂了多久无关。
   钩子只有两个，全部由 reality.ts 维护，本组件不新增任何 JS 状态：
     body.reality-holding（长按中）/ body[data-reality='dream'] ⇒ 漂移暂停；
     --reality-mix 与 --still（逐帧写入的醒度与动效倍率）⇒ 拼合↔错开、回溯幅度。
     ★ 但**方块自己的浮动动画**必须与这条逐帧变量链脱钩：它只在
     body[data-reality='dream']:not(.reality-holding) 成立（见 .fld-sq 上方注释）。
     160 条主线程动画只要在跑就逐帧被 tick，长按期间会把掉帧数从个位数推到 40 帧。
   性能纪律：几何在装载期一次性烘焙（固定种子 LCG ⇒ 每次加载完全一致），
   之后只剩 transform/opacity 的 CSS 动画——无 rAF、无滚动/尺寸监听、不 resize 重算；
   两态共用同一套尺寸，过渡只动 transform，不会逐帧改 width/height 触发重排；
   动画的成立条件按状态收窄，绝不留下「振幅为 0 却照跑」的空转动画。
   样式非 scoped：整片场是生成器运行时建的节点，拿不到 Astro 的组件 scope 属性，
   故一律用 .fld- 前缀做命名空间。 */
interface Props {
  /* through = z −2：在首页千层纸(−3)之上、缝线(−1)之下，与脑电同为 −2
     （BaseLayout 里挂在本组件之后 ⇒ DOM 在后 ⇒ 脑电压在它上面）。
     below  = z −3：被首页千层纸完全遮住，只有滚过首屏才出现。 */
  layer?: 'through' | 'below';
}
const { layer = 'through' } = Astro.props;
---

<div class="fld-bg" id="fld-bg" data-layer={layer} aria-hidden="true">
  <div class="fld-field" id="fld-field"></div>
</div>

<style is:global>
  /* ═══════════════════════════════════════════════════════════════════════
     ★ 调参总闸 · 三处旋钮都在这里，改一行就够
     ───────────────────────────────────────────────────────────────────────
       --fld-rewind  定距回溯距离（px）。梦态整片场朝 14° 反方向（左上）恒退
                     这一个距离，与已经漂了多久无关。只改这一个数即可 —— 
                     --rw-x / --rw-y 由生成器按 260×cos14° / sin14° 取整分解后
                     写回本元素（默认 252px / 63px），也可 ?rw=NNN 覆盖（同样自动分解）。
       --fld-sdur / --fld-sdel
                     方块抽帧节拍（**方块唯一的那一个旋钮**，写在生成器顶部的
                     BANDS 表里，一行三档）：12.5 / 11.0 / 9.5s + 各档错相
                     −1.5 / −4.0 / −6.5s ＝ 8 站里每站 10%（7 档 + 30% 停歇，
                     与 brand.ts 同拍）。想让方块也「每拍一跳、三档齐拍」：
                     把三档 sdur 全改 10、sdel 全改 0。
       --fld-gap     边缝（px）：醒态相邻两块之间的缝隙（远档 4 / 中档 6 / 近档 8，大幅留白）。
                     ⚠ 边缝在**生成期**就烘焙进 left/top/width/height 里，一条
                     CSS 变量改不动已经生成好的几何 —— 真源是生成器顶部的 GAP
                     表（一行），另可用 ?gap=N 覆盖。这里只是把它记在明面上。
       --sq-scale    梦态方块放大：方块在梦态随 --rw-k 原地膨胀，带平滑幂次随机
                     分布（1.2x ~ 3.0x，最大约 3x），醒态恒为 1.0x。可用 ?smax=N 覆盖。
       --sq-amp      梦态方块位置量化浮动：严格参考标题（AveritA）实现，采用 Celeste 风格
                     简谐位置量化（3px 最大幅值，1px 整像素阶跃，step-end 零 tween 瞬切，
                     波峰波谷 26% 滞空缓动）。
                     档位表在生成器顶部的 SQ_TIERS（烘焙成 16 条字面值 keyframes）。
                     ⚠ 只在梦面静置时成立（醒面与长按期间摘掉动画名）——
                     这是一条硬性能约束，不是可调项，详见 .fld-sq 上方注释。
                     ☆ 别拿序号 / 正文 ((浮起)) 的写法来对齐这里：那两族只有
                     一节两枚、一段数字的量级，2026-09-25 起改成「动画常驻、
                     振幅乘 --still」以换掉换面时的一下骤停；本层是 160 枚，
                     常驻的代价按 Constructs 的实测是每帧 2.5ms，两族的取舍因此相反。
       --fld-ink     方块墨色（填充 5% / 边线 9%），默认 var(--fg) ＝ 中性墨。
                     ★ 浓淡只由这两个百分数决定，别处不用动：
                       5 / 9  （现值）淡，砌而不抢；醒面拼合仍读得出缝。
                       7 / 13（2026-09-28 之前）偏浓，梦面重叠时抢眼。
                       ⇒ 由 --ghost-ink（梦端暖墨 #b98f74）改来。底色上已经有
                       一层暖洗染（.wash-backdrop 梦端暖褐 7%），暖墨再叠一层，
                       梦态方块各自放大 1.2–3x 互相重叠时整片读成米黄斑块、
                       背景发花。换中性墨后同一片场按**明度**分层，读作
                       「灰玻璃叠层」，暖色只剩洗染那一处。面 : 缝 ≈ 0.55，
                       两档一致 ⇒ 面与缝的明暗关系不变，只整体退后一档。
                     ☆ 本层叠在**地面之上**（z −2；首页 −3），地面换什么色都与它无关：
                       全站地面（tokens 的 --bg 与首页 StageBackdrop 五段）的墨
                       都是 --fg，故一处取值通吃。回到暖墨：写 var(--ghost-ink)，
                       浓淡改回 7 / 13。
     ═══════════════════════════════════════════════════════════════════════ */
  .fld-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: -2;
    contain: strict;
    transform: translateZ(0);
    --fld-rewind: 260px;
    /* 方块墨色：中性墨（见顶部调参总闸）。底色已带暖洗染，暖墨会二次加暖 */
    --fld-ink: var(--fg);
    --rw-x: 252px; /* = 260×cos14° 取整（生成器启动时按 --fld-rewind 重算） */
    --rw-y: 63px; /* = 260×sin14° 取整 */
    /* 一个漂移周期的向量：2400px 沿 14° ⇒ (2329, 581)。两份副本按它错开 */
    --fld-pan-x: 2329px;
    --fld-pan-y: 581px;
    /* 两个 smoothstep：tk 管「拼合 ↔ 错开」（醒 1 → 梦 0），
       rk 管「回溯」（醒 0 → 梦 1）。两端导数都为 0 ⇒ 按下/闩锁那两下不顿。 */
    --fld-tk: calc(var(--reality-mix) * var(--reality-mix) * (3 - 2 * var(--reality-mix)));
    --rw-k: calc(var(--still) * var(--still) * (3 - 2 * var(--still)));
  }

  .fld-bg[data-layer='below'] {
    z-index: -3;
  }

  /* 目录页与瞬间（BaseLayout 的 fieldVeil）：正文列里方块退到约三成、两侧照常，
     静态遮罩挂在已合成的整层上，不碰方块自己的动画。
     列宽 --mask-half 与缝线 / 脑电的中央消隐共用一个值（global.css） */
  body[data-field-veil] .fld-bg {
    --veil: rgba(0, 0, 0, 0.28);
    -webkit-mask-image: linear-gradient(
      to right,
      black 0,
      black calc(50% - var(--mask-half, 21rem) - 7rem),
      var(--veil) calc(50% - var(--mask-half, 21rem)),
      var(--veil) calc(50% + var(--mask-half, 21rem)),
      black calc(50% + var(--mask-half, 21rem) + 7rem),
      black 100%
    );
    mask-image: linear-gradient(
      to right,
      black 0,
      black calc(50% - var(--mask-half, 21rem) - 7rem),
      var(--veil) calc(50% - var(--mask-half, 21rem)),
      var(--veil) calc(50% + var(--mask-half, 21rem)),
      black calc(50% + var(--mask-half, 21rem) + 7rem),
      black 100%
    );
  }

  /* ── 场：.fld-field > .fld-rewind > 三档 .fld-pan > .fld-step → .fld-cell ×2 ── */
  .fld-field {
    position: absolute;
    inset: 0;
    will-change: transform;
    transform: translateZ(0);
  }

  /* 定距回溯。原版把漂移**幅度**乘了 σ(醒度)（梦态幅度 0 ⇒ 场被拉回生成原点），
     于是回溯距离＝已经漂过的累积位移（实测最多 2329px = 一整个周期）；
     用户的原话是「随着醒状态经过的位移越长，每次回溯看起来经过的距离就越长」。
     这里把两者解耦：回溯由这一层独立承担，恒为 --fld-rewind（260px），
     漂 20s 再按还是 260px。中途松手：--rw-k 随 --still 连续退回，按比例落回。 */
  .fld-rewind {
    position: absolute;
    inset: 0;
    transform: translate3d(calc(-1 * var(--rw-x) * var(--rw-k)), calc(-1 * var(--rw-y) * var(--rw-k)), 0);
  }

  /* 单向匀速漂移：整片场沿 14° 朝右下（+DX, +DY）恒速走一个周期。
     ★★ 这一条永远连续运行，**绝不乘 --reality-mix / --still** ★★
     一旦乘上幅度，梦态就会归零 ⇒ 回溯距离重新绑回「已经漂了多久」。
     它是本层唯一在醒态生效的动画。 */
  .fld-pan {
    position: absolute;
    inset: 0;
    opacity: var(--fld-o, 1);
    animation: fld-pan var(--fld-dur, 84s) linear infinite;
    /* 整档提成独立合成层：漂移只让这一层位移，不再逐帧重栅格化几百块板片 */
    will-change: transform;
  }

  @keyframes fld-pan {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(var(--fld-pan-x), var(--fld-pan-y), 0);
    }
  }

  /* 梦态（含按下到闩锁的整段长按）把漂移**停在当前进度**上。
     用 paused 而不是「把幅度缩到 0」：paused 冻结的是动画的当前时间——
       · 不归位到生成原点（那正是「回溯越漂越远」的病根）；
       · 回醒时从暂停处**继续**，位置连续、没有跳变；
       · 按下的一瞬速度从 23–36px/s 变成 0，一帧只差 ~0.5px，肉眼不可察。
     顺带的好处：漂移一停，切换期间的位移就**精确等于** .fld-rewind 的 260px。
     两个类都由 reality.ts 维护：reality-holding = 长按中，data-reality='dream' = 梦面。
     三态：醒＝连续流动 / 切换＝精确 ∓260px 的滑移 / 梦＝原地浮动（只剩 .fld-step）。 */
  body.reality-holding .fld-pan,
  body[data-reality='dream'] .fld-pan {
    animation-play-state: paused;
  }

  /* 移除大块整体抽帧：.fld-step 不再作为整片大层跳跃，抽帧运动下放给每个独立小块 (.fld-sq) */
  .fld-step {
    position: absolute;
    inset: 0;
  }

  .fld-cell {
    position: absolute;
    inset: 0;
  }

  /* 一个构造体：原点在它的屏幕锚点，板片相对它定位 */
  .fld-cl {
    position: absolute;
    width: 0;
    height: 0;
  }

  /* 一枚正方形：left/top 停在**梦态（loose）**位置，用 transform 滑到醒态（tiled）。
     醒态是「相邻边之间空出 1–2px」的拼接：渲染尺寸 = 格距 m − 缝宽 g，
     两档同一套尺寸 ⇒ 过渡只动 transform（不会逐帧改 width/height）。
     5% 面 / 9% 边线：缝两侧各一条 1px 边线，中间留 1–2px 底色 ⇒ 读得出「拼接」。
     两值同比例，调浓淡就是同时改这两个数（见顶部调参总闸 --fld-ink）。
     梦态独立小块浮动：参考标题（AveritA）实现，采用 Celeste 风格简谐位置量化
     （3px 最大幅值，1px 整像素阶跃，step-end 零 tween 瞬切，波峰波谷 26% 滞空缓动）。
     ★ 浮动动画由生成器写进内联 style，成立与否由下面那条 !important 门控决定 —— 原因见该处注释。 */
  .fld-sq {
    position: absolute;
    background: color-mix(in srgb, var(--fld-ink) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--fld-ink) 9%, transparent);
    transform: translate3d(calc(var(--fld-tx, 0px) * var(--fld-tk, 1)), calc(var(--fld-ty, 0px) * var(--fld-tk, 1)), 0);
    transform-origin: center center;
    scale: calc(1 + var(--sq-scale-delta, 0) * var(--rw-k, 0));
    will-change: transform, translate, scale;
  }

  /* ★ 浮动只在「梦面静置」时存在：醒面与长按（含回梦途中）都摘掉 animation-name。
     这 160 条浮动动画只要在跑，每个主线程帧 Blink 都要 tick 一遍并为每个方块重新解算
     动画值（即便动画本身已交给合成器 —— 同页任何一条主线程动画 / rAF 都会带出主线程帧）。实测主页长按 2.4s（trace 累计）：
     全站样式重算 1026→766ms、动画 Tick 423→62ms（＝「整片场不存在」?fld=off 的水平）；
     墙钟同口径多轮中位：p50 39.4→15.3ms、掉帧（>33ms）42→3 帧、长任务 6→0。
     只摘掉这一条动画即可，别的都不用动。
     而这两种状态下浮动本就是空转：醒面振幅为 0（原来是 --still 乘 0，白跑）；
     长按中 160 块正在做拼合/回溯过渡，1–3px 的原地阶跃看不见。
     ⚠ 别用 animation-play-state: paused 代替：暂停的动画仍逐帧解算 var()，
     实测反而更卡（掉帧 42 → 48 帧），必须让它根本不成立。
     ☆ 序号 / 正文 ((浮起)) 那一族 2026-09-25 走了**相反**的路（动画常驻、振幅乘
     --still，见 global.css「定格漂浮」与 design/.probe-float-ramp.cjs）：那一族一页只有
     几枚到几十枚，常驻实测代价可忽略，换来的是换面时不再有一下骤停；本层 160 枚，
     常驻代价就是上面那组数字 —— 同一把尺子量出两个答案，别照搬任何一边。
     动画本体由生成器写在每块的内联 style 里（animation: fld-sq-<档><横><纵> …），
     keyframes 是生成器按 SQ_TIERS 烘焙的 16 条字面值（振幅不乘 --still）。
     这里反过来只管「不成立」：醒面、长按、以及脚本落定梦面之前，一律摘掉动画名。
     作者样式的 !important 压得过内联的普通声明 ⇒ 门控仍在 CSS 这一处。
     摘掉动画名 ⇒ translate 回到 0。 */
  body:not([data-reality='dream']) .fld-sq,
  body.reality-holding .fld-sq {
    animation-name: none !important;
  }

  /* 减动效：整层停在醒面构图上（静止的拼接）。
     站点的 global.css 没有「全部动画停摆」的兜底规则（mock 外壳有），
     所以这一条必须由本组件自己给；reality.ts 在 RM 下恒醒面 ⇒ 场就是 tiled 那一态。 */
  @media (prefers-reduced-motion: reduce) {
    .fld-pan,
    .fld-step,
    .fld-sq {
      animation: none !important;
      translate: 0 0 !important;
      scale: 1 !important;
    }
  }
</style>

<script>
  /* ═══════════════════════════════════════════════════════════════════════
     构造场生成器（只跑一次；生成之后只剩 CSS 动画，零运行时成本）
     · 固定种子 LCG（不用 Math.random）⇒ 每次加载 / 每次截图完全一致
     · 无缝环回：每档内容只生成一份、复制成两份，第二份整体位移 −(DX,DY)
       ＝ (−2329, −581)px（＝ 一个 2400px 周期沿 14°）；平移量取同一个向量
       ⇒ 走出一画面的那份正是候在屏外的那份，首尾逐帧同帧、不跳回、不要 JS。
     · 内容在 u（14° 方向）上被约束在 ±1150 内 ⇒ 两份副本的 u 区间不相交
       ⇒ 醒态跨副本也不会重叠。
     · 无 rAF、无滚动/尺寸监听、无 resize 重算；只在启动时读一次 --fld-rewind
       （读的是 CSS 变量，不是 DOM 尺寸）。
     · ?fld=off 连生成一起跳过（QA 做「有层 / 无层」对照用，此时本层零节点）；
       ?seed=N 换一批；?gap=N 覆盖边缝；?rw=NNN 覆盖回溯距离。
     · import.meta.env.DEV 下把生成期读数写进 window.__fld（几何断言 / 耗时 /
       块数）；生产构建里整块被 DCE 掉，不占一个字节。
     ═══════════════════════════════════════════════════════════════════════ */
  const fldRoot = document.getElementById('fld-bg');
  const fldField = document.getElementById('fld-field');
  const fldQ = new URLSearchParams(location.search);

  if (fldRoot && fldField && fldQ.get('fld') !== 'off') {
    const T0 = performance.now();
    const SEED = (parseInt(fldQ.get('seed') || '', 10) >>> 0) || 20260925;
    let S = SEED;
    const rnd = () => ((S = (Math.imul(S, 1664525) + 1013904223) >>> 0) / 4294967296);

    const COS = 0.9702957,
      SIN = 0.2419219; // 14°：与 --seam-angle 同向
    const PERIOD = 2400; // u 方向一个周期（px）
    const DX = Math.round(PERIOD * COS); // 2329
    const DY = Math.round(PERIOD * SIN); // 581

    /* ★ 一行调：--fld-rewind（写在 .fld-bg 上，默认 260px）或 ?rw=NNN。
       这里按 14° 把它分解成整数像素写回 --rw-x / --rw-y（260 ⇒ 252 / 63），
       于是 CSS 里只需要维护 --fld-rewind 这一个数。 */
    const rwQ = parseFloat(fldQ.get('rw') || '');
    const rwPx =
      rwQ > 0 && isFinite(rwQ)
        ? Math.min(2000, rwQ)
        : parseFloat(getComputedStyle(fldRoot).getPropertyValue('--fld-rewind')) || 260;
    const RWX = Math.round(rwPx * COS),
      RWY = Math.round(rwPx * SIN);
    fldRoot.style.setProperty('--fld-rewind', rwPx + 'px');
    fldRoot.style.setProperty('--rw-x', RWX + 'px');
    fldRoot.style.setProperty('--rw-y', RWY + 'px');

    /* ★ 一行调：MAX_SCALE（梦态方块最大放大倍率，默认 3.0x）；可用 ?smax=N 覆盖。
       每个方块在 1.2x ~ MAX_SCALE 之间平滑幂次分布，保证留白与层次感。 */
    const smaxQ = parseFloat(fldQ.get('smax') || '');
    const MAX_SCALE = smaxQ >= 1.2 && isFinite(smaxQ) ? Math.min(10, smaxQ) : 3.0;

    /* ★ 一行调：GAP / sdur / sdel 表（远 4px / 中 6px / 近 8px，大幅留白）；?gap=N 覆盖全部三档。
       span ＝ 边长带：整体比上一稿加大 ~30%，每档数量 8 → 6（整片不再变吵），
       m（格距）的上限随之 118 → 146、下界 34 → 44。
       sdur / sdel ＝ 方块的抽帧节拍（8 站里每站 10%：7 档 + 30% 停歇，三档错相）。
       **方块抽帧的旋钮就只有这一行的 sdur / sdel 两个数**：想回到「每拍一跳（三档
       齐拍）」⇒ 三档 sdur 全写 10、sdel 全写 0（10 站 × 10%，一站=一拍）。 */
    const GAPQ = parseInt(fldQ.get('gap') || '', 10);
    const BANDS = [
      { n: 6, span: [225, 280], o: 0.66, dur: 104, amp: 2, gap: 4, gapU: 300, sdur: 12.5, sdel: -1.5 },
      { n: 6, span: [250, 320], o: 0.84, dur: 84, amp: 2, gap: 6, gapU: 330, sdur: 11.0, sdel: -4.0 },
      { n: 6, span: [295, 380], o: 1.0, dur: 66, amp: 3, gap: 8, gapU: 360, sdur: 9.5, sdel: -6.5 },
    ];
    if (GAPQ >= 0 && GAPQ <= 16) for (const b of BANDS) b.gap = GAPQ;

    /* ★ 方块梦态浮动的 4 档（px，[一阶, 中, 峰]；x 乘横向 ±1，y 朝上乘纵向 ±1）：
         档 0：纯纵向 3px（与 AveritA 字符完全同构）   档 1：微倾斜，X 最大 1px、Y 3px
         档 2：折线倾角，X 最大 2px、Y 3px              档 3：微幅纵向，X 1px、Y 2px
       轨迹：0 → 一阶 → 中 → 峰 → 中 → 一阶 → 0，停在 13 / 25 / 37 / 63 / 75 / 87%，
       step-end 零 tween 瞬切、波峰波谷 26% 滞空（与品牌字标同一条曲线）。
       这里把 档 × 横向 × 纵向 烘焙成 16 条**字面值** keyframes 注入一次：原先是一条
       keyframes 读每块身上的 8 个 --sq-* 变量，每个主线程帧里 160 块都要逐一解析一遍。 */
    const SQ_TIERS = [
      { x: [0, 0, 0], y: [1, 2, 3] },
      { x: [0, 1, 1], y: [1, 2, 3] },
      { x: [1, 1, 2], y: [1, 2, 3] },
      { x: [0, 1, 1], y: [1, 1, 2] },
    ];
    const sqKf = (tier: number, dx: number, dy: number) =>
      'fld-sq-' + tier + (dx > 0 ? 'r' : 'l') + (dy > 0 ? 'u' : 'd');
    {
      let css = '';
      SQ_TIERS.forEach((t, tier) => {
        for (const dx of [1, -1])
          for (const dy of [1, -1]) {
            const at = (k: number) => t.x[k] * dx + 'px ' + -t.y[k] * dy + 'px';
            css +=
              '@keyframes ' + sqKf(tier, dx, dy) +
              '{0%,87%,100%{translate:0 0}13%,75%{translate:' + at(0) +
              '}25%,63%{translate:' + at(1) + '}37%{translate:' + at(2) + '}}';
          }
      });
      const st = document.createElement('style');
      st.id = 'fld-sq-keyframes';
      st.textContent = css;
      document.head.appendChild(st);
    }

    /* 生成区（u,v 是 14° 的正交系 ⇒ 这里的距离就是屏幕距离）与「副本不相交」的 u 边界 */
    const UMAX = 830,
      VMAX = 760,
      UEDGE = 1180;

    type Cell = [number, number];
    interface Rect {
      x: number;
      y: number;
      w: number;
      h: number;
    }
    interface Cluster {
      m: number;
      sz: number;
      gap: number;
      tiled: Rect[];
      loose: Rect[];
      bb: Rect;
      span: number;
      depth: number;
      bad: number;
    }
    interface Placed {
      band: (typeof BANDS)[number];
      u: number;
      v: number;
      X: number;
      Y: number;
      m: number;
      sz: number;
      tiled: Rect[];
      loose: Rect[];
      bb: Rect;
      span: number;
      box: Rect;
      nr: Rect[];
    }

    const idx = (i: number, j: number) => i + ',' + j;
    const NB = [
      [1, 0],
      [-1, 0],
      [0, 1],
      [0, -1],
    ];
    const has = (cs: Cell[], i: number, j: number) => cs.some((c) => c[0] === i && c[1] === j);
    function nbCount(c: Cell, cs: Cell[]) {
      let n = 0;
      for (const [di, dj] of NB) if (has(cs, c[0] + di, c[1] + dj)) n++;
      return n;
    }
    function connected(cs: Cell[]) {
      if (!cs.length) return false;
      const seen = new Set([idx(cs[0][0], cs[0][1])]);
      const q: Cell[] = [cs[0]];
      while (q.length) {
        const [i, j] = q.pop()!;
        for (const [di, dj] of NB) {
          const k = idx(i + di, j + dj);
          if (seen.has(k) || !has(cs, i + di, j + dj)) continue;
          seen.add(k);
          q.push([i + di, j + dj]);
        }
      }
      return seen.size === cs.length;
    }

    /* ── 形状：从 2×2 / 2×3 / 3×3 的矩形里挖角，剩下的格必须连通、每格至少一个共边邻居 ── */
    const SHAPES = [
      { w: 2, h: 2, n: 4 },
      { w: 3, h: 2, n: 4 },
      { w: 3, h: 2, n: 5 },
      { w: 2, h: 3, n: 4 },
      { w: 2, h: 3, n: 5 },
      { w: 3, h: 3, n: 5 },
      { w: 3, h: 3, n: 6 },
      { w: 3, h: 3, n: 7 },
    ];
    function mkShape(spec: { w: number; h: number; n: number }) {
      const { w, h, n } = spec;
      let out: Cell[] = [];
      for (let j = 0; j < h; j++) for (let i = 0; i < w; i++) out.push([i, j]);
      const corner = new Set([idx(0, 0), idx(w - 1, 0), idx(0, h - 1), idx(w - 1, h - 1)]);
      let guard = 0;
      while (out.length > n && guard++ < 60) {
        const cs = out.filter((c) => corner.has(idx(c[0], c[1])));
        const es = out.filter(
          (c) => (c[0] === 0 || c[1] === 0 || c[0] === w - 1 || c[1] === h - 1) && !corner.has(idx(c[0], c[1])),
        );
        const pool = cs.length && (rnd() < 0.6 || !es.length) ? cs : es.length ? es : out;
        const pick = pool[Math.floor(rnd() * pool.length)];
        const rest = out.filter((c) => c !== pick);
        if (connected(rest) && rest.every((c) => nbCount(c, rest) >= 1)) out = rest;
      }
      const mi = Math.min(...out.map((c) => c[0])),
        mj = Math.min(...out.map((c) => c[1]));
      return out.map((c) => [c[0] - mi, c[1] - mj] as Cell);
    }

    /* ── 解析求交：轴对齐矩形的两两交 ── */
    function pairOverlaps(rs: Rect[]) {
      const res: Rect[] = [];
      for (let i = 0; i < rs.length; i++) {
        for (let j = i + 1; j < rs.length; j++) {
          const a = rs[i],
            b = rs[j];
          const x1 = Math.max(a.x, b.x),
            x2 = Math.min(a.x + a.w, b.x + b.w);
          const y1 = Math.max(a.y, b.y),
            y2 = Math.min(a.y + a.h, b.y + b.h);
          if (x2 > x1 && y2 > y1) res.push({ x: x1, y: y1, w: x2 - x1, h: y2 - y1 });
        }
      }
      return res;
    }
    function maxDepth(rs: Rect[]) {
      let mx = 1;
      for (const o of pairOverlaps(rs)) {
        for (let y = o.y + 0.5; y < o.y + o.h; y += 3) {
          for (let x = o.x + 0.5; x < o.x + o.w; x += 3) {
            let d = 0;
            for (const r of rs) if (x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h) d++;
            if (d > mx) mx = d;
          }
        }
      }
      return mx;
    }
    function depthWith(nr: Rect[], others: Rect[]) {
      let mx = 1;
      for (const a of nr) {
        for (const b of others) {
          const x1 = Math.max(a.x, b.x),
            x2 = Math.min(a.x + a.w, b.x + b.w);
          const y1 = Math.max(a.y, b.y),
            y2 = Math.min(a.y + a.h, b.y + b.h);
          if (x2 <= x1 || y2 <= y1) continue;
          for (let y = y1 + 0.5; y < y2; y += 3) {
            for (let x = x1 + 0.5; x < x2; x += 3) {
              let d = 0;
              for (const r of nr) if (x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h) d++;
              for (const r of others) if (x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h) d++;
              if (d > mx) mx = d;
            }
          }
        }
      }
      return mx;
    }
    const bbox = (rs: Rect[]) => {
      let x0 = 1e9,
        y0 = 1e9,
        x1 = -1e9,
        y1 = -1e9;
      for (const r of rs) {
        x0 = Math.min(x0, r.x);
        y0 = Math.min(y0, r.y);
        x1 = Math.max(x1, r.x + r.w);
        y1 = Math.max(y1, r.y + r.h);
      }
      return { x: x0, y: y0, w: x1 - x0, h: y1 - y0 };
    };
    /* 一组矩形在 u 轴（14° 方向）上的投影区间：用来把内容约束在半周期内 */
    function uRange(rs: Rect[]) {
      let lo = 1e9,
        hi = -1e9;
      for (const r of rs) {
        const ps = [
          [r.x, r.y],
          [r.x + r.w, r.y],
          [r.x, r.y + r.h],
          [r.x + r.w, r.y + r.h],
        ];
        for (const p of ps) {
          const uu = p[0] * COS + p[1] * SIN;
          if (uu < lo) lo = uu;
          if (uu > hi) hi = uu;
        }
      }
      return { lo, hi };
    }

    /* ── 一个构造体：tiled（边边相重合 + 相邻边留缝）+ loose（接缝错开）+ 交叠窗 ──
       关键：**两档同一套尺寸**。渲染尺寸 = 格距 m − 缝宽 g，网格间距仍是 m，
       醒态每块落在 i*m+g 上 ⇒ 相邻两块的间隙恒为 g（整数像素，1 或 2）。
       于是 tiled ↔ loose 只是位置差 ⇒ 过渡只需 transform，不会逐帧改 width。 */
    let tries = 0,
      firstTry = 0;
    function mkCluster(band: (typeof BANDS)[number]): Cluster {
      const g = band.gap;
      let best: Cluster | null = null;
      for (let k = 0; k < 40; k++) {
        tries++;
        const spec = SHAPES[Math.floor(rnd() * SHAPES.length)];
        const cells = mkShape(spec);
        const ext = Math.max(spec.w, spec.h);
        const m = Math.min(146, Math.max(44, Math.round((band.span[0] + rnd() * (band.span[1] - band.span[0])) / ext)));
        const s = m - g;
        const tiled = cells.map(([i, j]) => ({ x: i * m + g, y: j * m + g, w: s, h: s }));
        /* loose：每格挑一条它自己的共边（那个邻居），沿该边的法向滑开 0.30–0.52 格距，
           68% 真的「脱离」（离开那条边 ⇒ 接缝张开），32% 朝那条边滑（叠出一枚窗）；
           再带 ±0.12 格距的切向错开。尺寸不变 ⇒ 只有 transform 在动。 */
        const loose = tiled.map((t, n) => {
          const c = cells[n];
          const nbs = NB.filter(([di, dj]) => has(cells, c[0] + di, c[1] + dj));
          const nb = nbs[Math.floor(rnd() * nbs.length)];
          const away = rnd() < 0.68 ? 1 : -1;
          const mag = m * (0.3 + rnd() * 0.22);
          const tan = Math.round((rnd() - 0.5) * 0.24 * m);
          const ox = nb[0] !== 0 ? -nb[0] * away * mag : tan;
          const oy = nb[1] !== 0 ? -nb[1] * away * mag : tan;
          return { x: Math.round(t.x + ox), y: Math.round(t.y + oy), w: s, h: s };
        });
        const depth = maxDepth(loose);
        /* 占位框 = 醒态 bbox ∪ 梦态 bbox：过渡是两态之间的插值，
           所以「这个构造体的足迹」必须两个态都包住（不然跨构造体会撞上） */
        const bbT = bbox(tiled),
          bbL = bbox(loose);
        const x0 = Math.min(bbT.x, bbL.x),
          y0 = Math.min(bbT.y, bbL.y);
        const x1 = Math.max(bbT.x + bbT.w, bbL.x + bbL.w),
          y1 = Math.max(bbT.y + bbT.h, bbL.y + bbL.h);
        const bb = { x: x0, y: y0, w: x1 - x0, h: y1 - y0 };
        const span = Math.max(bbL.w, bbL.h);
        const bad = (depth > 3 ? 1 : 0) + (span > 420 ? 1 : 0) + (span < 160 ? 1 : 0);
        if (!best || bad < best.bad) best = { m, sz: s, gap: g, tiled, loose, bb, span, depth, bad };
        if (!bad) break;
      }
      // 循环至少跑一轮 ⇒ best 必有值
      const win = best!;
      if (win.bad === 0) firstTry++;
      return win;
    }

    const placed: Placed[] = []; // 已落位构造体（跨档共享）：醒态外接框必须互不相交
    const tiledAll: Rect[] = []; // 全部板片的醒态矩形（屏幕坐标，只记第一份副本）
    const looseAll: Rect[] = []; // 全部板片的梦态矩形（屏幕坐标，只记第一份副本）
    let retryPlace = 0,
      depthClip = 0,
      failPlace = 0,
      uClip = 0;

    function tryPlace(band: (typeof BANDS)[number]): Placed | null {
      for (let a = 0; a < 260; a++) {
        const g = mkCluster(band);
        const ut = uRange(g.tiled),
          ul = uRange(g.loose);
        const ext = Math.max(Math.abs(ut.lo), Math.abs(ut.hi), Math.abs(ul.lo), Math.abs(ul.hi));
        const u = Math.round((rnd() * 2 - 1) * UMAX);
        const v = Math.round((rnd() * 2 - 1) * VMAX);
        /* 副本不相交：内容（tiled 与 loose 一起算）在 u 上不许越过 ±UEDGE */
        if (Math.abs(u) + ext > UEDGE) {
          uClip++;
          continue;
        }
        let ok = true;
        for (const it of placed)
          if (it.band === band && Math.hypot(it.u - u, it.v - v) < band.gapU) {
            ok = false;
            break;
          }
        if (!ok) {
          retryPlace++;
          continue;
        }
        const X = Math.round(u * COS - v * SIN),
          Y = Math.round(u * SIN + v * COS);
        const box = { x: X + g.bb.x, y: Y + g.bb.y, w: g.bb.w, h: g.bb.h };
        ok = true;
        for (const p of placed) {
          if (
            box.x < p.box.x + p.box.w + 26 &&
            box.x + box.w + 26 > p.box.x &&
            box.y < p.box.y + p.box.h + 26 &&
            box.y + box.h + 26 > p.box.y
          ) {
            ok = false;
            break;
          }
        }
        if (!ok) {
          retryPlace++;
          continue;
        }
        const nr = g.loose.map((r) => ({ x: X + r.x, y: Y + r.y, w: r.w, h: r.h }));
        if (depthWith(nr, looseAll) > 3) {
          depthClip++;
          continue;
        }
        return {
          band,
          u,
          v,
          X,
          Y,
          m: g.m,
          sz: g.sz,
          tiled: g.tiled,
          loose: g.loose,
          bb: g.bb,
          span: g.span,
          box,
          nr,
        };
      }
      failPlace++;
      return null;
    }

    /* ── 生成 + 落 DOM（三档容器：.fld-pan > .fld-step > .fld-cell ×2）── */
    const frag = document.createDocumentFragment();
    /* 定距回溯层：三档共用一个位移（写在一个祖先上，整片场一起退） */
    const rewind = document.createElement('div');
    rewind.className = 'fld-rewind';
    let nSq = 0,
      nCl = 0;

    for (const band of BANDS) {
      const items: Placed[] = [];
      let guard = 0;
      while (items.length < band.n && guard++ < 60) {
        const g = tryPlace(band);
        if (!g) break;
        for (const r of g.tiled) tiledAll.push({ x: g.X + r.x, y: g.Y + r.y, w: r.w, h: r.h });
        for (const r of g.nr) looseAll.push(r);
        placed.push(g);
        items.push(g);
      }
      const pan = document.createElement('div');
      pan.className = 'fld-pan';
      pan.style.setProperty('--fld-o', String(band.o));
      pan.style.setProperty('--fld-dur', band.dur + 's');
      const beat = document.createElement('div');
      beat.className = 'fld-step';
      beat.style.setProperty('--fld-sdur', band.sdur + 's');
      beat.style.setProperty('--fld-sdel', band.sdel + 's');
      beat.style.setProperty('--fld-amp', String(band.amp));
      for (let c = 0; c < 2; c++) {
        const cell = document.createElement('div');
        cell.className = 'fld-cell';
        /* 第二份＝第一份整体位移 −(DX,DY)：与 .fld-pan 的平移量严格相等 ⇒ 无缝环回 */
        if (c) cell.style.transform = 'translate3d(' + -DX + 'px,' + -DY + 'px,0)';
        for (const g of items) {
          const cl = document.createElement('div');
          cl.className = 'fld-cl';
          cl.style.cssText = 'left:calc(50% + ' + g.X + 'px);top:calc(50% + ' + g.Y + 'px)';
          cl.dataset.c = g.X + ',' + g.Y; // 供自验脚本从 DOM 复核几何
          for (let n = 0; n < g.loose.length; n++) {
            const lo = g.loose[n],
              ti = g.tiled[n];
            const d = document.createElement('div');
            d.className = 'fld-sq';
            const h = ((g.X * 73856093) ^ (g.Y * 19349663) ^ (n * 83492791)) >>> 0;
            const dirX = h & 1 ? 1 : -1;
            const dirY = h & 2 ? 1 : -1;
            const dur = (2.8 + ((h >> 4) % 5) * 0.2).toFixed(1) + 's';
            const del = (-1 * (n * 0.4 + (((h >> 8) & 7) * 0.2))).toFixed(2) + 's';

            // 梦态个体随机缩放：平滑幂次分布，最低 1.2x，最高约 3.0x（MAX_SCALE）
            const rndScale = ((h >> 12) & 0xffff) / 65535;
            const scaleDelta = (0.2 + Math.pow(rndScale, 1.4) * (MAX_SCALE - 1 - 0.2)).toFixed(2);

            // 4 档离散随机浮动（严格对齐 AveritA 3px 峰值与 1px 阶跃量化，零 tween 瞬切）：
            // 档 × 横向 × 纵向 ⇒ 16 条烘焙好的 keyframes 之一（见下方 SQ_TIERS / sqKeyframes）
            const kf = sqKf(h % 4, dirX, dirY);

            /* 浮动直接写成内联 animation；醒面 / 长按期间由 CSS 的 !important 规则摘掉
               animation-name（见 .fld-sq 上方注释）。每块只剩 3 个自定义属性（拼合位移、梦态放大），
               浮动的 8 个参数全在 keyframes 字面值里 —— 主线程每次为动画元素重算样式时，
               要解析的 var() 少了一大半（实测单次重算 ≈ 快一倍）。 */
            d.style.cssText =
              'left:' +
              lo.x +
              'px;top:' +
              lo.y +
              'px;width:' +
              g.sz +
              'px;height:' +
              g.sz +
              'px;' +
              '--fld-tx:' +
              (ti.x - lo.x) +
              'px;--fld-ty:' +
              (ti.y - lo.y) +
              'px;' +
              '--sq-scale-delta:' +
              scaleDelta +
              ';animation:' +
              kf +
              ' ' +
              dur +
              ' step-end ' +
              del +
              ' infinite';
            d.dataset.b = ti.x + ',' + ti.y + ',' + g.sz; // 醒态（tiled）局部位置 + 边长
            d.dataset.l = lo.x + ',' + lo.y; // 梦态（loose）局部位置
            cl.appendChild(d);
            nSq++;
          }
          cell.appendChild(cl);
          nCl++;
        }
        beat.appendChild(cell);
      }
      pan.appendChild(beat);
      frag.appendChild(pan);
    }
    rewind.appendChild(frag);
    fldField.appendChild(rewind);

    /* ── 生成期断言：只在 dev 下跑（生产构建整块 DCE）。读数写进 window.__fld。
       ①醒态任意两块零重叠 ②相邻平行边间隙符合 gap 设定 ③跨副本零重叠
       ④梦态叠深 ≤3 ⑤构体错开后整体尺寸 160–420px ───────────────────────── */
    if (import.meta.env.DEV) {
      let badPairs = 0,
        worstOverlap = 0;
      for (let i = 0; i < tiledAll.length; i++) {
        for (let j = i + 1; j < tiledAll.length; j++) {
          const a = tiledAll[i],
            b = tiledAll[j];
          const w = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x);
          const h = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y);
          if (w > 0 && h > 0) {
            badPairs++;
            worstOverlap = Math.max(worstOverlap, w * h);
          }
        }
      }
      let copyPairs = 0,
        copyWorst = 0;
      for (const a of tiledAll) {
        for (const b of tiledAll) {
          const bx = b.x - DX,
            by = b.y - DY;
          const w = Math.min(a.x + a.w, bx + b.w) - Math.max(a.x, bx);
          const h = Math.min(a.y + a.h, by + b.h) - Math.max(a.y, by);
          if (w > 0 && h > 0) {
            copyPairs++;
            copyWorst = Math.max(copyWorst, w * h);
          }
        }
      }
      const gapDist: Record<number, number> = {};
      let gapPairs = 0,
        gapMin = 0,
        gapMax = 0;
      const touched = new Set<number>();
      const maxBandGap = Math.max(...BANDS.map((b) => b.gap));
      for (let i = 0; i < tiledAll.length; i++) {
        for (let j = 0; j < tiledAll.length; j++) {
          if (i === j) continue;
          const a = tiledAll[i],
            b = tiledAll[j];
          const yOv = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y);
          const xOv = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x);
          let d = -1,
            t = 0;
          if (yOv > 0) {
            t = b.x - (a.x + a.w);
            if (t >= 0 && t <= maxBandGap + 1) d = t;
          }
          if (d < 0 && xOv > 0) {
            t = b.y - (a.y + a.h);
            if (t >= 0 && t <= maxBandGap + 1) d = t;
          }
          if (d < 0 && yOv > 0) {
            t = a.x - (b.x + b.w);
            if (t >= 0 && t <= maxBandGap + 1) d = t;
          }
          if (d < 0 && xOv > 0) {
            t = a.y - (b.y + b.h);
            if (t >= 0 && t <= maxBandGap + 1) d = t;
          }
          if (d < 0) continue;
          touched.add(i);
          touched.add(j);
          if (i < j) {
            gapPairs++;
            gapDist[d] = (gapDist[d] || 0) + 1;
            if (!gapMin || d < gapMin) gapMin = d;
            if (d > gapMax) gapMax = d;
          }
        }
      }
      const depthAll = maxDepth(looseAll);
      const spans = placed.map((p) => p.span);
      const side = (arr: number[]) => {
        const v = arr.slice().sort((a, b) => a - b);
        return {
          n: v.length,
          min: v[0],
          max: v[v.length - 1],
          mean: Math.round((v.reduce((a, b) => a + b, 0) / v.length) * 10) / 10,
          median: v[Math.floor(v.length / 2)],
        };
      };
      Object.assign(window, {
        __fld: {
          seed: SEED,
          clusters: nCl,
          clustersPerCopy: nCl / 2,
          squares: nSq,
          nodes: fldField.querySelectorAll('*').length,
          ms: Math.round((performance.now() - T0) * 10) / 10,
          rewindPx: rwPx,
          rwX: RWX,
          rwY: RWY,
          gaps: BANDS.map((b) => b.gap),
          a_tiledOverlapPairs: badPairs,
          a_tiledWorstOverlapPx: worstOverlap,
          b_gapPairs: gapPairs,
          b_gapMinPx: gapMin,
          b_gapMaxPx: gapMax,
          b_gapDist: gapDist,
          b_isolated: tiledAll.length - touched.size,
          c_copyOverlapPairs: copyPairs,
          c_copyWorstPx: copyWorst,
          d_looseDepthMax: depthAll,
          e_looseSpanMin: Math.round(Math.min(...spans)),
          e_looseSpanMax: Math.round(Math.max(...spans)),
          g_clusterTries: tries,
          g_firstTry: firstTry,
          h_placeRetry: retryPlace,
          h_uClip: uClip,
          h_depthClip: depthClip,
          h_failPlace: failPlace,
          i_sideAll: side(placed.map((p) => p.sz)),
          i_sideByBand: BANDS.map((b) => side(placed.filter((p) => p.band === b).map((p) => p.sz))),
        },
      });
    }
  }
</script>
