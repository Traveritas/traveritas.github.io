---
/* ─────────────────────────────────────────────────────────────
   Ave：偶尔冒出来的一句旁白。
   · 台词、出现条件在 src/data/ave-lines.ts；调度、字幕揭开、出声、定位在 src/scripts/ave.ts。
     随笔 / 项目 / 瞬间可以在 frontmatter 里写 ave: 自带一句（见 src/lib/ave-page.ts）：这里构建时收齐、
     内联进每一页，漫游里点开那一篇、或进了它自己那一整页（entry），她就说那一句。
   · 位置：平时在右下角；台词带 at（或事件点名时带元素）就贴到那个元素旁边
     （右边放得下放右边，不行放左边，再不行放上下）。到位的方式是从右侧滑进来，不牵线。
   · 外观（2026-11-15 r2，design/mocks/ave-r2 的「1 卡片同门」）：与漫游 / 检索的卡片同一套——
     矩形、发丝边、上亮下暗两道细线，顶上一行等宽小字（○ AVE ×）。
     一颗晶体三轴星（src/scripts/ave-star.ts）落在框的左上角、比框大一圈：
     框外是实体的晶体，框里那一块只剩线框——像隔着磨砂看见它的轮廓；
     出现时它先转进来，框晚一拍浮起，收起时它转走。
     字底下一条线跟着念出来的字长，最后两个字底下是她颜色的线头，念完在句尾碎成三截。
   · 没有 JS 就不出现（它不承载正文内容）；工具栏「设置」里可以关掉。
   ───────────────────────────────────────────────────────────── */
import { getCollection } from 'astro:content';
import { avePageLine, type AvePageLine } from '../../lib/ave-page';

interface Props {
  /** 本页是哪一篇条目（<集合>/<条目 id>，随笔 / 项目自己那一整页）。
      条目页只说它自带的那一句，没写就不说，不拿版块的进页句子顶替 */
  entry?: string;
}
const { entry } = Astro.props;

/* 所有条目自带的那一句，键 = <集合>/<条目 id> */
const pages: Record<string, AvePageLine> = {};
for (const col of ['articles', 'projects', 'moments'] as const) {
  for (const e of await getCollection(col, (x) => !x.data.draft)) {
    const line = avePageLine(col, e.id, e.data.ave);
    if (line) pages[`${col}/${e.id}`] = line;
  }
}
// 内联 JSON：把 < 转义，免得台词里的 </script> 提前收掉标签
const pagesJson = JSON.stringify(pages).replace(/</g, '\\u003c');
---

<aside id="ave" class="ave" aria-label="Ave" data-entry={entry} hidden>
  {/* 星：比框大一圈，框外是实体、框里是线框（WebGL2，由 ave-star.ts 画；拿不到就空着） */}
  <canvas class="ave-star" aria-hidden="true"></canvas>
  <div class="ave-card">
    <p class="ave-hd mono" aria-hidden="true"><i class="ave-o"></i><span class="ave-who">AVE</span></p>
    <div class="ave-row">
      <div class="ave-portrait" aria-hidden="true">
        {/* 头像还没定稿时的占位：一小块像素流光，用她自己的配色（src/scripts/ave-flow.ts）。
            ave.ts 的 USE_FACES 打开后，按需动态挂面部头像 img 盖在它上面 */}
        <canvas class="ave-flow" width="10" height="10"></canvas>
      </div>
      <div class="ave-body">
        {/* 逐字的 span 由 ave.ts 生成：.c 是字，.on 是念到了，.head 是线头，末尾 .ave-tail 是碎屑 */}
        <p class="ave-text" aria-hidden="true"></p>
        {/* 读屏只念整句一次，不跟着逐字揭开反复播报 */}
        <p class="ave-sr" role="status"></p>
      </div>
    </div>
    <button class="ave-x" type="button" aria-label="收起">
      <svg viewBox="0 0 10 10" width="10" height="10" aria-hidden="true">
        <path d="M2 2l6 6M8 2L2 8" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <script type="application/json" class="ave-pages" set:html={pagesJson} />
</aside>

<style is:global>
  /* 她的色调（与头像 src/scripts/ave-flow.ts 的两套调色板同源）：醒面雾蓝、梦面薄暮紫。
     注册成颜色，换面时才能整块平滑地过渡过去，不是一下跳 */
  @property --ave-tint {
    syntax: '<color>';
    inherits: true;
    initial-value: #a1b8cf;
  }
  @property --ave-hue {
    syntax: '<color>';
    inherits: true;
    initial-value: #6f8bab;
  }
  @property --ave-deep {
    syntax: '<color>';
    inherits: true;
    initial-value: #415369;
  }
  .ave {
    /* 灰面（整块玻璃染的那层）/ 线头与饰件 / 名牌的深片 */
    --ave-tint: #a1b8cf;
    --ave-hue: #6f8bab;
    --ave-deep: #415369;
    transition:
      --ave-tint 1.2s ease,
      --ave-hue 1.2s ease,
      --ave-deep 1.2s ease;
    /* 材质：平时与工具栏薄片同一种玻璃；主页 / 漫游时跟场景（--w-*，见 wander.css），
       深色场景就是深色玻璃 + 浅字 */
    --ave-fg: var(--w-fg, var(--fg));
    --ave-faint: var(--w-faint, var(--fg-faint));
    --ave-panel: var(--chrome-bg);
    --ave-rim: var(--chrome-edge);
    --ave-sheen: var(--chrome-hi);
    --ave-sh: var(--chrome-sh);
    /* 线的墨色：比正文淡，像铅笔量出来的 */
    --ave-ink: color-mix(in srgb, var(--ave-fg) 46%, transparent);
    --ave-line: 1px;
    /* 线在字身底下多远（inline 的 padding-bottom，不占排版） */
    --ave-drop: 3px;
    /* 整块玻璃上的那层她的颜色；边环也微微偏同一个色 */
    --ave-wash: color-mix(in srgb, var(--ave-tint) 9%, transparent);
    --ave-edge: color-mix(in srgb, var(--ave-rim) 76%, var(--ave-tint));
    /* 下沿那道暗线（卡片的「上亮下暗」） */
    --ave-lo: var(--chrome-edge-lo);
    /* 头像边长（与背景同一个 5px 像素格，取 5 的倍数） */
    --ave-size: 45px;
    /* 星：边长与中心（相对框的左上角） */
    --ave-star: 230px;
    --ave-star-x: 22px;
    --ave-star-y: 8px;
    /* 框进场从右边滑进来多远 */
    --ave-slide: 24px;
    /* 星另一套：比框远得多、也久得多（框 24px / 0.5s）。
       两块不必同位移——ave-star.ts 每帧按两块的实到位置重算遮罩，错开也对得上 */
    --ave-star-slide: 72px;
    --ave-star-exit: 104px;
    --ave-star-in: 1.2s;
    /* 星比框晚出场多久（框 0.18s 后浮起）——先看见框，星再慢慢从右边转进来 */
    --ave-star-in-delay: 0.7s;
    /* 星的退场：CSS 位移与 WebGL 的转走缩没共用这一个数（ms，ave.ts 也读它） */
    --ave-star-out: 950;
    /* 星比框晚退场多久（框 0.3s 后开始收）——框先走，星最后才散 */
    --ave-star-out-delay: 0.62s;
    /* 星淡下去要多久：比滑走短一点，末尾留下一段「只剩个影子在滑」 */
    --ave-star-fade: 0.8s;
    /* 收起整个窗口要多久（ms，ave.ts 读它）：要盖住星那一段（延迟 0.62s + 0.95s = 1.57s） */
    --ave-out: 1700;
    /* 缓动：进场快起慢收；收起反过来，由慢到快。
       收起那条刻意让末尾收一收（y2 = 0.5 而不是 0.25）：纯 ease-in 是先慢后猛地冲到底，
       抬手不动、最后一百毫秒里跳掉一半，读起来还是「咔」一下没了 */
    --ave-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ave-ease-in: cubic-bezier(0.55, 0.06, 0.68, 0.5);
    position: fixed;
    right: 22px;
    /* 让开页脚那一行链接 */
    bottom: 58px;
    z-index: 59; /* 工具栏（60/61）展开时压在它上面 */
    /* 头像一栏占掉一截宽度，字栏要留够一行十几个字 */
    max-width: min(24rem, calc(100vw - 112px));
    pointer-events: none;
  }
  body[data-reality='dream'] .ave {
    --ave-tint: #a399c7;
    --ave-hue: #8a7cb8;
    --ave-deep: #4f4a66;
  }
  html[data-wscene] .ave {
    --ave-panel: rgb(var(--w-glass) / calc(var(--w-glass-a) + 0.2));
    --ave-rim: rgb(var(--w-edge) / calc(var(--w-edge-a) + 0.08));
    --ave-sheen: rgb(var(--w-sheen) / var(--w-sheen-a));
  }
  /* 贴元素：left/top（必要时还有 max-width）由 ave.ts 写 */
  .ave.is-anchored {
    right: auto;
    bottom: auto;
    max-width: min(24rem, calc(100vw - 32px));
  }
  .ave[hidden] {
    display: none;
  }

  /* ── 星：叠在框上面（不接指针）；落在框里的那一块由 ave-star.ts 画成线框 ── */
  .ave-star {
    position: absolute;
    left: calc(var(--ave-star-x) - var(--ave-star) / 2);
    top: calc(var(--ave-star-y) - var(--ave-star) / 2);
    z-index: 2;
    width: var(--ave-star);
    height: var(--ave-star);
    /* 比框大一圈是本意：别让全局的 canvas { max-width: 100% } 把它压回框宽 */
    max-width: none;
    pointer-events: none;
    /* 星自己的一套：更远（--ave-star-slide）、更久（--ave-star-in）。
       与框的位移不同步——它是一颗悬在后面的星，比框多滑一段才落下，收起时也后走。
       遮罩对得上是因为 ave-star.ts 画的时候现量两块的实到位置，不靠两者位移相等 */
    /* 透明度：进场与框一起淡上来，收起时整颗暗下去（只有位移和缩没的话，星像是被挪走而不是消散） */
    opacity: 0;
    translate: var(--ave-star-slide) 0;
    transition: translate calc(var(--ave-star-out) * 1ms) var(--ave-ease-out);
  }

  /* ── 框：与卡片同门 ── */
  .ave-card {
    position: relative;
    z-index: 1;
    padding: 9px 16px 13px;
    border: 1px solid var(--ave-edge);
    border-radius: var(--chrome-radius);
    color: var(--ave-fg);
    background:
      /* 她的颜色：薄薄一层铺在玻璃上 */
      linear-gradient(var(--ave-wash), var(--ave-wash)),
      var(--ave-panel);
    -webkit-backdrop-filter: blur(16px) saturate(1.06);
    backdrop-filter: blur(16px) saturate(1.06);
    box-shadow:
      inset 0 1px 0 var(--ave-sheen),
      0 1px 0 var(--ave-lo);
    opacity: 0;
    /* 起点在右侧一点：进场从右边淡着滑进来，收起时原路滑出去 */
    translate: var(--ave-slide) 0;
    transition:
      opacity 0.45s var(--ave-ease-out),
      translate 0.5s var(--ave-ease-out);
  }
  /* 星先转进来，框晚一拍浮起；星自己滑得比框远、也比框久（1.2s），所以先落地的是框 */
  .ave.is-on .ave-card {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
    transition-delay: 0.18s;
  }
  .ave.is-on .ave-star {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.4s var(--ave-ease-out),
      translate var(--ave-star-in) var(--ave-ease-out);
    transition-delay: var(--ave-star-in-delay);
  }
  /* 收起：曲线换成由慢到快（--ave-ease-in），时长也比进场长一截——
     0.45s 的淡出配上 ease-in 只剩末尾一百毫秒在掉，看着还是掐断的 */
  .ave.is-leaving .ave-card {
    transition:
      opacity 0.7s var(--ave-ease-in),
      translate 0.8s var(--ave-ease-in);
    transition-delay: 0.3s;
  }
  /* 收起：框先淡出滑走，星后走、走得比进场更远（--ave-star-exit），
     而且整颗一起暗下去——只有位移和缩没的话，星像是被挪走而不是消散 */
  .ave.is-leaving .ave-star {
    opacity: 0;
    translate: var(--ave-star-exit) 0;
    transition:
      opacity var(--ave-star-fade) var(--ave-ease-in),
      translate calc(var(--ave-star-out) * 1ms) var(--ave-ease-in);
    transition-delay: var(--ave-star-out-delay);
  }

  /* 连说中途换位置：整段只有 QUICK_OUT + THEN_GAP（约 310ms），星等不起 0.7s 的出场延迟，
     这一句里把它压成 0（.is-swap 由 ave.ts 在换位置那一句上临时挂、1.4s 后摘掉） */
  .ave.is-swap {
    --ave-star-in-delay: 0s;
  }

  /* 抬头行：○ AVE（× 在右上角） */
  .ave-hd {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding-right: 22px;
    font-size: 11px;
    line-height: 20px;
    letter-spacing: 0.12em;
    color: var(--ave-faint);
  }
  .ave-o {
    width: 7px;
    height: 7px;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  .ave-who {
    color: var(--ave-fg);
    opacity: 0.8;
  }
  .ave-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 6px;
  }

  /* ── 头像 ── */
  .ave-portrait {
    position: relative;
    flex: none;
    width: var(--ave-size);
    height: var(--ave-size);
    margin-top: 6px;
    overflow: hidden;
    /* 底色只在流光的缝里露出来：她自己的紫 / 蓝各自压暗一档，浅色页上也不会与卡片连成一片 */
    background: linear-gradient(
      165deg,
      color-mix(in srgb, var(--dream) 42%, var(--bg)) 0%,
      color-mix(in srgb, var(--umber) 52%, var(--bg)) 100%
    );
    box-shadow: 0 0 0 1px var(--ave-edge);
    isolation: isolate;
  }
  .ave-face {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* 占位：背景流光的一小块，5px 一格 */
  .ave-flow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  /* ── 字栏 ── */
  .ave-body {
    flex: 1;
    min-width: 0;
  }
  .ave-text {
    margin: 0;
    font: 500 15px/2 var(--font-display);
    overflow-wrap: anywhere;
  }
  /* 字：还没念到的先占着位置（框不跟着字一点点长），只是看不见。
     每个字底下自己的一小段线，念到了才长出来；相邻的字连成一条 */
  .ave-text .c {
    position: relative;
    padding-bottom: var(--ave-drop);
    background: linear-gradient(var(--ave-ink), var(--ave-ink)) 0 100% / 0 var(--ave-line) no-repeat;
    transition:
      background-size 0.22s cubic-bezier(0.3, 0.7, 0.2, 1),
      color 0.3s;
  }
  .ave-text .c:not(.on) {
    color: transparent;
  }
  .ave-text .c.on {
    background-size: 100% var(--ave-line);
  }
  /* 线头：最后念到的两个字底下换成她的颜色，加一点厚度——念完就停在句尾当句读 */
  .ave-text .c.head {
    background-image: linear-gradient(var(--ave-hue), var(--ave-hue));
    background-size: 100% 2px;
  }
  /* 收起：线从句首往句尾一字一字退掉，再整片淡出 */
  .ave.is-leaving .ave-text .c {
    background-size: 0 var(--ave-line);
    background-position: 100% 100%;
    transition-delay: calc(var(--i) * 14ms);
  }
  /* 句尾的三截碎屑：线说完了在这里碎掉（和最后一个字包在 .ave-end 里，不单独折行） */
  .ave-end {
    white-space: nowrap;
  }
  .ave-tail {
    display: inline-flex;
    align-items: flex-end;
    gap: 3px;
    height: 1em;
    margin-left: 5px;
    vertical-align: calc(-1 * var(--ave-drop) - 0.18em);
  }
  .ave-tail i {
    width: var(--ave-line);
    background: var(--ave-ink);
    opacity: 0;
    translate: 0 -4px;
    transition:
      opacity 0.35s,
      translate 0.5s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .ave-tail i:nth-child(1) {
    height: 7px;
  }
  .ave-tail i:nth-child(2) {
    height: 4px;
    transition-delay: 0.12s;
  }
  .ave-tail i:nth-child(3) {
    height: 2px;
    transition-delay: 0.24s;
  }
  .ave.is-done .ave-tail i {
    opacity: 1;
    translate: 0 0;
  }
  .ave.is-leaving .ave-tail i {
    opacity: 0;
    translate: 0 4px;
    transition-delay: 0s;
  }
  .ave-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── 收起 × ── */
  .ave-x {
    position: absolute;
    top: -3px;
    right: -1px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ave-faint);
    cursor: pointer;
    opacity: 0.55;
    transition:
      opacity 0.25s,
      color 0.25s;
  }
  .ave-card:hover .ave-x,
  .ave-x:focus-visible {
    opacity: 1;
  }
  .ave-x:hover {
    color: var(--ave-fg);
  }

  /* 连说中途换位置时的快收（ave.ts 的 QUICK_OUT = 250ms）：整片 0.2s 淡掉、滑回去 */
  .ave.is-quick .ave-card,
  .ave.is-quick .ave-star {
    transition:
      opacity 0.2s ease,
      translate 0.2s ease;
    transition-delay: 0s;
  }
  .ave.is-quick .ave-text .c,
  .ave.is-quick .ave-tail i {
    transition: none;
  }

  @media (max-width: 560px) {
    .ave {
      --ave-size: 40px;
      right: 12px;
      /* 让开底部那条阅读工具条 */
      bottom: 64px;
      /* 左边让出工具栏的星（left 22 + 48） */
      max-width: calc(100vw - 94px);
      --ave-star: 180px;
    }
    .ave-card {
      padding: 8px 12px 11px;
    }
    .ave-row {
      gap: 11px;
    }
    .ave-text {
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* 星在收起时另有一条 translate（--ave-star-exit），这里一并压平 */
    .ave-card,
    .ave-star,
    .ave.is-on .ave-star,
    .ave.is-leaving .ave-star,
    .ave.is-quick .ave-star {
      translate: none;
      transition: opacity 0.3s;
      transition-delay: 0s;
    }
    .ave-text .c,
    .ave-tail i {
      transition: none;
    }
  }
</style>
