---
/* ─────────────────────────────────────────────────────────────
   【原型 · 2026-10-02】开屏重做 · 碎晶放射（?loader=v1）
   纯色底 + 冷灰圆面；中央一枚「碎晶放射」剪影（public/textures/loader-shard.svg，
   只作蒙版，形状由 design/mocks/loader-shapes/gen-shapes.cjs 生成），剪影里叠三层填充，
   外绕光标同款星环（三道带缺口的发丝环，缺口里一粒小星芒，同心正圆、各自转）。三波：
   ① 迸出 0–.75s：晶片自中心向外迸出三次——纯色 / 树脂纹理 / 斜线，像同一位置的三次曝光
   ② 错版 .75–1.4s：三层沿 14° 各自错开，像套印没对准；一道网点扫过晶片
   ③ 破窗 1.45–2.3s：三层归位，页面先从晶片的形状里透出来，随即中心的圆把余下的铺满
   · 性能：所有动画只动 transform / opacity（含 scale / rotate / translate 单项属性），
     全部跑在合成线程上——首访时页面自己的脚本正占着主线程，开屏也不会被卡住。
     蒙版一律静态，不做蒙版尺寸 / 位置动画；破窗是一块静态挖孔的幕整体放大。
   · 同时保留 E 余像：站内跳转用跨文档 View Transition，旧页化开、新页成形
   · ?loader=off 退出；开关存在 sessionStorage，未开启时本组件不产生任何效果
   loader-proto.ts 只负责等素材到位后起播、打 booted、收场移除。
   定稿后：把它并入 BootVeil / global.css，删掉本组件与 loader-proto.ts。
   ───────────────────────────────────────────────────────────── */

/* 光标同款四角星（components/chrome/Cursor.astro），用作星环缺口里的小星芒 */
const STAR =
  'M0,-10C0.5,-3 2,-0.9 6.5,0C2,0.9 0.5,3 0,10C-0.5,3 -2,0.9 -6.5,0C-2,-0.9 -0.5,-3 0,-10Z';

/* 星环：viewBox ±100 对应 1.6 倍舞台宽；半径 / 缺口角（°），小星芒落在缺口正中 */
const RINGS = [
  { r: 70, gap: 30 },
  { r: 80, gap: 24 },
  { r: 92, gap: 19 },
].map(({ r, gap }) => {
  const c = 2 * Math.PI * r;
  const g = (c * gap) / 360;
  return { r, dash: `${(c - g).toFixed(2)} ${g.toFixed(2)}`, half: gap / 2 };
});
---

<script is:inline>
  (function () {
    var r = document.documentElement;
    var m = null;
    var OK = { v1: 1 };
    try {
      var q = new URLSearchParams(location.search).get('loader');
      if (q === 'off') sessionStorage.removeItem('xm-lp');
      else if (OK[q]) sessionStorage.setItem('xm-lp', q);
      m = sessionStorage.getItem('xm-lp');
      if (m && !OK[m]) {
        sessionStorage.removeItem('xm-lp');
        m = null;
      }
    } catch (e) {}

    // 未开原型：站内跳转不走 View Transition（@view-transition 是全局开的，这里逐次跳过）
    addEventListener('pageswap', function (e) {
      if (!m && e.viewTransition) e.viewTransition.skipTransition();
    });
    addEventListener('pagereveal', function (e) {
      if (!e.viewTransition) return;
      if (!m) e.viewTransition.skipTransition();
      else r.dataset.lpIntro = 'none'; // 余像接管，不再放开屏
      // 调参用：window.name = 'lp-freeze-500' 会把下一次余像钉在 500ms
      var fz = /^lp-freeze-(\d+)$/.exec(window.name);
      if (m && fz)
        e.viewTransition.ready.then(function () {
          document.getAnimations().forEach(function (a) {
            a.pause();
            a.currentTime = +fz[1];
          });
        });
    });

    if (!m) return;
    r.dataset.lp = m;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      r.dataset.lpIntro = 'none';
      return;
    }
    var nav = performance.getEntriesByType('navigation')[0];
    var internal = document.referrer.indexOf(location.origin) === 0 && nav && nav.type !== 'reload';
    r.dataset.lpIntro = internal ? 'none' : m;
  })();
</script>

<div class="lp-veil" aria-hidden="true">
  {/* 两块幕：挖孔幕叠在素幕上；前三波素幕把孔填平，破窗那一刻素幕熄掉、挖孔幕整体放大 */}
  <i class="v1-plain"></i>
  <i class="v1-window"></i>
  <div class="v1-stage">
    <i class="v1-disc"></i>
    {
      RINGS.map((ring, i) => (
        <div class={`v1-orbit v1-orbit-${i}`}>
          <svg viewBox="-100 -100 200 200" aria-hidden="true">
            <circle r={ring.r} stroke-dasharray={ring.dash} />
            <path
              d={STAR}
              transform={`rotate(${-ring.half}) translate(${ring.r} 0) rotate(${ring.half}) scale(0.32)`}
            />
          </svg>
        </div>
      ))
    }
    <div class="v1-shards">
      <div class="v1-reg v1-reg-solid"><i class="v1-fl v1-fl-solid"></i></div>
      <div class="v1-reg v1-reg-resin">
        <div class="v1-fl v1-fl-resin"><i class="v1-resin-pan"></i></div>
      </div>
      <div class="v1-reg v1-reg-hatch"><i class="v1-fl v1-fl-hatch"></i></div>
      <div class="v1-fl v1-dots"><i class="v1-dots-band"></i></div>
    </div>
  </div>
</div>

<nav class="lp-panel mono" aria-label="加载动画原型">
  <span class="lp-panel-k">开屏原型 · 碎晶放射</span>
  <button type="button" data-lp-replay>重放</button>
  <a href="?loader=off">退出</a>
</nav>

<style is:global>
  /* ═════ 公共 ═════ */
  html[data-lp] #bootveil {
    display: none;
  }

  .lp-veil,
  .lp-panel {
    display: none;
  }

  html[data-lp-intro='v1'] .lp-veil {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 300;
    overflow: hidden;
    pointer-events: none;

    --v1-bg: #ebe7e2;
    --v1-ink: #2b2c31;
    --v1-size: clamp(560px, 112vmin, 1100px); /* 大构图：星环可以溢出视口 */
    --v1-cy: 47vh;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 素材到位前（.go 之前）只有一整块纯色 */
  .lp-veil:not(.go) *,
  .lp-veil:not(.go) {
    animation-play-state: paused !important;
  }

  .lp-veil i {
    display: block;
  }

  /* ── 幕 ── */
  .v1-plain,
  .v1-window {
    position: absolute;
    inset: 0;
    background: var(--v1-bg);
  }

  /* 素幕垫在挖孔幕底下，把孔填平；到点一步熄掉（opacity 走合成线程，visibility 不走） */
  .v1-plain {
    animation: v1-off 0.01s steps(1, end) 1.45s forwards;
  }
  @keyframes v1-off {
    to {
      opacity: 0;
    }
  }

  /* ③ 破窗：全幅减去「晶片 + 中心小圆」（loader-window.svg，静态），幕以中心为原点整体放大。
     晶片孔先撑过屏幕，光从缝里先透出来；中心小圆跟着长大，把晶片之间的楔形余块一并吞掉 */
  .v1-window {
    transform-origin: 50vw var(--v1-cy);
    -webkit-mask:
      linear-gradient(#000 0 0),
      url('/textures/loader-window.svg') no-repeat calc(50vw - var(--v1-size) / 2)
        calc(var(--v1-cy) - var(--v1-size) / 2) / var(--v1-size) var(--v1-size);
    -webkit-mask-composite: source-out;
    mask:
      linear-gradient(#000 0 0),
      url('/textures/loader-window.svg') no-repeat calc(50vw - var(--v1-size) / 2)
        calc(var(--v1-cy) - var(--v1-size) / 2) / var(--v1-size) var(--v1-size);
    mask-composite: subtract;
    animation: v1-window 0.85s cubic-bezier(0.55, 0, 0.3, 1) 1.45s forwards;
  }
  @keyframes v1-window {
    to {
      transform: scale(34);
    }
  }

  .v1-stage {
    position: absolute;
    left: 50%;
    top: var(--v1-cy);
    width: var(--v1-size);
    height: var(--v1-size);
    margin: calc(var(--v1-size) / -2) 0 0 calc(var(--v1-size) / -2);
  }

  .v1-disc,
  .v1-shards,
  .v1-reg,
  .v1-fl {
    position: absolute;
    inset: 0;
  }

  @keyframes v1-recede {
    to {
      opacity: 0;
      transform: scale(1.25);
    }
  }

  /* ── 背景：冷灰圆面 ── */
  .v1-disc {
    inset: 3%;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 34%, #e3e5e7, #d3d7db 72%);
    opacity: 0;
    transform: scale(0.55);
    animation:
      v1-disc 0.9s var(--ease-out) 0.02s forwards,
      v1-recede 0.35s ease-in 1.45s forwards;
  }
  @keyframes v1-disc {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* ── 星环（光标同款）：三道同心正圆，各自转速不同 ── */
  .v1-orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    opacity: 0;
    animation:
      v1-orbit-in 0.7s var(--ease-out) calc(0.25s + var(--i) * 0.08s) forwards,
      v1-spin var(--spin) linear infinite,
      v1-recede 0.4s ease-in 1.45s forwards;
  }
  .v1-orbit-0 {
    --i: 0;
    --spin: 9s;
  }
  .v1-orbit-1 {
    --i: 1;
    --spin: 14s;
    animation-direction: normal, reverse, normal;
  }
  .v1-orbit-2 {
    --i: 2;
    --spin: 21s;
  }
  @keyframes v1-orbit-in {
    from {
      opacity: 0;
      scale: 0.9;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }
  @keyframes v1-spin {
    to {
      rotate: 360deg;
    }
  }

  .v1-orbit svg {
    position: absolute;
    left: calc(var(--v1-size) * -0.8);
    top: calc(var(--v1-size) * -0.8);
    width: calc(var(--v1-size) * 1.6);
    height: calc(var(--v1-size) * 1.6);
    max-width: none;
    overflow: visible;
  }
  .v1-orbit circle {
    fill: none;
    stroke: color-mix(in srgb, var(--v1-ink) 38%, transparent);
    stroke-width: 1;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .v1-orbit path {
    fill: color-mix(in srgb, var(--v1-ink) 55%, transparent);
  }
  .v1-orbit-2 circle {
    stroke: color-mix(in srgb, var(--v1-ink) 26%, transparent);
  }

  /* ── 晶片：三层同形不同填充（静态蒙版），各自从中心迸出（scale + 转角落定） ── */
  .v1-fl {
    -webkit-mask: url('/textures/loader-shard.svg') center / contain no-repeat;
    mask: url('/textures/loader-shard.svg') center / contain no-repeat;
  }

  .v1-fl-solid,
  .v1-fl-resin,
  .v1-fl-hatch {
    opacity: 0;
    transform: scale(0.08) rotate(var(--r0));
  }
  .v1-fl-solid {
    --r0: -24deg;
    background: #a9b3bd;
    animation: v1-burst 0.6s var(--ease-out) 0.08s forwards;
  }
  .v1-fl-resin {
    --r0: 18deg;
    overflow: hidden;
    animation: v1-burst 0.6s var(--ease-out) 0.18s forwards;
  }
  .v1-fl-hatch {
    --r0: -12deg;
    background: repeating-linear-gradient(
      104deg,
      color-mix(in srgb, #765640 60%, transparent) 0 1px,
      transparent 1px 9px
    );
    mix-blend-mode: multiply;
    animation: v1-burst 0.6s var(--ease-out) 0.28s forwards;
  }
  @keyframes v1-burst {
    0% {
      opacity: 0;
    }
    18% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  /* 树脂纹理缓缓平移：动的是蒙版里面那张图，不是蒙版 */
  .v1-resin-pan {
    position: absolute;
    left: -45%;
    top: -45%;
    width: 190%;
    height: 190%;
    background: url('/textures/resin.webp') center / cover;
    translate: 8% 6%;
    animation: v1-pan 2.4s linear forwards;
  }
  @keyframes v1-pan {
    to {
      translate: -9% -7%;
    }
  }

  /* ② 错版：沿 14° 各自滑开（快进、停住、再啪地归位） */
  .v1-reg {
    animation: v1-misreg 0.7s linear 0.72s forwards;
  }
  .v1-reg-solid {
    --dx: calc(var(--v1-size) * -0.055);
    --dy: calc(var(--v1-size) * -0.0137); /* 沿 14°：dy = dx · tan14° */
    --rot: -1.2deg;
  }
  .v1-reg-hatch {
    --dx: calc(var(--v1-size) * 0.046);
    --dy: calc(var(--v1-size) * 0.0115);
    --rot: 1.5deg;
  }
  .v1-reg-resin {
    --dx: 0px;
    --dy: 0px;
    --rot: 0deg;
  }
  @keyframes v1-misreg {
    0% {
      transform: none;
      animation-timing-function: cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    18% {
      transform: translate(var(--dx), var(--dy)) rotate(var(--rot));
    }
    82% {
      transform: translate(calc(var(--dx) * 1.15), calc(var(--dy) * 1.15)) rotate(var(--rot));
      animation-timing-function: cubic-bezier(0.8, 0, 0.6, 1);
    }
    100% {
      transform: none;
    }
  }

  /* 网点：晶片蒙版（静态）里一条带渐隐边的网点带，从左平移到右 */
  .v1-dots {
    overflow: hidden;
    mix-blend-mode: multiply;
  }
  .v1-dots-band {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 55%;
    background: radial-gradient(
        circle,
        color-mix(in srgb, var(--v1-ink) 55%, transparent) 0 1.1px,
        transparent 1.5px
      )
      0 0 / 6px 6px;
    -webkit-mask: linear-gradient(90deg, transparent, #000 35%, #000 65%, transparent);
    mask: linear-gradient(90deg, transparent, #000 35%, #000 65%, transparent);
    translate: -100% 0;
    animation: v1-sweep 0.75s cubic-bezier(0.45, 0, 0.35, 1) 0.75s forwards;
  }
  @keyframes v1-sweep {
    to {
      translate: 182% 0;
    }
  }

  /* ③ 破窗时晶片整体往外撑开 */
  .v1-shards {
    animation: v1-bloom 0.6s cubic-bezier(0.6, 0, 0.3, 1) 1.45s forwards;
  }
  @keyframes v1-bloom {
    to {
      transform: scale(2.6) rotate(10deg);
      opacity: 0;
    }
  }

  /* ═════ E · 余像（站内跳转） ═════
     旧页不立刻走：先褪一半，停住，再往光里化开；新页稍晚、更快地成形。 */
  @view-transition {
    navigation: auto;
  }

  html[data-lp]::view-transition-old(root) {
    animation: lp-vt-old 1.15s cubic-bezier(0.3, 0, 0.2, 1) both;
  }
  html[data-lp]::view-transition-new(root) {
    animation: lp-vt-new 0.8s cubic-bezier(0.25, 0.1, 0.25, 1) 0.18s both;
  }

  @keyframes lp-vt-old {
    0% {
      opacity: 1;
      filter: blur(0) brightness(1);
      transform: none;
    }
    28% {
      opacity: 0.5;
      filter: blur(1.5px) brightness(1.03);
    }
    55% {
      opacity: 0.32;
    }
    100% {
      opacity: 0;
      filter: blur(14px) brightness(1.12);
      transform: scale(1.018);
    }
  }
  @keyframes lp-vt-new {
    from {
      opacity: 0;
      filter: blur(7px) saturate(0.4);
      transform: scale(0.994);
    }
    to {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }

  /* ═════ 原型切换条 ═════ */
  html[data-lp] .lp-panel {
    display: flex;
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 260;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.4rem 0.3rem 0.75rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--fg-soft);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border: 1px solid var(--line);
    border-radius: 999px;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    view-transition-name: lp-panel;
  }

  .lp-panel-k {
    margin-right: 0.35rem;
    color: var(--fg-faint);
  }

  .lp-panel a,
  .lp-panel button {
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    background: none;
    border: 0;
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .lp-panel a:hover,
  .lp-panel button:hover {
    color: var(--fg);
    background: var(--line);
  }
</style>

<script>
  import { initLoaderProto } from '../../scripts/loader-proto';
  initLoaderProto();
</script>
