---
/* 缝线：fixed 14° 醒梦缝，170vmax 长；html.booted 后从中心划出。
   琥珀锚点由 chrome.ts 巡行到当前阅读带的「结」。 */
interface Props {
  variant?: 'default' | 'faint' | 'broken';
}
const { variant = 'default' } = Astro.props;
---

<div class="seam-wrap" aria-hidden="true">
  <div class:list={['seam', { 'seam--faint': variant === 'faint', 'seam--broken': variant === 'broken' }]}>
    <span class="seam-anchor"></span>
  </div>
</div>

<style>
  .seam-wrap {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  /* 文章页中央消隐：文字阅读核心列完全隐退，两侧留白自然延伸 */
  :global(body[data-page-type='article']) .seam-wrap {
    -webkit-mask-image: linear-gradient(
      to right,
      black 0,
      black calc(50% - 28rem),
      transparent calc(50% - 21rem),
      transparent calc(50% + 21rem),
      black calc(50% + 28rem),
      black 100%
    );
    mask-image: linear-gradient(
      to right,
      black 0,
      black calc(50% - 28rem),
      transparent calc(50% - 21rem),
      transparent calc(50% + 21rem),
      black calc(50% + 28rem),
      black 100%
    );
  }

  .seam {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 170vmax;
    height: 1px;
    background: linear-gradient(90deg, var(--wake), var(--dream));
    transform: translate(-50%, -50%) rotate(var(--seam-angle)) scaleX(var(--draw, 0.02));
    transform-origin: center;
    transition: transform 2.6s cubic-bezier(0.22, 0.61, 0.36, 1);
    pointer-events: none;
    opacity: 0.62;
  }

  /* 内页减配 */
  .seam--faint {
    opacity: 0.3;
  }

  /* 404：线在这里断了 */
  .seam--broken {
    -webkit-mask: linear-gradient(90deg, #000 0 37%, transparent 41% 47%, #000 51% 100%);
    mask: linear-gradient(90deg, #000 0 37%, transparent 41% 47%, #000 51% 100%);
  }

  :global(html.booted) .seam {
    --draw: 1;
  }

  /* 文章页隐藏正中央呼吸发光锚点，消除焦点争抢 */
  :global(body[data-page-type='article']) .seam-anchor {
    display: none;
  }

  .seam-anchor {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--amber);
    /* 光晕由 --amber 派生：随入梦检验的醒度插值一同换色 */
    box-shadow:
      0 0 10px 2px color-mix(in srgb, var(--amber) 55%, transparent),
      0 0 26px 6px color-mix(in srgb, var(--amber) 20%, transparent);
    animation: anchor-breathe 5.5s ease-in-out infinite;
  }

  @keyframes anchor-breathe {
    0%,
    100% {
      box-shadow:
        0 0 8px 1px color-mix(in srgb, var(--amber) 45%, transparent),
        0 0 20px 4px color-mix(in srgb, var(--amber) 16%, transparent);
    }
    50% {
      box-shadow:
        0 0 13px 3px color-mix(in srgb, var(--amber) 72%, transparent),
        0 0 34px 9px color-mix(in srgb, var(--amber) 30%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seam {
      transition: none;
      --draw: 1;
    }

    .seam-anchor {
      animation: none;
    }
  }</style>
