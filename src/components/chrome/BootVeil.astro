---
/* ─────────────────────────────────────────────────────────────
   开屏 · 碎晶放射（boot.ts 驱动；定稿自 2026-10-02 的 LoaderProto 原型）
   纯色底 + 冷灰圆面；中央一枚「碎晶放射」剪影（public/textures/loader-shard.svg，
   只作蒙版，形状由 design/mocks/loader-shapes/gen-shapes.cjs 生成），剪影里叠三层填充，
   外绕星环（三道同心发丝弧，缺口里一粒 1:1 小星芒；每次随机起角，各自转）。三波：
   ① 迸出 0–.75s：纯色 / 树脂纹理 / 斜线自中心先后迸出，像同一位置的三次曝光
   ② 错版 .75–1.4s：三层沿 14° 各自错开再归位，像套印没对准；一道网点带扫过晶片
   ③ 破窗 1.45–2.3s：挖了「晶片 + 中心小圆」孔的幕整体放大，
      页面先从晶片缝里透出来，再由中心铺满
   · 主页（always）每次进入都放，站内跳回主页也放（旧页的余像化进纯色里，再接开屏）；
     其余页面只在会话首访放，同会话后续页面不放（站内跳转由 global.css 的跨文档 View Transition 接管）。
     是否放由下方内联脚本在首帧前决定，免得不该放的页面先闪一帧纯色。
   · 性能：所有动画只动 transform / opacity（含 scale / rotate / translate 单项属性），
     蒙版一律静态——全程跑在合成线程上，首访时页面自己的脚本正占着主线程也不卡。
   · 无 JS：BaseLayout 的 noscript 直接隐藏；JS 起不来（.go 一直没加上）时 3.2s 后自己淡出。
   ───────────────────────────────────────────────────────────── */

/* 四角星（光标同款的曲线，四臂等长 ⇒ 1:1），用作星环缺口里的小星芒 */
const STAR =
  'M0,-10C0.7,-2.6 2.6,-0.7 10,0C2.6,0.7 0.7,2.6 0,10C-0.7,2.6 -2.6,0.7 -10,0C-2.6,-0.7 -0.7,-2.6 0,-10Z';
const STAR_R = 3.3; // 星芒半径（viewBox 单位）＝ 路径半径 10 × 缩放
const STAR_PAD = 3.6; // 星芒两侧到弧线端头留的空

interface Props {
  /* 每次进入都放（主页）；否则只在会话首访放 */
  always?: boolean;
}
const { always = false } = Astro.props;

/* 星环：viewBox ±100。每道环画成一段弧，缺口正对 0°，星芒落在缺口正中、两侧不碰弧线。
   不用 circle + dasharray：环上开了 non-scaling-stroke，虚线长度按屏幕像素算，
   一圈里会重复出好几个缺口，星芒就对不上了 */
const RINGS = [70, 80, 92].map((r) => {
  const h = (STAR_R + STAR_PAD) / r; // 缺口半角（弧度）
  const x = (r * Math.cos(h)).toFixed(3);
  const y = (r * Math.sin(h)).toFixed(3);
  return { r, arc: `M${x},${y}A${r},${r} 0 1 1 ${x},-${y}` };
});
---

<script is:inline define:vars={{ always }}>
  var r = document.documentElement;
  var seen = false;
  try {
    seen = sessionStorage.getItem('xm-boot-seen') === '1';
  } catch (e) {}
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || (seen && !always)) r.dataset.bootSkip = '';
  // 站内跳转若走了 View Transition，新页面不再放开屏（主页除外）
  if (!always)
    addEventListener('pagereveal', function (e) {
      if (e.viewTransition) r.dataset.bootSkip = '';
    });
</script>

<div class="bootveil" id="bootveil" aria-hidden="true">
  {/* 两块幕：挖孔幕叠在素幕上；前两波素幕把孔填平，破窗那一刻素幕熄掉、挖孔幕整体放大 */}
  <i class="bv-plain"></i>
  <i class="bv-window"></i>
  <div class="bv-stage">
    <i class="bv-disc"></i>
    {
      RINGS.map((ring, i) => (
        <div class={`bv-orbit bv-orbit-${i}`}>
          <svg viewBox="-100 -100 200 200" aria-hidden="true">
            <path class="bv-arc" d={ring.arc} />
            <path class="bv-star" d={STAR} transform={`translate(${ring.r} 0) scale(${STAR_R / 10})`} />
          </svg>
        </div>
      ))
    }
    <div class="bv-shards">
      <div class="bv-reg bv-reg-solid"><i class="bv-fl bv-fl-solid"></i></div>
      <div class="bv-reg bv-reg-resin">
        <div class="bv-fl bv-fl-resin"><i class="bv-resin-pan"></i></div>
      </div>
      <div class="bv-reg bv-reg-hatch"><i class="bv-fl bv-fl-hatch"></i></div>
      <div class="bv-fl bv-dots"><i class="bv-dots-band"></i></div>
    </div>
  </div>
</div>

{/* 三道环每次从随机角度起转（星芒不再总从正右方出发）；紧跟面纱同步跑，首帧前就定好 */}
<script is:inline>
  document.querySelectorAll('#bootveil .bv-orbit svg').forEach(function (el) {
    el.style.rotate = (Math.random() * 360).toFixed(1) + 'deg';
  });
</script>

<style>
  .bootveil {
    position: fixed;
    inset: 0;
    z-index: 200;
    overflow: hidden;
    pointer-events: none;

    --bv-bg: #ebe7e2;
    /* 两块幕用的底色：差 0.4% 不透明，肉眼与 --bv-bg 无别。幕若完全不透明，合成器认定底下的页面
       被挡住，就一直不给它光栅化，等破窗那一刻全部挤在同一帧补画（揭幕卡顿的大头）；
       留这一丝透，页面就在开屏前两波里悄悄画好 */
    --bv-veil: rgb(235 231 226 / 0.996);
    --bv-ink: #2b2c31;
    --bv-size: min(60vmin, 500px);
    --bv-ring: 1.3; /* 星环相对构图再放大一点 */
    --bv-cy: 47vh;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(html[data-boot-skip]) .bootveil {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .bootveil {
      display: none;
    }
  }

  /* 素材到位前（.go 之前）只有一整块纯色；JS 一直起不来就 3.2s 后自己淡出 */
  .bootveil:not(.go) {
    animation: bv-fallback 0.6s ease 3.2s forwards;
  }
  .bootveil:not(.go) * {
    animation-play-state: paused !important;
  }
  @keyframes bv-fallback {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  .bootveil i {
    display: block;
  }

  /* ── 幕 ── */
  .bv-plain,
  .bv-window {
    position: absolute;
    inset: 0;
    background: var(--bv-veil);
  }

  /* 素幕垫在挖孔幕底下，把孔填平；到点一步熄掉（opacity 走合成线程，visibility 不走） */
  .bv-plain {
    animation: bv-off 0.01s steps(1, end) 1.45s forwards;
  }
  @keyframes bv-off {
    to {
      opacity: 0;
    }
  }

  /* ③ 破窗：全幅减去「晶片 + 中心小圆」（loader-window.svg，静态），幕以中心为原点整体放大。
     晶片孔先撑过屏幕，光从缝里先透出来；中心小圆跟着长大，把晶片之间的楔形余块一并吞掉 */
  .bv-window {
    transform-origin: 50vw var(--bv-cy);
    -webkit-mask:
      linear-gradient(#000 0 0),
      url('/textures/loader-window.svg') no-repeat calc(50vw - var(--bv-size) / 2)
        calc(var(--bv-cy) - var(--bv-size) / 2) / var(--bv-size) var(--bv-size);
    -webkit-mask-composite: source-out;
    mask:
      linear-gradient(#000 0 0),
      url('/textures/loader-window.svg') no-repeat calc(50vw - var(--bv-size) / 2)
        calc(var(--bv-cy) - var(--bv-size) / 2) / var(--bv-size) var(--bv-size);
    mask-composite: subtract;
    animation: bv-window 0.85s cubic-bezier(0.55, 0, 0.3, 1) 1.45s forwards;
  }
  @keyframes bv-window {
    to {
      transform: scale(72); /* 中心小圆 9/200 构图宽，放到能盖过 2560×1440 的半对角线 */
    }
  }

  .bv-stage {
    position: absolute;
    left: 50%;
    top: var(--bv-cy);
    width: var(--bv-size);
    height: var(--bv-size);
    margin: calc(var(--bv-size) / -2) 0 0 calc(var(--bv-size) / -2);
  }

  .bv-disc,
  .bv-shards,
  .bv-reg,
  .bv-fl {
    position: absolute;
    inset: 0;
  }

  @keyframes bv-recede {
    to {
      opacity: 0;
      transform: scale(1.25);
    }
  }

  /* ── 背景：冷灰圆面 ── */
  .bv-disc {
    inset: 3%;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 34%, #e3e5e7, #d3d7db 72%);
    opacity: 0;
    transform: scale(0.55);
    animation:
      bv-disc 0.9s var(--ease-out) 0.02s forwards,
      bv-recede 0.35s ease-in 1.45s forwards;
  }
  @keyframes bv-disc {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* ── 星环（光标同款）：三道同心正圆，各自转速不同 ── */
  .bv-orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    opacity: 0;
    animation:
      bv-orbit-in 0.7s var(--ease-out) calc(0.25s + var(--i) * 0.08s) forwards,
      bv-spin var(--spin) linear infinite,
      bv-recede 0.4s ease-in 1.45s forwards;
  }
  .bv-orbit-0 {
    --i: 0;
    --spin: 9s;
  }
  .bv-orbit-1 {
    --i: 1;
    --spin: 14s;
    animation-direction: normal, reverse, normal;
  }
  .bv-orbit-2 {
    --i: 2;
    --spin: 21s;
  }
  @keyframes bv-orbit-in {
    from {
      opacity: 0;
      scale: 0.9;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }
  @keyframes bv-spin {
    to {
      rotate: 360deg;
    }
  }

  .bv-orbit svg {
    --w: calc(var(--bv-size) * 1.6 * var(--bv-ring));
    position: absolute;
    left: calc(var(--w) / -2);
    top: calc(var(--w) / -2);
    width: var(--w);
    height: var(--w);
    max-width: none;
    overflow: visible;
  }
  .bv-orbit .bv-arc {
    fill: none;
    stroke: color-mix(in srgb, var(--bv-ink) 38%, transparent);
    stroke-width: 1;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .bv-orbit .bv-star {
    fill: color-mix(in srgb, var(--bv-ink) 55%, transparent);
  }
  .bv-orbit-2 .bv-arc {
    stroke: color-mix(in srgb, var(--bv-ink) 26%, transparent);
  }

  /* ── 晶片：三层同形不同填充（静态蒙版），各自从中心迸出（scale + 转角落定） ── */
  .bv-fl {
    -webkit-mask: url('/textures/loader-shard.svg') center / contain no-repeat;
    mask: url('/textures/loader-shard.svg') center / contain no-repeat;
  }

  .bv-fl-solid,
  .bv-fl-resin,
  .bv-fl-hatch {
    opacity: 0;
    transform: scale(0.08) rotate(var(--r0));
  }
  .bv-fl-solid {
    --r0: -24deg;
    background: #a9b3bd;
    animation: bv-burst 0.6s var(--ease-out) 0.08s forwards;
  }
  .bv-fl-resin {
    --r0: 18deg;
    overflow: hidden;
    animation: bv-burst 0.6s var(--ease-out) 0.18s forwards;
  }
  /* 斜线与网点都按普通叠加画（不用 multiply：混合模式的层在破窗时每帧要多读一遍背景），
     斜线色比原先压深一档，叠在浅色晶片上与正片叠底的观感相当 */
  .bv-fl-hatch {
    --r0: -12deg;
    background: repeating-linear-gradient(
      104deg,
      color-mix(in srgb, #66493a 62%, transparent) 0 1px,
      transparent 1px 7px
    );
    animation: bv-burst 0.6s var(--ease-out) 0.28s forwards;
  }
  @keyframes bv-burst {
    0% {
      opacity: 0;
    }
    18% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  /* 树脂纹理缓缓平移：动的是蒙版里面那张图，不是蒙版 */
  .bv-resin-pan {
    position: absolute;
    left: -45%;
    top: -45%;
    width: 190%;
    height: 190%;
    background: url('/textures/resin.webp') center / cover;
    translate: 8% 6%;
    animation: bv-pan 2.4s linear forwards;
  }
  @keyframes bv-pan {
    to {
      translate: -9% -7%;
    }
  }

  /* ② 错版：沿 14° 各自滑开（快进、停住、再啪地归位） */
  .bv-reg {
    animation: bv-misreg 0.7s linear 0.72s forwards;
  }
  .bv-reg-solid {
    --dx: calc(var(--bv-size) * -0.055);
    --dy: calc(var(--bv-size) * -0.0137); /* 沿 14°：dy = dx · tan14° */
    --rot: -1.2deg;
  }
  .bv-reg-hatch {
    --dx: calc(var(--bv-size) * 0.046);
    --dy: calc(var(--bv-size) * 0.0115);
    --rot: 1.5deg;
  }
  .bv-reg-resin {
    --dx: 0px;
    --dy: 0px;
    --rot: 0deg;
  }
  @keyframes bv-misreg {
    0% {
      transform: none;
      animation-timing-function: cubic-bezier(0.2, 0.9, 0.3, 1);
    }
    18% {
      transform: translate(var(--dx), var(--dy)) rotate(var(--rot));
    }
    82% {
      transform: translate(calc(var(--dx) * 1.15), calc(var(--dy) * 1.15)) rotate(var(--rot));
      animation-timing-function: cubic-bezier(0.8, 0, 0.6, 1);
    }
    100% {
      transform: none;
    }
  }

  /* 网点：晶片蒙版（静态）里一条带渐隐边的网点带，从左平移到右 */
  .bv-dots {
    overflow: hidden;
  }
  .bv-dots-band {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 55%;
    background: radial-gradient(
        circle,
        color-mix(in srgb, var(--bv-ink) 55%, transparent) 0 1.1px,
        transparent 1.5px
      )
      0 0 / 6px 6px;
    -webkit-mask: linear-gradient(90deg, transparent, #000 35%, #000 65%, transparent);
    mask: linear-gradient(90deg, transparent, #000 35%, #000 65%, transparent);
    translate: -100% 0;
    animation: bv-sweep 0.75s cubic-bezier(0.45, 0, 0.35, 1) 0.75s forwards;
  }
  @keyframes bv-sweep {
    to {
      translate: 182% 0;
    }
  }

  /* ③ 破窗时晶片整体往外撑开 */
  .bv-shards {
    animation: bv-bloom 0.6s cubic-bezier(0.6, 0, 0.3, 1) 1.45s forwards;
  }
  @keyframes bv-bloom {
    to {
      transform: scale(2.6) rotate(10deg);
      opacity: 0;
    }
  }
</style>
