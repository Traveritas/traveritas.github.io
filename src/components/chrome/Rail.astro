---
/* 左侧仪表轨（入梦检验式深度表）
   · night：主页整夜——微型示波探针（1px发丝基准轨 + 琥珀游标搭载数字时钟与动态脑电微波形）
   · depth：文章页阅读深度（醒 / 入梦 / 深梦 / 将醒）
   · station：列表页仅站名
   < 1200px 隐藏（退化为顶部发丝线）。 */
import { fmtNightTime } from '../../data/night';

interface Props {
  mode?: 'night' | 'depth' | 'station';
  station?: string;
  en?: string;
  depthTarget?: string;
  /* depth 模式的夜内时钟（素夜：文章页唯一小仪器）——
     阅读进度在 fromMin → fromMin+durMin 之间爬行，页面脚本按
     data-from-min / data-dur-min 插值；stage 为静态分期注记 */
  readout?: { fromMin: number; durMin: number; stage: string };
}

const { mode = 'station', station, en, depthTarget, readout } = Astro.props;
const depthLabels = ['醒', '入梦', '深梦', '将醒'];
---

<aside class:list={['rail', `rail--${mode}`]} data-depth={depthTarget} aria-hidden="true">
  {
    mode !== 'night' && station && (
      <div class="rail-station">
        <span class="rail-name">{station}</span>
        {en && <span class="rail-en mono">{en}</span>}
      </div>
    )
  }

  {
    mode === 'night' && (
      <div class="rail-meter rail-meter--night">
        <i class="rail-track" />


        <div class="rail-probe" id="rail-probe">
          <i class="rail-dot" />
          <div class="probe-capsule">
            <span id="rail-time" class="mono">23:07</span>
            <div class="probe-wave-box" id="probe-wave-box">
              <svg class="probe-svg" width="38" height="12" viewBox="0 0 38 12" fill="none" aria-hidden="true">
                <path
                  class="probe-path-bg"
                  id="probe-wave-bg"
                  d="M 0 6 Q 2 4.5 4 6 T 8 6 T 12 6 T 16 6 T 20 6 T 24 6 T 28 6 T 32 6 T 36 6 L 38 6"
                  stroke="var(--line)"
                  stroke-width="1"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  opacity="0.45"
                  fill="none"
                />
                <path
                  id="probe-wave-path"
                  class="probe-path-live"
                  d="M 0 6 Q 2 4.5 4 6 T 8 6 T 12 6 T 16 6 T 20 6 T 24 6 T 28 6 T 32 6 T 36 6 L 38 6"
                  stroke="var(--amber)"
                  stroke-width="1.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                />
              </svg>
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    mode === 'depth' && (
      <div class="rail-meter rail-meter--depth">
        <i class="rail-track" />
        <i class="rail-dot" />
        {depthLabels.map((t, i) => (
          <span class={`meter-label l${i} mono`}>{t}</span>
        ))}
      </div>
    )
  }

  {
    mode === 'depth' && readout && (
      <div class="rail-read mono" data-from-min={readout.fromMin} data-dur-min={readout.durMin}>
        <span class="rail-clock">{fmtNightTime(readout.fromMin)}</span>
        <span class="rail-stage-txt">{readout.stage}</span>
      </div>
    )
  }
</aside>

<style>
  .rail {
    position: fixed;
    left: 28px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    pointer-events: none;
    color: var(--fg-soft);
    /* 首页滚过首屏完全离场才浮现，触碰破晓天亮时收起；内页 body 恒带 past-hero */
    opacity: 0;
    visibility: hidden;
    translate: -16px 0;
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      translate 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.6s;
  }

  :global(body.past-hero:not(.in-dawn)) .rail {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
  }

  /* ── Night 模式：探针微示波仪（时间轴 + 时间 + 波形一体化） ── */
  .rail-meter--night {
    position: relative;
    width: 60px;
    height: 180px;
  }

  .rail-meter--night .rail-track {
    position: absolute;
    left: 4px;
    top: 0;
    width: 1px;
    height: 100%;
    background: var(--line);
  }

  /* 上下虚空延伸：打破生硬截断，发丝线向夜幕两极渐隐消散 */
  .rail-meter--night .rail-track::before,
  .rail-meter--night .rail-track::after {
    content: '';
    position: absolute;
    left: 0;
    width: 1px;
    height: 24px;
    pointer-events: none;
  }

  .rail-meter--night .rail-track::before {
    bottom: 100%;
    background: linear-gradient(to top, var(--line), transparent);
  }

  .rail-meter--night .rail-track::after {
    top: 100%;
    background: linear-gradient(to bottom, var(--line), transparent);
  }


  .rail-meter--night .rail-probe {
    position: absolute;
    left: 1.5px;
    top: 4%;
    transform: translateY(-50%);
    display: flex !important;
    align-items: center;
    gap: 9px;
    pointer-events: none;
    transition: top 0.15s linear;
  }

  .rail-meter--night .rail-dot {
    position: relative !important;
    left: auto !important;
    top: auto !important;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow:
      0 0 8px 1px color-mix(in srgb, var(--amber) 55%, transparent),
      0 1px 3px rgba(35, 40, 48, 0.16);
    flex-shrink: 0;
  }

  .probe-capsule {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    padding: 3px 6px 3px 5px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.62);
    -webkit-backdrop-filter: blur(10px) saturate(130%);
    backdrop-filter: blur(10px) saturate(130%);
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow:
      0 2px 8px -2px rgba(35, 40, 48, 0.08),
      inset 0 1px 1px rgba(255, 255, 255, 0.9);
  }

  .probe-capsule #rail-time {
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .probe-wave-box {
    width: 38px;
    height: 12px;
    display: flex;
    align-items: center;
    overflow: visible;
    opacity: 0.92;
  }

  .probe-svg {
    width: 38px;
    height: 12px;
    overflow: visible;
  }

  .probe-path-bg {
    stroke: color-mix(in srgb, var(--fg) 22%, transparent);
    stroke-width: 1;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .probe-path-live {
    stroke: var(--amber);
    stroke-width: 1.35;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 1px 2px color-mix(in srgb, var(--amber) 40%, transparent));
    transition: d 0.3s ease;
  }

  .probe-wave-box.wave-swap {
    animation: wave-swap-pulse 0.35s ease-out;
  }

  @keyframes wave-swap-pulse {
    0% {
      opacity: 0.35;
      transform: scaleY(0.7);
    }
    100% {
      opacity: 0.92;
      transform: scaleY(1);
    }
  }

  /* ── 站头（仅列表页/文章页） ── */
  .rail-station {
    writing-mode: vertical-rl;
    display: flex;
    gap: 0.9rem;
    align-items: center;
    padding-left: 0.8rem;
    border-left: 1px solid var(--line);
  }

  .rail-name {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.42em;
  }

  .rail-en {
    font-size: 0.56rem;
    letter-spacing: 0.3em;
    opacity: 0.66;
  }

  /* ── Depth 模式（文章页） ── */
  .rail:not(.rail--night) {
    align-items: center;
    gap: 1.1rem;
  }

  .rail-meter--depth {
    position: relative;
    width: 12px;
    height: 200px;
  }

  .rail-meter--depth .rail-track {
    position: absolute;
    left: 5px;
    top: 0;
    width: 1px;
    height: 100%;
    background: var(--line);
  }

  .rail-meter--depth .rail-dot {
    position: absolute;
    left: 2.5px;
    top: 6%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 8px 1px color-mix(in srgb, var(--amber) 50%, transparent);
    transition: top 0.15s linear;
  }

  .meter-label {
    position: absolute;
    left: 14px;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    opacity: 0.66;
    writing-mode: vertical-rl;
    white-space: nowrap;
  }

  .l0 {
    top: -2px;
  }
  .l1 {
    top: 30%;
  }
  .l2 {
    top: 60%;
  }
  .l3 {
    top: 94%;
  }

  .rail-read {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    width: 7em;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .rail-clock {
    color: var(--fg);
    font-size: 0.72rem;
  }

  .rail-stage-txt {
    opacity: 0.72;
    width: 100%;
    text-align: center;
    white-space: nowrap;
  }

  .rail--night {
    --fg: #232830;
    --fg-soft: #56606d;
    --line: rgba(35, 40, 48, 0.18);
  }


  @media (max-width: 1200px) {
    .rail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail {
      transition: none;
      opacity: 1;
      visibility: visible;
      translate: 0 0;
    }

    .rail-probe {
      transition: none;
    }

    .probe-wave-box.wave-swap {
      animation: none;
    }

    .probe-path-live {
      transition: none;
    }
  }
</style>
