---
/* 全站一个外壳：一张画布（地面、玻璃、晶体都在里面画）+ 左上的位置 + 正文 + 左下的星与右下的 Ave + 自绘光标。
   画布与左下 / 右下两件跨页常驻（transition:persist），换页只换 #view 里的字，见 scripts/site.ts。 */
import { ClientRouter } from 'astro:transitions';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/tokens.css';
import '../styles/site.css';
import Toolstar from '../components/chrome/Toolstar.astro';
import Ave from '../components/chrome/Ave.astro';
import Cursor from '../components/chrome/Cursor.astro';
import { SECS, type Sec } from '../lib/entries';

interface Props {
  title?: string;
  description?: string;
  place: 'home' | 'list' | 'read' | 'lost' | 'find' | 'tag' | 'gate';
  sec?: Sec;
  slug?: string;
  publishedTime?: Date;
  ogImage?: string;
}
const {
  title,
  description = '在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？',
  place,
  sec,
  slug,
  publishedTime,
  ogImage,
} = Astro.props;
const NAME = 'AveritA 的昼梦叙集';
const fullTitle = title ? `${title} · ${NAME}` : NAME;
const isLost = place === 'lost';
const siteHref = Astro.site ? new URL('/', Astro.site).href : undefined;
const canonicalUrl = !isLost && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImgUrl = !isLost && Astro.site ? new URL(ogImage || '/og-default.png', Astro.site).href : undefined;
const ogType = place === 'read' && (sec === 'articles' || sec === 'moments') ? 'article' : 'website';
const jsonLd =
  place === 'home' && siteHref
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': `${siteHref}#website`,
            name: NAME,
            url: siteHref,
            description,
            inLanguage: 'zh-CN',
          },
          {
            '@type': 'Person',
            '@id': `${siteHref}#person`,
            name: 'AveritA',
            alternateName: 'Traveritas',
            url: siteHref,
            sameAs: ['https://github.com/Traveritas'],
          },
        ],
      }
    : place === 'read' && canonicalUrl && siteHref
      ? {
          '@context': 'https://schema.org',
          '@type': sec === 'projects' ? 'CreativeWork' : 'BlogPosting',
          headline: title || NAME,
          description,
          url: canonicalUrl,
          inLanguage: 'zh-CN',
          ...(publishedTime ? { datePublished: publishedTime.toISOString() } : {}),
          ...(ogImgUrl ? { image: ogImgUrl } : {}),
          author: {
            '@type': 'Person',
            '@id': `${siteHref}#person`,
            name: 'AveritA',
            url: siteHref,
          },
        }
      : null;
const jsonLdHtml = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<!doctype html>
<html lang="zh-CN" data-face="dream" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {isLost && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon-star.svg" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      !isLost && (
        <>
          <meta property="og:site_name" content={NAME} />
          <meta property="og:locale" content="zh_CN" />
          <meta property="og:type" content={ogType} />
          <meta property="og:title" content={fullTitle} />
          <meta property="og:description" content={description} />
          {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
          {ogImgUrl && (
            <>
              <meta property="og:image" content={ogImgUrl} />
              {!ogImage && <meta property="og:image:width" content="1200" />}
              {!ogImage && <meta property="og:image:height" content="630" />}
            </>
          )}
          {publishedTime && ogType === 'article' && (
            <meta property="article:published_time" content={publishedTime.toISOString()} />
          )}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={fullTitle} />
          <meta name="twitter:description" content={description} />
          {ogImgUrl && <meta name="twitter:image" content={ogImgUrl} />}
        </>
      )
    }
    {jsonLdHtml && <script type="application/ld+json" set:html={jsonLdHtml} />}
    <link rel="alternate" type="application/rss+xml" title={NAME} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="stylesheet" href="/fonts/noto-serif-sc/font.css" />
    <noscript>
      <style>
        #ts { display: none !important; }
      </style>
    </noscript>
    {/* 先定面与加载态，免得首帧闪出昼夜错色或未加载完的 DOM（无 JS 时不打 booting，正文仍完整可读） */}
    <script is:inline>
      (function () {
        var q = new URLSearchParams(location.search).get('face');
        var day = null;
        try { day = localStorage.getItem('rm-day'); } catch (e) {}
        var night = q ? q !== 'wake' : day !== '1';
        var h = document.documentElement;
        h.dataset.face = night ? 'dream' : 'wake';
        if (!h.classList.contains('booted')) h.classList.add('booting');
        // 阅读设置（工具栏「本页」里调）
        try {
          var s = localStorage.getItem('xm-read-size'), l = localStorage.getItem('xm-read-lead');
          if (s) h.dataset.readSize = s;
          if (l) h.dataset.readLead = l;
        } catch (e) {}
      })();
    </script>
    <style is:inline>
      html.booting body {
        background: #0c0d1b;
        overflow: hidden;
      }
      html.booting[data-face='wake'] body {
        background: #d6d5e2;
      }
      html.booting #view,
      html.booting #crumb,
      html.booting #ts,
      html.booting #ave {
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
      }
      html.booting #view,
      html.booting #view * {
        animation: none !important;
      }
      #boot-hud {
        display: none;
      }
    </style>
    <ClientRouter />
  </head>
  <body data-place={place} data-sec={sec} data-slug={slug}>
    <canvas id="g" aria-hidden="true" transition:persist="ground"></canvas>
    <div id="boot-hud" class="boot-hud" role="status" aria-live="polite" transition:persist="boot">
      <div class="boot-inner">
        <span id="boot-pct" class="boot-pct mono">0%</span>
        <div class="boot-bar" aria-hidden="true">
          <div id="boot-fill" class="boot-fill"></div>
        </div>
        <button id="boot-skip" class="boot-skip" type="button" tabindex="-1" aria-hidden="true">跳过</button>
      </div>
    </div>
    <nav id="crumb" class="mono" aria-label="位置">
      {
        place !== 'home' && (
          <>
            <a href="/" class="brand">AveritA</a>
            {sec && (
              <>
                <span class="sep">/</span>
                <a href={`/${sec}/`}>{SECS[sec].t}</a>
              </>
            )}
            {place === 'gate' && (
              <>
                <span class="sep">/</span>
                <a href="/gate/">NEXUS</a>
              </>
            )}
            {(place === 'find' || place === 'tag') && (
              <>
                <span class="sep">/</span>
                <a href="/find/">寻找</a>
              </>
            )}
          </>
        )
      }
    </nav>
    <main id="view"><slot /></main>
    <div id="chrome" transition:persist="chrome">
      <Toolstar />
      <Ave />
      <Cursor />
    </div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
