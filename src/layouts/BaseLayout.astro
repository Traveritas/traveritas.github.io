---
import '../styles/tokens.css';
import '../styles/global.css';
/* Noto Serif SC 不走 @fontsource：由 scripts/fonts.mjs 按站内实际用字自切（dev / build 前自动跑），
   产物在 public/fonts/noto-serif-sc/，下面 head 里用 <link> 引。全站只有 500 / 600 两个字重：
   写 400 的正文会匹配到 500；不要再写 300 / 700 / 900，写了也只会落到这两档。 */
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/silkscreen/400.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Seam from '../components/chrome/Seam.astro';
import Constructs from '../components/chrome/Constructs.astro';
import Eeg from '../components/chrome/Eeg.astro';
import Rail from '../components/chrome/Rail.astro';
import Gauge, { type Props as GaugeProps } from '../components/chrome/Gauge.astro';
import Hairline from '../components/chrome/Hairline.astro';
import BootVeil from '../components/chrome/BootVeil.astro';
import Cursor from '../components/chrome/Cursor.astro';
import Sound from '../components/chrome/Sound.astro';

interface Props {
  title: string;
  dreamTitle?: string;
  awayWakeTitle?: string;
  awayDreamTitle?: string;
  description?: string;
  type?: 'website' | 'article';
  /* 不给搜索引擎收录（404 这类没有固定地址的页）：输出 robots noindex，并省掉 canonical / og:url */
  noindex?: boolean;
  /* none：不画 14° 发丝线（主页故事板：脑电线自己就是那条缝） */
  seam?: 'default' | 'faint' | 'broken' | 'none';
  /* 构块场的挂法：through = z −2（默认，画在千层纸之上）；
     below = z −3（被首页千层纸遮住，滚过首屏才出现） */
  constructs?: 'through' | 'below' | 'none';
  /* 全页微温环境渐变叠加层（冷雾灰/薄暮灰紫/暖杏微温，视口固定 GPU 独立合成）：
     渲染 .page-ambient，样式在 global.css「全页微温环境微光叠加层」。
     随笔 / 项目（目录与阅读页）及瞬间页开启。 */
  ambient?: boolean;
  /* 阅读/长文页面中央线条消隐蒙版：正文列避让 14° 发丝线与脑电波（保留背景方块） */
  maskLines?: boolean;
  /* 构块场在正文列里退到约三成（配合 maskLines）：true = 目录页 container-wide 列宽；
     'narrow' = .container 列宽另加页边日期（瞬间） */
  fieldVeil?: boolean | 'narrow';
  /* 环境声的页面级电平。reading = 长文与关于这类阅读页：整支曲子退到阅读用负增益
     （量在 src/scripts/sound.ts 的 READING_TRIM_DB），别和字抢注意力 */
  bgm?: 'ambient' | 'reading';
  /* 开屏面纱：样式预览这类反复进出的工具页关掉（initBoot 找不到面纱即刻印 booted） */
  /* always：每次进入都放（主页）；true：只在会话首访放 */
  boot?: boolean | 'always';
  /* 主页整夜仪表轨（目录页 / 阅读页用 gauge） */
  rail?: { mode: 'night' };
  /* 页内导览轨（目录页 / 阅读页）：与 rail 二选一 */
  gauge?: GaugeProps;
}

const {
  title,
  dreamTitle,
  awayWakeTitle,
  awayDreamTitle,
  description = 'Traveritas 的个人网站——随笔、项目，与一些尚在成形的东西。',
  type = 'website',
  noindex = false,
  seam = 'faint',
  constructs = 'through',
  ambient = false,
  maskLines = type === 'article',
  fieldVeil = false,
  bgm,
  boot = true,
  rail,
  gauge,
} = Astro.props;

// 醒/梦双态标题推导规则（符合 AGENTS.md 核心词汇映射）
const deriveDreamTitle = (wake: string): string => {
  let dt = wake;
  dt = dt.replace(/Traveritas的个人(网站|网页)/g, 'AveritA的昼梦叙集');
  dt = dt.replace(/随笔/g, '断章');
  dt = dt.replace(/瞬间/g, '闪念');
  dt = dt.replace(/项目/g, '造物');
  dt = dt.replace(/关于/g, '此身');
  dt = dt.replace(/试验场/g, '未命名');
  dt = dt.replace(/标签「/g, '印记「');
  dt = dt.replace(/找不到这一页/g, '世界在边缘处留白');
  dt = dt.replace(/Traveritas/g, 'AveritA');
  return dt;
};

const resolvedDreamTitle = dreamTitle ?? deriveDreamTitle(title);

const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title
      data-wake={title}
      data-dream={resolvedDreamTitle}
      data-away-wake={awayWakeTitle}
      data-away-dream={awayDreamTitle}
    >{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/fonts/noto-serif-sc/font.css" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Traveritas"
      href={Astro.site ? new URL('rss.xml', Astro.site).href : '/rss.xml'}
    />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Traveritas的个人网站" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <noscript>
      <style>
        #bootveil {
          display: none;
        }
        [data-boot] {
          opacity: 1 !important;
          transform: none !important;
        }
        /* 环境声开关没有 JS 就按不动，干脆不摆出来 */
        [data-sound-toggle] {
          display: none;
        }
      </style>
    </noscript>
  </head>
  <body
    data-page-type={type}
    data-mask-lines={maskLines ? 'true' : undefined}
    data-field-veil={fieldVeil === 'narrow' ? 'narrow' : fieldVeil ? 'wide' : undefined}
    data-bgm={bgm === 'reading' ? 'reading' : undefined}
  >
    <div class="wash-backdrop" aria-hidden="true"></div>
    {/* wash-backdrop 全站常驻（z −5，7% 醒梦洗染）；page-ambient 只在传了 ambient 的页面出现 */}
    {ambient && <div class="page-ambient" aria-hidden="true" />}
    {boot && <BootVeil always={boot === 'always'} />}
    <Hairline />
    {seam !== 'none' && <Seam variant={seam} />}
    {/* 构块场与脑电同为 z −2，DOM 在前 ⇒ 脑电压在它上面 */}
    {constructs !== 'none' && <Constructs layer={constructs} />}
    <Eeg />
    {rail && <Rail {...rail} />}
    {gauge && <Gauge {...gauge} />}
    <div class="page">
      <SiteHeader />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
    <Sound />
    <Cursor />
    <script>
      import { initBoot } from '../scripts/boot';
      import { initChrome } from '../scripts/chrome';
      import { initMorph } from '../scripts/morph';
      import { initNight } from '../scripts/overnight';
      import { initBrand } from '../scripts/brand';
      import { initReality } from '../scripts/reality';
      import { initTitle } from '../scripts/title';
      import { initCursor } from '../scripts/cursor';
      import { initSound } from '../scripts/sound';
      initBoot();
      initChrome();
      initNight();
      initMorph();
      initBrand();
      initReality();
      initTitle();
      initCursor();
      initSound(); // 在 initReality 之后：开启时要按当前醒度定初始混合

      // 进页停在页头之下（p11-h 终选）：页头恰好被遮住，上滚才露出；
      // 浏览器还原了滚动位置或带锚点进入时不干预。
      // 主页首屏（千层纸）例外：整幅视口构图 + 页头为叠压式（不占布局），
      // 进页必须停在 scrollY=0，公式全部按视口坐标书写
      const siteHeader = document.querySelector('.site-header');
      if (siteHeader && !document.getElementById('ns-hero')) {
        addEventListener('load', () => {
          if (scrollY === 0 && !location.hash) {
            scrollTo({
              top: siteHeader.getBoundingClientRect().bottom + scrollY + 1,
              behavior: 'instant',
            });
          }
        });
      }
    </script>
  </body>
</html>
