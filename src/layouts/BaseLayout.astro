---
import '../styles/tokens.css';
import '../styles/global.css';
import '@fontsource/noto-serif-sc/300.css';
import '@fontsource/noto-serif-sc/500.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-serif-sc/900.css';
import '@fontsource/ibm-plex-mono/400.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Seam from '../components/chrome/Seam.astro';
import Eeg from '../components/chrome/Eeg.astro';
import Rail from '../components/chrome/Rail.astro';
import Hairline from '../components/chrome/Hairline.astro';
import BootVeil from '../components/chrome/BootVeil.astro';
import Grain from '../components/chrome/Grain.astro';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  seam?: 'default' | 'faint' | 'broken';
  rail?: {
    mode: 'night' | 'depth' | 'station';
    station: string;
    en?: string;
    depthTarget?: string;
  };
}

const {
  title,
  description = 'Traveritas 的个人网站——随笔、项目，与一些尚在成形的东西。',
  type = 'website',
  seam = 'faint',
  rail,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Traveritas"
      href={Astro.site ? new URL('rss.xml', Astro.site).href : '/rss.xml'}
    />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Traveritas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <noscript>
      <style>
        #bootveil {
          display: none;
        }
        [data-boot] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <BootVeil />
    <Hairline />
    <Grain />
    <Seam variant={seam} />
    <Eeg />
    {rail && <Rail {...rail} />}
    <div class="page">
      <SiteHeader />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script>
      import { initBoot } from '../scripts/boot';
      import { initChrome } from '../scripts/chrome';
      import { initMorph } from '../scripts/morph';
      import { initNight } from '../scripts/night';
      initBoot();
      initChrome();
      initNight();
      initMorph();
    </script>
  </body>
</html>
