---
import '../styles/tokens.css';
import '../styles/global.css';
import '@fontsource/noto-serif-sc/300.css';
import '@fontsource/noto-serif-sc/500.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-serif-sc/900.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/silkscreen/400.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Seam from '../components/chrome/Seam.astro';
import Eeg from '../components/chrome/Eeg.astro';
import Rail from '../components/chrome/Rail.astro';
import Hairline from '../components/chrome/Hairline.astro';
import BootVeil from '../components/chrome/BootVeil.astro';
import NightVeil from '../components/chrome/NightVeil.astro';
import Grain from '../components/chrome/Grain.astro';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  seam?: 'default' | 'faint' | 'broken';
  rail?: {
    mode: 'night' | 'depth' | 'station';
    station: string;
    en?: string;
    depthTarget?: string;
    /* depth 模式夜内时钟（透传 Rail：阅读进度在 fromMin→fromMin+durMin 爬行） */
    readout?: { fromMin: number; durMin: number; stage: string };
  };
}

const {
  title,
  description = 'Traveritas 的个人网站——随笔、项目，与一些尚在成形的东西。',
  type = 'website',
  seam = 'faint',
  rail,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Traveritas"
      href={Astro.site ? new URL('rss.xml', Astro.site).href : '/rss.xml'}
    />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Traveritas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <noscript>
      <style>
        #bootveil {
          display: none;
        }
        [data-boot] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <BootVeil />
    <NightVeil />
    <Hairline />
    <Grain />
    <Seam variant={seam} />
    <Eeg />
    {rail && <Rail {...rail} />}
    <div class="page">
      <SiteHeader />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script>
      import { initBoot } from '../scripts/boot';
      import { initChrome } from '../scripts/chrome';
      import { initMorph } from '../scripts/morph';
      import { initNight } from '../scripts/night';
      import { initBrand } from '../scripts/brand';
      import { initReality } from '../scripts/reality';
      initBoot();
      initChrome();
      initNight();
      initMorph();
      initBrand();
      initReality();

      // 进页停在页头之下（p11-h 终选）：页头恰好被遮住，上滚才露出；
      // 浏览器还原了滚动位置或带锚点进入时不干预。
      // 主页首屏（千层纸）例外：整幅视口构图 + 页头为叠压式（不占布局），
      // 进页必须停在 scrollY=0，公式全部按视口坐标书写
      const siteHeader = document.querySelector('.site-header');
      if (siteHeader && !document.getElementById('ns-hero')) {
        addEventListener('load', () => {
          if (scrollY === 0 && !location.hash) {
            scrollTo({
              top: siteHeader.getBoundingClientRect().bottom + scrollY + 1,
              behavior: 'instant',
            });
          }
        });
      }
    </script>
  </body>
</html>
