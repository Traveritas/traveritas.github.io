---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="关于 — Traveritas"
  description="关于 Traveritas、这个网站与「醒梦」"
  maskLines={true}
  bgm="reading"
  rail={{ mode: 'station', station: '关于 · 晨醒', en: 'PRESENCE' }}
>
  <div class="container page-body about-body">
    <header class="page-head about-head">
      <div class="verdict">
        <span class="vtag cool">存在于此 · PRESENCE</span>
      </div>
      <h1 data-morph data-true="关于" data-dream="此身">关于</h1>
      <div class="about-meta mono">
        <span class="about-clock" data-morph data-clock aria-label="当前时刻">--:--</span>
        <span class="meta-sep">·</span>
        <span data-morph data-true="06:31 · 晨醒 · β 波" data-dream="25:61 · 异相 · 眼动">06:31 · 晨醒 · β 波</span>
      </div>
    </header>

    <div class="prose about-prose">
      <section class="about-section">
        <p class="lead-line" data-morph data-true="我是 Traveritas。" data-dream="我是 Traveritas。">
          我是 Traveritas。
        </p>
        <p data-morph data-true="做一些安静的软件与界面。偏爱轻盈的秩序、留白充裕的版面，以及能在时间里留存得久一点的事物。" data-dream="“此身如水汽，随夜色聚形，在晨光里渐渐透明。”凡无法言说的，便在留白处长久悬停。">
          做一些安静的软件与界面。偏爱轻盈的秩序、留白充裕的版面，以及能在时间里留存得久一点的事物。
        </p>
      </section>

      <section class="about-section">
        <blockquote class="about-quote">
          <p data-morph data-true="在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？" data-dream="“在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？”">
            在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？
          </p>
        </blockquote>
        <p data-morph data-true="这个站点遵循一种介于清醒与残影之间的感知——「醒梦」：低饱和的微温、磨砂玻璃般的质感，以及充足的呼吸空间。全站纯静态生成，内容页不依赖任何客户端脚本，源码完全公开。" data-dream="万物脱离既定的语境，漂浮在微光中。凡能够被构想的，终将被建造；当晨光照亮纯净的页面，一切繁复皆归于澄澈。">
          这个站点遵循一种介于清醒与残影之间的感知——「醒梦」：低饱和的微温、磨砂玻璃般的质感，以及充足的呼吸空间。全站纯静态生成，内容页不依赖任何客户端脚本，源码完全公开。
        </p>
      </section>

      <section class="about-section about-signals">
        <p class="signal-title mono" data-morph data-true="出口 · 联络" data-dream="现实的信标">
          出口 · 联络
        </p>
        <ul class="signal-list">
          <li>
            <a href="https://github.com/Traveritas" target="_blank" rel="noopener noreferrer">
              <span class="sig-name">GitHub</span>
              <span class="sig-addr mono">github.com/Traveritas</span>
              <span class="sig-desc mono" data-morph data-true="日常行迹" data-dream="造物与代码">日常行迹</span>
            </a>
          </li>
          <li>
            <a href="/rss.xml">
              <span class="sig-name">RSS</span>
              <span class="sig-addr mono">/rss.xml</span>
              <span class="sig-desc mono" data-morph data-true="静默投递" data-dream="随笔订阅">静默投递</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/Traveritas/traveritas.github.io" target="_blank" rel="noopener noreferrer">
              <span class="sig-name">源码</span>
              <span class="sig-addr mono">traveritas.github.io</span>
              <span class="sig-desc mono" data-morph data-true="公开仓库" data-dream="开放源码">公开仓库</span>
            </a>
          </li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about-body {
    max-width: min(100% - 3rem, 42rem);
    margin-inline: auto;
  }

  .about-head {
    position: relative;
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }

  .verdict {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 0.85rem;
    margin-bottom: 1.2rem;
  }

  .vtag {
    --vt: color-mix(in srgb, var(--wake) 15%, var(--fg) 85%);
    color: var(--vt);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    padding: 0.3rem 0.6rem 0.26rem;
    border: 1px solid color-mix(in srgb, var(--vt) 45%, transparent);
    white-space: nowrap;
  }

  .vword {
    font-size: 0.84rem;
    letter-spacing: 0.08em;
    color: var(--fg-soft);
  }

  .about-head h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.15;
    margin: 0 0 0.85rem;
  }

  .about-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem 0.65rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--fg-soft);
  }

  .meta-sep {
    opacity: 0.35;
  }

  .about-prose {
    display: flex;
    flex-direction: column;
  }

  .about-section + .about-section {
    margin-top: clamp(2.4rem, 5vh, 3.4rem);
    padding-top: clamp(2rem, 4.5vh, 3rem);
    border-top: 1px solid var(--line);
  }

  .lead-line {
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--fg);
    margin-bottom: 0.75rem;
  }

  .about-section p {
    font-size: 1.02rem;
    line-height: 2.1;
    letter-spacing: 0.03em;
    color: var(--fg);
    margin: 0;
  }

  .about-section p + p {
    margin-top: 1.1rem;
  }

  .about-quote {
    margin: 0 0 1.3rem;
    padding: 0.5rem 0 0.5rem 1.4rem;
    border-left: 2px solid var(--amber);
    background: transparent;
  }

  .about-quote p {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 500;
    line-height: 1.85;
    color: var(--fg);
    letter-spacing: 0.04em;
  }

  .about-signals {
    padding-top: 0.5rem;
  }

  .signal-title {
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    color: var(--fg-soft);
    margin-bottom: 1.1rem !important;
  }

  .signal-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .signal-list li {
    border-bottom: 1px solid var(--line);
  }

  .signal-list li:first-child {
    border-top: 1px solid var(--line);
  }

  .signal-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0.2rem;
    text-decoration: none;
    color: var(--fg);
    transition: padding-left 0.2s ease, color 0.2s ease;
  }

  .signal-list a:hover {
    padding-left: 0.4rem;
    color: var(--amber);
  }

  .sig-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .sig-addr {
    font-size: 0.78rem;
    color: var(--fg-soft);
    letter-spacing: 0.06em;
  }

  .sig-desc {
    font-size: 0.72rem;
    color: var(--fg-soft);
    letter-spacing: 0.12em;
    margin-left: auto;
  }

  @media (max-width: 38em) {
    .signal-list a {
      flex-wrap: wrap;
      gap: 0.3rem 0.8rem;
    }

    .sig-desc {
      width: 100%;
      margin-left: 0;
      opacity: 0.85;
    }
  }
</style>
