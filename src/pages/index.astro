---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShardMark from '../components/ShardMark.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', (a) => !a.data.draft))
  .map(({ id, data }) => ({ id, ...data }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const manifesto = '这里不是梦，也不是现实。它是人在即将醒来时，看见的最后一层世界。';
---

<BaseLayout title="Traveritas" description={manifesto}>
  <!-- ═══ 封面：醒/梦边界世界（融合方案） ═══
       结构：对角轴线底色 → 文字碎片层 → 骑跨边界的巨构水晶（醒侧晶面清晰、梦侧磨砂）
             → 现实锚点照片 → 竖排导航。Phase 3 将把磨砂碎块升级为穿插式 3D。 -->
  <section class="cover">
    <a class="brand" href="/">
      <ShardMark />
      <span>Traveritas</span>
    </a>

    <nav class="nav" aria-label="站内入口">
      <a href="/articles/">随笔</a>
      <a href="/projects/">项目</a>
      <a href="/about/">关于</a>
    </nav>

    <!-- 巨构：骑跨醒梦边界的水晶（醒侧清晰晶面，梦侧磨砂） -->
    <div class="mega" aria-hidden="true">
      <div class="mega-shape">
        <div class="mega-dream"></div>
      </div>
      <svg viewBox="0 0 100 170" preserveAspectRatio="none">
        <!-- 醒侧晶面：不同透明度的面，伪造折射 -->
        <path d="M30 0 L84 10 L50 70 Z" fill="rgba(255,255,255,0.10)"/>
        <path d="M84 10 L102 48 L50 70 Z" fill="rgba(169,189,201,0.16)"/>
        <path d="M4 66 L50 70 L16 130 Z" fill="rgba(216,196,201,0.10)"/>
        <path d="M50 70 L94 124 L56 158 L16 130 Z" fill="rgba(255,255,255,0.06)"/>
        <path d="M50 70 L102 48 L94 124 Z" fill="rgba(169,189,201,0.12)"/>
        <!-- 晶面细线（不随视口缩放的 1px） -->
        <g stroke="rgba(76,106,128,0.30)" stroke-width="1" fill="none" vector-effect="non-scaling-stroke">
          <path d="M30 0 L84 10 L102 48 L94 124 L56 158 L16 130 L4 66 Z"/>
          <path d="M50 70 L30 0 M50 70 L102 48 M50 70 L16 130 M50 70 L56 158"/>
        </g>
        <!-- 错位晶面：不属于整体晶面规律的虚线，制造"似乎有规则却无法理解" -->
        <path d="M10 100 L72 28" stroke="rgba(76,106,128,0.26)" stroke-width="1"
              stroke-dasharray="3 4" fill="none" vector-effect="non-scaling-stroke"/>
      </svg>
    </div>

    <!-- 宣言：拆成文字碎片，末句没入巨构的磨砂侧 -->
    <h1 class="frag-set" aria-label={manifesto}>
      <span class="frags" aria-hidden="true">
        <span class="frag fx1">这里不是梦，</span>
        <span class="frag fx2">也不是现实。</span>
        <span class="frag fx3">它是人在即将醒来时，</span>
        <span class="frag fx4">看见的最后一层世界。</span>
      </span>
    </h1>

    <!-- 现实锚点：贴在巨构醒侧的一枚小照片（占位，将来换真照片） -->
    <figure class="anchor">
      <img src="https://picsum.photos/seed/xingmeng-anchor/400/500" alt="" loading="lazy" />
    </figure>
  </section>

  <!-- ═══ 封面之下：最近的随笔 ═══ -->
  <section class="recent container">
    <h2>最近的随笔</h2>
    <ul class="ledger">
      {
        articles.map((a) => (
          <li>
            <a href={`/articles/${a.id}/`}>
              <span class="ledger-date">{fmt(a.date)}</span>
              <span>
                <span class="ledger-title">{a.title}</span>
                {a.description && <span class="ledger-desc">{a.description}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="recent-more"><a href="/articles/">全部随笔</a></p>
  </section>
</BaseLayout>

<style>
  /* ── 封面世界 ── */
  .cover {
    position: relative;
    min-height: 100dvh;
    overflow: clip;
    /* 醒/梦对角轴线：左上冷雾，右下暖粉，无硬边界 */
    background:
      radial-gradient(66vw 62vh at 6% 4%, rgba(169, 189, 201, 0.24), transparent 70%),
      linear-gradient(118deg,
        rgba(169, 189, 201, 0.16) 0%,
        rgba(169, 189, 201, 0.04) 30%,
        rgba(216, 196, 201, 0.10) 52%,
        rgba(216, 196, 201, 0.26) 100%),
      var(--paper);
  }

  /* 站名 */
  .brand {
    position: absolute;
    top: 4.5vh;
    left: 4vw;
    z-index: 6;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }

  .brand :global(svg) { width: 16px; height: 16px; color: var(--mist-ink); }

  /* 竖排导航（单列，短线引向内容） */
  .nav {
    position: absolute;
    left: 3.5vw;
    top: 26vh;
    z-index: 6;
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
  }

  .nav a {
    position: relative;
    writing-mode: vertical-rl;
    letter-spacing: 0.5em;
    padding: 0.5rem 0.75rem;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .nav a::after {
    content: '';
    position: absolute;
    top: 45%;
    left: calc(100% + 0.4rem);
    width: 1.4rem;
    height: 1px;
    background: var(--line);
    transition: background 0.18s ease, width 0.18s ease;
  }

  .nav a:hover { color: var(--ink); }
  .nav a:hover::after { background: var(--mist); width: 2rem; }

  /* 巨构水晶：切出画面上缘与右缘，骑跨边界 */
  .mega {
    position: absolute;
    top: -10vh;
    right: -6vw;
    width: 56vw;
    height: 112vh;
    z-index: 3;
    pointer-events: none;
  }

  .mega svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* 梦侧磨砂：剪影内右半起雾（clip-path div，避免 foreignObject 的 Safari 问题） */
  .mega-shape {
    position: absolute;
    inset: 0;
    clip-path: polygon(30% 0%, 84% 5.9%, 102% 28.2%, 94% 72.9%, 56% 92.9%, 16% 76.5%, 4% 38.8%);
  }

  .mega-dream {
    position: absolute;
    inset: 0;
    clip-path: polygon(46% 0%, 100% 0%, 100% 100%, 46% 100%);
    background: linear-gradient(to right, rgba(233, 222, 225, 0.05), rgba(233, 222, 225, 0.3));
    backdrop-filter: blur(9px) saturate(1.05);
    -webkit-backdrop-filter: blur(9px) saturate(1.05);
  }

  /* 文字碎片层（巨构之下，末句没入磨砂） */
  .frag-set {
    margin: 0;
    padding: 0;
    font-weight: inherit;
  }

  .frags {
    position: absolute;
    inset: 0;
    display: block;
  }

  .frag {
    position: absolute;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--ink);
    z-index: 2;
  }

  /* 尺寸用 vw 与巨构边缘（同为 vw）保持稳定的空间关系 */
  .fx1 { top: 15vh; left: 9vw; font-size: max(1.9rem, 4.6vw); }

  .fx2 {
    top: 24vh; left: 46vw;
    font-size: max(0.95rem, 1.5vw);
    font-weight: 500;
    letter-spacing: 0.35em;
    color: var(--ink-faint);
  }

  .fx3 {
    top: 52vh; left: 12vw;
    font-size: max(0.95rem, 1.6vw);
    font-weight: 500;
    color: var(--ink-soft);
  }

  .fx4 {
    top: 61vh; left: 22vw;
    font-size: max(1.7rem, 3.6vw);
  }

  .fx4 em { font-style: normal; color: var(--mist-ink); }

  /* 现实锚点照片：贴在巨构醒侧 */
  .anchor {
    position: absolute;
    top: 24vh;
    right: 30vw;
    z-index: 4;
    margin: 0;
    padding: 6px;
    background: rgba(255, 255, 255, 0.74);
    transform: rotate(1deg);
  }

  .anchor img {
    display: block;
    width: 10vw;
    min-width: 110px;
    max-width: 170px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(0.85) contrast(0.88) opacity(0.82);
  }

  /* ── 封面之下：最近随笔（沿用站点 ledger 语言） ── */
  .recent {
    padding-block: clamp(3rem, 8vh, 5rem) var(--gap-v);
  }

  .recent h2 {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--ink-soft);
    margin: 0 0 1.2rem;
  }

  .recent-more { margin-top: 1.4rem; font-size: 0.9rem; }

  /* 透明度敏感回退 */
  @media (prefers-reduced-transparency: reduce) {
    .mega-dream {
      background: rgba(233, 222, 225, 0.72);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  /* 矮视口：允许滚动并收小碎片，避免互相碰撞 */
  @media (max-height: 640px) {
    .cover { min-height: 118dvh; }
    .fx1 { font-size: max(1.7rem, 4vw); }
    .fx4 { font-size: max(1.5rem, 3.1vw); top: 58vh; }
  }

  /* 窄屏：碎片收拢为纵向流，巨构退为顶部背景 */
  @media (max-width: 760px) {
    .cover {
      min-height: 100dvh;
      padding: 26vh 9vw 10vh;
    }

    .mega {
      top: -4vh;
      right: -30vw;
      width: 96vw;
      height: 58vh;
    }

    .anchor {
      position: static;
      margin: 3rem auto 0;
    }

    .frags { position: static; }

    .frag { position: static; display: block; margin: 0 0 2rem; }

    .fx1 { font-size: clamp(1.5rem, 7vw, 2rem); }
    .fx2 { font-size: 0.95rem; letter-spacing: 0.35em; color: var(--ink-faint); }
    .fx3 { font-size: 1rem; color: var(--ink-soft); }
    .fx4 { font-size: clamp(1.4rem, 6.8vw, 1.9rem); }
    .fx4 em { color: inherit; }

    .nav {
      position: static;
      margin: 2rem 0 0;
      flex-direction: row;
      gap: 1.8rem;
    }

    .nav a { writing-mode: horizontal-tb; letter-spacing: 0.2em; }
    .nav a::after { display: none; }
  }
</style>
