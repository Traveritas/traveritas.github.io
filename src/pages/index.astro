---
/* ─────────────────────────────────────────────────────────────
   主页 · 一根线的一夜（故事板）—— 定稿自 design/mocks/p25-thread-storyboard.html
   （五幕骨架）+ p27-membrane-glyphs.html（开屏「膜」与渐变字形）。
   · 五幕 = 五个 sticky 舞台（入夜 / 断章 / 造物 / 闪念 / 晨醒），相邻两幕首尾叠一屏；
     滚动写各幕的 --p，编排全在 CSS 里对 --p 的 calc。
   · 背景的脑电线就是全站那条线（同一套 eeg-wave 算法、同一个 Worker），只是在主页
     沿一条随幕变化的骨架走：开屏是过中心的 14° 直线，往下弯成竖线，晨醒拐成底线。
   · 驱动脚本：src/scripts/home-storyboard.ts。旧主页（千层纸）存档在 /legacy/。
   ───────────────────────────────────────────────────────────── */
import BaseLayout from '../layouts/BaseLayout.astro';
import RealityGuide from '../components/home/RealityGuide.astro';
import { getCollection } from 'astro:content';

const byDate = <T extends { id: string; data: { date: Date } }>(a: T, b: T) =>
  b.data.date.valueOf() - a.data.date.valueOf() || b.id.localeCompare(a.id);

const allArticles = (await getCollection('articles', (a) => !a.data.draft)).sort(byDate);
const allProjects = (await getCollection('projects', (p) => !p.data.draft)).sort(byDate);
const allMoments = (await getCollection('moments', (m) => !m.data.draft)).sort(byDate);

const articles = allArticles.slice(0, 3);
const projects = allProjects.slice(0, 3);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const fmtShort = (d: Date) => `${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const fmtMomentTime = (d: Date) =>
  `${fmtShort(d)} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;

/* 八阶成形 / 浮现度 */
const depthOf = (status: string) => ({ 构想中: 2, 进行中: 5, 已完成: 8 })[status] ?? 3;
const repoOf = (links: { href: string }[]) => links.some((l) => /^https:\/\/github\.com\//.test(l.href));

/* 闪念摘句：去掉两态块与行内语法，只留醒面文字 */
function snippet(md: string, maxLen = 64): string {
  const clean = md
    .replace(/:::(dream|wake)[\s\S]*?:::/g, '')
    .replace(/^#{1,6}\s+.+$/gm, '')
    .replace(/\[\[([^|[\]]+)\|([^|[\]]+)\]\]/g, '$1')
    .replace(/\(\(([^()|]+)(\|[^()]*)?\)\)/g, '$1')
    .replace(/\{\{([^{}|]+)(\|[^{}]*)?\}\}/g, '$1')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`#>-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return clean.length <= maxLen ? clean : clean.slice(0, maxLen).trim() + '…';
}

/* 闪念：最多 7 张，沿幕内进度等距闪现，左右交错挂在线两侧 */
const SLIP_POS = [
  ['16vw', '34svh', '-1deg'],
  ['60vw', '26svh', '.9deg'],
  ['18vw', '58svh', '.7deg'],
  ['62vw', '52svh', '-.8deg'],
  ['14vw', '40svh', '1.2deg'],
  ['60vw', '40svh', '-1deg'],
  ['18vw', '30svh', '.6deg'],
];
const moments = allMoments.slice(0, 7).map((m, i, arr) => ({
  id: m.id,
  title: m.data.title,
  tag: m.data.tags[0],
  time: fmtMomentTime(m.data.date),
  text: snippet(m.body ?? ''),
  c: (0.16 + (i * 0.72) / Math.max(1, arr.length - 1)).toFixed(3),
  pos: SLIP_POS[i],
}));

const exits = [
  { name: 'GitHub', href: 'https://github.com/Traveritas', addr: 'github.com/Traveritas', external: true },
  { name: '本站源码', href: 'https://github.com/Traveritas/traveritas.github.io', addr: 'traveritas.github.io', external: true },
  { name: 'RSS', href: '/rss.xml', addr: '/rss.xml', external: false },
  { name: '关于此处 →', href: '/about/', addr: '/about/', external: false },
];

const manifesto = '在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？';
---

<BaseLayout
  title="Traveritas的个人网页"
  dreamTitle="AveritA的昼梦叙集"
  description={manifesto}
  seam="none"
  constructs="none"
  rail={{ mode: 'night' }}
>
  <!-- 字形外扩轮廓：字形 alpha 向外膨胀两档之差 ＝ 一圈离开笔画约 5px 的细线 -->
  <svg class="defs" width="0" height="0" aria-hidden="true">
    <filter id="ring-w" x="-5%" y="-5%" width="110%" height="110%">
      <feMorphology in="SourceAlpha" operator="dilate" radius="6" result="a"></feMorphology>
      <feMorphology in="SourceAlpha" operator="dilate" radius="4.8" result="b"></feMorphology>
      <feComposite in="a" in2="b" operator="out" result="r"></feComposite>
      <feFlood flood-color="#232830"></feFlood>
      <feComposite in2="r" operator="in"></feComposite>
    </filter>
    <filter id="ring-d" x="-5%" y="-5%" width="110%" height="110%">
      <feMorphology in="SourceAlpha" operator="dilate" radius="7" result="a"></feMorphology>
      <feMorphology in="SourceAlpha" operator="dilate" radius="5.6" result="b"></feMorphology>
      <feComposite in="a" in2="b" operator="out" result="r"></feComposite>
      <feFlood flood-color="#b88560"></feFlood>
      <feComposite in2="r" operator="in"></feComposite>
    </filter>
  </svg>

  <div class="atmo" aria-hidden="true">
    <div class="fog f1"></div>
    <div class="fog f2"></div>
    <div class="dawnlight"></div>
  </div>

  <div class="home">
    <!-- ═══ 场 0 · 23:07 入夜：线是醒与梦之间的一层膜 ═══ -->
    <section class="scene s-hero" id="ns-hero" data-scene="0" style="--len:230svh">
      <div class="stage">
        <p class="sr-only">Traveritas的个人网页 —— 随笔、项目，与正在成形的东西。</p>
        <div class="gpair" aria-hidden="true">
          <div class="gw gw-wake" data-side="-1">
            <span class="ghost">醒</span>
            <span class="crisp"><i class="pa">醒</i><i class="pc">醒</i><i class="pb">醒</i></span>
          </div>
          <div class="gw gw-dream" data-side="1">
            <span class="ghost">梦</span>
            <span class="crisp"><i class="pa">梦</i><i class="pc">梦</i><i class="pb">梦</i></span>
          </div>
        </div>
        <h1 class="hero-line" id="hero-line">
          在即将醒来的那一瞬，<br />世界究竟是在<em>成形</em>，还是正在<em>融化</em>？
        </h1>
        <RealityGuide />
      </div>
    </section>

    <!-- ═══ 场 1 · 浅梦 · 断章：线在左，三篇同屏 ═══ -->
    <section class="scene s-essays side" id="ns-essays" data-scene="1" style="--len:280svh">
      <div class="stage">
        <div class="chap in-out">
          <span class="cap">浅梦 · 23:19 — 01:11</span>
          <h2>断章</h2>
        </div>
        <div class="essays">
          {
            articles.map((a, j) => (
              <a class="essay" href={`/articles/${a.id}/`} style={`--j:${j}`}>
                <span class="no">{String(j + 1).padStart(2, '0')}</span>
                <div>
                  <span class="meta">{[fmt(a.data.date), ...a.data.tags].join(' · ')}</span>
                  <h3>{a.data.title}</h3>
                  {a.data.description && <p>{a.data.description}</p>}
                </div>
              </a>
            ))
          }
          <div class="more"><a class="all" href="/articles/">全部断章 →</a></div>
        </div>
      </div>
    </section>

    <!-- ═══ 场 2 · 深眠 · 造物：同断章，线在左，晶板从右侧浮现 ═══ -->
    <section class="scene s-projects side" id="ns-projects" data-scene="2" style="--len:320svh">
      <div class="stage">
        <div class="chap in-out">
          <span class="cap">深眠 · 01:11 — 02:08</span>
          <h2>造物</h2>
        </div>
        <div class="slabs">
          {
            projects.map((p, j) => {
              const depth = depthOf(p.data.status);
              const repo = repoOf(p.data.links);
              return (
                <a class="slab" href={`/projects/${p.id}/`} style={`--j:${j};--depth:${depth}`}>
                  <div class="win">
                    <svg data-lily={3 + j * 4} viewBox="-100 -100 200 200" preserveAspectRatio="xMidYMid slice" />
                    <div class="fogv" />
                  </div>
                  <div class="slab-body">
                    <div class="slab-head">
                      <span>{fmt(p.data.date)}</span>
                      <span>{p.data.status}</span>
                    </div>
                    <div>
                      <h3>{p.data.title}</h3>
                      {p.data.description && <p>{p.data.description}</p>}
                    </div>
                    <div class="depth">
                      <span>
                        浮现度 <b>{depth}</b>/8
                      </span>
                      <span>{repo ? '✓ 公开仓库' : '○ 暂无公开'}</span>
                    </div>
                  </div>
                </a>
              );
            })
          }
          <div class="more"><a class="all" href="/projects/">全部造物 →</a></div>
        </div>
      </div>
    </section>

    <!-- ═══ 场 3 · 异相 · 闪念：线居中，便签左右交错闪现 ═══ -->
    <section class="scene s-rem" id="ns-rem" data-scene="3" style="--len:380svh">
      <div class="stage" data-w0=".09" data-w1=".16">
        <div class="chap in-out">
          <h2>闪念</h2>
          <span class="cap">异相 · 02:08 — 04:59</span>
        </div>
        {
          moments.map((m) => (
            <a
              class="slip"
              href={`/moments/#${m.id}`}
              data-c={m.c}
              style={`--x:${m.pos[0]};--y:${m.pos[1]};--tilt:${m.pos[2]}`}
            >
              <span class="h">
                <span>{m.time}</span>
                {m.tag && <em>#{m.tag}</em>}
              </span>
              {m.title && <b>{m.title}</b>}
              <span class="t">{m.text}</span>
            </a>
          ))
        }
        <div class="more in-out"><a class="all" href="/moments/">全部闪念 →</a></div>
      </div>
    </section>

    <!-- ═══ 场 4 · 06:31 晨醒：线从左上垂下、拐成标题下的底线 ═══ -->
    <section class="scene s-dawn" id="ns-dawn" data-scene="4" style="--len:200svh">
      <div class="stage">
        <div class="d-head dz">
          <div class="time">06:31 · 晨光</div>
          <h2
            data-morph
            data-faces="注视持续得太久。被注视之物微微退开。|在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？|世界随时可能消失，又随时重新被记起。"
          >
            注视持续得太久。被注视之物微微退开。
          </h2>
        </div>
        <div class="d-body dz">
          <div class="exits">
            {
              exits.map((x) => (
                <a href={x.href} target={x.external ? '_blank' : undefined} rel={x.external ? 'noopener' : undefined}>
                  {x.name}
                  <small>{x.addr}</small>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 目录（常规文档流） ═══ -->
    <section class="dir">
      <div class="index">
        <div>
          <h4><a href="/articles/">断章</a></h4>
          <ul>
            {
              allArticles.slice(0, 6).map((a) => (
                <li>
                  <a href={`/articles/${a.id}/`}>
                    {a.data.title}
                    <span>{fmtShort(a.data.date)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h4><a href="/projects/">造物</a></h4>
          <ul>
            {
              allProjects.slice(0, 6).map((p) => (
                <li>
                  <a href={`/projects/${p.id}/`}>
                    {p.data.title}
                    <span>{depthOf(p.data.status)}/8</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h4><a href="/moments/">闪念</a></h4>
          <ul>
            {
              allMoments.slice(0, 3).map((m) => (
                <li>
                  <a href={`/moments/#${m.id}`}>
                    {m.data.title ?? snippet(m.body ?? '', 14)}
                    <span>{fmtShort(m.data.date)}</span>
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/moments/">全部闪念 →<span></span></a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initStoryboard } from '../scripts/home-storyboard';

  /* 晶板窗口里的抽象百合（花瓣长度 / 开角抖动，避免机械放射对称） */
  let seed = 1;
  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  document.querySelectorAll<SVGSVGElement>('svg[data-lily]').forEach((svg) => {
    const id = svg.dataset.lily ?? '3';
    seed = Number(id) * 997;
    let out = `<defs><radialGradient id="pg${id}"><stop offset="0" stop-color="#f3e6d6" stop-opacity=".55"/><stop offset="1" stop-color="#a9b8d6" stop-opacity=".08"/></radialGradient></defs>`;
    const k = 5 + Math.floor(rnd() * 2);
    const rot0 = rnd() * 60;
    for (let i = 0; i < k; i++) {
      const a = rot0 + (i * 360) / k + (rnd() - 0.5) * 22;
      const L = 62 + rnd() * 26;
      const w = 16 + rnd() * 10;
      const bend = (rnd() - 0.5) * 18;
      out += `<path transform="rotate(${a.toFixed(1)})" d="M0 0 C ${w} ${-L * 0.3}, ${w * 0.6 + bend} ${-L * 0.85}, ${bend} ${-L} C ${-w * 0.6 + bend} ${-L * 0.85}, ${-w} ${-L * 0.3}, 0 0Z" fill="url(#pg${id})" stroke="#e6ecf7" stroke-opacity=".45" stroke-width=".8"/>`;
    }
    svg.innerHTML = out + '<circle r="5" fill="#d9a05b" fill-opacity=".7"/>';
  });

  initStoryboard();
</script>

<style is:global>
  /* 主页文字不参与选择（入口/链接照常可点）——长按入梦可从任意文字处起手 */
  html body {
    user-select: none;
    -webkit-user-select: none;
  }

  /* 页头叠压首屏（其余页维持文档流页头） */
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
  }

  .defs {
    position: absolute;
  }

  .home .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── 环境层：雾 / 晨光（取代构块场） ── */
  .atmo {
    position: fixed;
    inset: 0;
    z-index: -3;
    pointer-events: none;
    overflow: hidden;
  }
  .atmo .fog {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow, rgba(255, 255, 255, 0.75)), transparent);
  }
  .atmo .f1 {
    width: 70vmax;
    height: 50vmax;
    left: -20vmax;
    top: -12vmax;
    animation: home-fog1 38s ease-in-out infinite alternate;
  }
  .atmo .f2 {
    width: 60vmax;
    height: 44vmax;
    right: -22vmax;
    bottom: -14vmax;
    animation: home-fog2 46s ease-in-out infinite alternate;
  }
  @keyframes home-fog1 {
    to {
      transform: translate3d(8vmax, 6vmax, 0);
    }
  }
  @keyframes home-fog2 {
    to {
      transform: translate3d(-10vmax, -4vmax, 0);
    }
  }
  .atmo .dawnlight {
    position: absolute;
    inset: -10% -10% auto;
    height: 90%;
    opacity: var(--dawn, 0);
    background: radial-gradient(60% 70% at 50% 0%, rgba(255, 214, 160, 0.55), rgba(255, 232, 205, 0.2) 45%, transparent 75%);
  }

  /* ── 场与舞台 ── */
  .home .scene {
    position: relative;
    height: var(--len);
  }
  /* 相邻两幕首尾叠一屏：上一幕舞台离开的同时下一幕舞台已钉住 */
  .home .scene + .scene {
    margin-top: -100svh;
  }
  .home .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .home .cap {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    color: var(--fg-soft);
  }
  .home .in-out {
    opacity: calc(clamp(0, calc(var(--p) / 0.08), 1) * clamp(0, calc((1 - var(--p)) / 0.08), 1));
  }
  .home .all {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.18em;
    border-bottom: 1px solid var(--amber);
    padding-bottom: 3px;
    text-decoration: none;
    color: var(--fg);
  }
  .home a {
    text-decoration: none;
  }

  /* 窗口函数：--c 为本镜中心，--w0 全显半宽，--w1 消失半宽 */
  .home [data-c] {
    --d: calc(var(--p) - var(--c));
    --ad: max(var(--d), calc(var(--d) * -1));
    --a: clamp(0, calc((var(--w1) - var(--ad)) / (var(--w1) - var(--w0))), 1);
    /* 浮走方向：还没到本镜中心（--d < 0）＝ +1（从下方浮上）；过了中心 ＝ −1（继续向上浮走） */
    --dir: clamp(-1, calc(var(--d) * -400), 1);
    opacity: var(--a);
    pointer-events: none;
  }
  .home [data-c].on {
    pointer-events: auto;
  }

  /* ═══ 场 0 · 入夜 · 膜 ═══
     tan14° = .2493：字框中心 x 处的线高 ＝ 50svh + (x − 50vw)·tan14°（开屏姿态的线过视口中心）。
     --still（梦度，reality.ts）：梦面时膜两侧虚实互换 —— 醒变软、梦变清晰 */
  .s-hero {
    --G: min(46svh, 30vw);
    --t14: 0.2493;
  }
  .gpair {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: calc(1 - clamp(0, calc((var(--p) - 0.5) / 0.35), 1));
  }
  .gw {
    position: absolute;
    width: var(--G);
    height: var(--G);
    opacity: 0;
  }
  html.booted .gw {
    animation: home-develop 1.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .gw > span {
    position: absolute;
    inset: 0;
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--G);
    line-height: 1;
    text-align: center;
  }
  .gw i {
    position: absolute;
    inset: 0;
    display: block;
    font-style: normal;
  }
  .gw-wake {
    --cx: calc(30vw + var(--G) / 2);
    left: 30vw;
    top: calc(50svh + (var(--cx) - 50vw) * var(--t14) - var(--G) * 0.8);
    animation-delay: 0.7s !important;
  }
  .gw-dream {
    --cx: calc(55vw + var(--G) / 2);
    left: 55vw;
    top: calc(50svh + (var(--cx) - 50vw) * var(--t14) - var(--G) * 0.22);
    animation-delay: 1.05s !important;
  }
  @keyframes home-develop {
    from {
      opacity: 0;
      filter: blur(18px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }
  /* 清晰的一面（本侧）与残影（越到膜另一侧的部分）；clip-path 由脚本按主波路径写入 */
  .gw .crisp,
  .gw .ghost {
    clip-path: inset(0 0 100% 0);
  }
  .gw-wake .crisp {
    filter: blur(calc(var(--still, 0) * 4.5px));
    opacity: calc(1 - var(--still, 0) * 0.45);
  }
  .gw-wake .ghost {
    color: var(--fg);
    filter: blur(9px);
    opacity: calc(0.16 + var(--still, 0) * 0.06);
  }
  .gw-dream .crisp {
    filter: blur(calc((1 - var(--still, 0)) * 1.2px));
    opacity: calc(0.9 + var(--still, 0) * 0.1);
  }
  .gw-dream .ghost {
    color: #c6a07e;
    filter: blur(9px);
    opacity: calc(0.2 - var(--still, 0) * 0.04);
  }

  /* 渐变字形：同一个字里实心与波纹沿 14° 膜的法向渐变 ——
     醒：远离膜处实心，靠近膜处化成波纹（融化）；梦：贴膜处是波纹，往下凝成实心（成形）。
