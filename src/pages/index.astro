---
import BaseLayout from '../layouts/BaseLayout.astro';
import StitchHeader from '../components/home/StitchHeader.astro';
import GlassChip from '../components/home/GlassChip.astro';
import { getCollection } from 'astro:content';
import { fmtNightTime } from '../data/night';

const articles = (await getCollection('articles', (a) => !a.data.draft))
  .map(({ id, data }) => ({ id, ...data }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects', (p) => !p.data.draft))
  .map(({ id, data }) => ({ id, ...data }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const pinsOf = (status: string) => ({ 构想中: 2, 进行中: 5, 已完成: 8 })[status] ?? 3;

/* 账目核验：仓库链接在 frontmatter 里，有即 ✓，无即 ✗ */
const repoOf = (p: (typeof projects)[number]) =>
  (p.links ?? []).some((l) => /^https:\/\/github\.com\//.test(l.href));

const manifesto = '这里不是梦，也不是现实。它是人在即将醒来时，看见的最后一层世界。';
const frags = ['这里不是梦，', '也不是现实。', '它是人在即将醒来时，', '看见的最后一层世界。'];

const seeds = [
  { name: '水面', desc: '连续域扭曲的水彩晕染，构造上不量化。', lift: 0 },
  { name: '细线', desc: '缝线与拴绳的本家，圆圈群已经醒了。', lift: 16 },
  { name: '帷幕', desc: '遮与露之间的一层，尚未开工。', lift: 6 },
  { name: '巨型空洞', desc: '尺度本身作为母题，最远的一粒。', lift: 22 },
  { name: '花', desc: '三稿未成，回炉重做。', lift: 10 },
];

const deadSeeds = [{ name: '碎块', desc: '过于规整，已否决。' }];

const wakeAnchors = [
  {
    name: 'GitHub',
    href: 'https://github.com/Traveritas',
    addr: 'github.com/Traveritas',
    why: '找我 · 醒着的时候',
    external: true,
  },
  {
    name: '本站源码',
    href: 'https://github.com/Traveritas/traveritas.github.io',
    addr: 'traveritas.github.io',
    why: '仓库 · 醒着的证据',
    external: true,
  },
  { name: 'RSS', href: '/rss.xml', addr: '/rss.xml', why: '订阅 · 梦的定期投递', external: false },
];
---

<BaseLayout
  title="Traveritas"
  description={manifesto}
  seam="default"
  rail={{ mode: 'night', station: '今夜 · 落针', en: 'FIRST STITCH' }}
>
  <div class="vignette" aria-hidden="true"></div>

  <!-- ═══ 23:07 入夜 · 首屏：醒右上 / 梦左下，贴缝线两侧；线上脑电纹理常驻浮动 ═══ -->
  <section class="hero" id="ns-hero">
    <h1 class="sr-only">Traveritas —— {manifesto}</h1>

    <span class="ghost-char" data-boot style="--bd: 1.35s" aria-hidden="true">梦</span>

    <div class="hero-chars" aria-hidden="true">
      <span class="ch ch-wake" data-boot style="--bd: 0.4s">醒</span>
      <span class="vsub" data-boot style="--bd: 0.9s">在醒与梦之间</span>
      <span class="ch ch-dream drift" data-boot style="--bd: 0.62s; --d-amp: 10px; --d-dur: 9s">梦</span>
      <span class="vlat mono" data-boot style="--bd: 1.05s">HYPNOGRAM · NIGHT 2026-09</span>
    </div>

    <div class="hero-frags" aria-hidden="true">
      {
        frags.map((f, i) => (
          <p
            class:list={['frag', `f${i + 1}`, 'ghost-pair', { 'drift-soft': i === 1 || i === 2 }]}
            data-boot
            style={`--bd: ${(0.85 + i * 0.15).toFixed(2)}s`}
          >
            <span class="ghost">{f}</span>
            {f.split('').map((ch) => (
              <span class="c">{ch}</span>
            ))}
          </p>
        ))
      }
    </div>

    <p class="hero-scroll" data-boot style="--bd: 1.6s">
      <i></i><span data-morph data-true="顺着缝线 · 过完这一夜" data-dream="顺着缝线 · 越沉越深">顺着缝线 · 过完这一夜</span>
    </p>
  </section>

  <!-- ═══ N1–N2 浅梦 · 随笔：玻璃片沿左缘短划逐级下沉；纸面标签带叠影（半醒复视） ═══ -->
  <section class="band band-essays" id="ns-essays">
    <div class="container-wide">
      <StitchHeader title="随笔" stage="浅梦 · LIGHT · N1–N2" time={`${fmtNightTime(12)} → ${fmtNightTime(124)}`} />
      <p class="verdict">
        <span class="vtag warm">半可核验 · HALF-VERIFIABLE</span>
        <span class="vword" data-morph data-true="写下时是醒的。" data-dream="读起来已像梦话。">写下时是醒的。</span>
      </p>
      <p class="band-intro" data-morph data-true="浅睡的人写字最诚实——字还没醒，替我先说了。" data-dream="浅睡的人写字最诚实——字先替我梦见了。">
        浅睡的人写字最诚实——字还没醒，替我先说了。
      </p>
      <div class="ladder">
        {
          articles.map((a, i) => {
            const label = `${fmt(a.date)} · ${a.tags.join(' · ')}`;
            return (
              <div class="rung" style={`--step: ${i * 9}`}>
                <GlassChip
                  href={`/articles/${a.id}/`}
                  title={a.title}
                  desc={a.description}
                  meta={`随笔 · ${String(i + 1).padStart(2, '0')}`}
                  style={`--tilt: ${(i % 2 === 0 ? -1.1 : 1).toString()}deg; --d-phase: ${(-i * 2.3).toString()}s`}
                />
                <p class="rung-label mono ghost-pair">
                  <span class="ghost" aria-hidden="true">{label}</span>{label}
                </p>
              </div>
            );
          })
        }
      </div>
      <p class="essay-cap">
        <span data-morph data-true="标签的重影不是印坏——半睡的眼睛，看什么都是两层。" data-dream="标签的重影是梦在临帖，总也临不像。">标签的重影不是印坏——半睡的眼睛，看什么都是两层。</span>
      </p>
      <p class="band-more"><a href="/articles/">全部随笔 · 账目</a></p>
    </div>
  </section>

  <!-- ═══ N3 深眠 · 项目：夜最深处的账目反而最醒——放宽一档、绝对静止，行尾核验 ═══ -->
  <section class="band band-projects" id="ns-projects">
    <div class="still-col">
      <StitchHeader title="项目" stage="深眠 · DEEP · N3 δ" time={`${fmtNightTime(124)} → ${fmtNightTime(181)}`} />
      <p class="verdict">
        <span class="vtag cool">可核验 · CAN VERIFY</span>
        <span class="vword" data-morph data-true="夜到最深处，账目反而最醒。" data-dream="夜到最深处，连账目都在打盹。">夜到最深处，账目反而最醒。</span>
      </p>
      <p class="waso-note">
        <span class="mono waso-tag">微觉醒 · WASO {fmtNightTime(163)}</span>
        世界应当始终保留一种感觉：它可能马上消失。
      </p>
      <ul class="ledger">
        {
          projects.map((p) => (
            <li>
              <a href={`/projects/${p.id}/`}>
                <span class="ledger-date">{fmt(p.date)}</span>
                <span>
                  <span class="ledger-title">
                    {p.title}
                    <span class="ledger-status">{p.status}</span>
                    <span class="stitch-meter" title={`第 ${pinsOf(p.status)} 针 / 八针`}>
                      {Array.from({ length: 8 }).map((_, i) => (
                        <i class:list={{ on: i < pinsOf(p.status) }} />
                      ))}
                    </span>
                  </span>
                  {p.description && <span class="ledger-desc">{p.description}</span>}
                </span>
                <span class:list={['tick', { 'tick-ok': repoOf(p), 'tick-na': !repoOf(p) }]}>
                  {repoOf(p) ? '✓ 有仓库' : '✗ 暂无'}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="band-more"><a href="/projects/">全部项目 · 账目</a></p>
    </div>
  </section>

  <!-- ═══ REM · 试验场：种子药丸浮在玻璃签四周，否决的一枚划线留在场内 ═══ -->
  <section class="band band-rem" id="ns-rem">
    <div class="container-wide">
      <StitchHeader title="试验场" stage="异相 · REM · 眼动" time={`${fmtNightTime(181)} → ${fmtNightTime(352)}`} />
      <p class="verdict">
        <span class="vtag warm">还没有 · NOT YET</span>
        <span class="vword" data-morph data-true="反复梦见的，迟早会被做出来。" data-dream="反复梦见的，就一直是梦。">反复梦见的，迟早会被做出来。</span>
      </p>
      <p class="band-intro" data-morph data-true="后半夜的长梦里，五粒母题的种子还悬着。" data-dream="后半夜的长梦里，五粒母题的种子还悬在半空。">
        后半夜的长梦里，五粒母题的种子还悬着。
      </p>
      <div class="rem-field">
        <div class="pill-field">
          {
            seeds.map((s, i) => (
              <span
                class="pill drift"
                style={`--d-amp: 6px; --d-dur: ${(6.4 + i * 0.7).toFixed(1)}s; --d-phase: ${(-i * 1.7).toFixed(1)}s; --d-rot: 0.5deg; --lift: ${s.lift}px`}
              >
                <span class="pill-skin" style={`--tilt: ${(i % 2 === 0 ? 1.2 : -0.9).toString()}deg`}>
                  <b>{s.name}</b>
                  <small>{s.desc}</small>
                </span>
              </span>
            ))
          }
          {
            deadSeeds.map((d) => (
              <span class="pill-skin dead" style="--lift: 14px">
                <b>{d.name}</b>
                <small>{d.desc}</small>
              </span>
            ))
          }
        </div>
        <div class="slip-stage">
          <div class="slip-glow" aria-hidden="true"></div>
          <canvas id="slip-canvas" aria-hidden="true"></canvas>
          <div class="slip-fallback" aria-hidden="true">
            <span class="sf-t">它可能<br />马上消失。</span>
            <span class="sf-b mono">GLASS SLIP · 玻璃签</span>
          </div>
          <p class="slip-cap mono">丝印于玻璃 · 梦侧唯一允许发光的句子</p>
        </div>
      </div>
      <p class="rem-cap">
        <span data-morph data-true="划线的一枚已否决；判定与三轮记录，都在" data-dream="划线的那枚已经醒来，其余的还梦着——见">划线的一枚已否决；判定与三轮记录，都在</span><a href="/articles/motif-exploration-log/">《母题探索记录》</a>。
      </p>
    </div>
  </section>

  <!-- ═══ 06:31 晨醒 · 关于与出口：天亮了；需要把我叫醒的话，三个锚都在 ═══ -->
  <section class="band band-dawn" id="ns-dawn">
    <div class="container">
      <StitchHeader title="关于" stage="晨醒 · WAKE · β" time={`${fmtNightTime(352)} → ${fmtNightTime(444)}`} />
      <p class="verdict verdict-center">
        <span class="vtag cool">可到达 · REACHABLE</span>
        <span class="vword" data-morph data-true="醒着的时候，都找得到我。" data-dream="梦里留的话，也有人收。">醒着的时候，都找得到我。</span>
      </p>
      <p class="dawn-time mono" data-boot style="--bd: 0.2s">06:31 · 天亮了</p>
      <div class="dawn-card">
        <p class="dawn-line" data-morph data-faces="白天，我写代码。|夜里，我造梦。|此刻，我在缝这一页。">白天，我写代码。</p>
        <p class="dawn-line" data-morph data-true="这个网站由智能体与我共同建造。" data-dream="这个网站由智能体与梦共同建造。">
          这个网站由智能体与我共同建造。
        </p>
      </div>
      <div class="wake">
        <p class="wake-head">需要把我叫醒的话</p>
        <p class="wake-sub">
          <span data-morph data-true="以下链接真实有效——梦里点，也会通。" data-dream="这些是锚点中的锚点——在梦里点，也会通。">以下链接真实有效——梦里点，也会通。</span>
        </p>
        <div class="wake-row">
          {
            wakeAnchors.map((w) => (
              <a class="wake-anchor" href={w.href} target={w.external ? '_blank' : undefined} rel={w.external ? 'noopener' : undefined}>
                <span class="wa-name">{w.name}</span>
                <span class="wa-href mono">{w.addr}</span>
                <span class="wa-why">{w.why}</span>
              </a>
            ))
          }
        </div>
      </div>
      <p class="final-line ghost-pair">
        <span class="ghost">看见的最后一层世界。</span>看见的最后一层世界。
      </p>
      <p class="band-more"><a href="/about/">关于这个网站，与我</a></p>
    </div>
  </section>
</BaseLayout>

<script>
  // 3D 懒加载：IO 优先，轮询兜底（覆盖渲染被节流、IO 回调滞后的环境）
  const lazy = (id: string, run: () => Promise<unknown>) => {
    const el = document.getElementById(id);
    if (!el) return;
    let loaded = false;
    const near = () => {
      const r = el.getBoundingClientRect();
      return r.bottom > -innerHeight && r.top < innerHeight * 2;
    };
    const load = () => {
      if (loaded) return;
      loaded = true;
      io.disconnect();
      clearInterval(timer);
      el.dataset.loading = '1';
      run()
        .then(() => {
          el.dataset.loaded = '1';
        })
        .catch((err) => {
          el.dataset.loadErr = String(err);
          /* WebGL 不可用时由静态回退接手 */
        });
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((en) => en.isIntersecting)) load();
      },
      { rootMargin: '280px' },
    );
    io.observe(el);
    const timer = setInterval(() => {
      if (near()) load();
    }, 900);
  };
  lazy('slip-canvas', () => import('../scripts/slip').then((m) => m.initSlip()));
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* 揭幕编排：booted 后逐级浮现 */
  [data-boot] {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.9s ease var(--bd, 0s),
      transform 0.9s ease var(--bd, 0s);
  }

  :global(html.booted) [data-boot] {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-boot] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* 暗角：呼吸速率随分期（night.ts 写 body[data-stage]） */
  .vignette {
    position: fixed;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: radial-gradient(120% 92% at 50% 44%, transparent 52%, rgba(8, 10, 16, 0.52) 100%);
    opacity: 0.42;
    animation: vig var(--breath, 15s) ease-in-out infinite;
  }

  @keyframes vig {
    0%,
    100% {
      opacity: 0.34;
    }
    50% {
      opacity: 0.52;
    }
  }

  :global(body[data-stage='n3']) {
    --breath: 26s;
  }

  :global(body[data-stage='rem']) {
    --breath: 8s;
  }

  @media (prefers-reduced-motion: reduce) {
    .vignette {
      animation: none;
    }
  }

  /* ── 首屏（版式随 var1：巨字贴缝线两侧，线上脑电常驻浮动） ── */
  .hero {
    --gfs: clamp(140px, 18.5vw, 240px);
    /* 缝线在视口 50vh；hero 起点在页头（约 70px）之下，换算到 hero 坐标 */
    --lineH: calc(50vh - 70px);
    --wakeTop: calc(var(--lineH) + 1.5vw - var(--gfs) - 22px);
    --dreamTop: calc(var(--lineH) + (var(--gfs) - 33vw) * 0.2493 + 26px);
    position: relative;
    min-height: calc(112dvh - 70px);
    overflow: clip;
  }

  /* 脑电纹理已提为全站常驻层（components/chrome/Eeg.astro） */

  /* 描边幽灵字（入梦检验的字线框）：半屏尺度，几乎只剩轮廓的呼吸 */
  .ghost-char {
    position: absolute;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: min(72vmin, 40rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(38, 44, 51, 0.07);
    user-select: none;
    z-index: 0;
  }

  .hero-chars .ch {
    position: absolute;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--gfs);
    line-height: 1;
    user-select: none;
    z-index: 2;
  }

  .ch-wake {
    left: 56vw;
    top: var(--wakeTop);
    color: var(--fg);
  }

  .ch-dream {
    left: 17vw;
    top: var(--dreamTop);
    color: color-mix(in srgb, var(--fg) 78%, var(--dream));
  }

  /* 竖排注：醒旁中文，梦旁拉丁（var1） */
  .vsub {
    position: absolute;
    left: calc(56vw + var(--gfs) + 26px);
    top: var(--wakeTop);
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0.52em;
    color: var(--fg-soft);
    z-index: 2;
  }

  .vlat {
    position: absolute;
    left: calc(17vw - 44px);
    top: var(--dreamTop);
    writing-mode: vertical-rl;
    font-size: 10.5px;
    letter-spacing: 0.4em;
    color: var(--fg-soft);
    opacity: 0.8;
    z-index: 2;
  }

  .hero-frags {
    position: absolute;
    left: 17vw;
    top: calc(var(--dreamTop) + var(--gfs) + 40px);
    max-width: min(42rem, 76vw);
    z-index: 2;
  }

  .frag {
    margin: 0 0 1.05rem;
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--fg);
  }

  /* 逐字微错位与局部失焦（睡眠图对宣言碎片的处理） */
  .frag .c {
    display: inline-block;
    white-space: pre;
  }

  .frag .c:nth-child(4n + 2) {
    transform: translateY(0.13em);
  }

  .frag .c:nth-child(4n + 3) {
    transform: translateY(-0.09em) rotate(0.8deg);
  }

  .frag .c:nth-child(7n + 5) {
    filter: blur(0.9px);
    opacity: 0.8;
  }

  .frag .c:nth-child(9n + 4) {
    transform: rotate(-1.1deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .frag .c {
      transform: none !important;
      filter: none !important;
      opacity: 1 !important;
    }
  }

  .f1 {
    font-size: clamp(1.4rem, 2.1vw, 1.75rem);
  }

  .f2 {
    margin-left: 9%;
    font-size: clamp(0.88rem, 1.3vw, 1rem);
    letter-spacing: 0.32em;
    color: var(--fg-soft);
  }

  .f3 {
    margin-left: 4%;
    font-size: clamp(0.88rem, 1.35vw, 1rem);
    color: var(--fg-soft);
  }

  .f4 {
    margin-left: 14%;
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
  }

  .hero-scroll {
    position: absolute;
    right: 6vw;
    /* 锚定首屏折叠线（hero 比 100dvh 高，不能用 bottom） */
    top: calc(100dvh - 70px - 7vh);
    margin: 0;
    font-size: 14px;
    font-weight: 300;
    letter-spacing: 0.26em;
    color: var(--fg-soft);
    z-index: 2;
  }

  .hero-scroll i {
    display: inline-block;
    width: 24px;
    height: 2px;
    background: var(--amber);
    opacity: 0.5;
    transform: rotate(calc(var(--seam-angle) * -1));
    vertical-align: middle;
    margin-right: 12px;
  }

  /* ── 各夜段 ── */
  .band {
    position: relative;
    padding-block: clamp(5.5rem, 13vh, 9.5rem);
  }

  /* 层级判词：一枚冷暖小签（可核验度）+ 一句随 morph 双声轨的话 */
  .verdict {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.3rem 0.85rem;
    margin: -1.1rem 0 2.2rem;
  }

  .vtag {
