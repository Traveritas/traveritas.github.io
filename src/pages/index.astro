---
import BaseLayout from '../layouts/BaseLayout.astro';
import StitchHeader from '../components/home/StitchHeader.astro';
import GlassChip from '../components/home/GlassChip.astro';
import { getCollection } from 'astro:content';
import { fmtNightTime } from '../data/night';

const articles = (await getCollection('articles', (a) => !a.data.draft))
  .map(({ id, data }) => ({ id, ...data }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects', (p) => !p.data.draft))
  .map(({ id, data }) => ({ id, ...data }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const pinsOf = (status: string) => ({ 构想中: 2, 进行中: 5, 已完成: 8 })[status] ?? 3;

/* 账目核验：仓库链接在 frontmatter 里，有即 ✓，无即 ✗ */
const repoOf = (p: (typeof projects)[number]) =>
  (p.links ?? []).some((l) => /^https:\/\/github\.com\//.test(l.href));

const manifesto = '在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？';
const frags = ['世界在此停留片刻。', '它并非梦境，', '亦非确凿之物。', '只是人在睁眼之前，最后一眼看见的明亮倒影。'];

const seeds = [
  { name: '水面', desc: '连续域扭曲的水彩晕染，构造上不量化。', lift: 0 },
  { name: '细线', desc: '微光与轮廓的边界，圆环正在聚拢。', lift: 16 },
  { name: '帷幕', desc: '遮蔽与展露之间的一层薄纱。', lift: 6 },
  { name: '巨型空洞', desc: '尺度本身作为母题，悬于视界边缘。', lift: 22 },
  { name: '花', desc: '抽象形态探索中，待重塑。', lift: 10 },
];

const deadSeeds = [{ name: '碎块', desc: '形态过于规整，已归档。' }];

const wakeAnchors = [
  {
    name: 'GitHub',
    href: 'https://github.com/Traveritas',
    addr: 'github.com/Traveritas',
    why: '找我 · 活跃坐标',
    external: true,
  },
  {
    name: '本站源码',
    href: 'https://github.com/Traveritas/traveritas.github.io',
    addr: 'traveritas.github.io',
    why: '仓库 · 源码与构建',
    external: true,
  },
  { name: 'RSS', href: '/rss.xml', addr: '/rss.xml', why: '订阅 · 静默投递', external: false },
];
---

<!-- 构块场在首页走 below（z −3，与纸同层、DOM 在前 ⇒ 被首屏千层纸完全遮住）：
     首屏是不透明的纸叠 + 两个巨字，场画在纸**之上**（through）会把纸读成格纸、
     边角的方块还会被读成多出来的纸片 —— 让纸压在场上面，滚过首屏场才浮现
     （内页沿用默认 through）。理由与对照截图见 design/mocks/p18-notes.md -->
<BaseLayout
  title="Traveritas"
  description={manifesto}
  seam="default"
  constructs="below"
  rail={{ mode: 'night', station: '入夜 · 初刻', en: 'NIGHTFALL' }}
>
  <div class="vignette" aria-hidden="true"></div>

  <!-- ═══ 23:07 入夜 · 首屏「千层纸」（p11-a 落地）：一叠悬浮的纸——
       墙(幽灵描边) → 底纸 → 醒字纸 → 梦字叶 → [固定的 14° 发丝线 chrome：
       全局 Seam/Eeg，不在纸叠内、任何状态不动] → 宣言手记 → 前景丝线。
       纸壳以负 z 沉到线之下（线画在梦叶纸面上），文字全部 z≥0 压住线 ═══ -->
  <section class="hero" id="ns-hero">
    <h1 class="sr-only">Traveritas —— {manifesto}</h1>

    <!-- P0 墙：最远的幽灵描边（糊、淡、慢） -->
    <div class="ps-plane ps-wall" data-p="0" aria-hidden="true">
      <span class="ghost-char">梦</span>
    </div>

    <!-- P1 底纸 · P2 醒字纸壳：负 z，沉在脑电(-2)与缝线(-1)之下 -->
    <div class="ps-plane ps-sheet-base" data-p="1" aria-hidden="true">
      <div class="sheet p-base"></div>
    </div>
    <div class="ps-plane ps-sheet-wake" data-p="2" aria-hidden="true">
      <div class="sheet p-wake"></div>
    </div>

    <!-- P2 醒字墨（在线之上）：醒(墨·绝对静止) + 竖排注 + HYPNOGRAM + 左轨站名 -->
    <div class="ps-plane ps-ink-wake" data-p="2" aria-hidden="true">
      <span class="ch-wake">醒</span>
      <span class="vsub">在醒与梦之间</span>
      <span class="vlat mono">HYPNOGRAM · NIGHT 2026-09</span>
      <aside class="pl-rail">
        <div class="pl-rail-station">
          <span class="pl-rail-name">入夜 · 初刻</span>
          <span class="pl-rail-en mono">NIGHTFALL</span>
        </div>
      </aside>
    </div>

    <!-- P2.5 梦字叶：纸壳负 z（线搭在叶面上），梦字墨在线之上 -->
    <div class="ps-plane ps-leaf" data-p="3" aria-hidden="true">
      <div class="leaf-paper"></div>
    </div>
    <div class="ps-plane ps-leaf-ink" data-p="3" aria-hidden="true">
      <span class="ch-dream">梦</span>
    </div>

    <!-- P3 宣言手记：最近的内容纸，压住梦叶下缘、也压住线 -->
    <div class="ps-plane ps-note" data-p="4" aria-hidden="true">
      <div class="note-paper"></div>
      <div class="note-ink">
        <span class="note-stamp mono">手记 · 23:07</span>
        {
          frags.map((f, i) => (
            <p class:list={['frag', `f${i + 1}`]}>
              {f.split('').map((ch) => (
                <span class="c">{ch}</span>
              ))}
            </p>
          ))
        }
      </div>
    </div>

    <!-- P4 前景（最近）：几缕脱线的丝 + 滚动提示
         主丝：左缘走廊下行、中段自卷、尾端搭手记左下角（此端刻意留在纸面上）；
         伴丝×2：都有一端伸出视口边框（右上穿角而过、右下自底边垂入），
         线不与任何文字相遇 -->
    <div class="ps-plane ps-fore" data-p="5">
      <svg class="curl" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
        <path
          class="silk-main"
          d="M -70 536 C 40 550 78 600 84 646 C 88 678 52 684 46 656 C 41 630 74 612 96 648 C 118 686 100 764 108 806 C 114 838 152 866 214 888 C 226 908 234 924 248 938"
        />
        <path
          class="silk-pass"
          d="M 1210 -34 C 1224 60 1268 96 1316 108 C 1362 120 1402 96 1436 64 C 1466 36 1492 24 1522 20"
        />
        <path
          class="silk-drop"
          d="M 905 942 C 916 878 894 838 916 806 C 934 780 968 788 962 818 C 958 840 934 840 928 820 C 924 804 942 786 966 792"
        />
      </svg>
      <p class="hero-scroll">
        <i></i><span data-morph data-true="向下轻移 · 穿行于这一夜" data-dream="“万物皆在降落。”——向深处潜行">向下轻移 · 穿行于这一夜</span>
      </p>
    </div>
  </section>

  <!-- ═══ N1–N2 浅梦 · 随笔：玻璃片沿左缘短划逐级下沉；纸面标签带叠影（半醒复视） ═══ -->
  <section class="band band-essays" id="ns-essays">
    <div class="container-wide">
      <StitchHeader title="随笔" stage="浅梦 · LIGHT · N1–N2" time={`${fmtNightTime(12)} → ${fmtNightTime(124)}`} />
      <p class="verdict">
        <span class="vtag warm">可言说的 · SAYABLE</span>
        <span class="vword" data-morph data-true="写下时很笃定。" data-dream="重读时散作微光。">写下时很笃定。</span>
      </p>
      <p class="band-intro" data-morph data-true="夜深时的字句最诚实——不急于得出结论，只记下发生的瞬间。" data-dream="“思绪如薄雾聚散，语言尚未落定，影子先有了形状。”">
        夜深时的字句最诚实——不急于得出结论，只记下发生的瞬间。
      </p>
      <div class="ladder">
        {
          articles.map((a, i) => {
            const label = `${fmt(a.date)} · ${a.tags.join(' · ')}`;
            return (
              <div class="rung" style={`--step: ${i * 9}`}>
                <GlassChip
                  href={`/articles/${a.id}/`}
                  title={a.title}
                  desc={a.description}
                  meta={`随笔 · ${String(i + 1).padStart(2, '0')}`}
                  style={`--tilt: ${(i % 2 === 0 ? -1.1 : 1).toString()}deg; --d-phase: ${(-i * 2.3).toString()}s`}
                />
                <p class="rung-label mono ghost-pair">
                  <span class="ghost" aria-hidden="true">{label}</span>{label}
                </p>
              </div>
            );
          })
        }
      </div>
      <p class="essay-cap">
        <span data-morph data-true="标签微弱的重影不是印坏——视线停留太久，轮廓便有了呼吸。" data-dream="“世界本无两重，只是光在折射时有了迟疑。”">标签微弱的重影不是印坏——视线停留太久，轮廓便有了呼吸。</span>
      </p>
      <p class="band-more"><a href="/articles/">全部随笔 · 记录</a></p>
    </div>
  </section>

  <!-- ═══ N3 深眠 · 项目：夜最深处的账目反而最醒——放宽一档、绝对静止，行尾核验 ═══ -->
  <section class="band band-projects" id="ns-projects">
    <div class="still-col">
      <StitchHeader title="项目" stage="深眠 · DEEP · N3 δ" time={`${fmtNightTime(124)} → ${fmtNightTime(181)}`} />
      <p class="verdict">
        <span class="vtag cool">可构造的 · BUILDABLE</span>
        <span class="vword" data-morph data-true="夜到最深处，万物反而最沉静。" data-dream="“凡不可测量的，皆归于无声——结构静默，等待光线穿透。”">夜到最深处，万物反而最沉静。</span>
      </p>
      <p class="waso-note">
        <span class="mono waso-tag">微觉醒 · WASO {fmtNightTime(163)}</span>
        <span data-morph data-true="在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？" data-dream="“世界是所有发生的事情——可若今夜什么都没有发生呢？”">在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？</span>
      </p>
      <ul class="ledger">
        {
          projects.map((p) => (
            <li>
              <a href={`/projects/${p.id}/`}>
                <span class="ledger-date">{fmt(p.date)}</span>
                <span>
                  <span class="ledger-title">
                    {p.title}
                    <span class="ledger-status">{p.status}</span>
                    <span class="stitch-meter" title={`成形度第 ${pinsOf(p.status)} 阶 / 八阶`}>
                      {Array.from({ length: 8 }).map((_, i) => (
                        <i class:list={{ on: i < pinsOf(p.status) }} />
                      ))}
                    </span>
                  </span>
                  {p.description && <span class="ledger-desc">{p.description}</span>}
                </span>
                <span class:list={['tick', { 'tick-ok': repoOf(p), 'tick-na': !repoOf(p) }]}>
                  {repoOf(p) ? '✓ 公开仓库' : '○ 暂无公开'}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="band-more"><a href="/projects/">全部项目 · 造物</a></p>
    </div>
  </section>

  <!-- ═══ REM · 试验场：种子药丸浮在玻璃签四周，否决的一枚划线留在场内 ═══ -->
  <section class="band band-rem" id="ns-rem">
    <div class="container-wide">
      <StitchHeader title="试验场" stage="异相 · REM · 眼动" time={`${fmtNightTime(181)} → ${fmtNightTime(352)}`} />
      <p class="verdict">
        <span class="vtag warm">未命名的 · UNNAMED</span>
        <span class="vword" data-morph data-true="反复悬想的，迟早会被做出来。" data-dream="若从未被凝视，它便始终是一缕微澜。">反复悬想的，迟早会被做出来。</span>
      </p>
      <p class="band-intro" data-morph data-true="在更辽阔的留白处，五粒母题的种子还悬着。" data-dream="“世界是由事实构成的，而非事物——那些尚未落定的可能，仍在半空微浮。”">
        在更辽阔的留白处，五粒母题的种子还悬着。
      </p>
      <div class="rem-field">
        <div class="pill-field">
          {
            seeds.map((s, i) => (
              <span
                class="pill drift"
                style={`--d-amp: 6px; --d-dur: ${(6.4 + i * 0.7).toFixed(1)}s; --d-phase: ${(-i * 1.7).toFixed(1)}s; --d-rot: 0.5deg; --lift: ${s.lift}px`}
              >
                <span class="pill-skin" style={`--tilt: ${(i % 2 === 0 ? 1.2 : -0.9).toString()}deg`}>
                  <b>{s.name}</b>
                  <small>{s.desc}</small>
                </span>
              </span>
            ))
          }
          {
            deadSeeds.map((d) => (
              <span class="pill-skin dead" style="--lift: 14px">
                <b>{d.name}</b>
                <small>{d.desc}</small>
              </span>
            ))
          }
        </div>
        <div class="slip-stage">
          <div class="slip-glow" aria-hidden="true"></div>
          <canvas id="slip-canvas" aria-hidden="true"></canvas>
          <div class="slip-fallback" aria-hidden="true">
            <span class="sf-t">它可能<br />马上消失。</span>
            <span class="sf-b mono">GLASS SLIP · 玻璃签</span>
          </div>
          <p class="slip-cap mono">丝印于玻璃 · 夜色中唯一发光的句子</p>
        </div>
      </div>
      <p class="rem-cap">
        <span data-morph data-true="划线的一枚已否决；判定与三轮记录，都在" data-dream="“划线者归于静止，余下的仍在微光中延展——见”">划线的一枚已否决；判定与三轮记录，都在</span><a href="/articles/motif-exploration-log/">《母题探索记录》</a>。
      </p>
    </div>
  </section>

  <!-- ═══ 06:31 晨醒 · 关于与出口：天亮了；需要把我叫醒的话，三个锚都在 ═══ -->
  <section class="band band-dawn" id="ns-dawn">
    <div class="container">
      <StitchHeader title="关于" stage="晨醒 · WAKE · β" time={`${fmtNightTime(352)} → ${fmtNightTime(444)}`} />
      <p class="verdict verdict-center">
        <span class="vtag cool">存在于此 · PRESENCE</span>
        <span class="vword" data-morph data-true="只要发出信号，随时找得到我。" data-dream="“凡被投递的信息，终会留下共振。”">只要发出信号，随时找得到我。</span>
      </p>
      <p class="dawn-time mono" data-boot style="--bd: 0.2s">06:31 · 天亮了</p>
      <div class="dawn-card">
        <p class="dawn-line" data-morph data-faces="白天，我写代码。|夜里，我构筑世界。|此刻，这一页正在浮现。">白天，我写代码。</p>
        <p class="dawn-line" data-morph data-true="这个网站由智能体与我共同建造。" data-dream="“代码与想象在此交叠，共同勾勒出此地的轮廓。”">
          这个网站由智能体与我共同建造。
        </p>
      </div>
      <div class="wake">
        <p class="wake-head">如果需要找我</p>
        <p class="wake-sub">
          <span data-morph data-true="以下入口真实有效，通往明亮清晰的世界。" data-dream="“微小的信标依然亮着，无论何时触碰都会泛起回音。”">以下入口真实有效，通往明亮清晰的世界。</span>
        </p>
        <div class="wake-row">
          {
            wakeAnchors.map((w) => (
              <a class="wake-anchor" href={w.href} target={w.external ? '_blank' : undefined} rel={w.external ? 'noopener' : undefined}>
                <span class="wa-name">{w.name}</span>
                <span class="wa-href mono">{w.addr}</span>
                <span class="wa-why">{w.why}</span>
              </a>
            ))
          }
        </div>
      </div>
      <p class="final-line ghost-pair">
        <span class="ghost">最后一眼看见的明亮倒影。</span>最后一眼看见的明亮倒影。
      </p>
      <p class="band-more"><a href="/about/">关于这个网站，与我</a></p>
    </div>
  </section>
</BaseLayout>

<script>
  import { initPaperstack } from '../scripts/paperstack';
  initPaperstack();

  // 3D 懒加载：IO 优先，轮询兜底（覆盖渲染被节流、IO 回调滞后的环境）
  const lazy = (id: string, run: () => Promise<unknown>) => {
    const el = document.getElementById(id);
    if (!el) return;
    let loaded = false;
    const near = () => {
      const r = el.getBoundingClientRect();
      return r.bottom > -innerHeight && r.top < innerHeight * 2;
    };
    const load = () => {
      if (loaded) return;
      loaded = true;
      io.disconnect();
      clearInterval(timer);
      el.dataset.loading = '1';
      run()
        .then(() => {
          el.dataset.loaded = '1';
        })
        .catch((err) => {
          el.dataset.loadErr = String(err);
          /* WebGL 不可用时由静态回退接手 */
        });
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((en) => en.isIntersecting)) load();
      },
      { rootMargin: '280px' },
    );
    io.observe(el);
    const timer = setInterval(() => {
      if (near()) load();
    }, 900);
  };
  lazy('slip-canvas', () => import('../scripts/slip').then((m) => m.initSlip()));
</script>

<style>
  /* 主页文字不参与选择（入口/链接照常可点）——长按入梦可从任意文字处起手 */
  :global(html body) {
    user-select: none;
    -webkit-user-select: none;
  }

  /* 顶部一袭 floatwin 式冷→暖淡染（照 p5-floatwin 的墙取色）：
     垂直融出——斜向渐变在矩形带内褪不尽，下缘会切出硬线 */
  :global(html body) {
    background-image: linear-gradient(
      180deg,
      #e3e9ef 0%,
      #eae3e6 44%,
      rgba(237, 218, 211, 0.55) 68%,
      rgba(237, 218, 211, 0) 100%
    );
    background-repeat: no-repeat;
    background-position: top;
    background-size: 100% min(100svh, 900px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* 揭幕编排：booted 后逐级浮现 */
  [data-boot] {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.9s ease var(--bd, 0s),
      transform 0.9s ease var(--bd, 0s);
  }

  :global(html.booted) [data-boot] {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-boot] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* 暗角：呼吸速率随分期（night.ts 写 body[data-stage]）；浓度梦浓醒淡 */
  .vignette {
    position: fixed;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: radial-gradient(120% 92% at 50% 44%, transparent 52%, rgba(8, 10, 16, 0.52) 100%);
    opacity: calc(0.42 - var(--reality-mix, 1) * 0.18);
    animation: vig var(--breath, 15s) ease-in-out infinite;
  }

  @keyframes vig {
    0%,
    100% {
      opacity: calc(0.34 - var(--reality-mix, 1) * 0.15);
    }
    50% {
      opacity: calc(0.52 - var(--reality-mix, 1) * 0.22);
    }
  }

  :global(body[data-stage='n3']) {
    --breath: 26s;
  }

  :global(body[data-stage='rem']) {
    --breath: 8s;
  }

  @media (prefers-reduced-motion: reduce) {
    .vignette {
      animation: none;
    }
  }

  /* ── 首屏 · 千层纸（p11-a-paperstack 落地；发丝线 = 全局固定 chrome，不动） ──
     根层叠上下文层序：body 洗地墙 → 幽灵描边(-4) → 底纸/醒纸/梦叶纸壳(-3)
     → 脑电(-2，全局 Eeg) → 发丝线(-1，全局 Seam) + 刻痕(-1) → 醒字墨/梦字墨(1)
     → 宣言手记(2) → 前景(3)。线画在梦叶纸面上（分界感），又被手记与全部
     文字压住——「纸压线」。注意：hero 及其祖先不得产生层叠上下文
     （无 transform/opacity/filter/z-index），负 z 纸壳才能沉到全局发丝线之下；
     视差所需的透视走每平面 transform 自带的 perspective() 函数。 ── */
  .hero {
    --gfs: clamp(150px, 18.5vw, 250px);
    /* 缝线在视口 50svh；页头叠压在首屏上（见 :global(.site-header)），hero 起点即页顶。
       66px 与 mock 基准一致（页头实高不参与公式——线锚定视口，字锚定线） */
    --lineH: calc(50svh - 66px);
    --wakeTop: calc(var(--lineH) + 1.5vw - var(--gfs) - 20px);
    --noteTop: calc(50svh + 180px);
    position: relative;
    height: 100svh;
  }

  /* 页头叠压首屏（千层纸的取景框——几何公式全部按视口坐标书写）；
     其余页维持文档流页头，不受影响 */
  :global(.site-header) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
  }

  .ps-plane {
    position: absolute;
    will-change: transform;
    pointer-events: none;
  }

  /* ── P0 墙：最远的幽灵描边（糊、淡、慢） ── */
  .ps-wall {
    inset: 0;
    z-index: -4;
  }

  .ghost-char {
    position: absolute;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 1;
    font-size: min(72vmin, 40rem);
    color: transparent;
    -webkit-text-stroke: 1px rgba(38, 44, 51, 0.065);
    filter: blur(2.5px);
    animation: ps-wall-drift 16s ease-in-out infinite;
  }

  @keyframes ps-wall-drift {
    0%,
    100% {
      transform: translate(-50%, -50%) translate3d(calc(-4px * var(--still, 0)), calc(-6px * var(--still, 0)), 0);
    }
    50% {
      transform: translate(-50%, -50%) translate3d(calc(5px * var(--still, 0)), calc(7px * var(--still, 0)), 0);
    }
  }

  /* ── 纸张通用：纸色 = 深度（越近越亮），随过夜色板微动；影子朝下散 ── */
  .sheet {
    position: absolute;
    inset: 0;
  }

  .ps-sheet-base {
    inset: 0;
    z-index: -3;
  }

  .p-base {
    left: -3%;
    top: -2%;
    width: 105.4%;
    height: 104.6%;
    background: color-mix(in srgb, var(--bg) 85%, #cdd7e0);
    box-shadow:
      0 30px 70px -34px rgba(38, 44, 51, 0.16),
      inset 8px 0 10px -8px rgba(38, 44, 51, 0.12),
      inset -8px 0 10px -8px rgba(38, 44, 51, 0.12),
      inset 0 -8px 10px -8px rgba(38, 44, 51, 0.1);
  }

  .ps-sheet-wake {
    inset: 0;
    z-index: -3;
  }

  .p-wake {
    left: -1%;
    top: -3%;
    width: 104.4%;
    height: 105%;
    background: color-mix(in srgb, var(--bg) 92%, #ffffff);
    box-shadow:
      0 26px 60px -30px rgba(38, 44, 51, 0.14),
      inset 0 8px 10px -8px rgba(38, 44, 51, 0.1),
      inset -8px 0 10px -8px rgba(38, 44, 51, 0.12);
  }

  /* ── P2 醒字墨（在线之上）：醒(墨·绝对静止) + 竖排注 + HYPNOGRAM + 左轨站名 ── */
  .ps-ink-wake {
    inset: 0;
    z-index: 1;
  }

  .ch-wake {
    position: absolute;
    left: 55vw;
    top: var(--wakeTop);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--gfs);
    line-height: 1;
    color: var(--fg);
  }

  .vsub {
    position: absolute;
    left: calc(55vw + var(--gfs) + 28px);
    top: calc(var(--wakeTop) + 4px);
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0.52em;
    color: var(--fg-soft);
  }

  .vlat {
    position: absolute;
    left: calc(12.5vw - 42px);
    top: calc(33svh + 24px); /* 下移 18px：极端姿态下与固定缝线保持 ≥4px 余量 */
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.4em;
    color: var(--fg-soft);
    opacity: 0.85;
  }

  /* 左轨站名（首屏期装饰；滚过首屏后全局 Rail 接班，<1200px 与全局轨同隐） */
  .pl-rail {
    position: absolute;
    left: 26px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    color: var(--fg-soft);
  }

  .pl-rail-station {
    writing-mode: vertical-rl;
    display: flex;
    gap: 0.9rem;
    align-items: center;
    padding-left: 0.8rem;
    border-left: 1px solid var(--line);
  }

  .pl-rail-name {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.42em;
  }

  .pl-rail-en {
    font-size: 0.56rem;
    letter-spacing: 0.3em;
    opacity: 0.66;
  }

  /* ── P2.5 梦字叶：纸壳负 z（线搭在叶面上），梦字墨在线之上、慢漂（醒静梦动） ── */
  .ps-leaf {
    left: 12.5vw;
    top: 33svh;
    width: clamp(300px, 30vw, 432px);
    aspect-ratio: 1 / 1;
    z-index: -3;
  }

  .leaf-paper {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 80%, #ddd0c2);
    clip-path: polygon(0 5.5%, 5% 0, 100% 0, 100% 87%, 94% 100%, 61% 98.6%, 0 100%);
    filter: drop-shadow(0 16px 34px rgba(38, 44, 51, 0.18)) drop-shadow(0 2px 5px rgba(38, 44, 51, 0.06));
  }

  .ps-leaf-ink {
    left: 12.5vw;
    top: 33svh;
    width: clamp(300px, 30vw, 432px);
    aspect-ratio: 1 / 1;
    z-index: 1;
    display: grid;
    place-items: center;
  }

  .ch-dream {
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 1;
    font-size: var(--gfs);
    color: color-mix(in srgb, var(--fg) 76%, var(--dream));
    animation: ps-leaf-drift 9s ease-in-out infinite;
  }

  @keyframes ps-leaf-drift {
    0%,
    100% {
      transform: translate3d(calc(-3px * var(--still, 0)), calc(-6px * var(--still, 0)), 0)
        rotate(calc(-0.35deg * var(--still, 0)));
    }
    50% {
      transform: translate3d(calc(4px * var(--still, 0)), calc(7px * var(--still, 0)), 0)
        rotate(calc(0.3deg * var(--still, 0)));
    }
  }

  /* ── P3 宣言手记：最近的内容纸，右缘撕毛边，压住梦叶下缘与线 ── */
  .ps-note {
    left: 13vw;
    top: var(--noteTop);
    width: min(44vw, 640px);
    z-index: 2;
  }

  .note-paper {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 65%, #f7f7f7);
    clip-path: polygon(0 0, 100% 1.6%, 98.7% 17%, 100% 33%, 98.9% 51%, 100% 70%, 98.8% 85%, 100% 100%, 0 100%);
    filter: drop-shadow(0 20px 44px rgba(38, 44, 51, 0.17)) drop-shadow(0 2px 5px rgba(38, 44, 51, 0.05));
  }

  /* 熄灯后首屏还会被看见一程（跨越点定在随笔段顶到视口 38% 处），
     65% 混出的中灰纸(#656565)衬不住纸上的字——浅墨只有 4.42:1、soft 只有 2.79:1。
     夜面下让纸贴住夜底：82% 时纸色 #3f434a，实测 ink 7.54:1、soft 4.75:1，
     纸仍比底(#171b24)浅一档，与另外三张纸的层次也保住了
     （亮面下四张纸本来就只差 4/255，靠投影与裁边读层）。 */
  :global(body[data-zone='deep']) .note-paper {
    background: color-mix(in srgb, var(--bg) 82%, #f7f7f7);
  }

  .note-ink {
    position: relative;
    padding: 1.5rem 2.2rem 1.3rem 1.8rem;
  }

  .note-stamp {
    position: absolute;
    top: 0.55rem;
    right: 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.2em;
    color: var(--fg-soft);
  }

  .note-ink .frag {
    margin: 0 0 0.9rem;
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--fg);
  }

  /* 逐字微错位与局部失焦（睡眠图对宣言碎片的处理） */
  .note-ink .c {
    display: inline-block;
    white-space: pre;
  }

  .note-ink .c:nth-child(4n + 2) {
    transform: translateY(0.13em);
  }

  .note-ink .c:nth-child(4n + 3) {
    transform: translateY(-0.09em) rotate(0.8deg);
  }

  .note-ink .c:nth-child(7n + 5) {
    filter: blur(0.9px);
    opacity: 0.8;
  }

  .note-ink .c:nth-child(9n + 4) {
    transform: rotate(-1.1deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .note-ink .c {
      transform: none !important;
      filter: none !important;
      opacity: 1 !important;
    }
  }

  .note-ink .f1 {
    font-size: clamp(1.4rem, 2.1vw, 1.75rem);
  }

  .note-ink .f2 {
    margin-left: 9%;
    font-size: clamp(0.88rem, 1.3vw, 1rem);
    letter-spacing: 0.32em;
    color: var(--fg-soft);
  }

  .note-ink .f3 {
    margin-left: 4%;
    font-size: clamp(0.88rem, 1.35vw, 1rem);
    color: var(--fg-soft);
  }

  .note-ink .f4 {
    margin-left: 14%;
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
  }

  /* ── P4 前景：一缕脱线的丝 + 滚动提示（最近，动得最多） ──
     丝的走线：沿左缘走廊下行，中段自卷，尾端搭在手记纸左下角上 */
  .ps-fore {
    inset: 0;
    z-index: 3;
  }

  .curl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: blur(0.4px);
    /* 让越过 viewBox 的线端真正伸出视口边框（被屏幕边缘裁切，而非停在框内） */
    overflow: visible;
  }

  .curl path {
    stroke: var(--umber);
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .curl .silk-main {
    stroke-width: 1.4;
    opacity: 0.45;
  }

  .curl .silk-pass {
    stroke-width: 1.1;
    opacity: 0.34;
  }

  .curl .silk-drop {
    stroke-width: 1.1;
    opacity: 0.3;
  }

  .hero-scroll {
    position: absolute;
    right: 6vw;
    top: 91svh;
    margin: 0;
    font-size: 14px;
    font-weight: 300;
    letter-spacing: 0.26em;
    color: var(--fg-soft);
    animation: ps-fore-drift 11s ease-in-out infinite;
    pointer-events: auto;
  }

  .hero-scroll i {
    display: inline-block;
    width: 24px;
    height: 2px;
    background: var(--amber);
    opacity: 0.5;
    transform: rotate(calc(var(--seam-angle) * -1));
    vertical-align: middle;
    margin-right: 12px;
  }

  @keyframes ps-fore-drift {
    0%,
    100% {
      transform: translate3d(calc(-2px * var(--still, 0)), calc(-3px * var(--still, 0)), 0);
    }
    50% {
      transform: translate3d(calc(3px * var(--still, 0)), calc(4px * var(--still, 0)), 0);
    }
  }

  @media (max-width: 1199px) {
    .pl-rail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ghost-char,
    .ch-dream,
    .hero-scroll {
      animation: none !important;
    }
  }

  /* 窄屏（四段纵排：醒 → 梦叶 → 提示带 → 手记） */
  @media (max-width: 760px) {
    .hero {
      --gfs: clamp(96px, 30vw, 150px);
      --wakeTop: calc(var(--lineH) - 2vw - var(--gfs) - 6px);
      --noteTop: calc(50svh + 205px);
    }

    .ch-wake {
      left: 40vw;
    }

    .vsub {
      left: auto;
      right: 3vw;
      top: calc(var(--wakeTop) + 4px);
      letter-spacing: 0.4em;
    }

    .vlat {
      display: none;
    }

    .ghost-char {
      font-size: 92vw;
      top: 2svh;
    }

    .ps-leaf,
    .ps-leaf-ink {
      left: 3vw;
      top: calc(var(--lineH) - 6px);
      width: clamp(190px, 52vw, 260px);
    }

    .ps-note {
      left: 4vw;
      right: 4vw;
      width: auto;
    }

    .note-ink {
      padding: 1.2rem 1.3rem 1.05rem 1.25rem;
    }

    .note-ink .frag {
      margin-bottom: 1.05rem;
    }

    .note-ink .f2,
    .note-ink .f3,
    .note-ink .f4 {
      margin-left: 0;
    }

    /* 窄屏：滚动提示放进梦叶下缘与手记上缘之间的空带，不与任何字打架 */
    .hero-scroll {
      left: 5vw;
      right: auto;
      top: calc(50svh + 146px);
      font-size: 12.5px;
    }
  }

  /* ── 各夜段 ── */
  .band {
    position: relative;
    padding-block: clamp(5.5rem, 13vh, 9.5rem);
  }

  /* 层级判词：一枚冷暖小签（可核验度）+ 一句随 morph 双声轨的话 */
  .verdict {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.3rem 0.85rem;
    margin: -1.1rem 0 2.2rem;
  }

  .vtag {
    --vt: color-mix(in srgb, var(--dream) 15%, var(--fg) 85%);
    color: var(--vt);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    padding: 0.3rem 0.6rem 0.26rem;
    border: 1px solid color-mix(in srgb, var(--vt) 45%, transparent);
    white-space: nowrap;
  }

  .vtag.cool {
    --vt: color-mix(in srgb, var(--wake) 15%, var(--fg) 85%);
  }

  .vword {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--fg-soft);
  }

  .band-intro {
    margin: 0 0 3rem;
    max-width: 36em;
    color: var(--fg-soft);
    font-size: 0.98rem;
    letter-spacing: 0.06em;
  }

  .band-more {
    margin-top: 2.4rem;
    font-size: 0.88rem;
    letter-spacing: 0.1em;
  }

  .band-more a {
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
  }

  /* ── 浅梦 · 下沉的玻璃片梯：左缘短划逐级右移，纸面标签带叠影 ── */
  .ladder {
    display: flex;
    flex-direction: column;
    gap: 3.4rem;
  }

  .rung {
    margin-left: calc(var(--step, 0) * 1%);
    padding-left: 1.3rem;
    border-left: 1px solid var(--line);
  }

  .rung-label {
    margin: 0.95rem 0 0 0.2rem;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: var(--fg-soft);
  }

  .essay-cap {
    margin: 3.2rem 0 0;
    max-width: 34em;
    font-size: 0.88rem;
    line-height: 1.95;
    color: var(--fg-soft);
    letter-spacing: 0.04em;
  }

  /* ── 深眠 · 放宽一档的静止账目（核验列收在行尾） ── */
  .band-projects {
    min-height: 108vh;
    display: flex;
    align-items: center;
  }

  .still-col {
    position: relative;
    z-index: 2;
    width: min(100% - 3rem, 68rem);
    margin-inline: auto;
  }

  .waso-note {
    margin: 0 0 3rem;
    max-width: 34em;
    font-family: var(--font-display);
    font-size: 1.02rem;
    letter-spacing: 0.08em;
    color: var(--fg-soft);
    padding-left: 1.2rem;
    border-left: 2px solid var(--amber);
  }

  .waso-tag {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    color: var(--amber);
  }

  .band-projects .ledger a {
    grid-template-columns: 7.5em 1fr auto;
    gap: 0 2rem;
  }

  .tick {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    white-space: nowrap;
    padding-top: 0.42em;
  }

  .tick-ok {
    color: color-mix(in srgb, var(--wake) 50%, var(--fg) 50%);
  }

  .tick-na {
    color: var(--fg-soft);
  }

  /* 深夜分期玻璃增实：白玻薄端压在夜底上会衬不出 meta 小字，
     入夜各分期抬玻璃下限（昼夜整体仍是白玻深字） */
  :global(body[data-stage='n1'] .chip-glass, body[data-stage='n2'] .chip-glass, body[data-stage='n3'] .chip-glass, body[data-stage='rem'] .chip-glass, body[data-stage='waso'] .chip-glass) {
    background: linear-gradient(135deg, rgba(252, 252, 250, 0.88), rgba(252, 252, 250, 0.8));
  }

  @media (max-width: 34em) {
    .band-projects .ledger a {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .tick {
      margin-top: 0.4rem;
      padding-top: 0;
    }
  }

  /* ── REM · 药丸星座：种子绕玻璃签漂，否决的一枚划线留在场内 ── */
  .rem-field {
    display: grid;
    gap: 3.4rem;
    margin-bottom: 3.4rem;
  }

  @media (min-width: 900px) {
    .rem-field {
      grid-template-columns: minmax(0, 32rem) minmax(16rem, auto);
      align-items: center;
      justify-content: center;
      gap: clamp(3rem, 6vw, 5rem);
    }
  }

  .pill-field {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.1rem 1rem;
  }

  .pill {
    margin-top: var(--lift, 0px);
  }

  .pill-skin {
    display: grid;
    gap: 0.3rem;
    padding: 0.8rem 1.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--dream) 42%, transparent);
    background: color-mix(in srgb, var(--fg) 3%, transparent);
    transform: rotate(var(--tilt, 0deg));
    transition: border-color 0.3s ease;
  }

  .pill-skin:hover {
    border-color: color-mix(in srgb, var(--dream) 75%, transparent);
  }

  .pill-skin b {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.06em;
    color: var(--fg);
  }

  .pill-skin small {
    font-size: 0.72rem;
    line-height: 1.65;
    letter-spacing: 0.02em;
    color: var(--fg-soft);
  }

  .pill-skin.dead {
    margin-top: var(--lift, 0px);
    border-style: dashed;
    border-color: color-mix(in srgb, var(--fg-faint) 45%, transparent);
  }

  .pill-skin.dead b {
    color: var(--fg-faint);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  /* 否决种子的描述仍是正文信息：只让标题靠划线＋淡色退场 */
  .pill-skin.dead small {
    color: var(--fg-soft);
  }

  .rem-cap {
    margin: 0;
    max-width: 34em;
    font-size: 0.88rem;
    line-height: 1.95;
    color: var(--fg-soft);
    letter-spacing: 0.04em;
  }

  .slip-stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.4rem;
    padding-block: 2rem;
    overflow: clip;
  }

  .slip-glow {
    position: absolute;
