---
/* ─────────────────────────────────────────────────────────────
   主页 · 还没分开的那片空间（2026-10-18；上一版「一根线的一夜」存档在 /legacy/thread/）
   主页与随笔 / 瞬间 / 项目三个目录页是同一片空间（components/wander/WanderIndex.astro），主页是它还没分开的样子：
   三种夜色只是一池池浮在靛夜里，三个场景的窗混在一起、一扇扇从景深里经过焦平面；一根 14° 的线过屏幕中心，
   名字站在线的左上方，三个栏头挂在线下，NEXUS 在右下角、RSS 的右边。
   往下走（滚轮 / 上划 / ↓ / 点栏头）：线转过 90°、劈成两条缝，三栏分开，就是检索；地址随之变成那一栏的目录地址。
   编排全在 src/scripts/wander/wander.js（home）与 light.js（池、转动的缝）。
   下面 .w-fallback 是无脚本时的那一份（也是给搜索引擎的）：名字、三个入口、最近的几条。
   ───────────────────────────────────────────────────────────── */
import BaseLayout from '../layouts/BaseLayout.astro';
import WanderIndex from '../components/wander/WanderIndex.astro';
import { getCollection } from 'astro:content';
import { fmtDate } from '../lib/format';

const byDate = <T extends { id: string; data: { date: Date } }>(a: T, b: T) =>
  b.data.date.valueOf() - a.data.date.valueOf() || b.id.localeCompare(a.id);

const articles = (await getCollection('articles', (a) => !a.data.draft)).sort(byDate).slice(0, 3);
const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(byDate).slice(0, 3);

const manifesto = '在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？';
---

<BaseLayout title="Traveritas的个人网站" dreamTitle="AveritA的昼梦叙集" description={manifesto} immersive eeg>
  <WanderIndex scene="home" />
  <div class="w-fallback">
    <div class="container page-body">
      <header class="page-head">
        <h1>Traveritas</h1>
        <p class="lede">{manifesto}</p>
      </header>
      <nav class="home-fb-nav" aria-label="版块">
        <a href="/articles/">随笔</a>
        <a href="/moments/">瞬间</a>
        <a href="/projects/">项目</a>
        <a href="/gate/">NEXUS</a>
      </nav>
      <section>
        <h2>随笔</h2>
        <ul>
          {articles.map((a) => <li><a href={`/articles/${a.id}/`}>{a.data.title}</a> <time datetime={a.data.date.toISOString()}>{fmtDate(a.data.date)}</time></li>)}
        </ul>
      </section>
      <section>
        <h2>项目</h2>
        <ul>
          {projects.map((p) => <li><a href={`/projects/${p.id}/`}>{p.data.title}</a> <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time></li>)}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home-fb-nav {
    display: flex;
    gap: 1.6rem;
    margin: 2rem 0 3rem;
  }
  .w-fallback section {
    margin-bottom: 2.4rem;
  }
  .w-fallback ul {
    padding-left: 1.2rem;
    line-height: 2;
  }
  .w-fallback time {
    margin-left: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--fg-soft);
  }
</style>
