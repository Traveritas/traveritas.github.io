---
/* 主页：一根 14° 的线，三颗晶体挂在上面 = 三处 */
import Base from '../layouts/Base.astro';
import { SECS, ORDER, entriesOf } from '../lib/entries';
import { pad } from '../lib/text';

const counts = Object.fromEntries(await Promise.all(ORDER.map(async (k) => [k, (await entriesOf(k)).length])));
---

<Base place="home">
  <section class="home">
    <div class="name-wrap">
      <h1 class="name">AveritA</h1>
      <p class="kick">的昼梦叙集</p>
    </div>
    <div class="slash" aria-hidden="true"></div>
    <nav class="doors">
      {
        ORDER.map((k, i) => (
          <a class="door" href={`/${k}/`} data-sec={k} style={`--i:${i}`}>
            <i class="x" data-x={k} />
            <span class="door-t">
              <span class="num">{['I', 'II', 'III'][i]}</span>
              {SECS[k].t}
            </span>
            <span class="door-m mono">
              {SECS[k].en} · {pad(counts[k])}
            </span>
          </a>
        ))
      }
    </nav>
  </section>
</Base>
