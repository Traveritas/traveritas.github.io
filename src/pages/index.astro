---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShardMark from '../components/ShardMark.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', (a) => !a.data.draft))
  .map(({ id, data }) => ({ id, ...data }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="Traveritas">
  <section class="cover container">
    <ShardMark size={30} />
    <p class="cover-manifesto">
      这里不是梦，也不是现实。它是人在即将醒来时，看见的最后一层世界。
    </p>
    <p class="cover-sub">
      我的个人网站——存放随笔、项目，与一些尚在成形的东西。
    </p>
    <nav class="cover-links" aria-label="站内入口">
      <a href="/articles/">随笔</a>
      <a href="/projects/">项目</a>
      <a href="/about/">关于</a>
    </nav>
  </section>

  <section class="recent container">
    <h2>最近的随笔</h2>
    <ul class="ledger">
      {
        articles.map((a) => (
          <li>
            <a href={`/articles/${a.id}/`}>
              <span class="ledger-date">{fmt(a.date)}</span>
              <span>
                <span class="ledger-title">{a.title}</span>
                {a.description && <span class="ledger-desc">{a.description}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="recent-more"><a href="/articles/">全部随笔</a></p>
  </section>
</BaseLayout>
