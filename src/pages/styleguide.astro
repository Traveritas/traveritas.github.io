<script>
  import { forceReality, getReality, onRealityChange } from '../scripts/reality';
  import { sheenEase } from '../markdown/sheen-timing.mjs';

  const root = document.documentElement;

  /* 令牌数值回填：一律读计算值，不把色号抄第二处。
     注意读自定义属性要用连字符原名（驼峰取不到，见 content-typography.md 第五节踩坑 1）。 */
  const fillTokens = () => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-sg-token]')) {
      const name = el.dataset.sgToken ?? '';
      el.textContent = getComputedStyle(root).getPropertyValue(name).trim() || '—';
    }
  };

  /* 实测尺寸回填：取 border box 的矩形（虚框自己带 1px 边，clientWidth 会少 2px） */
  const rectOf = (id: string | undefined) => {
    const target = id ? document.getElementById(id) : null;
    if (!target) return null;
    return target.getBoundingClientRect();
  };
  const fillSizes = () => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-sg-w]')) {
      const r = rectOf(el.dataset.sgW);
      el.textContent = r ? `${Math.round(r.width)}px` : '—';
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-sg-h]')) {
      const r = rectOf(el.dataset.sgH);
      el.textContent = r ? `${Math.round(r.height)}px` : '—';
    }
  };

  /* 面：走 reality 的闩锁路径，故叠影 / 强调色 / 双面文案 / 跨页记忆都跟着对齐 */
  const faceBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-sg-face]')];
  const syncFace = () => {
    const now = getReality();
    for (const b of faceBtns) b.setAttribute('aria-pressed', String(b.dataset.sgFace === now));
  };
  for (const b of faceBtns) {
    b.addEventListener('click', () => forceReality(b.dataset.sgFace === 'dream' ? 'dream' : 'wake'));
  }
  onRealityChange(() => {
    syncFace();
    // 强调色在 notify 之后才写，等两帧再读计算值
    requestAnimationFrame(() => requestAnimationFrame(fillTokens));
  });

  /* 图层消隐与参考线：按下 = 加上那个 html 类 */
  const toggleBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-sg-toggle]')];
  const syncToggles = () => {
    for (const b of toggleBtns) {
      const cls = b.dataset.sgToggle;
      if (cls) root.classList.toggle(cls, b.getAttribute('aria-pressed') === 'true');
    }
  };
  for (const b of toggleBtns) {
    b.addEventListener('click', () => {
      b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      syncToggles();
    });
  }

  /* 叠影滑杆：写在 #sg-echo-zone 上而不是 :root —— 将来若又有脚本按滚动写 --echo，局部值仍优先 */
  const echoZone = document.getElementById('sg-echo-zone');
  const echoInput = document.querySelector<HTMLInputElement>('[data-sg-echo]');
  const echoRead = document.querySelector<HTMLElement>('[data-sg-echo-val]');
  const applyEcho = () => {
    const v = echoInput?.value ?? '0';
    echoZone?.style.setProperty('--echo', v);
    if (echoRead) echoRead.textContent = Number(v).toFixed(2);
  };
  echoInput?.addEventListener('input', applyEcho);

  /* 行内光景滑杆：写在 #sg-inline-fx 的容器上，样张里没写参数的那几处继承它 */
  const fxZone = document.getElementById('sg-inline-fx');
  const fxInputs = [...document.querySelectorAll<HTMLInputElement>('[data-sg-fx]')];
  const applyFx = () => {
    for (const input of fxInputs) {
      const prop = input.dataset.sgFx ?? '';
      const unit = input.dataset.sgUnit ?? '';
      fxZone?.style.setProperty(prop, input.value + unit);
      const read = document.querySelector<HTMLElement>(`[data-sg-fx-val="${prop}"]`);
      if (read) read.textContent = input.value + unit;
    }
    /* 流光的光带宽度（span）在构建期烘焙进每个单元的曲线 --sh-e，改变量本身不生效：
       没写 span 参数的那几段按滑杆值重算（与插件同一个函数） */
    const spanIn = fxInputs.find((i) => i.dataset.sgFx === '--sheen-span');
    if (fxZone && spanIn) {
      const S = Number(spanIn.value) / 100;
      for (const run of fxZone.querySelectorAll<HTMLElement>('.sheen-run')) {
        if (run.style.getPropertyValue('--sheen-span')) continue;
        const steps = Number(run.dataset.steps ?? 0);
        for (const u of run.querySelectorAll<HTMLElement>('.sheen-u')) {
          u.style.setProperty('--sh-e', sheenEase(Number(u.dataset.c), S, steps));
        }
      }
    }
  };
  for (const input of fxInputs) input.addEventListener('input', applyFx);

  document.querySelector('[data-sg-reset]')?.addEventListener('click', () => {
    for (const b of toggleBtns) b.setAttribute('aria-pressed', 'false');
    syncToggles();
    if (echoInput) echoInput.value = '0';
    applyEcho();
    for (const input of fxInputs) input.value = input.defaultValue;
    applyFx();
  });

  addEventListener('resize', fillSizes, { passive: true });
  addEventListener('load', fillSizes, { passive: true });
  fillTokens();
  fillSizes();
  applyEcho();
  applyFx();
</script>
