---
/* ─────────────────────────────────────────────────────────────
   样式预览（/styleguide/）
   把全站「共用的」样式与变体摊在一页上：令牌 · 正文三层 · 通用构件 ·
   醒梦双态 · 全站仪器层。样张里的样式一律现取真实来源
   （tokens.css / global.css / 组件），本页只负责摆框与标注。
   新增样张的约定见 docs/design/styleguide.md —— 一句话：
   在对应的 <GuideSection> 里塞一个 <Spec>，把实物放进它的 slot。

   本页刻意不进 sitemap、robots 禁止收录、也不挂任何站内导航：
   它是工作台，不是内容页。
   ───────────────────────────────────────────────────────────── */
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideSection from '../components/styleguide/GuideSection.astro';
import Spec from '../components/styleguide/Spec.astro';
import Swatch from '../components/styleguide/Swatch.astro';
import StitchHeader from '../components/home/StitchHeader.astro';
import GlassChip from '../components/home/GlassChip.astro';
import ShardMark from '../components/ShardMark.astro';
import YearGroup from '../components/index/YearGroup.astro';
import IndexRow from '../components/index/IndexRow.astro';
import Rail from '../components/chrome/Rail.astro';
import Sound from '../components/chrome/Sound.astro';
import Seam from '../components/chrome/Seam.astro';
import '../styles/styleguide.css';
import Prose from '../styleguide/specimens/prose.md';
import Tasklist from '../styleguide/specimens/tasklist.md';
import TwoSided from '../styleguide/specimens/two-sided.md';
import InlineFx from '../styleguide/specimens/inline-fx.md';
import { ordinalMarkup } from '../markdown/ordinal.mjs';

/* 小节序号样张：01–12 全部由插件那一个函数画出来（set:html），
   所以这排序号与正文里的记号永远同源，不会各自漂移。 */
const ORD_SAMPLES = Array.from({ length: 12 }, (_, i) => i + 1);

/* 目录：加章节时这里加一行，正文里加一个同 id 的 <GuideSection> */
const SECTIONS = [
  { id: 'tokens', n: '一', title: '设计令牌', en: 'TOKENS' },
  { id: 'prose', n: '二', title: '内容页正文', en: 'PROSE · 3 LAYERS' },
  { id: 'parts', n: '三', title: '通用构件', en: 'PARTS' },
  { id: 'dual', n: '四', title: '醒梦双态', en: 'TWO FACES' },
  { id: 'chrome', n: '五', title: '全站仪器层', en: 'CHROME LAYERS' },
  { id: 'local', n: '六', title: '页面专属块', en: 'PAGE-LOCAL' },
];

/* 页面专属块索引：样式写在各自页面的 <style> 里（Astro 作用域隔离），
   本页复用不到，只给实物入口。 */
const LOCAL_BLOCKS = [
  {
    name: '项目封面（δ 波纹 + 幽灵编号）',
    cls: '.coverband .ghostno',
    file: 'pages/projects/[slug].astro',
    to: '/projects/personal-website/',
    at: '项目页 · 封面',
  },
  {
    name: '成形度行与深眠注记',
    cls: '.pin-line .file-note',
    file: 'pages/projects/[slug].astro',
    to: '/projects/personal-website/',
    at: '项目页 · 正文上缘',
  },
  {
    name: '出口区（相关链接 / 项目导航）',
    cls: '.link-list .ll-* .pj-next',
    file: 'pages/projects/[slug].astro',
    to: '/projects/personal-website/',
    at: '项目页 · 文末',
  },
  {
    name: '标签行与醒来卡',
    cls: '.tag-row .wake-card .wc-* .wn-*',
    file: 'pages/articles/[slug].astro',
    to: '/articles/hello-xingmeng/',
    at: '随笔页 · 文末',
  },
  {
    name: '晓线',
    cls: '.dawn-glow',
    file: 'pages/articles/[slug].astro',
    to: '/articles/hello-xingmeng/',
    at: '随笔页 · 全页',
  },
  {
    name: '标签页的结',
    cls: '.knot-head .big-knot',
    file: 'pages/tags/[tag].astro',
    to: '/tags/建站/',
    at: '标签页',
  },
  {
    name: '关于页区块与出口名录',
    cls: '.about-section .about-quote .lead-line .signal-list',
    file: 'pages/about.astro',
    to: '/about/',
    at: '关于页',
  },
  {
    name: '主页各夜段（深色主题作用域）',
    cls: '.band-essays / .band-projects / .band-rem',
    file: 'pages/index.astro',
    to: '/',
    at: '首屏之下的各段',
  },
  {
    name: '玻璃片梯与药丸星座',
    cls: '.ladder .rung .pill .pill-skin',
    file: 'pages/index.astro',
    to: '/',
    at: '浅梦段 / 异相段',
  },
  {
    name: '晨醒出口与手记',
    cls: '.wake-anchor .dawn-card .dawn-line',
    file: 'pages/index.astro',
    to: '/',
    at: '晨醒段',
  },
  {
    name: '首屏千层纸',
    cls: '.ps-* .sheet .ch-wake .ch-dream .note-*',
    file: 'pages/index.astro',
    to: '/',
    at: '首页首屏',
  },
  {
    name: '失线页',
    cls: '.lost .lost-beacon .rethread',
    file: 'pages/404.astro',
    to: '/404.html',
    at: '404',
  },
];
---

<BaseLayout
  title="样式预览 — Traveritas"
  description="站内共用样式与变体的自查页。"
  seam="faint"
  boot={false}
>
  <div class="sg-grid-overlay" aria-hidden="true"></div>

  <div class="sg-body">
    <header class="page-head">
      <h1>样式预览</h1>
      <p class="sg-lede">
        这一页只放<b>共用</b>的东西：全站令牌、内容页正文的公共层与两个变体、通用构件、醒梦双态机制、全站仪器层。
        每一格都标了类名与出处文件，格子里是实物——样式现取真实来源，不在这里另写一份。
      </p>
      <ul class="sg-hints">
        <li>长按空白处 2.2 秒：入梦；同手势 1.3 秒：回醒。下方面板可即时切换同一状态。</li>
        <li>Shift + 空格 = 键盘等价手势；短按 260ms 内完全静默。</li>
        <li>下方面板还能逐层关掉仪器、叠上 8 / 64px 参考线与轮廓。</li>
        <li>新样式怎么加进来：见仓库里 docs/design/styleguide.md；改正文排版前先读的那份地图是 docs/design/content-typography.md。</li>
      </ul>
      <ul class="sg-toc">
        {
          SECTIONS.map((s) => (
            <li>
              <a href={`#sg-${s.id}`}>
                {s.n} · {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <!-- ═══ 一 · 设计令牌 ═══ -->
    <GuideSection
      id="tokens"
      n="一"
      title="设计令牌"
      en="TOKENS"
      note="一条 14° 的发丝线贯穿整站；醒侧冷灰、梦侧暖沙，琥珀是全站唯一的异质色。下面每一格的色票与数值都取自变量本身，切面时数值会跟着变。"
    >
      <Spec
        name="醒梦缝与强调色"
        cls=":root"
        src="styles/tokens.css"
        note="强调色由 reality.ts 按醒度插值逐帧改写：醒面是冷灰的休眠态（--amber 退成 #a7b1ba），梦面才是暖琥珀。--seal 只用于关于页的「醒」章；--wash 是大表面 7% 洗染的指向色。"
      >
        <div class="sg-swatches">
          <Swatch token="--wake" role="醒 · 冷灰" />
          <Swatch token="--dream" role="梦 · 暖沙" />
          <Swatch token="--umber" role="正文里的链接色" />
          <Swatch token="--amber" role="全站唯一异质色：锚点 / 进度 / 焦点" />
          <Swatch token="--seal" role="朱砂 · 仅关于页的「醒」章" />
          <Swatch token="--ghost-ink" role="叠影残影的暖墨" />
          <Swatch token="--wash" role="大表面洗染的醒端指向色" />
        </div>
      </Spec>

      <Spec
        name="面与底线"
        cls=":root"
        src="styles/tokens.css"
        note="--line 是 rgba 的发丝线，色票要在浅底上才看得见。--fg-faint 已从全站文字用途退场（只留给主页夜色系统），正文小字一律 --fg-soft。"
      >
        <div class="sg-swatches">
          <Swatch token="--bg" role="根底色（静态，不随醒度变）" />
          <Swatch token="--bg-sunken" role="行内代码与等宽块的凹底" />
          <Swatch token="--fg" role="正文" />
          <Swatch token="--fg-soft" role="次级文字 / 元信息" />
          <Swatch token="--fg-faint" role="已退场，仅夜色系统留用" />
          <Swatch token="--line" role="发丝线 · 1px 分隔" />
        </div>
      </Spec>

      <Spec
        name="字体"
        cls="--font-display / --font-body / --font-mono / --font-pixel"
        src="styles/tokens.css"
        note="Noto Serif SC 载入 300 / 500 / 600 / 900 四档（正文只要 400，浏览器的隐性字重匹配见 backlog 三.5）；IBM Plex Mono 只载 400，界面上的 mono「粗体」是伪粗体。"
      >
        <div class="sg-fonts">
          <div class="sg-font sg-font--display">
            <div class="sg-font-h">--font-display · 标题与长文正典（宋体）</div>
            <p class="sg-font-sample">在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？</p>
            <span class="sg-font-en">Aa Gg Rr 0123 · Palatino / Songti / Noto Serif SC</span>
          </div>
          <div class="sg-font sg-font--body">
            <div class="sg-font-h">--font-body · 界面与元信息（黑体）</div>
            <p class="sg-font-sample">正在做、做过、以及还只存在于念头里的东西。</p>
            <span class="sg-font-en">system-ui · PingFang SC · Microsoft YaHei</span>
          </div>
          <div class="sg-font sg-font--mono">
            <div class="sg-font-h">--font-mono · 刻度、编号与时刻</div>
            <p class="sg-font-sample">23:07 → 06:31 · N3 δ · 06.8:1</p>
            <span class="sg-font-en">IBM Plex Mono · 只载 400</span>
          </div>
          <div class="sg-font sg-font--pixel">
            <div class="sg-font-h">--font-pixel · 极窄用途</div>
            <p class="sg-font-sample">ERR 404 OUT OF BOUNDS</p>
            <span class="sg-font-en">Silkscreen · 只有拉丁字形</span>
          </div>
        </div>
      </Spec>

      <Spec
        name="度量与骨架"
        cls="--measure / --gap-v / --seam-angle / .container"
        src="styles/tokens.css · global.css"
        note="--measure 是 34em：随笔变体的字号把它折算成 629px、项目 544px（1280 视口实测），两个值是否该一致尚未拍板。下面两条虚线框是 .container 与 .container-wide 的真实宽度。"
      >
        <div class="sg-metrics">
          <div>
            <p class="sg-metric-h">
              <code class="sg-spec-cls">--measure</code><span>列宽 · 34em</span>
              <span class="sg-val" data-sg-w="sg-m-measure">—</span>
            </p>
            <div class="sg-metric-bar" id="sg-m-measure" style="width: var(--measure)"></div>
          </div>
          <div>
            <p class="sg-metric-h">
              <code class="sg-spec-cls">--gap-v</code><span>段落级留白 · clamp(3.5rem, 9vh, 6.5rem)</span>
              <span class="sg-val" data-sg-h="sg-m-gap">—</span>
            </p>
            <div class="sg-metric-gap" id="sg-m-gap" style="height: var(--gap-v)"></div>
          </div>
          <div>
            <p class="sg-metric-h">
              <code class="sg-spec-cls">--seam-angle</code><span>缝线与刻度倾斜 · 14deg</span>
            </p>
            <div class="sg-metric-rule"></div>
          </div>
          <div>
            <p class="sg-metric-h">
              <code class="sg-spec-cls">.container</code><span>长文容器 · min(100% - 3rem, 42rem)</span>
              <span class="sg-val" data-sg-w="sg-m-container">—</span>
            </p>
            <div class="container sg-metric-box" id="sg-m-container">正文列</div>
          </div>
          <div>
            <p class="sg-metric-h">
              <code class="sg-spec-cls">.container-wide</code><span>列表容器 · min(100% - 3rem, 56rem)</span>
              <span class="sg-val" data-sg-w="sg-m-wide">—</span>
            </p>
            <div class="container-wide sg-metric-box" id="sg-m-wide">名录与列表</div>
          </div>
        </div>
      </Spec>
    </GuideSection>

    <!-- ═══ 二 · 内容页正文 ═══ -->
    <GuideSection
      id="prose"
      n="二"
      title="内容页正文"
      en="PROSE · 3 LAYERS"
      note="内页 markdown 容器都是 .md，排版分三层：默认层给非 markdown 长文兜底、公共层写随笔与项目取值一致的部分、变体层只声明两页相异处。<b>同一份样张</b>放在三条管道里，差异一眼可对。全貌与待设计清单见 docs/design/content-typography.md。<br />本轮已补齐（2026-09-25）：<code>ol</code> 保留原生序号、只换成 mono 与 <code>--fg-soft</code>；<code>table</code> 公共层只走横向发丝线、项目侧加成方框板块；<code>figure</code> / <code>figcaption</code> 图注内容由正文自己写、不自动编号；<code>code</code> / <code>pre</code> 随笔是梦色左缘、项目成方框，配色改由 src/markdown/shiki-theme.mjs 指到站内令牌（原先 github-dark 会盖成一块深色板）。<b>小节序号</b>已由构建期注入的「定格漂浮」接管（见下方样张），<code>h3</code> 的记号仍留给自制的「小节」组件的下一层。"
    >
      <div class="sg-cols sg-cols--3">
        <Spec
          name="默认层"
          cls=".prose .md"
          src="styles/global.css · 默认层"
          note="关于页这类非 markdown 长文，以及两页尚未分化的 h3 / ol / code / pre / img / table / figure。"
        >
          <div class="prose">
            <div class="md"><Prose /></div>
          </div>
        </Spec>

        <Spec
          name="随笔 · 宋体夜话"
          cls=".prose--essay"
          src="styles/global.css · 变体层"
          note="clamp(17→18.5px)、行高 2.08、字距 .015em、两端对齐（≤640px 转左对齐）；小节号行内嵌字，与标题同一套字。"
        >
          <div class="prose prose--essay">
            <div class="md"><Prose /></div>
          </div>
        </Spec>

        <Spec
          name="项目 · 黑体方正文"
          cls=".prose--project"
          src="styles/global.css · 变体层"
          note="16px、行高 2.05、字距 .02em；小节号是一枚印章板 + 右侧细线（板宽不随章节数变化），列表符号是 mono 空心圈。"
        >
          <div class="prose prose--project">
            <div class="md"><Prose /></div>
          </div>
        </Spec>
      </div>

      <Spec
        name="小节序号 · 定格漂浮"
        cls=".ord / .ord-digit"
        src="styles/global.css + markdown/ordinal.mjs"
        note="h2 的序号在<b>构建期</b>由 mdast 插件注入（把数字拆成一枚一个 span），所以内容页仍然零客户端 JS——这排样张也是那同一个函数画的。<b>醒与梦共用同一套字</b>：序号吃标题自己的字，是标题那一行的延续；两面的差别只有动与不动——动画常驻，振幅乘 <code>--still</code>：梦面满幅（每枚数字按 1px 整像素阶跃定格漂浮，与品牌字标同一条曲线、0.4s 错相），醒面收到 0。切「醒 / 梦」对看：振幅是连续带过的，所以两面之间不会有一下骤停。因为浮动只走 translate，标题永远不会被推一下，序号也就不需要固定盒。"
      >
        <div class="sg-ord-row">
          {ORD_SAMPLES.map((n) => <span set:html={ordinalMarkup(n)} />)}
        </div>
      </Spec>

      <Spec
        name="页头与元信息"
        cls=".prose-head / .prose-meta / .prose-rule"
        src="styles/global.css"
        note="同一份页头挂在两个变体下。两页的 hr 都只有 --line 那条发丝线（随笔页原有的 3.4rem 琥珀起笔标尺已于 2026-09-25 移除）。"
      >
        <div class="sg-cols sg-cols--2">
          <div class="prose prose--essay">
            <header class="prose-head">
              <h1>在即将醒来的那一瞬</h1>
              <p class="prose-meta">
                <time datetime="2026-09-21">2026.09.21</time>
              </p>
            </header>
            <hr class="prose-rule" />
          </div>
          <div class="prose prose--project">
            <header class="prose-head">
              <h1>个人网站</h1>
              <p class="prose-meta">
                <span class="status">进行中</span> · <time datetime="2026-09-18">2026.09.18</time>
              </p>
            </header>
            <hr class="prose-rule" />
          </div>
        </div>
      </Spec>

      <div class="sg-cols sg-cols--2">
        <Spec
          name="任务清单 · 项目变体"
          cls=".prose--project .md li:has(input)"
          src="styles/global.css · 公共层"
          note="两页同款：原生 checkbox 被藏起，改由 ::before 画符号：○ 未完成 → 琥珀 ✓ 完成。"
        >
          <div class="prose prose--project">
            <div class="md"><Tasklist /></div>
          </div>
        </Spec>

        <Spec
          name="同一份清单 · 随笔变体"
          cls=".prose--essay .md li:has(input)"
          src="styles/global.css · 公共层"
          note="两页同款：随笔侧同样隐藏原生选框，与项目共用一套 ○ / 琥珀 ✓ 进度符号与两档明暗排版。"
        >
          <div class="prose prose--essay">
            <div class="md"><Tasklist /></div>
          </div>
        </Spec>
      </div>

      <Spec
        name="跨页互链块"
        cls=".xfile / .xfile-t"
        src="styles/global.css"
        note="随笔页取值 margin-top 2.6rem，项目页 3rem；标签文案与条目由页面各自给（「关联篇章」/「关联记述」）。"
      >
        <div class="sg-cols sg-cols--2">
          <div class="prose prose--essay">
            <div class="xfile">
              <span class="xfile-t">关联篇章 · RELATED</span>
              <a href="/articles/">在即将醒来的那一瞬</a>
              <a href="/projects/">个人网站</a>
            </div>
          </div>
          <div class="prose prose--project">
            <div class="xfile">
              <span class="xfile-t">关联记述 · RELATED</span>
              <a href="/projects/">醒梦 · 视觉母题探索</a>
            </div>
          </div>
        </div>
      </Spec>
    </GuideSection>

    <!-- ═══ 三 · 通用构件 ═══ -->
    <GuideSection
      id="parts"
      n="三"
      title="通用构件"
      en="PARTS"
      note="跨页复用、已经有自己组件的那些。页头与页脚就在这一页上（随面切换会换文案），不再另做样张。"
    >
      <Spec
        name="站头轴线"
        cls=".stitch-head"
        src="components/home/StitchHeader.astro"
        note="各夜段的段首：一条 -4° 分段轴线从左划出（进视口时 scaleX 0→1），两端 mono 标签，菱形「结」兼作缝线锚点的停靠位。三段的名目与时刻只是取实样，样式与内容无关。"
      >
        <div class="sg-cols sg-cols--3">
          <Spec name="浅梦段" cls=".stitch-head">
            <StitchHeader title="随笔" stage="浅梦 · LIGHT · N1–N2" time="23:19 → 01:11" />
          </Spec>
          <Spec name="深眠段" cls=".stitch-head">
            <StitchHeader title="项目" stage="深眠 · DEEP · N3 δ" time="01:11 → 02:08" />
          </Spec>
          <Spec name="异相段" cls=".stitch-head">
            <StitchHeader title="试验场" stage="异相 · REM · 眼动" time="02:08 → 04:59" />
          </Spec>
        </div>
      </Spec>

      <Spec
        name="玻璃片入口"
        cls=".chip-slot / .chip / .chip-glass"
        src="components/home/GlassChip.astro"
