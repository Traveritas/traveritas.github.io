---
/* ─────────────────────────────────────────────────────────────
   原型 C · 显影薄片（/mock/moments-slides/）
   一则一片磨砂树脂薄片，两列错落：
   · 构建期按顺序左右分发（新的在上），右列下沉 4.5rem 错开；窄屏两列拆回单列，
     用 order 恢复时间顺序（列容器 display: contents）；
   · 配图出血铺在片顶，像显影出来的那一面；文字在下；
   · 越旧越透：--age 把片的底色与字一起压淡。
   配图：MomentGallery（网格）+ MomentLightbox（页尾大图层）。
   ───────────────────────────────────────────────────────────── */
import BaseLayout from '../../layouts/BaseLayout.astro';
import MomentGallery from '../../components/moments/MomentGallery.astro';
import MomentLightbox from '../../components/moments/MomentLightbox.astro';
import { demoMoments, md, full } from './_moments-demo';

const moments = await demoMoments();
const year = moments[0]?.date.getFullYear();
const cols = [moments.filter((_, i) => i % 2 === 0), moments.filter((_, i) => i % 2 === 1)];
const order = new Map(moments.map((m, i) => [m.id, i]));
---

<BaseLayout
  title="瞬间 · 显影薄片 — Traveritas"
  dreamTitle="闪念 — AveritA"
  description="原型 C"
  ambient
  maskLines
  fieldVeil
>
  <div class="container-wide page-body">
    <header class="page-head">
      <h1 data-morph data-true="瞬间" data-dream="闪念">瞬间</h1>
      <p class="lede" data-morph data-true="即逝的直觉、断简与思绪微光。" data-dream="“在即将醒来的那一瞬，尚未串联成篇的散落光斑。”">
        即逝的直觉、断简与思绪微光。
      </p>
    </header>

    <p class="s-year mono">{year}</p>

    <div class="sheets">
      {
        cols.map((col) => (
          <div class="col">
            {col.map((m) => (
              <article class="sheet" id={m.id} style={`--age: ${m.age.toFixed(3)}; order: ${order.get(m.id)}`}>
                {m.images.length > 0 && (
                  <div class="sheet-media">
                    <MomentGallery images={m.images} anchor={m.id} />
                  </div>
                )}
                <div class="sheet-text">
                  <header class="sheet-head">
                    {m.title && <h3 class="sheet-title">{m.title}</h3>}
                    <a class="sheet-date" href={`#${m.id}`} title={full(m.date)}>
                      <time datetime={m.date.toISOString()}>{md(m.date)}</time>
                    </a>
                  </header>
                  <div class="sheet-body md">
                    <m.Content />
                  </div>
                </div>
              </article>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  {moments.map((m) => <MomentLightbox images={m.images} anchor={m.id} />)}
</BaseLayout>

<style>
  .s-year {
    margin: 0 0 2.2rem;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--umber);
  }

  .sheets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.6rem;
    align-items: start;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .col + .col {
    padding-top: 4.5rem;
  }

  /* ── 一片薄片 ── */
  .sheet {
    position: relative;
    overflow: hidden;
    scroll-margin-top: 6rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, calc(0.6 - var(--age) * 0.32));
    border: 1px solid rgba(255, 255, 255, calc(0.85 - var(--age) * 0.35));
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.6),
      0 14px 34px -16px rgba(38, 44, 51, calc(0.12 - var(--age) * 0.07));
    transition:
      background 0.4s ease,
      transform 0.4s ease,
      box-shadow 0.4s ease;
  }

  .sheet:hover,
  .sheet:target {
    background: rgba(255, 255, 255, 0.68);
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.8),
      0 18px 40px -16px rgba(38, 44, 51, 0.14);
  }

  .sheet:target {
    border-color: color-mix(in srgb, var(--amber) 60%, #fff);
  }

  /* 配图出血铺在片顶：网格贴边、缝细一档 */
  .sheet-media :global(.gallery) {
    margin: 0;
    gap: 2px;
    max-width: none;
  }

  .sheet-media :global(.g-cell) {
    border-radius: 0;
  }

  .sheet-media :global(.g-single img) {
    max-height: 24rem;
    object-fit: cover;
  }

  .sheet-text {
    padding: 1.35rem 1.6rem 1.5rem;
    opacity: calc(1 - var(--age) * 0.3);
    transition: opacity 0.4s ease;
  }

  .sheet:hover .sheet-text,
  .sheet:target .sheet-text {
    opacity: 1;
  }

  .sheet-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .sheet-title {
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--fg);
  }

  .sheet-date {
    flex: none;
    margin-left: auto;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
    text-decoration: none;
  }

  .sheet-date:hover,
  .sheet:target .sheet-date {
    color: var(--umber);
  }

  .sheet-body {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.02rem;
    line-height: 1.95;
    letter-spacing: 0.015em;
    color: var(--fg);
  }

  .sheet-body :global(p) {
    margin: 0 0 0.6em;
  }

  .sheet-body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* 窄屏：拆回单列，order 恢复时间顺序 */
  @media (max-width: 760px) {
    .sheets {
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
    }

    .col {
      display: contents;
    }

    .col + .col {
      padding-top: 0;
    }
  }
</style>
