---
/* ─────────────────────────────────────────────────────────────
   原型 A · 散落光斑（/mock/moments-scatter/）
   瞬间是一句一个物件，不是一段一段地读：
   · 左右两道交错，邻居相互咬进 3rem（两道不横向重叠，咬合安全）；
   · 越旧越远：--age 0→1 把不透明度压到 ~0.58、轻微失焦；悬停 / 锚点 / 聚焦时回到清晰，
     并浮出一层极淡的磨砂底（借 C 稿的材质，只在被注视时出现）；
   · 正文用标题字放大成一句一句的造型，日期退到角落。
   配图：MomentGallery（网格）+ MomentLightbox（页尾大图层）。
   ───────────────────────────────────────────────────────────── */
import BaseLayout from '../../layouts/BaseLayout.astro';
import MomentGallery from '../../components/moments/MomentGallery.astro';
import MomentLightbox from '../../components/moments/MomentLightbox.astro';
import { demoMoments, md, full } from './_moments-demo';

const moments = await demoMoments();
const year = moments[0]?.date.getFullYear();
---

<BaseLayout
  title="瞬间 · 散落光斑 — Traveritas"
  dreamTitle="闪念 — AveritA"
  description="原型 A"
  ambient
  maskLines
  fieldVeil
  rail={{ mode: 'station', station: '瞬间 · 异相', en: 'MOMENTS · REM' }}
>
  <div class="container-wide page-body">
    <header class="page-head">
      <h1 data-morph data-true="瞬间" data-dream="闪念">瞬间</h1>
      <p class="lede" data-morph data-true="即逝的直觉、断简与思绪微光。" data-dream="“在即将醒来的那一瞬，尚未串联成篇的散落光斑。”">
        即逝的直觉、断简与思绪微光。
      </p>
    </header>

    <p class="s-year mono">{year}</p>

    <div class="scatter">
      {
        moments.map((m, i) => (
          <article class:list={['spot', i % 2 ? 'lane-r' : 'lane-l']} id={m.id} style={`--age: ${m.age.toFixed(3)}`}>
            {m.title && <h3 class="spot-title">{m.title}</h3>}
            <div class="spot-body md">
              <m.Content />
            </div>
            <MomentGallery images={m.images} anchor={m.id} />
            <a class="spot-date" href={`#${m.id}`} title={full(m.date)}>
              <span class="ghost" aria-hidden="true">
                {md(m.date)}
              </span>
              <time datetime={m.date.toISOString()}>{md(m.date)}</time>
            </a>
          </article>
        ))
      }
    </div>
  </div>

  {moments.map((m) => <MomentLightbox images={m.images} anchor={m.id} />)}
</BaseLayout>

<style>
  .s-year {
    margin: 0 0 2.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--umber);
  }

  .scatter {
    display: flex;
    flex-direction: column;
    padding-bottom: 2rem;
  }

  /* ── 一枚光斑 ── */
  .spot {
    position: relative;
    isolation: isolate;
    width: min(100%, 25rem);
    min-height: 7rem;
    scroll-margin-top: 7rem;
    opacity: calc(1 - var(--age) * 0.42);
    filter: blur(calc(var(--age) * 0.6px));
    transition:
      opacity 0.7s ease,
      filter 0.7s ease;
  }

  /* 两道交错，邻居咬进 3rem；同道内再按 4 拍错开一点 */
  .spot + .spot {
    margin-top: -3rem;
  }

  .lane-l {
    align-self: flex-start;
    margin-left: var(--j, 0);
  }

  .lane-r {
    align-self: flex-end;
    margin-right: var(--j, 0);
  }

  .spot:nth-child(4n + 2) {
    --j: 3rem;
  }

  .spot:nth-child(4n + 3) {
    --j: 5rem;
  }

  .spot:nth-child(4n) {
    --j: 1rem;
  }

  /* 被注视：回到清晰，浮出一层极淡的磨砂底 */
  .spot:hover,
  .spot:target,
  .spot:focus-within {
    opacity: 1;
    filter: none;
  }

  .spot::before {
    content: '';
    position: absolute;
    inset: -1.3rem -1.5rem;
    z-index: -1;
    border-radius: 6px;
    background: color-mix(in srgb, #fff 42%, transparent);
    border: 1px solid color-mix(in srgb, #fff 70%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .spot:hover::before,
  .spot:target::before {
    opacity: 1;
  }

  .spot-title {
    margin: 0 0 0.55rem;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--umber);
  }

  .spot-body {
    max-width: 19em;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.2rem;
    line-height: 1.9;
    letter-spacing: 0.02em;
    color: var(--fg);
  }

  .spot-body :global(p) {
    margin: 0 0 0.6em;
  }

  .spot-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .spot-date {
    position: relative;
    display: inline-block;
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--fg-soft);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ghost {
    position: absolute;
    inset: 0;
    color: var(--ghost-ink);
    opacity: 0;
    pointer-events: none;
    transform: translate(-5px, 3px);
    filter: blur(0.4px);
    transition:
      opacity 0.55s ease,
      transform 0.55s ease;
  }

  .spot:hover .spot-date,
  .spot:target .spot-date {
    color: var(--umber);
  }

  .spot:hover .ghost {
    opacity: 0.5;
    transform: translate(4px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .ghost {
      display: none;
    }
  }

  /* 窄屏：单道，左右只留一点错落；不咬合、不失焦 */
  @media (max-width: 760px) {
    .spot {
      width: 100%;
      filter: none;
      opacity: calc(1 - var(--age) * 0.25);
    }

    .spot + .spot {
      margin-top: 3.2rem;
    }

    .lane-l {
      margin-left: 0;
    }

    .lane-r {
      margin-right: 0;
      padding-left: 1.4rem;
    }

    .spot-body {
      font-size: 1.1rem;
    }
  }
</style>
