---
/* ─────────────────────────────────────────────────────────────
   原型 · floatwin 场景首屏（/mock/scene-floatwin/）
   复制自 src/pages/new.astro（经 quiet 原型的网格），只重做场 0：首屏即入口 ——
   四扇半透明小窗悬在一轮极淡的圆光前，沿那根线错落挂着、沿线极轻地漂。
   说明见 design/mocks/scene-floatwin-notes.md。
   以下为主稿原注：
   主页 · 一根线的一夜（故事板）—— 定稿自 design/mocks/p25-thread-storyboard.html
   （五幕骨架）+ p27-membrane-glyphs.html（开屏「膜」与渐变字形）。
   · 五幕 = 五个 sticky 舞台（入夜 / 断章 / 造物 / 闪念 / 晨醒），相邻两幕首尾叠一屏；
     滚动写各幕的 --p，编排全在 CSS 里对 --p 的 calc。
   · 背景的脑电线就是全站那条线（同一套 eeg-wave 算法、同一个 Worker），只是在主页
     沿一条随幕变化的骨架走：开屏是过中心的 14° 直线，往下弯成竖线，晨醒拐成底线。
   · 驱动脚本：src/scripts/home-storyboard.ts。
   ───────────────────────────────────────────────────────────── */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RealityGuide from '../../components/home/RealityGuide.astro';
import { getCollection } from 'astro:content';

const byDate = <T extends { id: string; data: { date: Date } }>(a: T, b: T) =>
  b.data.date.valueOf() - a.data.date.valueOf() || b.id.localeCompare(a.id);

const allArticles = (await getCollection('articles', (a) => !a.data.draft)).sort(byDate);
const allProjects = (await getCollection('projects', (p) => !p.data.draft)).sort(byDate);
const allMoments = (await getCollection('moments', (m) => !m.data.draft)).sort(byDate);

const articles = allArticles.slice(0, 3);
const projects = allProjects.slice(0, 3);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const fmtShort = (d: Date) => `${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const fmtMomentTime = (d: Date) =>
  `${fmtShort(d)} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;

/* 八阶成形 / 浮现度 */
const depthOf = (status: string) => ({ 构想中: 2, 进行中: 5, 已完成: 8 })[status] ?? 3;
const repoOf = (links: { href: string }[]) => links.some((l) => /^https:\/\/github\.com\//.test(l.href));

/* 闪念摘句：去掉两态块与行内语法，只留醒面文字 */
function snippet(md: string, maxLen = 64): string {
  const clean = md
    .replace(/:::(dream|wake)[\s\S]*?:::/g, '')
    .replace(/^#{1,6}\s+.+$/gm, '')
    .replace(/\[\[([^|[\]]+)\|([^|[\]]+)\]\]/g, '$1')
    .replace(/\(\(([^()|]+)(\|[^()]*)?\)\)/g, '$1')
    .replace(/\{\{([^{}|]+)(\|[^{}]*)?\}\}/g, '$1')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`#>-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return clean.length <= maxLen ? clean : clean.slice(0, maxLen).trim() + '…';
}

/* 闪念：最多 7 张，左右交错挂在线两侧。
   窗口半宽（幕内进度）：全显 W0 / 散尽 W1。七张的中心在 [散尽, 1 − 散尽] 里等距铺开、
   两头各留 EDGE 的余量 —— 第一张的浮起与最后一张的散场因此都完整落在幕内（--p ∈ 0..1），
   最后一张不会再「没散完就被舞台带走」。窄屏另备一组（W0M / W1M）：手机上七张只有两行
   站位，窗口不收窄的话，同一行会同时停着两张。 */
const W0 = 0.075;
const W1 = 0.23;
const W0M = 0.028;
const W1M = 0.085;
const EDGE = 0.02;

/* 一行 ＝ 一张便签的全部手艺：站位 / 静姿倾角 · 入场（横移 + 附加倾角）· 散场（同）。
   入场都从自己这一侧斜着来、散场往另一侧走 —— 左右两张因此总是相向而行，交错着看过去
   就是「互相穿过」；行程的长短与倾角各不相同，七张不会像一套机械装置。附加倾角只在飘的
   过程里带上，落位时回到静姿 --tilt。 */
const SLIP_POS = [
  { x: '15vw', y: '33svh', tilt: '-1deg', in: ['-22vw', '-7deg'], out: ['15vw', '4.5deg'] },
  { x: '61vw', y: '25svh', tilt: '.9deg', in: ['20vw', '6deg'], out: ['-14vw', '-4deg'] },
  { x: '17vw', y: '58svh', tilt: '.7deg', in: ['-16vw', '-5deg'], out: ['18vw', '5.5deg'] },
  { x: '62vw', y: '53svh', tilt: '-.8deg', in: ['18vw', '5.5deg'], out: ['-20vw', '-6deg'] },
  { x: '12.5vw', y: '46svh', tilt: '1.2deg', in: ['-24vw', '-7.5deg'], out: ['13vw', '4deg'] },
  { x: '59vw', y: '39svh', tilt: '-1deg', in: ['16vw', '4.5deg'], out: ['-18vw', '-5.5deg'] },
  { x: '19vw', y: '26svh', tilt: '.6deg', in: ['-14vw', '-4.5deg'], out: ['21vw', '6.5deg'] },
];
const nSlip = Math.min(allMoments.length, 7);
const moments = allMoments.slice(0, nSlip).map((m, i) => {
  const s = SLIP_POS[i];
  const c = nSlip > 1 ? W1 + EDGE + (i * (1 - 2 * (W1 + EDGE))) / (nSlip - 1) : 0.5;
  return {
    id: m.id,
    title: m.data.title,
    tag: m.data.tags[0],
    time: fmtMomentTime(m.data.date),
    text: snippet(m.body ?? ''),
    c: c.toFixed(3),
    vars: `--x:${s.x};--y:${s.y};--tilt:${s.tilt};--dxin:${s.in[0]};--drin:${s.in[1]};--dxout:${s.out[0]};--drout:${s.out[1]}`,
  };
});

const exits = [
  { name: 'GitHub', href: 'https://github.com/Traveritas', addr: 'github.com/Traveritas', external: true },
  { name: '本站源码', href: 'https://github.com/Traveritas/traveritas.github.io', addr: 'traveritas.github.io', external: true },
  { name: 'RSS', href: '/rss.xml', addr: '/rss.xml', external: false },
  { name: '关于此处 →', href: '/about/', addr: '/about/', external: false },
];

const manifesto = '在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？';

/* ── 场 0 · 悬浮窗：四个版块各一扇窗，挂在开屏那根 14° 线上 ──
   --x 为窗的吊线落在线上的横坐标（中栏左沿 --g + n 栏），side 为窗在线上方 / 下方，
   --gap 为窗沿到线的距离，--w 窗宽，--z 景深（0 近 … 1 远：越远越小、越淡、影越散），
   --t / --ph 为漂流周期与相位（互不同步）。窄屏另有一组站位写在 CSS 里。 */
const fwins = [
  {
    key: 'about',
    no: '04',
    href: '/about/',
    wake: '关于',
    dream: '此身',
    badge: 'PRESENCE',
    side: 'up',
    vars: '--x:calc(var(--g) + 1 * var(--col));--gap:84px;--w:196px;--z:.85;--t:23s;--ph:-7s',
    rows: [{ t: '知觉的留白，与「醒梦」', d: '' }],
    foot: '此处 →',
  },
  {
    key: 'articles',
    no: '01',
    href: '/articles/',
    wake: '随笔',
    dream: '断章',
    badge: 'SAYABLE',
    side: 'up',
    vars: '--x:calc(var(--g) + 6 * var(--col));--gap:56px;--w:288px;--z:0;--t:17s;--ph:-3s',
    rows: allArticles.slice(0, 2).map((a) => ({ t: a.data.title, d: fmtShort(a.data.date) })),
    foot: `共 ${allArticles.length} 篇 →`,
  },
  {
    key: 'moments',
    no: '02',
    href: '/moments/',
    wake: '瞬间',
    dream: '闪念',
    badge: 'EPHEMERAL',
    side: 'up',
    vars: '--x:calc(var(--g) + 11 * var(--col));--gap:44px;--w:236px;--z:.55;--t:29s;--ph:-11s',
    rows: allMoments.slice(0, 1).map((m) => ({ t: snippet(m.body ?? '', 30), d: fmtMomentTime(m.data.date) })),
    foot: `共 ${allMoments.length} 则 →`,
  },
  {
    key: 'projects',
    no: '03',
    href: '/projects/',
    wake: '项目',
    dream: '造物',
    badge: 'BUILDABLE',
    side: 'down',
    vars: '--x:calc(var(--g) + 13 * var(--col));--gap:60px;--w:256px;--z:.3;--t:19s;--ph:-5s',
    rows: allProjects.slice(0, 2).map((p) => ({ t: p.data.title, d: `${depthOf(p.data.status)}/8` })),
    foot: `共 ${allProjects.length} 件 →`,
  },
];
---

<BaseLayout
  title="Traveritas的个人网页"
  dreamTitle="AveritA的昼梦叙集"
  description={manifesto}
  seam="none"
  constructs="none"
  rail={{ mode: 'night' }}
>
  <div class="atmo" aria-hidden="true">
    <div class="fog f1"></div>
    <div class="fog f2"></div>
    <div class="dawnlight"></div>
  </div>

  <div class="home">
    <!-- ═══ 场 0 · 23:07 入夜：一根线、一句话；醒与梦只是线两侧的两枚小注 ═══ -->
    <section class="scene s-hero" id="ns-hero" data-scene="0" style="--len:230svh">
      <div class="stage">
        <p class="sr-only">Traveritas的个人网页 —— 随笔、项目，与正在成形的东西。</p>
        <div class="orb" aria-hidden="true"><i class="orb-w"></i><i class="orb-d"></i></div>
        <div class="qset">
          <div class="qhead rise" aria-hidden="true">
            <span class="cap">入夜 · 23:07</span>
          </div>
          <h1 class="q" id="hero-line">
            <span class="ql">在即将醒来的那一瞬，</span><span class="ql">世界究竟是在<em>成形</em>，</span><span class="ql">还是正在<em>融化</em>？</span>
          </h1>
          <span class="qmeta rise" aria-hidden="true">随笔、项目，与正在成形的东西</span>
        </div>
        <nav class="fwins" aria-label="版块">
          {
            fwins.map((w, k) => (
              <a class={`fw fw-${w.side} fw-${w.key}`} href={w.href} style={`${w.vars};--k:${k}`}>
                <span class="fw-in">
                  <span class="fw-h">
                    <span class="no">{w.no}</span>
                    <span class="nm" data-morph data-true={w.wake} data-dream={w.dream}>
                      {w.wake}
                    </span>
                    <span class="bd">{w.badge}</span>
                  </span>
                  <span class="fw-b">
                    {w.rows.map((r) => (
                      <span class="row">
                        <span class="rt">{r.t}</span>
                        {r.d && <span class="rd">{r.d}</span>}
                      </span>
                    ))}
                  </span>
                  <span class="fw-f">{w.foot}</span>
                </span>
              </a>
            ))
          }
        </nav>
        <RealityGuide />
      </div>
    </section>

    <!-- ═══ 场 1 · 浅梦 · 断章：线在左，三篇同屏 ═══ -->
    <section class="scene s-essays side" id="ns-essays" data-scene="1" style="--len:280svh">
      <div class="stage">
        <div class="chap in-out">
          <span class="cap">浅梦 · 23:19 — 01:11</span>
          <h2>断章</h2>
        </div>
        <div class="essays">
          {
            articles.map((a, j) => (
              <a class="essay" href={`/articles/${a.id}/`} style={`--j:${j}`}>
                <span class="no">{String(j + 1).padStart(2, '0')}</span>
                <div>
                  <span class="meta">{[fmt(a.data.date), ...a.data.tags].join(' · ')}</span>
                  <h3>{a.data.title}</h3>
                  {a.data.description && <p>{a.data.description}</p>}
                </div>
              </a>
            ))
          }
          <div class="more"><a class="all" href="/articles/">全部断章 →</a></div>
        </div>
      </div>
    </section>

    <!-- ═══ 场 2 · 深眠 · 造物：同断章，线在左，晶板从右侧浮现 ═══ -->
    <section class="scene s-projects side" id="ns-projects" data-scene="2" style="--len:320svh">
      <div class="stage">
        <div class="chap in-out">
          <span class="cap">深眠 · 01:11 — 02:08</span>
          <h2>造物</h2>
        </div>
        <div class="slabs">
          {
            projects.map((p, j) => {
              const depth = depthOf(p.data.status);
              const repo = repoOf(p.data.links);
              return (
                <a class="slab" href={`/projects/${p.id}/`} style={`--j:${j};--depth:${depth}`}>
                  <div class="win">
                    <svg data-lily={3 + j * 4} viewBox="-100 -100 200 200" preserveAspectRatio="xMidYMid slice" />
                    <div class="fogv" />
                  </div>
                  <div class="slab-body">
                    <div class="slab-head">
                      <span>{fmt(p.data.date)}</span>
                      <span>{p.data.status}</span>
                    </div>
                    <div>
                      <h3>{p.data.title}</h3>
                      {p.data.description && <p>{p.data.description}</p>}
                    </div>
                    <div class="depth">
                      <span>
                        浮现度 <b>{depth}</b>/8
                      </span>
                      <span>{repo ? '✓ 公开仓库' : '○ 暂无公开'}</span>
                    </div>
                  </div>
                </a>
              );
            })
          }
          <div class="more"><a class="all" href="/projects/">全部造物 →</a></div>
        </div>
      </div>
    </section>

    <!-- ═══ 场 3 · 异相 · 闪念：线居中，便签左右交错闪现 ═══ -->
    <section class="scene s-rem" id="ns-rem" data-scene="3" style="--len:380svh">
      <div class="stage" data-w0={String(W0)} data-w1={String(W1)} data-w0m={String(W0M)} data-w1m={String(W1M)}>
        <div class="chap in-out">
          <h2>闪念</h2>
          <span class="cap">异相 · 02:08 — 04:59</span>
        </div>
        {
          moments.map((m) => (
            <a
              class="slip"
              href={`/moments/#${m.id}`}
              data-c={m.c}
              style={m.vars}
            >
              <span class="h">
                <span>{m.time}</span>
                {m.tag && <em>#{m.tag}</em>}
              </span>
              {m.title && <b>{m.title}</b>}
              <span class="t">{m.text}</span>
            </a>
          ))
        }
        <div class="more in-out"><a class="all" href="/moments/">全部闪念 →</a></div>
      </div>
    </section>

    <!-- ═══ 场 4 · 06:31 晨醒：线从左上垂下、拐成标题下的底线 ═══ -->
    <section class="scene s-dawn" id="ns-dawn" data-scene="4" style="--len:200svh">
      <div class="stage">
        <div class="d-head dz">
          <div class="time">06:31 · 晨光</div>
          <h2
            data-morph
            data-faces="注视持续得太久。被注视之物微微退开。|在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？|世界随时可能消失，又随时重新被记起。"
          >
            注视持续得太久。被注视之物微微退开。
          </h2>
        </div>
        <div class="d-body dz">
          <div class="exits">
            {
              exits.map((x) => (
                <a href={x.href} target={x.external ? '_blank' : undefined} rel={x.external ? 'noopener' : undefined}>
                  {x.name}
                  <small>{x.addr}</small>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 目录（常规文档流） ═══ -->
    <section class="dir">
      <div class="index">
        <div>
          <h4><a href="/articles/">断章</a></h4>
          <ul>
            {
              allArticles.slice(0, 6).map((a) => (
                <li>
                  <a href={`/articles/${a.id}/`}>
                    {a.data.title}
                    <span>{fmtShort(a.data.date)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h4><a href="/projects/">造物</a></h4>
          <ul>
            {
              allProjects.slice(0, 6).map((p) => (
                <li>
                  <a href={`/projects/${p.id}/`}>
                    {p.data.title}
                    <span>{depthOf(p.data.status)}/8</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h4><a href="/moments/">闪念</a></h4>
          <ul>
            {
              allMoments.slice(0, 3).map((m) => (
                <li>
                  <a href={`/moments/#${m.id}`}>
                    {m.data.title ?? snippet(m.body ?? '', 14)}
                    <span>{fmtShort(m.data.date)}</span>
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/moments/">全部闪念 →<span></span></a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initFloatwin } from '../../scripts/proto/scene-floatwin';

  /* 晶板窗口里的抽象百合（花瓣长度 / 开角抖动，避免机械放射对称） */
  let seed = 1;
  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  document.querySelectorAll<SVGSVGElement>('svg[data-lily]').forEach((svg) => {
    const id = svg.dataset.lily ?? '3';
    seed = Number(id) * 997;
    let out = `<defs><radialGradient id="pg${id}"><stop offset="0" stop-color="#f3e6d6" stop-opacity=".55"/><stop offset="1" stop-color="#a9b8d6" stop-opacity=".08"/></radialGradient></defs>`;
    const k = 5 + Math.floor(rnd() * 2);
    const rot0 = rnd() * 60;
    for (let i = 0; i < k; i++) {
      const a = rot0 + (i * 360) / k + (rnd() - 0.5) * 22;
      const L = 62 + rnd() * 26;
      const w = 16 + rnd() * 10;
      const bend = (rnd() - 0.5) * 18;
      out += `<path transform="rotate(${a.toFixed(1)})" d="M0 0 C ${w} ${-L * 0.3}, ${w * 0.6 + bend} ${-L * 0.85}, ${bend} ${-L} C ${-w * 0.6 + bend} ${-L * 0.85}, ${-w} ${-L * 0.3}, 0 0Z" fill="url(#pg${id})" stroke="#e6ecf7" stroke-opacity=".45" stroke-width=".8"/>`;
    }
    svg.innerHTML = out + '<circle r="5" fill="#d9a05b" fill-opacity=".7"/>';
  });

  initFloatwin();
</script>

<style is:global>
  /* 主页文字不参与选择（入口/链接照常可点）——长按入梦可从任意文字处起手 */
  html body {
    user-select: none;
    -webkit-user-select: none;
  }

  /* 页头叠压首屏（其余页维持文档流页头） */
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
  }

  .defs {
    position: absolute;
  }

  .home .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── 环境层：雾 / 晨光（取代构块场） ── */
  .atmo {
    position: fixed;
    inset: 0;
    z-index: -3;
    pointer-events: none;
    overflow: hidden;
  }
  .atmo .fog {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow, rgba(255, 255, 255, 0.75)), transparent);
  }
  .atmo .f1 {
    width: 70vmax;
    height: 50vmax;
    left: -20vmax;
    top: -12vmax;
    animation: home-fog1 38s ease-in-out infinite alternate;
  }
  .atmo .f2 {
    width: 60vmax;
    height: 44vmax;
    right: -22vmax;
    bottom: -14vmax;
    animation: home-fog2 46s ease-in-out infinite alternate;
  }
  @keyframes home-fog1 {
    to {
      transform: translate3d(8vmax, 6vmax, 0);
    }
  }
  @keyframes home-fog2 {
    to {
      transform: translate3d(-10vmax, -4vmax, 0);
    }
  }
  .atmo .dawnlight {
    position: absolute;
    inset: -10% -10% auto;
    height: 90%;
    opacity: var(--dawn, 0);
    background: radial-gradient(60% 70% at 50% 0%, rgba(255, 214, 160, 0.55), rgba(255, 232, 205, 0.2) 45%, transparent 75%);
  }

  /* ── 场与舞台 ── */
  .home .scene {
    position: relative;
    height: var(--len);
  }
  /* 相邻两幕首尾叠一屏：上一幕舞台离开的同时下一幕舞台已钉住 */
  .home .scene + .scene {
    margin-top: -100svh;
  }
  .home .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .home .cap {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    color: var(--fg-soft);
  }
  .home .in-out {
    opacity: calc(clamp(0, calc(var(--p) / 0.08), 1) * clamp(0, calc((1 - var(--p)) / 0.08), 1));
  }
  .home .all {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.18em;
    border-bottom: 1px solid var(--amber);
    padding-bottom: 3px;
    text-decoration: none;
    color: var(--fg);
  }
  .home a {
    text-decoration: none;
  }

  /* 窗口函数：--c 为本镜中心，--w0 全显半宽，--w1 散尽半宽（皆由幕上的 data-w*
     按屏宽写进来，见前台 W0 / W1 / W0M / W1M）。消费它的只有便签：
     显影走 --a（线性），位移与倾角走 .slip 里的 --f / --s（带缓动）。 */
  .home [data-c] {
    --d: calc(var(--p) - var(--c));
    --ad: max(var(--d), calc(var(--d) * -1));
    --a: clamp(0, calc((var(--w1) - var(--ad)) / (var(--w1) - var(--w0))), 1);
    opacity: var(--a);
    pointer-events: none;
  }
  .home [data-c].on {
    pointer-events: auto;
  }

  /* ═══ 场 0 · 入夜 · floatwin ═══
     首屏即入口：四个版块各一扇半透明小窗，挂在开屏那根 14° 线上（吊线垂到线上，线上留一粒小珠），
     背后一轮极淡的圆光；问句是最大一级排版，独占左下，与窗不重叠。
     网格沿用 quiet：中栏左沿 --g（与页头 42rem 同沿）、12 栏 --col，窗的吊线落在栏线上（可越出中栏右延）。
     线高：x 处 ＝ 50svh + (x − 50vw)·tan14°（--ly）。
     动的只有：窗沿线方向的极轻漂流（transform 关键帧，四扇周期互不同步）、圆光的呼吸（opacity）；
     滚动时窗沿线向左收拢、淡出（--p 驱动 transform / opacity）。离开首屏后（html.fw-off）全部暂停。 */
  .s-hero {
    --t14: 0.2493;
    --g: max(24px, calc((100vw - 42rem) / 2));
    --col: calc((100vw - 2 * var(--g)) / 12);
    /* 收拢进度：滚过开屏的前 30% 里窗沿线收走 */
    --cp: clamp(0, calc((var(--p) - 0.03) / 0.3), 1);
  }

  /* ── 圆光：一轮极淡的大圆，醒面冷白、梦面微暖；在线之后（z 与雾同层，在线画布之下） ── */
  .orb {
    --R: min(66svh, 46vw);
    position: absolute;
    z-index: -3;
    left: calc(var(--g) + 10.5 * var(--col) - var(--R) / 2);
    top: calc(45svh - var(--R) / 2);
    width: var(--R);
    height: var(--R);
    pointer-events: none;
    opacity: calc(1 - var(--cp));
  }
  .orb i {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  .orb-w {
    /* 一团被雾稀释的光：中心偏左上最亮，边缘不画线，只在 96%–100% 收出一圈极软的界 */
    background: radial-gradient(
      circle at 42% 38%,
      rgba(255, 255, 255, 0.95),
      rgba(255, 255, 255, 0.62) 26%,
      rgba(252, 253, 255, 0.3) 58%,
      rgba(250, 252, 255, 0.14) 84%,
      rgba(250, 252, 255, 0.08) 97%,
      rgba(250, 252, 255, 0) 100%
    );
    box-shadow: 0 0 180px 60px rgba(255, 255, 255, 0.32);
    opacity: var(--reality-mix, 1);
  }
  .orb-d {
    background: radial-gradient(
      circle at 46% 42%,
      rgba(255, 246, 238, 0.92),
      rgba(250, 226, 216, 0.52) 30%,
      rgba(240, 214, 210, 0.26) 62%,
      rgba(236, 210, 205, 0.13) 86%,
      rgba(236, 210, 205, 0.07) 97%,
      rgba(236, 210, 205, 0) 100%
    );
    box-shadow: 0 0 180px 50px rgba(250, 228, 220, 0.45);
    opacity: calc(1 - var(--reality-mix, 1));
  }
  .orb {
    visibility: hidden;
  }
  html.booted .orb {
    visibility: visible;
    animation: fw-orb-in 2.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s backwards;
  }
  /* 呼吸放在里层（外层 opacity 留给滚动） */
  html.booted .orb-w,
  html.booted .orb-d {
    animation: fw-breathe 14s ease-in-out 3s infinite alternate;
  }
  @keyframes fw-orb-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
  @keyframes fw-breathe {
    to {
      transform: scale(1.015);
    }
  }

  /* ── 问句与两行元信息：左下，贴中栏左沿 ── */
  .qset {
    position: absolute;
    left: var(--g);
    bottom: clamp(44px, 12svh, 112px);
    display: flex;
    flex-direction: column;
    gap: 20px;
    pointer-events: none;
    opacity: calc(1 - clamp(0, calc((var(--p) - 0.06) / 0.2), 1));
  }
  .q {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.5rem, 2.25vw, 2.15rem);
    line-height: 1.75;
    letter-spacing: 0.16em;
    color: var(--fg);
    white-space: nowrap;
  }
  .q .ql {
    display: block;
  }
  .q .ql:first-child {
    color: var(--fg-soft);
  }
  .q em {
    font-style: normal;
    color: color-mix(in srgb, var(--fg) 55%, var(--umber));
  }
  .q .c {
    display: inline-block;
    opacity: 0;
  }
  html.booted .q .c {
    animation: q-drip 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(1.3s + var(--i) * 40ms);
  }
  @keyframes q-drip {
    from {
      opacity: 0;
      transform: translateY(-0.4em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .rise {
    opacity: 0;
  }
  html.booted .rise {
    animation: q-rise 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  html.booted .qhead {
    animation-delay: 0.9s;
  }
  html.booted .qmeta {
    animation-delay: 2.6s;
  }
  @keyframes q-rise {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .qmeta {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 13px;
    letter-spacing: 0.14em;
    color: var(--fg-soft);
  }

  /* ── 窗 ──
     外层 .fw：站位 + 滚动收拢（沿线向 30vw 处收、缩一点、淡出）；
     里层 .fw-in：窗身 + 入场显影（opacity）+ 沿线漂流（transform）。
     漂流方向就是线的方向（cos14°, sin14°）—— 吊线的下端因此始终落在线上。 */
  .fwins {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .fw {
    --ly: calc(50svh + (var(--x) - 50vw) * var(--t14));
    /* 吊线在窗宽上的位置（0 左沿 … 1 右沿）；窗以吊线为轴站位 */
    --tx: 0.5;
    /* 沿线左移的行程：收拢时窗顺着线被带走一小段 */
    --run: 7vw;
    position: absolute;
    left: calc(var(--x) - var(--w) * var(--tx));
    width: var(--w);
    display: block;
    color: var(--fg);
    text-decoration: none;
    pointer-events: auto;
    /* 景深 + 收拢都以线上那粒小珠为原点缩放：远的窗小一号，收拢时窗缩回自己的珠子里 */
    transform-origin: calc(var(--tx) * 100%) calc(100% + var(--gap));
    transform: translate(calc(var(--cp) * var(--run) * -0.9703), calc(var(--cp) * var(--run) * -0.2419))
      scale(calc((1 - var(--z) * 0.12) * (1 - var(--cp) * 0.7)));
    opacity: calc(1 - var(--cp) * 1.7);
  }
  .fw-up {
    bottom: calc(100svh - var(--ly) + var(--gap));
  }
  .fw-down {
    top: calc(var(--ly) + var(--gap));
    transform-origin: calc(var(--tx) * 100%) calc(-1 * var(--gap));
  }
  .fw-in {
    --a: 7px;
    position: relative;
    display: block;
    padding: 13px 16px 11px;
    border-radius: 2px;
    /* 醒面冷白、梦面微暖（--reality-mix：1 醒 / 0 梦）；越远越薄 */
    --tint: color-mix(in srgb, #ffffff calc(var(--reality-mix, 1) * 100%), #f8e9e3);
    /* 树脂薄片：左上一道斜向受光、右下透出背后；边只在上沿与左沿亮一线 */
    background:
      linear-gradient(118deg, rgba(255, 255, 255, 0.32), rgba(255, 255, 255, 0) 42%),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--tint) calc(48% - var(--z) * 18%), transparent),
        color-mix(in srgb, var(--tint) calc(22% - var(--z) * 10%), transparent)
      );
    border: 1px solid transparent;
    border-top-color: color-mix(in srgb, var(--tint) calc(92% - var(--z) * 30%), transparent);
    border-left-color: color-mix(in srgb, var(--tint) calc(70% - var(--z) * 30%), transparent);
    border-bottom-color: color-mix(in srgb, var(--fg) 4%, transparent);
    border-right-color: color-mix(in srgb, var(--tint) 30%, transparent);
    box-shadow: 0 calc(22px + var(--z) * 12px) calc(46px + var(--z) * 24px) -22px
      rgba(36, 44, 60, calc(0.16 - var(--z) * 0.07));
    opacity: 0;
    transition:
      background-color 0.4s,
      border-color 0.4s;
  }
  html.booted .fw-in {
    opacity: calc(1 - var(--z) * 0.4);
    animation:
      fw-develop 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) backwards,
      fw-drift var(--t) ease-in-out infinite;
    animation-delay: calc(1.5s + var(--k) * 0.22s), var(--ph);
  }
  @keyframes fw-develop {
    from {
      opacity: 0;
    }
  }
  @keyframes fw-drift {
    0%,
    100% {
      transform: translate(calc(var(--a) * -0.9703), calc(var(--a) * -0.2419));
    }
    50% {
      transform: translate(calc(var(--a) * 0.9703), calc(var(--a) * 0.2419));
    }
  }
  /* 吊线 + 线上的小珠 */
  .fw-in::before {
    content: '';
    position: absolute;
    left: calc(var(--tx) * 100%);
    width: 1px;
    height: var(--gap);
    background: linear-gradient(var(--fg-soft), transparent);
    opacity: 0.32;
  }
  .fw-up .fw-in::before {
    top: 100%;
  }
  .fw-down .fw-in::before {
    bottom: 100%;
    background: linear-gradient(transparent, var(--fg-soft));
  }
  .fw-in::after {
    content: '';
    position: absolute;
    left: calc(var(--tx) * 100% - 2.5px);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--fg-soft) 70%, transparent);
    background: var(--bg);
  }
  .fw-up .fw-in::after {
    top: calc(100% + var(--gap) - 3px);
  }
  .fw-down .fw-in::after {
    bottom: calc(100% + var(--gap) - 3px);
  }

  .fw-h {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-bottom: 9px;
    margin-bottom: 9px;
    border-bottom: 1px solid color-mix(in srgb, var(--fg) 9%, transparent);
  }
  .fw-h .no,
  .fw-h .bd,
  .fw-f,
  .fw .rd {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.22em;
    color: var(--fg-soft);
  }
  .fw-h .nm {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 14.5px;
    letter-spacing: 0.24em;
    color: var(--fg);
  }
  .fw-h .bd {
    margin-left: auto;
    font-size: 8.5px;
    letter-spacing: 0.26em;
    opacity: 0.75;
  }
  .fw-b {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .fw .row {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .fw .rt {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 13px;
    line-height: 1.8;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--fg) 86%, transparent);
  }
  /* 单条的窗（瞬间 / 关于）：时刻在上一行，正文最多两行 */
  .fw-moments .row,
  .fw-about .row {
    flex-direction: column;
    gap: 2px;
  }
  .fw-moments .rd {
    order: -1;
  }
  .fw-moments .rt,
  .fw-about .rt {
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .fw-f {
    display: block;
    margin-top: 8px;
    text-align: right;
    transition: color 0.4s;
  }
  .fw:hover .fw-in,
  .fw:focus-visible .fw-in {
    border-color: color-mix(in srgb, var(--tint) 100%, transparent);
    background-color: color-mix(in srgb, var(--tint) 30%, transparent);
  }
  .fw:hover .fw-f,
  .fw:focus-visible .fw-f {
    color: var(--umber);
  }
  .fw:focus-visible {
    outline: none;
  }
  .fw:focus-visible .fw-in {
    outline: 1px solid var(--fg);
    outline-offset: 5px;
  }

  /* 离开首屏：漂流与呼吸全部停下（滚回来再续） */
  html.fw-off .fw-in,
  html.fw-off .orb-w,
  html.fw-off .orb-d {
    animation-play-state: paused;
  }

  .s-hero .reality-guide {
    opacity: calc(1 - clamp(0, calc((var(--p) - 0.06) / 0.14), 1));
  }

  /* ═══ 场 1 · 断章 / 场 2 · 造物：线在左，章名竖排在线左侧 ═══ */
  .side .chap {
    position: absolute;
    left: clamp(110px, 13vw, 200px);
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
  }
  .home .chap h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    letter-spacing: 0.3em;
    color: color-mix(in srgb, var(--fg) 32%, transparent);
  }
  .side .chap h2 {
    writing-mode: vertical-rl;
    font-size: clamp(50px, 6vw, 90px);
  }
  .side .chap .cap {
    writing-mode: vertical-rl;
  }
  .essays,
  .slabs {
    position: absolute;
    left: 37vw;
    right: 8vw;
    top: 52%;
    transform: translate3d(0, calc(-50% + (var(--p) - 0.5) * -8svh), 0);
  }
  .essays .more,
  .slabs .more {
    margin-top: 1.2rem;
    opacity: calc(clamp(0, calc((var(--p) - 0.3) / 0.12), 1) * clamp(0, calc((1 - var(--p)) / 0.1), 1));
  }
  .essay {
    --r: clamp(0, calc((var(--p) - 0.06 - var(--j) * 0.07) / 0.16), 1);
    --out: clamp(0, calc((0.96 - var(--p) + var(--j) * 0.02) / 0.1), 1);
    position: relative;
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0 1.2rem;
    padding: 1.6rem 0;
    color: var(--fg);
    opacity: calc(var(--r) * var(--out));
    filter: blur(calc((1 - var(--r)) * 6px));
    transform: translate3d(calc((1 - var(--r)) * 3vw), 0, 0);
  }
  .essay + .essay {
    border-top: 1px solid var(--line);
  }
  .essay .no {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 2.2rem;
    line-height: 1;
    color: color-mix(in srgb, var(--fg) 22%, transparent);
    transition: color 0.3s;
  }
  .essay:hover .no {
    color: var(--amber);
  }
  .essay .meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    color: var(--fg-soft);
    margin-bottom: 0.6rem;
  }
  .essay h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.35rem, 2.2vw, 2.05rem);
    line-height: 1.3;
    letter-spacing: 0.04em;
    transition: color 0.3s;
  }
  .essay:hover h3 {
    color: var(--umber);
  }
  .essay p {
    margin: 0;
    max-width: 34em;
    font-family: var(--font-display);
    font-size: clamp(0.88rem, 1.05vw, 0.98rem);
    line-height: 1.85;
    color: var(--fg-soft);
  }

  .slabs {
    display: grid;
    gap: clamp(12px, 2svh, 20px);
  }
  .slab {
    --r: clamp(0, calc((var(--p) - 0.06 - var(--j) * 0.08) / 0.18), 1);
    --out: clamp(0, calc((0.96 - var(--p) + var(--j) * 0.02) / 0.1), 1);
    --dev: clamp(0, calc((var(--p) - 0.3) / 0.38), 1);
    --sfg: #e6e9ef;
    --sfg-soft: #9aa6b8;
    color: var(--sfg);
    display: grid;
    grid-template-columns: minmax(0, 34%) minmax(0, 1fr);
    height: clamp(150px, 21svh, 200px);
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.03));
    border: 1px solid rgba(255, 255, 255, 0.13);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 30px 60px -30px rgba(0, 0, 0, 0.6);
    opacity: calc(var(--r) * var(--out));
    filter: blur(calc((1 - var(--r)) * 6px));
    transform: translate3d(calc((1 - var(--r)) * 9vw), 0, 0);
    transition: border-color 0.3s;
  }
  .slab:hover {
    border-color: color-mix(in srgb, var(--amber) 60%, transparent);
  }
  .slab .win {
    position: relative;
    min-height: 0;
    background: radial-gradient(120% 90% at 30% 20%, #34405a, #1a2030 70%);
    overflow: hidden;
  }
  .slab .win svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: blur(calc((1 - var(--dev) * var(--depth) / 8) * 14px));
    opacity: calc(0.3 + var(--dev) * var(--depth) / 8 * 0.7);
  }
  .slab .fogv {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(170, 185, 210, 0.25), rgba(120, 135, 160, 0.1));
    opacity: calc(1 - var(--dev) * var(--depth) / 8);
  }
  .slab-body {
    padding: 16px 22px 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 6px;
    min-width: 0;
  }
  .slab-head,
  .slab .depth {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--sfg-soft);
  }
  .slab .depth {
    padding-top: 6px;
    border-top: 1px solid rgba(230, 233, 239, 0.14);
  }
  .slab .depth b {
    font-weight: 500;
    color: var(--amber);
  }
  .slab h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    letter-spacing: 0.04em;
  }
  .slab p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.84rem;
    line-height: 1.7;
    color: var(--sfg-soft);
  }

  /* ═══ 场 3 · 闪念：线居中，便签左右交错闪现 ═══ */
  .s-rem .chap {
    position: absolute;
    left: 14vw;
    top: 14svh;
    display: flex;
    align-items: baseline;
    gap: 20px;
  }
  .s-rem .chap h2 {
