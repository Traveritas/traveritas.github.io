---
/* ─────────────────────────────────────────────────────────────
   原型 · submerged 场景首屏（/mock/scene-submerged/）
   复制自 hero-quiet.astro（网格与小注沿用），只重做场 0：那根线是一道水面。
   水上：雾与极淡的天光、问句；水下：浅青灰的水体、斜射光柱、悬着的半透明板、深处的细立柱。
   滚动时水面缓缓上漫（线与水体同一个公式），再交给第 1 幕的竖线。
   说明见 design/mocks/scene-submerged-notes.md。
   以下为主稿原注：
   主页 · 一根线的一夜（故事板）—— 定稿自 design/mocks/p25-thread-storyboard.html
   （五幕骨架）+ p27-membrane-glyphs.html（开屏「膜」与渐变字形）。
   · 五幕 = 五个 sticky 舞台（入夜 / 断章 / 造物 / 闪念 / 晨醒），相邻两幕首尾叠一屏；
     滚动写各幕的 --p，编排全在 CSS 里对 --p 的 calc。
   · 背景的脑电线就是全站那条线（同一套 eeg-wave 算法、同一个 Worker），只是在主页
     沿一条随幕变化的骨架走：开屏是过中心的 14° 直线，往下弯成竖线，晨醒拐成底线。
   · 驱动脚本：src/scripts/home-storyboard.ts。
   ───────────────────────────────────────────────────────────── */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RealityGuide from '../../components/home/RealityGuide.astro';
import { getCollection } from 'astro:content';

const byDate = <T extends { id: string; data: { date: Date } }>(a: T, b: T) =>
  b.data.date.valueOf() - a.data.date.valueOf() || b.id.localeCompare(a.id);

const allArticles = (await getCollection('articles', (a) => !a.data.draft)).sort(byDate);
const allProjects = (await getCollection('projects', (p) => !p.data.draft)).sort(byDate);
const allMoments = (await getCollection('moments', (m) => !m.data.draft)).sort(byDate);

const articles = allArticles.slice(0, 3);
const projects = allProjects.slice(0, 3);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const fmtShort = (d: Date) => `${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const fmtMomentTime = (d: Date) =>
  `${fmtShort(d)} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;

/* 八阶成形 / 浮现度 */
const depthOf = (status: string) => ({ 构想中: 2, 进行中: 5, 已完成: 8 })[status] ?? 3;
const repoOf = (links: { href: string }[]) => links.some((l) => /^https:\/\/github\.com\//.test(l.href));

/* 闪念摘句：去掉两态块与行内语法，只留醒面文字 */
function snippet(md: string, maxLen = 64): string {
  const clean = md
    .replace(/:::(dream|wake)[\s\S]*?:::/g, '')
    .replace(/^#{1,6}\s+.+$/gm, '')
    .replace(/\[\[([^|[\]]+)\|([^|[\]]+)\]\]/g, '$1')
    .replace(/\(\(([^()|]+)(\|[^()]*)?\)\)/g, '$1')
    .replace(/\{\{([^{}|]+)(\|[^{}]*)?\}\}/g, '$1')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`#>-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return clean.length <= maxLen ? clean : clean.slice(0, maxLen).trim() + '…';
}

/* 闪念：最多 7 张，左右交错挂在线两侧。
   窗口半宽（幕内进度）：全显 W0 / 散尽 W1。七张的中心在 [散尽, 1 − 散尽] 里等距铺开、
   两头各留 EDGE 的余量 —— 第一张的浮起与最后一张的散场因此都完整落在幕内（--p ∈ 0..1），
   最后一张不会再「没散完就被舞台带走」。窄屏另备一组（W0M / W1M）：手机上七张只有两行
   站位，窗口不收窄的话，同一行会同时停着两张。 */
const W0 = 0.075;
const W1 = 0.23;
const W0M = 0.028;
const W1M = 0.085;
const EDGE = 0.02;

/* 一行 ＝ 一张便签的全部手艺：站位 / 静姿倾角 · 入场（横移 + 附加倾角）· 散场（同）。
   入场都从自己这一侧斜着来、散场往另一侧走 —— 左右两张因此总是相向而行，交错着看过去
   就是「互相穿过」；行程的长短与倾角各不相同，七张不会像一套机械装置。附加倾角只在飘的
   过程里带上，落位时回到静姿 --tilt。 */
const SLIP_POS = [
  { x: '15vw', y: '33svh', tilt: '-1deg', in: ['-22vw', '-7deg'], out: ['15vw', '4.5deg'] },
  { x: '61vw', y: '25svh', tilt: '.9deg', in: ['20vw', '6deg'], out: ['-14vw', '-4deg'] },
  { x: '17vw', y: '58svh', tilt: '.7deg', in: ['-16vw', '-5deg'], out: ['18vw', '5.5deg'] },
  { x: '62vw', y: '53svh', tilt: '-.8deg', in: ['18vw', '5.5deg'], out: ['-20vw', '-6deg'] },
  { x: '12.5vw', y: '46svh', tilt: '1.2deg', in: ['-24vw', '-7.5deg'], out: ['13vw', '4deg'] },
  { x: '59vw', y: '39svh', tilt: '-1deg', in: ['16vw', '4.5deg'], out: ['-18vw', '-5.5deg'] },
  { x: '19vw', y: '26svh', tilt: '.6deg', in: ['-14vw', '-4.5deg'], out: ['21vw', '6.5deg'] },
];
const nSlip = Math.min(allMoments.length, 7);
const moments = allMoments.slice(0, nSlip).map((m, i) => {
  const s = SLIP_POS[i];
  const c = nSlip > 1 ? W1 + EDGE + (i * (1 - 2 * (W1 + EDGE))) / (nSlip - 1) : 0.5;
  return {
    id: m.id,
    title: m.data.title,
    tag: m.data.tags[0],
    time: fmtMomentTime(m.data.date),
    text: snippet(m.body ?? ''),
    c: c.toFixed(3),
    vars: `--x:${s.x};--y:${s.y};--tilt:${s.tilt};--dxin:${s.in[0]};--drin:${s.in[1]};--dxout:${s.out[0]};--drout:${s.out[1]}`,
  };
});

const exits = [
  { name: 'GitHub', href: 'https://github.com/Traveritas', addr: 'github.com/Traveritas', external: true },
  { name: '本站源码', href: 'https://github.com/Traveritas/traveritas.github.io', addr: 'traveritas.github.io', external: true },
  { name: 'RSS', href: '/rss.xml', addr: '/rss.xml', external: false },
  { name: '关于此处 →', href: '/about/', addr: '/about/', external: false },
];

const manifesto = '在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？';
---

<BaseLayout
  title="Traveritas的个人网页"
  dreamTitle="AveritA的昼梦叙集"
  description={manifesto}
  seam="none"
  constructs="none"
  rail={{ mode: 'night' }}
>

  <div class="atmo" aria-hidden="true">
    <div class="fog f1"></div>
    <div class="fog f2"></div>
    <div class="dawnlight"></div>
  </div>

  <!-- 场 0 的水：固定层，压在脑电线（z −2）之下，线正好是它的上沿。
       脚本只写两枚变量：--wl（水面高，px）与 --rise（滚动时水面上漫的距离，px） -->
  <div class="sea" aria-hidden="true">
    <div class="sky"></div>
    <div class="mist"><i class="m1"></i><i class="m2"></i></div>
    <div class="body">
      <div class="water w-wake"></div>
      <div class="water w-dream"></div>
      <div class="pillars">
        <i style="--x:9%;--t:44svh;--w:7px;--o:.34;--b:1.6px"></i>
        <i style="--x:22.5%;--t:30svh;--w:12px;--o:.55;--b:.6px"></i>
        <i style="--x:33.5%;--t:50svh;--w:5px;--o:.26;--b:2.2px"></i>
        <i style="--x:63%;--t:46svh;--w:6px;--o:.3;--b:1.8px"></i>
        <i style="--x:76%;--t:35svh;--w:10px;--o:.46;--b:.9px"></i>
        <i style="--x:91%;--t:54svh;--w:5px;--o:.22;--b:2.4px"></i>
      </div>
      <div class="shafts">
        <i style="--x:12%;--w:9vw;--h:78svh;--o:.55;--d:0s;--T:13s"></i>
        <i style="--x:29%;--w:3.2vw;--h:60svh;--o:.45;--d:-4s;--T:9s"></i>
        <i style="--x:45%;--w:14vw;--h:86svh;--o:.36;--d:-7s;--T:17s"></i>
        <i style="--x:71%;--w:5vw;--h:70svh;--o:.5;--d:-2s;--T:11s"></i>
      </div>
      <!-- 悬板：近 / 中 / 远三层，越远越淡、越糊、越染水色 -->
      <svg class="plate p-far" viewBox="0 0 120 150" style="--x:81%;--y:24svh;--w:clamp(70px,7vw,110px);--T:23s;--d:-9s">
        <defs>
          <linearGradient id="sg-pf" x1="0" y1="0" x2=".6" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity=".5"></stop><stop offset="1" stop-color="#cfe0e3" stop-opacity=".08"></stop>
          </linearGradient>
          <filter id="sg-pfb" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="2.2"></feGaussianBlur></filter>
        </defs>
        <g filter="url(#sg-pfb)">
          <path d="M18 6 L96 14 L112 58 L88 138 L40 146 L10 84 Z" fill="url(#sg-pf)"></path>
          <path d="M18 6 L96 14 L112 58" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="1.2"></path>
        </g>
      </svg>
      <svg class="plate p-mid" viewBox="0 0 160 120" style="--x:17%;--y:17svh;--w:clamp(110px,10.5vw,160px);--T:19s;--d:-5s">
        <defs>
          <linearGradient id="sg-pm" x1="0" y1="0" x2=".8" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity=".62"></stop><stop offset=".55" stop-color="#e3eeef" stop-opacity=".2"></stop><stop offset="1" stop-color="#bcd2d6" stop-opacity=".06"></stop>
          </linearGradient>
          <filter id="sg-pmb" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation=".8"></feGaussianBlur></filter>
        </defs>
        <g filter="url(#sg-pmb)">
          <path d="M8 30 L70 8 L150 22 L142 74 L96 112 L22 98 Z" fill="url(#sg-pm)"></path>
          <path d="M8 30 L70 8 L150 22" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="1"></path>
          <path d="M70 8 L84 64 L142 74 M84 64 L22 98" fill="none" stroke="#fff" stroke-opacity=".22" stroke-width=".8"></path>
        </g>
      </svg>
      <svg class="plate p-near" viewBox="0 0 200 300" style="--x:50%;--y:5svh;--w:clamp(150px,14vw,230px);--T:27s;--d:-12s">
        <defs>
          <linearGradient id="sg-pn" x1=".1" y1="0" x2=".7" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity=".72"></stop><stop offset=".4" stop-color="#eef5f5" stop-opacity=".3"></stop><stop offset="1" stop-color="#c4d8db" stop-opacity=".05"></stop>
          </linearGradient>
          <linearGradient id="sg-pne" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity=".95"></stop><stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <path d="M30 10 L150 4 L188 52 L172 168 L128 292 L84 286 L46 196 L12 88 Z" fill="url(#sg-pn)"></path>
        <path d="M30 10 L150 4 L188 52 L172 168" fill="none" stroke="url(#sg-pne)" stroke-width="1.1"></path>
        <path d="M12 88 L30 10" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width=".9"></path>
        <path d="M150 4 L118 120 L172 168 M118 120 L46 196 M118 120 L128 292" fill="none" stroke="#fff" stroke-opacity=".2" stroke-width=".8"></path>
      </svg>
      <div class="motes">
        <i style="--x:21%;--y:62svh;--T:26s;--d:-3s"></i>
        <i style="--x:38%;--y:48svh;--T:31s;--d:-17s"></i>
        <i style="--x:54%;--y:70svh;--T:22s;--d:-9s"></i>
        <i style="--x:69%;--y:58svh;--T:35s;--d:-24s"></i>
        <i style="--x:84%;--y:66svh;--T:28s;--d:-12s"></i>
        <i style="--x:12%;--y:74svh;--T:33s;--d:-20s"></i>
      </div>
      <!-- 问句的倒影：贴着水面倒挂。倒影里「成形」与「融化」换了位置 -->
      <div class="refl"><p class="refl-q"><span>在即将醒来的那一瞬，</span><span>世界究竟是在<em>融化</em>，</span><span>还是正在<em>成形</em>？</span></p></div>
      <div class="sheen"></div>
    </div>
  </div>

  <div class="home">
    <!-- ═══ 场 0 · 23:07 入夜：线是一道水面。水上是雾与一句话，水下是光与悬着的东西 ═══ -->
    <section class="scene s-hero" id="ns-hero" data-scene="0" style="--len:230svh">
      <div class="stage">
        <p class="sr-only">Traveritas的个人网页 —— 随笔、项目，与正在成形的东西。</p>
        <i class="wl-mark" aria-hidden="true"></i>
        <div class="qset">
          <h1 class="q" id="hero-line">
            <span class="ql">在即将醒来的那一瞬，</span><span class="ql">世界究竟是在<em>成形</em>，</span><span class="ql">还是正在<em>融化</em>？</span>
          </h1>
          <div class="mk mk-wake rise" aria-hidden="true">
            <b>醒</b><span>06:31</span>
          </div>
          <div class="mk mk-dream rise" aria-hidden="true">
            <b>梦</b><span>23:07</span>
          </div>
          <div class="qmeta rise" aria-hidden="true">
            <span class="cap">入夜 · 23:07</span>
            <span class="desc">随笔、项目，<br />与正在成形的东西</span>
          </div>
          <span class="qidx rise" aria-hidden="true">00 / 05</span>
        </div>
        <RealityGuide />
      </div>
    </section>

    <!-- ═══ 场 1 · 浅梦 · 断章：线在左，三篇同屏 ═══ -->
    <section class="scene s-essays side" id="ns-essays" data-scene="1" style="--len:280svh">
      <div class="stage">
        <div class="chap in-out">
          <span class="cap">浅梦 · 23:19 — 01:11</span>
          <h2>断章</h2>
        </div>
        <div class="essays">
          {
            articles.map((a, j) => (
              <a class="essay" href={`/articles/${a.id}/`} style={`--j:${j}`}>
                <span class="no">{String(j + 1).padStart(2, '0')}</span>
                <div>
                  <span class="meta">{[fmt(a.data.date), ...a.data.tags].join(' · ')}</span>
                  <h3>{a.data.title}</h3>
                  {a.data.description && <p>{a.data.description}</p>}
                </div>
              </a>
            ))
          }
          <div class="more"><a class="all" href="/articles/">全部断章 →</a></div>
        </div>
      </div>
    </section>

    <!-- ═══ 场 2 · 深眠 · 造物：同断章，线在左，晶板从右侧浮现 ═══ -->
    <section class="scene s-projects side" id="ns-projects" data-scene="2" style="--len:320svh">
      <div class="stage">
        <div class="chap in-out">
          <span class="cap">深眠 · 01:11 — 02:08</span>
          <h2>造物</h2>
        </div>
        <div class="slabs">
          {
            projects.map((p, j) => {
              const depth = depthOf(p.data.status);
              const repo = repoOf(p.data.links);
              return (
                <a class="slab" href={`/projects/${p.id}/`} style={`--j:${j};--depth:${depth}`}>
                  <div class="win">
                    <svg data-lily={3 + j * 4} viewBox="-100 -100 200 200" preserveAspectRatio="xMidYMid slice" />
                    <div class="fogv" />
                  </div>
                  <div class="slab-body">
                    <div class="slab-head">
                      <span>{fmt(p.data.date)}</span>
                      <span>{p.data.status}</span>
                    </div>
                    <div>
                      <h3>{p.data.title}</h3>
                      {p.data.description && <p>{p.data.description}</p>}
                    </div>
                    <div class="depth">
                      <span>
                        浮现度 <b>{depth}</b>/8
                      </span>
                      <span>{repo ? '✓ 公开仓库' : '○ 暂无公开'}</span>
                    </div>
                  </div>
                </a>
              );
            })
          }
          <div class="more"><a class="all" href="/projects/">全部造物 →</a></div>
        </div>
      </div>
    </section>

    <!-- ═══ 场 3 · 异相 · 闪念：线居中，便签左右交错闪现 ═══ -->
    <section class="scene s-rem" id="ns-rem" data-scene="3" style="--len:380svh">
      <div class="stage" data-w0={String(W0)} data-w1={String(W1)} data-w0m={String(W0M)} data-w1m={String(W1M)}>
        <div class="chap in-out">
          <h2>闪念</h2>
          <span class="cap">异相 · 02:08 — 04:59</span>
        </div>
        {
          moments.map((m) => (
            <a
              class="slip"
              href={`/moments/#${m.id}`}
              data-c={m.c}
              style={m.vars}
            >
              <span class="h">
                <span>{m.time}</span>
                {m.tag && <em>#{m.tag}</em>}
              </span>
              {m.title && <b>{m.title}</b>}
              <span class="t">{m.text}</span>
            </a>
          ))
        }
        <div class="more in-out"><a class="all" href="/moments/">全部闪念 →</a></div>
      </div>
    </section>

    <!-- ═══ 场 4 · 06:31 晨醒：线从左上垂下、拐成标题下的底线 ═══ -->
    <section class="scene s-dawn" id="ns-dawn" data-scene="4" style="--len:200svh">
      <div class="stage">
        <div class="d-head dz">
          <div class="time">06:31 · 晨光</div>
          <h2
            data-morph
            data-faces="注视持续得太久。被注视之物微微退开。|在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？|世界随时可能消失，又随时重新被记起。"
          >
            注视持续得太久。被注视之物微微退开。
          </h2>
        </div>
        <div class="d-body dz">
          <div class="exits">
            {
              exits.map((x) => (
                <a href={x.href} target={x.external ? '_blank' : undefined} rel={x.external ? 'noopener' : undefined}>
                  {x.name}
                  <small>{x.addr}</small>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 目录（常规文档流） ═══ -->
    <section class="dir">
      <div class="index">
        <div>
          <h4><a href="/articles/">断章</a></h4>
          <ul>
            {
              allArticles.slice(0, 6).map((a) => (
                <li>
                  <a href={`/articles/${a.id}/`}>
                    {a.data.title}
                    <span>{fmtShort(a.data.date)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h4><a href="/projects/">造物</a></h4>
          <ul>
            {
              allProjects.slice(0, 6).map((p) => (
                <li>
                  <a href={`/projects/${p.id}/`}>
                    {p.data.title}
                    <span>{depthOf(p.data.status)}/8</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h4><a href="/moments/">闪念</a></h4>
          <ul>
            {
              allMoments.slice(0, 3).map((m) => (
                <li>
                  <a href={`/moments/#${m.id}`}>
                    {m.data.title ?? snippet(m.body ?? '', 14)}
                    <span>{fmtShort(m.data.date)}</span>
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/moments/">全部闪念 →<span></span></a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initSubmerged } from '../../scripts/proto/scene-submerged';

  /* 晶板窗口里的抽象百合（花瓣长度 / 开角抖动，避免机械放射对称） */
  let seed = 1;
  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  document.querySelectorAll<SVGSVGElement>('svg[data-lily]').forEach((svg) => {
    const id = svg.dataset.lily ?? '3';
    seed = Number(id) * 997;
    let out = `<defs><radialGradient id="pg${id}"><stop offset="0" stop-color="#f3e6d6" stop-opacity=".55"/><stop offset="1" stop-color="#a9b8d6" stop-opacity=".08"/></radialGradient></defs>`;
    const k = 5 + Math.floor(rnd() * 2);
    const rot0 = rnd() * 60;
    for (let i = 0; i < k; i++) {
      const a = rot0 + (i * 360) / k + (rnd() - 0.5) * 22;
      const L = 62 + rnd() * 26;
      const w = 16 + rnd() * 10;
      const bend = (rnd() - 0.5) * 18;
      out += `<path transform="rotate(${a.toFixed(1)})" d="M0 0 C ${w} ${-L * 0.3}, ${w * 0.6 + bend} ${-L * 0.85}, ${bend} ${-L} C ${-w * 0.6 + bend} ${-L * 0.85}, ${-w} ${-L * 0.3}, 0 0Z" fill="url(#pg${id})" stroke="#e6ecf7" stroke-opacity=".45" stroke-width=".8"/>`;
    }
    svg.innerHTML = out + '<circle r="5" fill="#d9a05b" fill-opacity=".7"/>';
  });

  initSubmerged();
</script>

