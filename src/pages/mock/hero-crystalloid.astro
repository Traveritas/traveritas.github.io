---
/* ─────────────────────────────────────────────────────────────
   新首页首屏 · 右侧圆区域前景主体 Hero 原型与变体评测
   专为评测前景主体设计：剥离其余复杂幕式，完整保留圆光、地平线与低饱和氛围。
   支持 4 套高完成度 3D/伪3D 变体，支持连续醒/梦解构插值与交互旋转。
   ───────────────────────────────────────────────────────────── */

import BaseLayout from '../../layouts/BaseLayout.astro';

const manifesto = '在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？';

const variants = [
  {
    key: 'octahedron',
    num: '01',
    name: '八面体解构晶',
    sub: 'Octahedron Cleavage',
    desc: '原初构想的顶级打磨。8 块实心四面体晶片。醒态咬合为修长正八面冰晶；梦态顺着外法向解构错位、悬停漂移，内部显露出 14° 微温光丝。',
    tag: '几何纯粹 · 八方解离',
  },
  {
    key: 'asymmetric',
    num: '02',
    name: '非对称断层晶簇',
    sub: 'Sculptural Cleavage Quartz',
    desc: '打破正多面体刻板感。5 块大小不一的矿物晶块，如天然冰洲石。醒态成形为极具现代雕塑感的单体；梦态沿地质解理面斜向滑移，各块带不同惯性漂游。',
    tag: '地质雕塑 · 解理滑移',
  },
  {
    key: 'lenses',
    num: '03',
    name: '多层悬浮透镜组',
    sub: 'Planar Optical Lenses',
    desc: '直接呼应右侧圆光。4 片超薄磨砂光学透镜与微刻光阑。醒态同心致密叠合为高折射晶币；梦态沿视线深度 Z 轴拉开离焦，透射光环交叠微散。',
    tag: '光学显影 · 离焦光阑',
  },
  {
    key: 'petal',
    num: '04',
    name: '晶化百合苞片',
    sub: 'Crystalline Petal Bud',
    desc: '将自然物记忆融入半透明树脂。4 片修长曲面晶瓣。醒态合拢为 Brancusi 雕塑般静穆的花苞；梦态失重剥离散开，犹如水下漂散的花瓣残片。',
    tag: '植物记忆 · 凝固绽放',
  },
];
---

<BaseLayout
  title="Hero 主体原型与变体评测 · 醒梦"
  dreamTitle="Hero 主体原型与变体评测 · 昼梦"
  description={manifesto}
  seam="none"
  constructs="none"
>
  <div class="mock-atmo" aria-hidden="true">
    <div class="fog f1"></div>
    <div class="fog f2"></div>
  </div>

  <main class="mock-stage">
    <!-- 左侧：控制面板与设计评注（不干扰视觉主体） -->
    <aside class="panel">
      <header class="panel-header">
        <span class="badge mono">PROTOTYPE · HERO LAB</span>
        <h1 class="title">首屏圆区主体 · 变体评测</h1>
        <p class="manifesto">{manifesto}</p>
      </header>

      <!-- 变体切换 -->
      <section class="sec">
        <div class="sec-label mono">01 / SELECT VARIANT · 选择变体</div>
        <div class="variant-grid">
          {
            variants.map((v) => (
              <button
                type="button"
                class="btn-var"
                data-var={v.key}
                aria-pressed={v.key === 'octahedron' ? 'true' : 'false'}
              >
                <div class="bv-top">
                  <span class="bv-num mono">{v.num}</span>
                  <span class="bv-tag">{v.tag}</span>
                </div>
                <div class="bv-name">{v.name}</div>
                <div class="bv-sub mono">{v.sub}</div>
              </button>
            ))
          }
        </div>
      </section>

      <!-- 醒 ↔ 梦 滑块 -->
      <section class="sec">
        <div class="sec-head">
          <span class="sec-label mono">02 / STATE MORPH · 状态解构</span>
          <span class="val-label mono" id="dream-pct">0% · 醒态凝固</span>
        </div>
        <div class="slider-wrap">
          <span class="sl-tag mono">醒 · 成形</span>
          <input
            type="range"
            id="slider-dream"
            min="0"
            max="1"
            step="0.005"
            value="0"
            aria-label="醒梦解构程度"
          />
          <span class="sl-tag mono">梦 · 融化</span>
        </div>
        <div class="btn-group">
          <button type="button" class="btn-sub active" id="btn-wake">醒态 (凝固)</button>
          <button type="button" class="btn-sub" id="btn-dream">梦态 (错位)</button>
          <button type="button" class="btn-sub" id="btn-loop">自律呼吸循环</button>
        </div>
      </section>

      <!-- 交互控制 -->
      <section class="sec sec-compact">
        <div class="sec-label mono">03 / VIEW & SHADER · 视角与光影</div>
        <div class="toggles">
          <label class="toggle-item">
            <input type="checkbox" id="chk-rotate" checked />
            <span class="chk-box"></span>
            <span class="toggle-text">微速自转 (Auto Spin)</span>
          </label>
          <label class="toggle-item">
            <input type="checkbox" id="chk-wire" checked />
            <span class="chk-box"></span>
            <span class="toggle-text">棱面微光刻线 (Facet Edges)</span>
          </label>
          <button type="button" class="btn-text mono" id="btn-reset">重置视角 ↺</button>
        </div>
      </section>

      <!-- 评注卡片 -->
      <section class="sec-card">
        <div class="card-title mono" id="card-title">01 · 八面体解构晶</div>
        <p class="card-desc" id="card-desc">
          原初构想的顶级打磨。8 块实心四面体晶片。醒态咬合为修长正八面冰晶；梦态顺着外法向解构错位、悬停漂移，内部显露出 14° 微温光丝。
        </p>
      </section>
    </aside>

    <!-- 右侧舞台：前景主体 3D Canvas 与居中圆光 -->
    <div class="hero-canvas-wrap" id="canvas-container">
      <div class="env-hz-line" aria-hidden="true"></div>
      <div class="env-sun-glow" aria-hidden="true"></div>
      <div class="env-sun-disc" aria-hidden="true"></div>
      <div class="drag-hint mono" id="drag-hint">✣ 拖拽旋转视角 · 滚轮微调距离</div>
    </div>
  </main>
</BaseLayout>

<style>
  :root {
    --panel-w: 430px;
    --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --font-serif: 'Noto Serif SC', Source Han Serif SC, STSong, serif;
    --amber: #cca36e;
    --amber-soft: rgba(204, 163, 110, 0.22);
    --line-subtle: rgba(140, 130, 120, 0.18);
  }

  .mock-atmo {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .fog {
    position: absolute;
    inset: -20%;
    background: radial-gradient(circle at 60% 45%, rgba(240, 235, 230, 0.08), transparent 70%);
  }

  .mock-stage {
    position: relative;
    width: 100vw;
    height: 100svh;
    display: flex;
    overflow: hidden;
    background: #171514;
    color: #e5dfd8;
    user-select: none;
  }



  /* ═══ 左侧控制面板 ═══ */
  .panel {
    position: relative;
    z-index: 10;
    width: var(--panel-w);
    height: 100%;
    padding: 38px 34px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 22px;
    overflow-y: auto;
    background: rgba(22, 20, 19, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-right: 1px solid var(--line-subtle);
    box-sizing: border-box;
  }

  .badge {
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--amber);
    display: block;
    margin-bottom: 8px;
  }

  .title {
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.12em;
    margin: 0 0 10px;
    color: #f7f3ee;
  }

  .manifesto {
    font-family: var(--font-serif);
    font-size: 13px;
    line-height: 1.6;
    color: #9c938a;
    margin: 0;
  }

  .sec {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .sec-label {
    font-size: 10.5px;
    letter-spacing: 0.18em;
    color: #8c8278;
  }

  .val-label {
    font-size: 11px;
    color: var(--amber);
  }

  /* 变体网格按钮 */
  .variant-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .btn-var {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    padding: 10px 11px;
    text-align: left;
    cursor: pointer;
    transition: all 0.22s ease;
    color: #d8d0c7;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .btn-var:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(204, 163, 110, 0.35);
  }

  .btn-var[aria-pressed='true'] {
    background: rgba(204, 163, 110, 0.1);
    border-color: var(--amber);
    box-shadow: 0 0 16px rgba(204, 163, 110, 0.12);
  }

  .bv-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .bv-num {
    font-size: 10px;
    color: var(--amber);
  }

  .bv-tag {
    font-size: 9.5px;
    color: #7b7269;
  }

  .bv-name {
    font-size: 13px;
    font-weight: 500;
    color: #eee9e3;
    margin-top: 2px;
  }

  .bv-sub {
    font-size: 9px;
    letter-spacing: 0.04em;
    color: #8a8075;
  }

  /* 滑块与预设 */
  .slider-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .sl-tag {
    font-size: 11px;
    color: #7b7269;
    white-space: nowrap;
  }

  input[type='range'] {
    flex: 1;
    -webkit-appearance: none;
    appearance: none;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.12);
    outline: none;
    cursor: pointer;
  }

  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 8px rgba(204, 163, 110, 0.6);
    cursor: grab;
    transition: transform 0.15s ease;
  }

  input[type='range']::-webkit-slider-thumb:hover {
    transform: scale(1.25);
  }

  .btn-group {
    display: flex;
    gap: 6px;
  }

  .btn-sub {
    flex: 1;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 3px;
    padding: 7px 4px;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: #aaa095;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .btn-sub:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #eee;
  }

  .btn-sub.active {
    background: rgba(204, 163, 110, 0.15);
    border-color: var(--amber);
    color: #f7ede1;
  }

  /* 切换项 */
  .toggles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    padding-top: 4px;
  }

  .toggle-item {
    display: flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
  }

  .toggle-item input {
    display: none;
  }

  .chk-box {
    width: 13px;
    height: 13px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 2px;
    display: inline-block;
    position: relative;
    transition: all 0.15s ease;
  }

  .toggle-item input:checked + .chk-box {
    background: var(--amber);
    border-color: var(--amber);
  }

  .toggle-text {
    font-size: 11px;
    color: #9c9287;
  }

  .btn-text {
    margin-left: auto;
    background: none;
    border: none;
    font-size: 11px;
    color: #8c8278;
    cursor: pointer;
    padding: 4px 6px;
    transition: color 0.15s ease;
  }
  .btn-text:hover {
    color: var(--amber);
  }

  /* 评注卡片 */
  .sec-card {
    margin-top: auto;
    background: rgba(255, 255, 255, 0.025);
    border-left: 2px solid var(--amber);
    padding: 12px 14px;
    border-radius: 0 4px 4px 0;
  }

  .card-title {
    font-size: 12px;
    color: #eae3db;
    letter-spacing: 0.1em;
    margin-bottom: 6px;
  }

  .card-desc {
    font-size: 12px;
    line-height: 1.6;
    color: #8f857a;
    margin: 0;
  }

  /* ═══ 3D 舞台与居中圆区背景 ═══ */
  .hero-canvas-wrap {
    flex: 1;
    height: 100%;
    position: relative;
    z-index: 5;
    cursor: grab;
    overflow: hidden;
  }
  .hero-canvas-wrap:active {
    cursor: grabbing;
  }
  .hero-canvas-wrap canvas {
    position: absolute;
    inset: 0;
    z-index: 4;
  }

  .env-hz-line {
    position: absolute;
    left: -20vw;
    right: -20vw;
    top: 50%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(204, 163, 110, 0.08) 20%,
      rgba(204, 163, 110, 0.32) 50%,
      rgba(240, 230, 220, 0.48) 65%,
      transparent 100%
    );
    transform: rotate(-14deg);
    pointer-events: none;
    z-index: 1;
  }

  .env-sun-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 660px;
    height: 660px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(235, 222, 212, 0.16) 0%, rgba(204, 163, 110, 0.05) 45%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
    filter: blur(28px);
  }

  .env-sun-disc {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 480px;
    height: 480px;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle at 45% 45%,
      rgba(245, 240, 235, 0.22) 0%,
      rgba(230, 220, 210, 0.09) 50%,
      rgba(200, 190, 180, 0.02) 80%,
      transparent 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 50%;
    pointer-events: none;
    z-index: 2;
    backdrop-filter: blur(2px);
  }

  .drag-hint {
    position: absolute;
    bottom: 24px;
    right: 28px;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.32);
    pointer-events: none;
    z-index: 6;
  }

  @media (max-width: 900px) {
    .mock-stage {
      flex-direction: column-reverse;
    }
    .panel {
      width: 100%;
      height: 48vh;
      border-right: none;
      border-top: 1px solid var(--line-subtle);
    }
    .hero-canvas-wrap {
      height: 52vh;
    }
  }
</style>

<script>
  import { initCrystalloid, type VariantType } from '../../scripts/mock-hero-crystalloid';

  const container = document.getElementById('canvas-container');
  const slider = document.getElementById('slider-dream') as HTMLInputElement;
  const dreamPct = document.getElementById('dream-pct');
  const btnWake = document.getElementById('btn-wake');
  const btnDream = document.getElementById('btn-dream');
  const btnLoop = document.getElementById('btn-loop');
  const chkRotate = document.getElementById('chk-rotate') as HTMLInputElement;
  const chkWire = document.getElementById('chk-wire') as HTMLInputElement;
  const btnReset = document.getElementById('btn-reset');
  const cardTitle = document.getElementById('card-title');
  const cardDesc = document.getElementById('card-desc');
  const varButtons = document.querySelectorAll<HTMLButtonElement>('.btn-var');

  const metaMap: Record<string, { title: string; desc: string }> = {
    octahedron: {
      title: '01 · 八面体解构晶 (Octahedron Cleavage)',
      desc: '原初构想的顶级打磨。8 块实心四面体晶片。醒态咬合为修长正八面冰晶；梦态顺着外法向解构错位、悬停漂移，内部显露出 14° 微温光丝。',
    },
    asymmetric: {
      title: '02 · 非对称断层晶簇 (Sculptural Cleavage Quartz)',
      desc: '打破正多面体刻板感。5 块大小不一的矿物晶块，如天然冰洲石。醒态成形为极具现代雕塑感的单体；梦态沿地质解理面斜向滑移，各块带不同惯性漂游。',
    },
    lenses: {
      title: '03 · 多层悬浮透镜组 (Planar Optical Lenses)',
      desc: '直接呼应右侧圆光。4 片超薄磨砂光学透镜与微刻光阑。醒态同心致密叠合为高折射晶币；梦态沿视线深度 Z 轴拉开离焦，透射光环交叠微散。',
    },
    petal: {
      title: '04 · 晶化百合苞片 (Crystalline Petal Bud)',
      desc: '将自然物记忆融入半透明树脂。4 片修长曲面晶瓣。醒态合拢为 Brancusi 雕塑般静穆的花苞；梦态失重剥离散开，犹如水下漂散的花瓣残片。',
    },
  };

  if (container) {
    let isLooping = false;

    const handle = initCrystalloid({
      container,
      initialVariant: 'octahedron',
      initialDream: 0,
      autoRotate: true,
      autoBreath: false,
      wireframe: true,
      onDreamChange: (val) => {
        if (slider) slider.value = val.toFixed(3);
        updateLabel(val);
      },
    });

    function updateLabel(val: number) {
      if (!dreamPct) return;
      const pct = Math.round(val * 100);
      let stateTxt = '在成形与融化之间';
      if (pct <= 5) stateTxt = '醒态 · 凝固体';
      else if (pct >= 95) stateTxt = '梦态 · 解构漂移';
      dreamPct.textContent = `${pct}% · ${stateTxt}`;
    }

    // 变体切换
    varButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const v = btn.dataset.var as VariantType;
        if (!v) return;
        varButtons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        handle.setVariant(v);

        if (metaMap[v]) {
          if (cardTitle) cardTitle.textContent = metaMap[v].title;
          if (cardDesc) cardDesc.textContent = metaMap[v].desc;
        }
      });
    });

    // 滑块
    slider?.addEventListener('input', () => {
      if (isLooping) {
        isLooping = false;
        handle.setAutoBreath(false);
        btnLoop?.classList.remove('active');
      }
      btnWake?.classList.remove('active');
      btnDream?.classList.remove('active');

      const val = parseFloat(slider.value);
      handle.setDream(val);
      updateLabel(val);
    });

    // 预设按钮
    btnWake?.addEventListener('click', () => {
      isLooping = false;
      handle.setAutoBreath(false);
      btnLoop?.classList.remove('active');
      btnDream?.classList.remove('active');
      btnWake.classList.add('active');

      animateDreamTo(0);
    });

    btnDream?.addEventListener('click', () => {
      isLooping = false;
      handle.setAutoBreath(false);
      btnLoop?.classList.remove('active');
      btnWake?.classList.remove('active');
      btnDream.classList.add('active');

      animateDreamTo(1);
    });

    btnLoop?.addEventListener('click', () => {
      isLooping = !isLooping;
      handle.setAutoBreath(isLooping);
      btnLoop.classList.toggle('active', isLooping);
      btnWake?.classList.remove('active');
      btnDream?.classList.remove('active');
    });

    function animateDreamTo(target: number) {
      const start = handle.getDream();
      const startTime = performance.now();
      const duration = 600;

      function step(now: number) {
        const p = Math.min(1, (now - startTime) / duration);
        const ease = p * p * (3 - 2 * p);
        const cur = start + (target - start) * ease;
        handle.setDream(cur);
        if (slider) slider.value = cur.toFixed(3);
        updateLabel(cur);
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    // 视角控制
    chkRotate?.addEventListener('change', () => {
      handle.setAutoRotate(chkRotate.checked);
    });

    chkWire?.addEventListener('change', () => {
      handle.setWireframe(chkWire.checked);
    });

    btnReset?.addEventListener('click', () => {
      handle.resetView();
    });
  }
</script>
