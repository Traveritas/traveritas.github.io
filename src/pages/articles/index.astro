---
import BaseLayout from '../../layouts/BaseLayout.astro';
import YearGroup from '../../components/index/YearGroup.astro';
import IndexRow from '../../components/index/IndexRow.astro';
import { getCollection } from 'astro:content';

/* 字数统计：剥掉 markdown 语法后按非空白字符计（与素夜定稿同法） */
function countChars(md: string): number {
  return md
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/^>\s?/gm, '')
    .replace(/^[-*]\s+(\[[ xX]\]\s+)?/gm, '')
    .replace(/\*\*/g, '')
    .replace(/\[(.+?)\]\(.+?\)/g, '$1')
    .replace(/\s+/g, '').length;
}

// 新→旧；按年份分组
const articles = (await getCollection('articles', (a) => !a.data.draft))
  .map(({ id, body, data }) => ({ id, ...data, chars: countChars(body ?? '') }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf() || b.id.localeCompare(a.id));

const byYear = new Map<number, typeof articles>();
for (const a of articles) {
  const y = a.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(a);
}
---

<BaseLayout
  title="随笔 — Traveritas"
  description="Traveritas 的随笔与记录"
  ambient
  maskLines
  fieldVeil
  rail={{ mode: 'station', station: '随笔 · 浅梦', en: 'ESSAYS · LIGHT' }}
>
  <div class="container-wide page-body">
    <header class="page-head">
      <h1 data-morph data-true="随笔" data-dream="断章">随笔</h1>
      <p class="lede" data-morph data-true="想法、记录，与白昼留下的草稿。" data-dream="“语言无法触及之处，皆为回声——那些从深眠中打捞出的断章。”">
        想法、记录，与白昼留下的草稿。
      </p>
    </header>

    {
      [...byYear].map(([y, list]) => (
        <YearGroup year={y}>
          {list.map((a) => (
            <IndexRow date={a.date} href={`/articles/${a.id}/`} title={a.title} desc={a.description}>
              <Fragment slot="aside">{a.chars.toLocaleString('en-US')} 字</Fragment>
            </IndexRow>
          ))}
        </YearGroup>
      ))
    }
  </div>
</BaseLayout>
