---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', (a) => !a.data.draft))
  .map(({ id, data }) => ({ id, ...data }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

// 按年份分组（保持倒序）
const byYear = new Map<number, typeof articles>();
for (const a of articles) {
  const y = a.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(a);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout
  title="随笔 — Traveritas"
  description="Traveritas 的随笔与记录"
  rail={{ mode: 'station', station: '随笔 · 账目', en: 'ESSAYS LEDGER' }}
>
  <div class="container page-body">
    <header class="page-head">
      <h1>随笔</h1>
      <p class="lede" data-morph data-true="想法、记录，与梦的边角料。" data-dream="想法、记录，与梦的边角梦见。">
        想法、记录，与梦的边角料。
      </p>
    </header>

    {
      years.map((y) => (
        <section class="year-group">
          <div class="axis" aria-hidden="true">
            <i class="axis-line"></i>
            <span class="axis-tag mono">
              {y} · {byYear.get(y)!.length} 篇
            </span>
            <span class="axis-tag-en mono">WAKE · VERIFIABLE</span>
          </div>
          <ul class="ledger">
            {byYear.get(y)!.map((a) => (
              <li>
                <a href={`/articles/${a.id}/`}>
                  <span class="ledger-date">{fmt(a.date)}</span>
                  <span>
                    <span class="ledger-title">{a.title}</span>
                    {a.description && <span class="ledger-desc">{a.description}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .year-group {
    margin-bottom: 3.4rem;
  }

  /* 分段轴线：-4° 斜线 + mono 双语标签（来自入梦检验） */
  .axis {
    position: relative;
    margin: 0 0 1.6rem;
    padding-left: 0.2rem;
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
  }

  .axis-line {
    position: absolute;
    left: -3.4rem;
    top: 0.5em;
    width: 150px;
    height: 1px;
    background: var(--fg-soft);
    opacity: 0.4;
    transform: rotate(-4deg);
    transform-origin: right center;
  }

  .axis-tag {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--umber);
  }

  .axis-tag-en {
    font-size: 0.56rem;
    letter-spacing: 0.24em;
    color: var(--fg-faint);
  }
</style>
