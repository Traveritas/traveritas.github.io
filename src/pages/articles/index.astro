---
/* 断章 —— 题即版面：没有卡片，题目直接写在地面上，日期挂在左边。
   悬停的那一行，一片玻璃从左边扫过来垫在它下面（地面在那里变清楚）；
   每篇底下一根篇幅线，长短照字数（满五千字到头），线尾一道 14° 的小撇，字数跟在撇后面 */
import Base from '../../layouts/Base.astro';
import ListHead from '../../components/ListHead.astro';
import Tags from '../../components/Tags.astro';
import { entriesOf } from '../../lib/entries';
import { plain, chars, minutes, dot } from '../../lib/text';

const list = await entriesOf('articles');
---

<Base title="断章" place="list" sec="articles">
  <section class="list list--articles">
    <ListHead k="articles" n={list.length} />
    <ol class="ars">
      {
        list.map((e, i) => {
          const n = chars(e.body);
          return (
            <li class="ar" style={`--i:${i};--len:${Math.min(1, n / 5000).toFixed(3)}`}>
              <a href={`/articles/${e.id}/`}>
                <span class="ar-lens" data-glass aria-hidden="true" />
                <time class="ar-date mono" datetime={e.data.date.toISOString()}>
                  {dot(e.data.date)}
                </time>
                <span class="ar-t">{plain(e.data.title)}</span>
                {e.data.description && <span class="ar-d">{plain(e.data.description)}</span>}
                <Tags tags={e.data.tags} />
                <span class="ar-len">
                  <i aria-hidden="true" />
                  <span class="mono">
                    {n.toLocaleString()} 字 · 约 {minutes(n)} 分钟
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>
</Base>
