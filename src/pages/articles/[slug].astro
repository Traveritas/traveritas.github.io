---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { stageAt, STAGE_INFO } from '../../data/night';

/* 夜时刻：与随笔列表同一规则（写作先后在浅梦段 12→124 分内等分） */
const SEG_FROM = 12;
const SEG_TO = 124;

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const CN = ['零', '一', '二', '三', '四', '五', '六', '七', '八', '九', '十'];
const cn = (n: number) => CN[n] ?? String(n);

function countChars(md: string): number {
  return md
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/^>\s?/gm, '')
    .replace(/^[-*]\s+(\[[ xX]\]\s+)?/gm, '')
    .replace(/\*\*/g, '')
    .replace(/\[(.+?)\]\(.+?\)/g, '$1')
    .replace(/\s+/g, '').length;
}

export async function getStaticPaths() {
  const articles = (await getCollection('articles', (a) => !a.data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf() || a.id.localeCompare(b.id),
  );
  /* 夜时刻：与随笔列表同一规则（写作先后在浅梦段 12→124 分内等分）；
     getStaticPaths 编译在独立 chunk，段落常量需本地定义 */
  const SEG_FROM = 12;
  const SEG_TO = 124;
  const nightMin = new Map<string, number>();
  articles.forEach((a, i) => {
    nightMin.set(a.id, SEG_FROM + ((SEG_TO - SEG_FROM) * (i + 0.5)) / articles.length);
  });
  return articles.map((a, i) => ({
    params: { slug: a.id },
    props: {
      article: a,
      nightMin: nightMin.get(a.id) ?? SEG_FROM,
      // 此处按旧→新排列：较早的一篇在前面，较晚的一篇在后面
      older: i > 0 ? articles[i - 1] : undefined,
      newer: i < articles.length - 1 ? articles[i + 1] : undefined,
    },
  }));
}

const { article, older, newer, nightMin } = Astro.props;
const { Content } = await render(article);
const { title, description, date, tags, related } = article.data;

const chars = countChars(article.body ?? '');
const readMin = Math.max(1, Math.round(chars / 400));
const stage = STAGE_INFO[stageAt(nightMin)];
const stageLabel = `${stage.zh} · ${stage.wave}`;
---

<BaseLayout
  title={`${title} — Traveritas`}
  description={description}
  type="article"
  bgm="reading"
  rail={{
    mode: 'depth',
    station: '入梦 · 阅读',
    en: 'READING DEPTH',
    depthTarget: 'article.prose',
    readout: { fromMin: nightMin, durMin: readMin, stage: stageLabel },
  }}
>
  <div class="dawn-glow" aria-hidden="true"></div>
  <div class="container page-body">
    <article class="prose prose--essay">
      <header class="prose-head">
        <h1 data-morph data-entrance data-true={title} aria-label={title}>{title}</h1>
        <p class="prose-meta">
          <time datetime={date.toISOString()}>{fmt(date)}</time>
        </p>
      </header>
      <hr class="prose-rule" />
      <div class="md">
        <Content />
      </div>
      {
        tags.length > 0 && (
          <nav class="tag-row" aria-label="标签">
            {tags.map((t) => (
              <a href={`/tags/${t}/`}>{t}</a>
            ))}
          </nav>
        )
      }
      {
        related.length > 0 && (
          <div class="xfile">
            <span class="xfile-t mono">关联篇章 · RELATED</span>
            {related.map((r) => (
              <a href={r.href}>{r.label}</a>
            ))}
          </div>
        )
      }
      <footer class="wake-card">
        <div class="wc-nav">
          {
            older ? (
              <a href={`/articles/${older.id}/`}>
                <span class="wn-label mono">较早的一篇</span>
                <span class="wn-title">{older.data.title}</span>
              </a>
            ) : (
              <span class="wn-empty">
                <span class="wn-label mono">较早的一篇</span>
                <span class="wn-title">这是今夜最早的一篇。</span>
              </span>
            )
          }
          {
            newer ? (
              <a class="wn-right" href={`/articles/${newer.id}/`}>
                <span class="wn-label mono">较晚的一篇</span>
                <span class="wn-title">{newer.data.title}</span>
              </a>
            ) : (
              <span class="wn-empty wn-right">
                <span class="wn-label mono">较晚的一篇</span>
                <span class="wn-title">这是今夜最新的一篇。</span>
              </span>
            )
          }
        </div>
        <p class="wc-foot mono">
          <a href="/articles/">回到随笔</a>
          <span>全文约 {chars} 字 · 阅读约需 {cn(readMin)} 分钟</span>
        </p>
      </footer>
    </article>
  </div>
</BaseLayout>

<script>
  // 夜内时钟：阅读进度在本篇夜时刻 → +读时（分钟）之间爬行。
  // 进度公式与 chrome.ts 的深度轨一致（0.6 视高处入文），光标点与时钟同步下行。
  const readout = document.querySelector<HTMLElement>('.rail-read[data-from-min]');
  const prose = document.querySelector<HTMLElement>('article.prose');
  const clock = readout?.querySelector<HTMLElement>('.rail-clock');
  if (readout && prose && clock) {
    const from = Number(readout.dataset.fromMin ?? 0);
    const dur = Number(readout.dataset.durMin ?? 1);
    const NIGHT_START = 23 * 60 + 7;
    const fmtNight = (m: number) => {
      const total = NIGHT_START + Math.min(Math.max(m, 0), 444);
      const h = String(Math.floor(total / 60) % 24).padStart(2, '0');
      const mm = String(Math.floor(total % 60)).padStart(2, '0');
      return `${h}:${mm}`;
    };
    let raf = 0;
    const tick = () => {
      raf = 0;
      const r = prose!.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / Math.max(r.height, 1)));
      clock!.textContent = fmtNight(from + p * dur);
    };
    addEventListener(
      'scroll',
      () => {
        if (!raf) raf = requestAnimationFrame(tick);
      },
      { passive: true },
    );
    tick();
  }
</script>

<style>
  /* 晓线：暖光随阅读进度从底部升起，读到末尾天亮 */
  .dawn-glow {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34vh;
    z-index: 4;
    pointer-events: none;
    opacity: 0.12;
    background: linear-gradient(to top, color-mix(in srgb, var(--amber) 30%, transparent), color-mix(in srgb, var(--amber) 8%, transparent) 55%, transparent);
    transition: opacity 0.3s linear;
  }

  /* 标签行：纸面小签 */
  .tag-row {
    margin-top: 3rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
  }

  .tag-row a {
    color: var(--fg-soft);
    border: 1px solid var(--line);
    padding: 0.14rem 0.5rem 0.1rem;
    border-radius: 2px;
    text-decoration: none;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .tag-row a:hover {
    color: var(--fg);
    border-color: color-mix(in srgb, var(--dream) 50%, transparent);
  }

  /* ── 醒来卡：较早/较晚 + 字数读时 ── */
  .wake-card {
    margin-top: 3.4rem;
    border-top: 1px solid var(--line);
    padding-top: 0.5rem;
  }

  .wc-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .wc-nav a,
  .wc-nav .wn-empty {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 0.2rem 0.5rem;
    text-decoration: none;
  }

  .wc-nav .wn-right {
    border-left: 1px solid var(--line);
    padding-left: 1.4rem;
    align-items: flex-end;
    text-align: right;
  }

  .wn-label {
    font-size: 0.58rem;
    letter-spacing: 0.3em;
    color: var(--umber);
  }

  .wn-title {
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--fg-soft);
    transition: color 0.2s;
  }

  .wc-nav a:hover .wn-title {
    color: var(--umber);
  }

  .wc-nav .wn-empty .wn-title {
    color: var(--fg-soft);
  }

  .wc-foot {
    margin: 1.2rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.4rem;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: var(--fg-soft);
  }

  .wc-foot a {
    color: var(--fg-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
  }

  .wc-foot a:hover {
    color: var(--umber);
  }

  @media (prefers-reduced-motion: reduce) {
    .dawn-glow {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .wc-nav {
      grid-template-columns: 1fr;
    }

    .wc-nav .wn-right {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-left: 0.2rem;
      align-items: flex-start;
      text-align: left;
      padding-top: 1rem;
    }
  }
</style>
