---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { excerpt } from '../../lib/excerpt';
import { countChars, fmtDate } from '../../lib/format';
import TagRow from '../../components/article/TagRow.astro';
import WakeCard from '../../components/article/WakeCard.astro';

export async function getStaticPaths() {
  const articles = (await getCollection('articles', (a) => !a.data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf() || a.id.localeCompare(b.id),
  );
  return articles.map((a, i) => ({
    params: { slug: a.id },
    props: {
      article: a,
      // 此处按旧→新排列：较早的一篇在前面，较晚的一篇在后面
      older: i > 0 ? articles[i - 1] : undefined,
      newer: i < articles.length - 1 ? articles[i + 1] : undefined,
    },
  }));
}

const { article, older, newer } = Astro.props;
const { Content } = await render(article);
const { title, description, date, tags, related } = article.data;

const chars = countChars(article.body ?? '');
const readMin = Math.max(1, Math.round(chars / 400));
---

<BaseLayout
  title={`${title} — Traveritas`}
  description={description ?? excerpt(article.body ?? '')}
  type="article"
  ambient
  bgm="reading"
  gauge={{
    kind: 'reading',
    depthTarget: 'article.prose',
  }}
>
  <div class="dawn-glow" aria-hidden="true"></div>
  <div class="container page-body">
    <article class="prose prose--essay">
      <header class="prose-head">
        <h1 data-morph data-entrance data-true={title} aria-label={title}>{title}</h1>
        <p class="prose-meta">
          <time datetime={date.toISOString()}>{fmtDate(date)}</time>
        </p>
      </header>
      <hr class="prose-rule" />
      <div class="md">
        <Content />
      </div>
      {tags.length > 0 && <TagRow tags={tags} />}
      {
        related.length > 0 && (
          <div class="xfile">
            <span class="xfile-t mono">关联篇章 · RELATED</span>
            {related.map((r) => (
              <a href={r.href}>{r.label}</a>
            ))}
          </div>
        )
      }
      <WakeCard
        older={older && { id: older.id, title: older.data.title }}
        newer={newer && { id: newer.id, title: newer.data.title }}
        chars={chars}
        readMin={readMin}
      />
    </article>
  </div>
</BaseLayout>

<style>
  /* 晓线：暖光随阅读进度从底部升起，读到末尾天亮 */
  .dawn-glow {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34vh;
    z-index: 4;
    pointer-events: none;
    opacity: 0.12;
    background: linear-gradient(to top, color-mix(in srgb, var(--amber) 30%, transparent), color-mix(in srgb, var(--amber) 8%, transparent) 55%, transparent);
    transition: opacity 0.3s linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .dawn-glow {
      transition: none;
    }
  }
</style>
