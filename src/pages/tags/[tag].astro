---
import BaseLayout from '../../layouts/BaseLayout.astro';
import YearGroup from '../../components/index/YearGroup.astro';
import IndexRow from '../../components/index/IndexRow.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = (await getCollection('articles', (a) => !a.data.draft))
    .map(({ id, data }) => ({ id, ...data }))
    .sort((a, b) => b.date.valueOf() - a.date.valueOf() || b.id.localeCompare(a.id));

  const tags = new Map<string, typeof articles>();
  for (const a of articles) {
    for (const t of a.tags ?? []) {
      if (!tags.has(t)) tags.set(t, []);
      tags.get(t)!.push(a);
    }
  }
  return [...tags.keys()].map((t) => ({ params: { tag: t }, props: { tag: t, articles: tags.get(t)! } }));
}

const { tag, articles } = Astro.props;

// 与随笔目录同一套：按年份分组，行用 <IndexRow>
const byYear = new Map<number, typeof articles>();
for (const a of articles) {
  const y = a.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(a);
}
---

<BaseLayout
  title={`标签「${tag}」 — Traveritas`}
  description={`标签「${tag}」下的全部随笔`}
>
  <div class="container-wide page-body">
    <header class="page-head knot-head">
      <span class="big-knot" aria-hidden="true"></span>
      <h1>{tag}</h1>
      <p class="lede" data-morph data-true={`锚定于此 · ${articles.length} 篇随笔。`} data-dream={`“此处的微光串联起 ${articles.length} 段断章。”`}>
        锚定于此 · {articles.length} 篇随笔。<a href="/articles/">全部随笔</a>
      </p>
    </header>

    {
      [...byYear].map(([y, list]) => (
        <YearGroup year={y}>
          {list.map((a) => (
            <IndexRow date={a.date} href={`/articles/${a.id}/`} title={a.title} desc={a.description} tags={a.tags} />
          ))}
        </YearGroup>
      ))
    }
  </div>
</BaseLayout>

<style>
  /* 标签是缝上的「结」 */
  .knot-head {
    position: relative;
    padding-left: 2.2rem;
  }

  .big-knot {
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 14px;
    height: 14px;
    background: var(--amber);
    transform: rotate(45deg);
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--amber) 40%, transparent);
  }
</style>
