---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = (await getCollection('articles', (a) => !a.data.draft))
    .map(({ id, data }) => ({ id, ...data }))
    .sort((a, b) => b.date.valueOf() - a.date.valueOf());

  const tags = new Map<string, { id: string; title: string; description?: string; date: Date }[]>();
  for (const a of articles) {
    for (const t of a.tags ?? []) {
      if (!tags.has(t)) tags.set(t, []);
      tags.get(t)!.push(a);
    }
  }
  return [...tags.keys()].map((t) => ({ params: { tag: t }, props: { tag: t, articles: tags.get(t)! } }));
}

const { tag, articles } = Astro.props;

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout
  title={`标签「${tag}」 — Traveritas`}
  description={`标签「${tag}」下的全部随笔`}
  rail={{ mode: 'station', station: '标签 · 结', en: 'TAG KNOT' }}
>
  <div class="container page-body">
    <header class="page-head knot-head">
      <span class="big-knot" aria-hidden="true"></span>
      <h1>{tag}</h1>
      <p class="lede">
        缝上的一个结 · {articles.length} 篇随笔。<a href="/articles/">全部随笔</a>
      </p>
    </header>

    <ul class="ledger">
      {
        articles.map((a) => (
          <li>
            <a href={`/articles/${a.id}/`}>
              <span class="ledger-date">{fmt(a.date)}</span>
              <span>
                <span class="ledger-title">{a.title}</span>
                {a.description && <span class="ledger-desc">{a.description}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  /* 标签是缝上的「结」 */
  .knot-head {
    position: relative;
    padding-left: 2.2rem;
  }

  .big-knot {
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 14px;
    height: 14px;
    background: var(--amber);
    transform: rotate(45deg);
    box-shadow: 0 0 12px 2px rgba(217, 160, 91, 0.4);
  }
</style>
