---
import BaseLayout from '../../layouts/BaseLayout.astro';
import YearGroup from '../../components/index/YearGroup.astro';
import IndexRow from '../../components/index/IndexRow.astro';
import { getCollection } from 'astro:content';

/* 八阶成形：状态 → 浮现度（与项目页同表） */
const depthOf = (status: string) => ({ 构想中: 2, 进行中: 5, 已完成: 8 })[status] ?? 3;

// 新→旧；按年份分组
const projects = (await getCollection('projects', (p) => !p.data.draft))
  .map(({ id, data }) => ({ id, ...data }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf() || b.id.localeCompare(a.id));

const byYear = new Map<number, typeof projects>();
for (const p of projects) {
  const y = p.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
---

<BaseLayout
  title="项目 — Traveritas"
  description="Traveritas 的项目与造物"
  ambient
  maskLines
  fieldVeil
  rail={{ mode: 'station', station: '项目 · 深眠', en: 'PROJECTS N3' }}
>
  <div class="container-wide page-body">
    <header class="page-head">
      <h1 data-morph data-true="项目" data-dream="造物">项目</h1>
      <p class="lede" data-morph data-true="正在做、做过、以及还只存在于念头里的东西。" data-dream="“凡能够被构想的，也必能够被建造——散落在深眠中的世界切片。”">
        正在做、做过、以及还只存在于念头里的东西。
      </p>
    </header>

    {
      [...byYear].map(([y, list]) => (
        <YearGroup year={y}>
          {list.map((p) => (
            <IndexRow date={p.date} href={`/projects/${p.id}/`} title={p.title} desc={p.description}>
              <span slot="aside" class="stitch-meter" title={`${p.status} · 浮现度 ${depthOf(p.status)} / 8`}>
                {Array.from({ length: 8 }).map((_, i) => (
                  <i class:list={{ on: i < depthOf(p.status) }} />
                ))}
                <span class="sr-only">{p.status}</span>
              </span>
            </IndexRow>
          ))}
        </YearGroup>
      ))
    }
  </div>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
