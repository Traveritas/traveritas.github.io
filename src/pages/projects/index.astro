---
/* 造物 —— 陈列：等宽小片，同样按 14° 错开，状态在右上 */
import Base from '../../layouts/Base.astro';
import ListHead from '../../components/ListHead.astro';
import { entriesOf } from '../../lib/entries';
import { plain, dot } from '../../lib/text';

const list = await entriesOf('projects');
---

<Base title="造物" place="list" sec="projects">
  <section class="list list--projects">
    <ListHead k="projects" n={list.length} />
    <div class="cols">
      {
        list.map((e, i) => (
          <div class="cell" style={`--i:${i}`}>
            <a class="pane pane--p" data-glass href={`/projects/${e.id}/`}>
              <span class="meta mono">
                <span>{dot(e.data.date)}</span>
                <span class="st">{plain(e.data.status)}</span>
              </span>
              <span class="t">{plain(e.data.title)}</span>
              {e.data.description && <span class="d">{plain(e.data.description)}</span>}
            </a>
          </div>
        ))
      }
    </div>
  </section>
</Base>
