---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, date, status, links, cover } = project.data;

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout
  title={`${title} — Traveritas`}
  description={description}
  rail={{ mode: 'station', station: '项目 · 深眠', en: 'PROJECTS N3' }}
>
  <div class="container page-body">
    <article class="prose">
      <header class="prose-head">
        <h1 data-morph data-entrance data-true={title} aria-label={title}>{title}</h1>
        <p class="prose-meta">
          <span class="status">{status}</span>
          <time datetime={date.toISOString()}>{fmt(date)}</time>
        </p>
      </header>
      <hr class="prose-rule" />
      {
        cover && (
          <img class="cover" src={cover} alt={`${title} 的封面`} loading="lazy" />
        )
      }
      <Content />
      {
        links.length > 0 && (
          <nav class="link-list" aria-label="相关链接">
            {links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener">
                {l.label}
              </a>
            ))}
          </nav>
        )
      }
    </article>
  </div>
</BaseLayout>

<style>
  .cover {
    display: block;
    width: min(100%, 30rem);
    margin: 0 0 2.2rem;
    border-radius: 4px;
    filter: grayscale(0.7) contrast(0.92) opacity(0.9);
  }
</style>
