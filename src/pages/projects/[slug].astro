---
/* ─────────────────────────────────────────────────────────────
   项目 · 单独一件（2026-11-03 跟随随笔阅读页改版）
   与随笔页同一套阅读语汇：不出页头页脚，不画 14° 缝线与脑电，
   一片昼雾铺到底，正文列沉在雾最静的那一条里，左上角一枚「回到项目 / 退回造物」。
   地面见 components/chrome/Mist.astro 与 src/scripts/mist.ts。

   这一页特有的块照旧——封面 δ 波纹（Coverband）、注记（FileNote）、
   施工清单与链接（LinkList）、文末导航（ProjectNav）：它们不是仪器层，是正文的一部分。
   ───────────────────────────────────────────────────────────── */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { excerpt } from '../../lib/excerpt';
import { fmtDate } from '../../lib/format';
import Coverband from '../../components/project/Coverband.astro';
import FileNote from '../../components/project/FileNote.astro';
import LinkList from '../../components/project/LinkList.astro';
import ProjectNav from '../../components/project/ProjectNav.astro';
import Return from '../../components/chrome/Return.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  // 编号与列表页同一规则：按日期先后编（最旧为 PRJ-01）
  const sorted = [...projects].sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf() || a.id.localeCompare(b.id),
  );
  const codeOf = new Map<string, string>();
  sorted.forEach((p, i) => codeOf.set(p.id, `PRJ-${String(i + 1).padStart(2, '0')}`));
  return projects.map((p) => ({
    params: { slug: p.id },
    props: {
      project: p,
      code: codeOf.get(p.id) ?? 'PRJ-01',
      // 「另一项」：名录里的下一件（循环）
      other: sorted[(sorted.findIndex((x) => x.id === p.id) + 1) % sorted.length],
    },
  }));
}

const { project, code, other } = Astro.props;
const { Content } = await render(project);
const { title, description, date, status, links, related, note } = project.data;
---

<BaseLayout
  title={`${title} — Traveritas`}
  description={description ?? excerpt(project.body ?? '')}
  type="article"
  bare
  ave
  mist
  seam="none"
  eeg={false}
  bgm="reading"
  aveEntry={`projects/${project.id}`}
  gauge={{ kind: 'reading' }}
>
  <Return href="/projects/" label="回到项目" dream="退回造物" />
  <div class="container page-body">
    <article class="prose prose--project">
      <header class="prose-head">
        <h1 data-morph data-entrance data-true={title} aria-label={title}>{title}</h1>
        <p class="prose-meta">
          <span class="status">{status}</span> · <time datetime={date.toISOString()}>{fmtDate(date)}</time>
        </p>
      </header>
      <hr class="prose-rule" />

      <Coverband code={code} />

      <div class="md">
        <Content />
      </div>

      {note && <FileNote awake={note.awake} dream={note.dream} />}

      {
        related.length > 0 && (
          <div class="xfile">
            <span class="xfile-t mono">关联记述 · RELATED</span>
            {related.map((r) => (
              <a href={r.href}>{r.label}</a>
            ))}
          </div>
        )
      }

      <LinkList links={links} />

      <ProjectNav next={other.id !== project.id ? { id: other.id, title: other.data.title } : undefined} />
    </article>
  </div>
</BaseLayout>
