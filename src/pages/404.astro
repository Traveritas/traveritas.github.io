---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到这一页 — Traveritas" description="线在这里断了。" seam="broken">
  <div class="container">
    <section class="lost">
      <div class="lost-needle" aria-hidden="true"></div>
      <p class="lost-code mono">ERR · STITCH DROPPED</p>
      <p class="lost-line" data-morph data-true="线在这里断了：这一页像醒来的梦，存在过，但现在不在这里了。" data-dream="线在这里断了：这一页像醒来的梦，存在梦，但现在不在这了。">
        线在这里断了：这一页像醒来的梦，存在过，但现在不在这里了。
      </p>
      <a class="rethread" href="/">把线接回去</a>
    </section>
  </div>
</BaseLayout>

<style>
  .lost {
    min-height: 72dvh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
    padding-block: var(--gap-v);
  }

  /* 坠落的针：从断口掉下来，斜停在半空 */
  .lost-needle {
    width: 64px;
    height: 1px;
    background: var(--fg-soft);
    transform: rotate(38deg);
    position: relative;
    animation: needle-rest 7s ease-in-out infinite;
  }

  .lost-needle::after {
    content: '';
    position: absolute;
    right: -3px;
    top: -2.5px;
    width: 5px;
    height: 5px;
    background: var(--amber);
    transform: rotate(45deg);
  }

  @keyframes needle-rest {
    0%,
    100% {
      translate: 0 0;
      rotate: 38deg;
    }
    50% {
      translate: 0 5px;
      rotate: 36deg;
    }
  }

  .lost-code {
    margin: 0;
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    color: var(--fg-faint);
  }

  .lost-line {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--fg-soft);
    max-width: 26em;
    line-height: 2;
  }

  .rethread {
    font-family: var(--font-display);
    letter-spacing: 0.2em;
    text-decoration: none;
    border-bottom: 1px solid var(--amber);
    padding-bottom: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lost-needle {
      animation: none;
    }
  }
</style>
