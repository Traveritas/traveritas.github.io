---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShardMark from '../components/ShardMark.astro';
---

<BaseLayout title="找不到这一页 — Traveritas">
  <div class="container">
    <section class="lost">
      <ShardMark size={26} />
      <p>这一页像醒来的梦：它存在过，但现在不在这里了。</p>
      <a href="/">回到封面</a>
    </section>
  </div>
</BaseLayout>
