---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到这一页 — Traveritas" description="世界在边缘处留白。" seam="broken" noindex>
  <div class="container">
    <section class="lost">
      <h1 class="sr-only">找不到这一页</h1>
      <div class="lost-beacon" aria-hidden="true"></div>
      <p class="lost-code mono">ERR · 404 · OUT OF BOUNDS</p>
      <p class="lost-line" data-morph data-true="线索到这里中断了：这一页如同被擦除的痕迹，曾在此处，但现在不在这里。" data-dream="“世界在边缘处留白。尚未命名的风景，不会在此停留。”">
        线索到这里中断了：这一页如同被擦除的痕迹，曾在此处，但现在不在这里。
      </p>
      <a class="rethread" href="/" data-morph data-true="返回主轴" data-dream="退回最初的岸">返回主轴</a>
    </section>
  </div>
</BaseLayout>

<style>
  .lost {
    min-height: 72dvh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
    padding-block: var(--gap-v);
  }

  /* 坐标浮标：在边缘处微弱呼吸的琥珀微光 */
  .lost-beacon {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 16px 2px color-mix(in srgb, var(--amber) 45%, transparent);
    animation: beacon-pulse 4s ease-in-out infinite;
  }

  @keyframes beacon-pulse {
    0%,
    100% {
      transform: scale(0.92);
      opacity: 0.6;
    }
    50% {
      transform: scale(1.15);
      opacity: 0.95;
      box-shadow: 0 0 24px 4px color-mix(in srgb, var(--amber) 65%, transparent);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .lost-code {
    margin: 0;
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    color: var(--fg-soft);
  }

  .lost-line {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--fg-soft);
    max-width: 26em;
    line-height: 2;
  }

  .rethread {
    font-family: var(--font-display);
    letter-spacing: 0.2em;
    text-decoration: none;
    border-bottom: 1px solid var(--amber);
    padding-bottom: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lost-beacon {
      animation: none;
    }
  }
</style>
