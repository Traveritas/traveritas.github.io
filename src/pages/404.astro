---
/* ─────────────────────────────────────────────────────────────
   404 · 失线页（2026-11-03 重做）
   旧版的记号是一根「断在这里」的 14° 缝线。线撤了之后，这一页换一个记号：
   雾里有一个洞 —— 同一支流光场，在视口正中塌成一个安静的坑，
   坑里的光是灰的，坑边一圈很淡的亮，坑外照常走。

   这是一页没有地址的地方，所以页头页脚都不出（bare），只剩：
     · 一枚返回（回到你多半想去的那个地方：主页）
     · 一句醒面的实话 + 梦面的另一句
     · ERR · 404 · 这一处没有坐标
   文案沿用旧版的意思，只把「线断了」换成「这里原本有一页，现在只剩空处」这类
   不带缝线与审计口吻的说法；两组字照旧走双态溶变。

   地面：components/chrome/Mist.astro（mist 属性），404 传自己的静域感 —
   洞心就是「最静的地方」，正文两行字落在洞口上，所以静域中心对齐视口中心。
   ───────────────────────────────────────────────────────────── */
import BaseLayout from '../layouts/BaseLayout.astro';
import Return from '../components/chrome/Return.astro';
---

<BaseLayout
  title="找不到这一页 — Traveritas"
  description="尚未命名的风景，不会在此停留。"
  bare
  ave
  mist="hole"
  seam="none"
  eeg={false}
  noindex
>
  <Return href="/" label="回到主页" dream="退回原处" />
  <div class="container lost-wrap">
    <section class="lost">
      <h1 class="lost-code mono">ERR · 404</h1>
      <p
        class="lost-line"
        data-morph
        data-true="这一处没有坐标。你要找的那一页，也许从未被写下来，也许已经散在雾里。"
        data-dream="“尚未命名的风景，不会在此停留。”"
      >
        这一处没有坐标。你要找的那一页，也许从未被写下来，也许已经散在雾里。
      </p>
      <nav class="lost-links" aria-label="还可以去的地方">
        <a href="/articles/" data-morph data-true="随笔" data-dream="断章">随笔</a>
        <a href="/moments/" data-morph data-true="瞬间" data-dream="闪念">瞬间</a>
        <a href="/projects/" data-morph data-true="项目" data-dream="造物">项目</a>
      </nav>
    </section>
  </div>
</BaseLayout>

<style>
  .lost-wrap {
    min-height: 100dvh;
    display: grid;
    place-items: center;
  }

  .lost {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.6rem;
    /* 字压在洞口上：整块往上提一点，读的时候视线正好落在坑心 */
    transform: translateY(-1.5vh);
  }

  .lost-code {
    margin: 0;
    font-size: 0.62rem;
    letter-spacing: 0.34em;
    color: var(--fg-faint);
  }

  .lost-line {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.02rem, 1.8vw, 1.14rem);
    line-height: 2.1;
    color: var(--fg-soft);
    max-width: 24em;
  }

  .lost-links {
    display: flex;
    gap: 1.6rem;
    margin-top: 0.4rem;
  }

  .lost-links a {
    font-family: var(--font-display);
    font-size: 0.92rem;
    letter-spacing: 0.06em;
    color: var(--fg-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 3px;
    transition:
      color 0.22s ease,
      border-color 0.22s ease;
  }

  .lost-links a:hover,
  .lost-links a:focus-visible {
    color: var(--fg);
    border-bottom-color: color-mix(in srgb, var(--amber) 55%, transparent);
  }

  .lost-links a:focus-visible {
    outline: 1px solid var(--amber);
    outline-offset: 4px;
  }
</style>
