---
/* ─────────────────────────────────────────────────────────────
   主页 · 一根线的一夜（故事板）—— 五幕骨架定稿自 design/mocks/p25-thread-storyboard.html。
   · 五幕 = 五个 sticky 舞台（入夜 / 断章 / 造物 / 闪念 / 晨醒），相邻两幕首尾叠一屏；
     滚动写各幕的 --p，编排全在 CSS 里对 --p 的 calc。
   · 背景的脑电线就是全站那条线（同一套 eeg-wave 算法、同一个 Worker），只是在主页
     沿一条随幕变化的骨架走：开屏是过中心的 14° 直线，往下弯成竖线，晨醒拐成底线。
   · 开屏是「线景」：那条线当地平线，地平线下展开成一整片「同一根线的回声」（地形 Worker），
     线绕成的一枚圆半沉在地形里，几道静态的穹肋从画外汇向它；问句是唯一的字。
     原型与取舍见 design/mocks/scene-linescape-notes.md / -vault-notes.md / -palette-notes.md（配色方案②）。
     旧开屏（醒 / 梦大字与膜）见 git 历史。
   · 驱动脚本：src/scripts/home-linescape.ts（地形 home-linescape-worker.ts，穹肋 home-linescape-ribs.ts）。
   ───────────────────────────────────────────────────────────── */
import BaseLayout from '../layouts/BaseLayout.astro';
import RealityGuide from '../components/home/RealityGuide.astro';
import { getCollection } from 'astro:content';

const byDate = <T extends { id: string; data: { date: Date } }>(a: T, b: T) =>
  b.data.date.valueOf() - a.data.date.valueOf() || b.id.localeCompare(a.id);

const allArticles = (await getCollection('articles', (a) => !a.data.draft)).sort(byDate);
const allProjects = (await getCollection('projects', (p) => !p.data.draft)).sort(byDate);
const allMoments = (await getCollection('moments', (m) => !m.data.draft)).sort(byDate);

const articles = allArticles.slice(0, 3);
const projects = allProjects.slice(0, 3);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const fmtShort = (d: Date) => `${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const fmtMomentTime = (d: Date) =>
  `${fmtShort(d)} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;

/* 八阶成形 / 浮现度 */
const depthOf = (status: string) => ({ 构想中: 2, 进行中: 5, 已完成: 8 })[status] ?? 3;
const repoOf = (links: { href: string }[]) => links.some((l) => /^https:\/\/github\.com\//.test(l.href));

/* 闪念摘句：去掉两态块与行内语法，只留醒面文字 */
function snippet(md: string, maxLen = 64): string {
  const clean = md
    .replace(/:::(dream|wake)[\s\S]*?:::/g, '')
    .replace(/^#{1,6}\s+.+$/gm, '')
    .replace(/\[\[([^|[\]]+)\|([^|[\]]+)\]\]/g, '$1')
    .replace(/\(\(([^()|]+)(\|[^()]*)?\)\)/g, '$1')
    .replace(/\{\{([^{}|]+)(\|[^{}]*)?\}\}/g, '$1')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`#>-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return clean.length <= maxLen ? clean : clean.slice(0, maxLen).trim() + '…';
}

/* 闪念：最多 7 张，左右交错挂在线两侧。
   窗口半宽（幕内进度）：全显 W0 / 散尽 W1。七张的中心在 [散尽, 1 − 散尽] 里等距铺开、
   两头各留 EDGE 的余量 —— 第一张的浮起与最后一张的散场因此都完整落在幕内（--p ∈ 0..1），
   最后一张不会再「没散完就被舞台带走」。窄屏另备一组（W0M / W1M）：手机上七张只有两行
   站位，窗口不收窄的话，同一行会同时停着两张。 */
const W0 = 0.075;
const W1 = 0.23;
const W0M = 0.028;
const W1M = 0.085;
const EDGE = 0.02;

/* 一行 ＝ 一张便签的全部手艺：站位 / 静姿倾角 · 入场（横移 + 附加倾角）· 散场（同）。
   入场都从自己这一侧斜着来、散场往另一侧走 —— 左右两张因此总是相向而行，交错着看过去
   就是「互相穿过」；行程的长短与倾角各不相同，七张不会像一套机械装置。附加倾角只在飘的
   过程里带上，落位时回到静姿 --tilt。 */
const SLIP_POS = [
  { x: '15vw', y: '33svh', tilt: '-1deg', in: ['-22vw', '-7deg'], out: ['15vw', '4.5deg'] },
  { x: '61vw', y: '25svh', tilt: '.9deg', in: ['20vw', '6deg'], out: ['-14vw', '-4deg'] },
  { x: '17vw', y: '58svh', tilt: '.7deg', in: ['-16vw', '-5deg'], out: ['18vw', '5.5deg'] },
  { x: '62vw', y: '53svh', tilt: '-.8deg', in: ['18vw', '5.5deg'], out: ['-20vw', '-6deg'] },
  { x: '12.5vw', y: '46svh', tilt: '1.2deg', in: ['-24vw', '-7.5deg'], out: ['13vw', '4deg'] },
  { x: '59vw', y: '39svh', tilt: '-1deg', in: ['16vw', '4.5deg'], out: ['-18vw', '-5.5deg'] },
  { x: '19vw', y: '26svh', tilt: '.6deg', in: ['-14vw', '-4.5deg'], out: ['21vw', '6.5deg'] },
];
const nSlip = Math.min(allMoments.length, 7);
const moments = allMoments.slice(0, nSlip).map((m, i) => {
  const s = SLIP_POS[i];
  const c = nSlip > 1 ? W1 + EDGE + (i * (1 - 2 * (W1 + EDGE))) / (nSlip - 1) : 0.5;
  return {
    id: m.id,
    title: m.data.title,
    tag: m.data.tags[0],
    time: fmtMomentTime(m.data.date),
    text: snippet(m.body ?? ''),
    c: c.toFixed(3),
    vars: `--x:${s.x};--y:${s.y};--tilt:${s.tilt};--dxin:${s.in[0]};--drin:${s.in[1]};--dxout:${s.out[0]};--drout:${s.out[1]}`,
  };
});

const exits = [
  { name: 'GitHub', href: 'https://github.com/Traveritas', addr: 'github.com/Traveritas', external: true },
  { name: '本站源码', href: 'https://github.com/Traveritas/traveritas.github.io', addr: 'traveritas.github.io', external: true },
  { name: 'RSS', href: '/rss.xml', addr: '/rss.xml', external: false },
  { name: '关于此处 →', href: '/about/', addr: '/about/', external: false },
];

const manifesto = '在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？';

/* ── 测量点：版块入口钉在地形的几条等高线上，平时只有一粒点与一行小字；
   hover / focus / 点按时，floatwin 式的半透明小窗从点上浮起。窗内容与取数同 scene-floatwin。
   tx / ty ＝ 目标位置（视口比例；桌面 / 窄屏各一组），脚本找离它最近的那条线把点钉上去 ── */
const pins = [
  {
    key: 'articles',
    href: '/articles/',
    wake: '随笔',
    dream: '断章',
    badge: 'SAYABLE',
    at: [0.25, 0.63, 0.2, 0.62],
    rows: allArticles.slice(0, 2).map((a) => ({ t: a.data.title, d: fmtShort(a.data.date) })),
    foot: `共 ${allArticles.length} 篇 →`,
  },
  {
    key: 'moments',
    href: '/moments/',
    wake: '瞬间',
    dream: '闪念',
    badge: 'EPHEMERAL',
    at: [0.55, 0.79, 0.66, 0.69],
    rows: allMoments.slice(0, 1).map((m) => ({ t: snippet(m.body ?? '', 30), d: fmtMomentTime(m.data.date) })),
    foot: `共 ${allMoments.length} 则 →`,
  },
  {
    key: 'projects',
    href: '/projects/',
    wake: '项目',
    dream: '造物',
    badge: 'BUILDABLE',
    at: [0.4, 0.71, 0.34, 0.78],
    rows: allProjects.slice(0, 2).map((p) => ({ t: p.data.title, d: `${depthOf(p.data.status)}/8` })),
    foot: `共 ${allProjects.length} 件 →`,
  },
  {
    key: 'about',
    href: '/about/',
    wake: '关于',
    dream: '此身',
    badge: 'PRESENCE',
    at: [0.12, 0.78, 0.78, 0.85],
    rows: [{ t: '知觉的留白，与「醒梦」', d: '' }],
    foot: '此处 →',
  },
];
---

<BaseLayout
  title="Traveritas的个人网页"
  dreamTitle="AveritA的昼梦叙集"
  description={manifesto}
  seam="none"
  constructs="none"
  rail={{ mode: 'night' }}
>
  <div class="atmo" aria-hidden="true">
    <div class="fog f1"></div>
    <div class="fog f2"></div>
    <div class="dawnlight"></div>
  </div>
  <!-- 线景：天空、地平线后的微光、圆光、穹肋（固定层，压在地形画布之下）；地形与线圈在画布里（home-linescape-worker.ts） -->
  <div class="ls-sky" aria-hidden="true"><i class="sky-w"></i><i class="sky-d"></i></div>
  <div class="ls-glow" aria-hidden="true"></div>
  <div class="ls-sun" aria-hidden="true"><i class="sun-w"></i><i class="sun-d"></i></div>
  <div class="ls-ribs" aria-hidden="true"><canvas id="ls-rib-w"></canvas><canvas id="ls-rib-d"></canvas></div>
  <canvas class="ls-canvas" id="ls-canvas" aria-hidden="true"></canvas>

  <div class="home">
    <!-- ═══ 场 0 · 23:07 入夜：线景 —— 那一根线是地平线，地平线下是它自己的一整片回声 ═══ -->
    <section class="scene s-hero" id="ns-hero" data-scene="0" style="--len:230svh">
      <div class="stage">
        <p class="sr-only">Traveritas的个人网页 —— 随笔、项目，与正在成形的东西。</p>
        <div class="qset">
          <h1 class="q" id="hero-line">
            <span class="ql">在即将醒来的那一瞬，</span><span class="ql">世界究竟是在成形，</span><span class="ql">还是正在融化？</span>
          </h1>
        </div>
        <!-- 等高线标注：地平线上是入夜，最近那条线上是天亮（脚本按地形把它们钉到线上、给出沿线角度） -->
        <div class="ls-marks" aria-hidden="true">
          <span class="cmark cmark-h" data-mark="h">23:07</span>
          <span class="cmark" data-mark="n">06:31</span>
        </div>
        <nav class="ls-pins" aria-label="版块">
          {
            pins.map((p) => (
              <div class={`pin pin-${p.key}`} data-pin={p.key} data-at={p.at.join(',')}>
                <button class="pin-dot" type="button" aria-expanded="false" aria-controls={`pw-${p.key}`}>
                  <i aria-hidden="true" />
                  <span class="pin-l">
                    <span data-morph data-true={p.wake} data-dream={p.dream}>
                      {p.wake}
                    </span>
                  </span>
                </button>
                <a class="pw" id={`pw-${p.key}`} href={p.href}>
                  <span class="fw-h">
                    <span class="nm" data-morph data-true={p.wake} data-dream={p.dream}>
                      {p.wake}
                    </span>
                    <span class="bd">{p.badge}</span>
                  </span>
                  <span class="fw-b">
                    {p.rows.map((r) => (
                      <span class="row">
                        <span class="rt">{r.t}</span>
                        {r.d && <span class="rd">{r.d}</span>}
                      </span>
                    ))}
                  </span>
                  <span class="fw-f">{p.foot}</span>
                </a>
              </div>
            ))
          }
        </nav>
        <RealityGuide />
      </div>
    </section>

    <!-- ═══ 场 1 · 浅梦 · 断章：线在左，三篇同屏 ═══ -->
    <section class="scene s-essays side" id="ns-essays" data-scene="1" style="--len:280svh">
      <div class="stage">
        <div class="chap in-out">
          <span class="cap">浅梦 · 23:19 — 01:11</span>
          <h2>断章</h2>
        </div>
        <div class="essays">
          {
            articles.map((a, j) => (
              <a class="essay" href={`/articles/${a.id}/`} style={`--j:${j}`}>
                <span class="no">{String(j + 1).padStart(2, '0')}</span>
                <div>
                  <span class="meta">{[fmt(a.data.date), ...a.data.tags].join(' · ')}</span>
                  <h3>{a.data.title}</h3>
                  {a.data.description && <p>{a.data.description}</p>}
                </div>
              </a>
            ))
          }
          <div class="more"><a class="all" href="/articles/">全部断章 →</a></div>
        </div>
      </div>
    </section>

    <!-- ═══ 场 2 · 深眠 · 造物：同断章，线在左，晶板从右侧浮现 ═══ -->
    <section class="scene s-projects side" id="ns-projects" data-scene="2" style="--len:320svh">
      <div class="stage">
        <div class="chap in-out">
          <span class="cap">深眠 · 01:11 — 02:08</span>
          <h2>造物</h2>
        </div>
        <div class="slabs">
          {
            projects.map((p, j) => {
              const depth = depthOf(p.data.status);
              const repo = repoOf(p.data.links);
              return (
                <a class="slab" href={`/projects/${p.id}/`} style={`--j:${j};--depth:${depth}`}>
                  <div class="win">
                    <svg data-lily={3 + j * 4} viewBox="-100 -100 200 200" preserveAspectRatio="xMidYMid slice" />
                    <div class="fogv" />
                  </div>
                  <div class="slab-body">
                    <div class="slab-head">
                      <span>{fmt(p.data.date)}</span>
                      <span>{p.data.status}</span>
                    </div>
                    <div>
                      <h3>{p.data.title}</h3>
                      {p.data.description && <p>{p.data.description}</p>}
                    </div>
                    <div class="depth">
                      <span>
                        浮现度 <b>{depth}</b>/8
                      </span>
                      <span>{repo ? '✓ 公开仓库' : '○ 暂无公开'}</span>
                    </div>
                  </div>
                </a>
              );
            })
          }
          <div class="more"><a class="all" href="/projects/">全部造物 →</a></div>
        </div>
      </div>
    </section>

    <!-- ═══ 场 3 · 异相 · 闪念：线居中，便签左右交错闪现 ═══ -->
    <section class="scene s-rem" id="ns-rem" data-scene="3" style="--len:380svh">
      <div class="stage" data-w0={String(W0)} data-w1={String(W1)} data-w0m={String(W0M)} data-w1m={String(W1M)}>
        <div class="chap in-out">
          <h2>闪念</h2>
          <span class="cap">异相 · 02:08 — 04:59</span>
        </div>
        {
          moments.map((m) => (
            <a
              class="slip"
              href={`/moments/#${m.id}`}
              data-c={m.c}
              style={m.vars}
            >
              <span class="h">
                <span>{m.time}</span>
                {m.tag && <em>#{m.tag}</em>}
              </span>
              {m.title && <b>{m.title}</b>}
              <span class="t">{m.text}</span>
            </a>
          ))
        }
        <div class="more in-out"><a class="all" href="/moments/">全部闪念 →</a></div>
      </div>
    </section>

    <!-- ═══ 场 4 · 06:31 晨醒：线从左上垂下、拐成标题下的底线 ═══ -->
    <section class="scene s-dawn" id="ns-dawn" data-scene="4" style="--len:200svh">
      <div class="stage">
        <div class="d-head dz">
          <div class="time">06:31 · 晨光</div>
          <h2
            data-morph
            data-faces="注视持续得太久。被注视之物微微退开。|在即将醒来的那一瞬，世界究竟是在成形，还是正在融化？|世界随时可能消失，又随时重新被记起。"
          >
            注视持续得太久。被注视之物微微退开。
          </h2>
        </div>
        <div class="d-body dz">
          <div class="exits">
            {
              exits.map((x) => (
                <a href={x.href} target={x.external ? '_blank' : undefined} rel={x.external ? 'noopener' : undefined}>
                  {x.name}
                  <small>{x.addr}</small>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 目录（常规文档流） ═══ -->
    <section class="dir">
      <div class="index">
        <div>
          <h4><a href="/articles/">断章</a></h4>
          <ul>
            {
              allArticles.slice(0, 6).map((a) => (
                <li>
                  <a href={`/articles/${a.id}/`}>
                    {a.data.title}
                    <span>{fmtShort(a.data.date)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h4><a href="/projects/">造物</a></h4>
          <ul>
            {
              allProjects.slice(0, 6).map((p) => (
                <li>
                  <a href={`/projects/${p.id}/`}>
                    {p.data.title}
                    <span>{depthOf(p.data.status)}/8</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h4><a href="/moments/">闪念</a></h4>
          <ul>
            {
              allMoments.slice(0, 3).map((m) => (
                <li>
                  <a href={`/moments/#${m.id}`}>
                    {m.data.title ?? snippet(m.body ?? '', 14)}
                    <span>{fmtShort(m.data.date)}</span>
                  </a>
                </li>
              ))
            }
            <li>
              <a href="/moments/">全部闪念 →<span></span></a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initLinescape } from '../scripts/home-linescape';

  /* 晶板窗口里的抽象百合（花瓣长度 / 开角抖动，避免机械放射对称） */
  let seed = 1;
  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  document.querySelectorAll<SVGSVGElement>('svg[data-lily]').forEach((svg) => {
    const id = svg.dataset.lily ?? '3';
    seed = Number(id) * 997;
    let out = `<defs><radialGradient id="pg${id}"><stop offset="0" stop-color="#f3e6d6" stop-opacity=".55"/><stop offset="1" stop-color="#a9b8d6" stop-opacity=".08"/></radialGradient></defs>`;
    const k = 5 + Math.floor(rnd() * 2);
    const rot0 = rnd() * 60;
    for (let i = 0; i < k; i++) {
      const a = rot0 + (i * 360) / k + (rnd() - 0.5) * 22;
      const L = 62 + rnd() * 26;
      const w = 16 + rnd() * 10;
      const bend = (rnd() - 0.5) * 18;
      out += `<path transform="rotate(${a.toFixed(1)})" d="M0 0 C ${w} ${-L * 0.3}, ${w * 0.6 + bend} ${-L * 0.85}, ${bend} ${-L} C ${-w * 0.6 + bend} ${-L * 0.85}, ${-w} ${-L * 0.3}, 0 0Z" fill="url(#pg${id})" stroke="#e6ecf7" stroke-opacity=".45" stroke-width=".8"/>`;
    }
    svg.innerHTML = out + '<circle r="5" fill="#d9a05b" fill-opacity=".7"/>';
  });

  initLinescape();
</script>

<style is:global>
  /* 主页文字不参与选择（入口/链接照常可点）——长按入梦可从任意文字处起手 */
  html body {
    user-select: none;
    -webkit-user-select: none;
  }

  /* 页头叠压首屏（其余页维持文档流页头） */
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
  }

  .defs {
    position: absolute;
  }

  .home .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── 环境层：雾 / 晨光（取代构块场） ── */
  .atmo {
    position: fixed;
    inset: 0;
    z-index: -3;
    pointer-events: none;
    overflow: hidden;
  }
  .atmo .fog {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow, rgba(255, 255, 255, 0.75)), transparent);
  }
  .atmo .f1 {
    width: 70vmax;
    height: 50vmax;
    left: -20vmax;
    top: -12vmax;
    animation: home-fog1 38s ease-in-out infinite alternate;
  }
  .atmo .f2 {
    width: 60vmax;
    height: 44vmax;
    right: -22vmax;
    bottom: -14vmax;
    animation: home-fog2 46s ease-in-out infinite alternate;
  }
  @keyframes home-fog1 {
    to {
      transform: translate3d(8vmax, 6vmax, 0);
    }
  }
  @keyframes home-fog2 {
    to {
      transform: translate3d(-10vmax, -4vmax, 0);
    }
  }
  .atmo .dawnlight {
    position: absolute;
    inset: -10% -10% auto;
    height: 90%;
    opacity: var(--dawn, 0);
    background: radial-gradient(60% 70% at 50% 0%, rgba(255, 214, 160, 0.55), rgba(255, 232, 205, 0.2) 45%, transparent 75%);
  }

  /* ── 场与舞台 ── */
  .home .scene {
    position: relative;
    height: var(--len);
  }
  /* 相邻两幕首尾叠一屏：上一幕舞台离开的同时下一幕舞台已钉住 */
  .home .scene + .scene {
    margin-top: -100svh;
  }
  .home .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .home .cap {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    color: var(--fg-soft);
  }
  .home .in-out {
    opacity: calc(clamp(0, calc(var(--p) / 0.08), 1) * clamp(0, calc((1 - var(--p)) / 0.08), 1));
  }
  .home .all {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.18em;
    border-bottom: 1px solid var(--amber);
    padding-bottom: 3px;
    text-decoration: none;
    color: var(--fg);
  }
  .home a {
    text-decoration: none;
  }

  /* 窗口函数：--c 为本镜中心，--w0 全显半宽，--w1 散尽半宽（皆由幕上的 data-w*
     按屏宽写进来，见前台 W0 / W1 / W0M / W1M）。消费它的只有便签：
     显影走 --a（线性），位移与倾角走 .slip 里的 --f / --s（带缓动）。 */
  .home [data-c] {
    --d: calc(var(--p) - var(--c));
    --ad: max(var(--d), calc(var(--d) * -1));
    --a: clamp(0, calc((var(--w1) - var(--ad)) / (var(--w1) - var(--w0))), 1);
    opacity: var(--a);
    pointer-events: none;
  }
  .home [data-c].on {
    pointer-events: auto;
  }

  /* ═══ 场 0 · 入夜 · 线景 ═══
     全站那条线（Eeg 的 Worker）＝ 地平线；它下方那一整片线织地形与线圈
     由 #ls-canvas（另一个 Worker，home-linescape-worker.ts）画。
     这一层只剩三样：问句（一种颜色、一个字号）、两枚等高线标注、测量点。
     标注与测量点的位置由脚本按「静止地形」算一次（尺寸变化时才重算），Worker 在它们附近把波压平，
     所以它们始终落在线上，却不必逐帧挪。滚动只动 opacity。 */
  .s-hero {
    --t14: 0.2493;
    --g: max(24px, calc((100vw - 42rem) / 2));
    --fadeP: clamp(0, calc((var(--p) - 0.02) / 0.12), 1);
  }
  /* z −3：在全站那条线（Eeg，z −2）之下 ⇒ 地平线永远压在地形上面；
     画面下沿一张静止遮罩：近处的线退进雾里，视线停在中景 */
  .ls-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -3;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 58%, rgba(0, 0, 0, 0.12) 100%);
    mask-image: linear-gradient(to bottom, #000 58%, rgba(0, 0, 0, 0.12) 100%);
  }
  /* 地平线上的一道微光：旋转 14° 的宽带过视口中心（＝ 开屏姿态的线），峰值略低于线。
     收拢到底后（html.ls-folded，脚本只在滚动时切换）淡出 */
  /* ═══ 配色（灰粉梦温）═══
     天空 ＝ 一张静止的渐变层（z −4：在洗染之上、雾 / 光 / 地形之下），醒梦两张按 --reality-mix 交叉淡化，
     整层按 --sky（脚本只在滚动时写）往第 1 幕淡出到 --bg。
     主渐变方向 194° ＝ 地平线的法向：色带与地平线平行，地平线（视口中心）处是最亮的一道雾带；
     径向光在圆的那一侧（右）：空气透视 —— 离光近的一侧更白、更暖 / 更带方案的异质色。 */
  .ls-sky {
    position: fixed;
    inset: 0;
    z-index: -4;
    pointer-events: none;
    opacity: var(--sky, 1);
  }
    /* 穹肋（home-linescape-ribs.ts）：两张静态画布，醒 / 梦按 --reality-mix 交叉淡化，整层按 --rib 随收拢淡出；
     入场在地形铺开之后淡入。z 与天空同层、DOM 在其后 ⇒ 压在天空之上、地形画布之下（近处的线从前面经过） */
  .ls-ribs {
    position: fixed;
    inset: 0;
    z-index: -4;
    pointer-events: none;
    opacity: var(--rib, 1);
    visibility: hidden;
  }
  html.booted .ls-ribs {
    visibility: visible;
    animation: q-rise 2.2s ease 2s backwards;
  }
  .ls-ribs canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  #ls-rib-w {
    opacity: var(--reality-mix, 1);
  }
  #ls-rib-d {
    opacity: calc(1 - var(--reality-mix, 1));
  }
  .ls-sky i {
    position: absolute;
    inset: 0;
  }
  .sky-w {
    opacity: var(--reality-mix, 1);
    background:
      radial-gradient(60% 55% at 76% 46%, var(--sw-lit), transparent 70%),
      linear-gradient(194deg, var(--sw-0) 0%, var(--sw-1) 36%, var(--sw-h) 49.5%, var(--sw-2) 53%, var(--sw-3) 100%);
  }
  .sky-d {
    opacity: calc(1 - var(--reality-mix, 1));
    background:
      radial-gradient(60% 55% at 76% 46%, var(--sd-lit), transparent 70%),
      linear-gradient(194deg, var(--sd-0) 0%, var(--sd-1) 36%, var(--sd-h) 49.5%, var(--sd-2) 53%, var(--sd-3) 100%);
  }
  html {
    /* 灰粉梦温（方案②） */
    --sw-0: #e1ddd9; --sw-1: #eae6e2; --sw-h: #f6f3f0; --sw-2: #f0ece8; --sw-3: #e2ddd8;
    --sw-lit: rgba(240, 232, 252, 0.55);
    --sd-0: #e7d8da; --sd-1: #efe3e3; --sd-h: #f8f0ee; --sd-2: #f2e8e6; --sd-3: #e6d9da;
    --sd-lit: rgba(236, 224, 252, 0.6);
    --q-w: #2e2825; --q-d: #3b2a30;
    --mk-w: #74665e; --mk-d: #80637a;
    /* 圆光：比原型淡约四成，只是一层透过来的亮，不是一团发光体 */
    --sun-w: rgba(255, 255, 255, 0.55), rgba(234, 226, 248, 0.32) 34%, rgba(226, 216, 244, 0.12) 64%, rgba(226, 216, 244, 0) 100%;
    --sun-d: rgba(255, 246, 248, 0.55), rgba(236, 220, 246, 0.32) 34%, rgba(232, 214, 236, 0.13) 64%, rgba(232, 214, 236, 0) 100%;
  }
  html {
    --ls-mark: color-mix(in srgb, var(--mk-w) calc(var(--reality-mix, 1) * 100%), var(--mk-d));
    /* 地平线上那枚标注底下的托底 ＝ 天空在地平线处的雾带色（不是 --bg，否则在天空层上露出一块异色） */
    --ls-hz: color-mix(in srgb, var(--sw-h) calc(var(--reality-mix, 1) * 100%), var(--sd-h));
  }
  html .q {
    color: color-mix(in srgb, color-mix(in srgb, var(--q-w) calc(var(--reality-mix, 1) * 100%), var(--q-d)) 74%, transparent);
  }
  html .sun-w {
    background: radial-gradient(closest-side, var(--sun-w));
  }
  html .sun-d {
    background: radial-gradient(closest-side, var(--sun-d));
  }

  .ls-glow {
    position: fixed;
    left: -30vw;
    right: -30vw;
    top: calc(50svh - 13svh);
    height: 26svh;
    z-index: -3;
    pointer-events: none;
    transform: rotate(14deg);
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--glow) 60%, transparent) 45%,
      var(--glow) 53%,
      color-mix(in srgb, var(--glow) 35%, transparent) 70%,
      transparent 100%
    );
    transition: opacity 0.8s ease;
  }
  html.ls-folded .ls-glow,
  html.ls-folded .ls-sun {
    opacity: 0;
  }

  /* ── a · 线圈后的那团圆光（参考 floatwin 的圆光）：固定层，圆心 / 半径由脚本在尺寸变化时写入
     （--sx / --sy / --sr，与 Worker 里的线圈同一份几何）。地平线以下的半截用一张静止遮罩收掉：
     渐变方向 194° ＝ 地平线的法向（朝下），盒子边长 3R ⇒ 渐变全长 3.64R，地平线在圆心下方 0.3R
     处 ⇒ 落在 58% ── */
  .ls-sun {
    position: fixed;
    z-index: -3;
    left: calc(var(--sx, -999px) - 1.5 * var(--sr, 0px));
    top: calc(var(--sy, -999px) - 1.5 * var(--sr, 0px));
    width: calc(3 * var(--sr, 0px));
    height: calc(3 * var(--sr, 0px));
    pointer-events: none;
    -webkit-mask-image: linear-gradient(194deg, #000 0 51%, transparent 59.5%);
    mask-image: linear-gradient(194deg, #000 0 51%, transparent 59.5%);
    transition: opacity 0.8s ease;
    visibility: hidden;
  }
  html.booted .ls-sun {
    visibility: visible;
    animation: q-rise 3s cubic-bezier(0.2, 0.7, 0.2, 1) 1.8s backwards;
  }
  .ls-sun i {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  .sun-w {
    background: radial-gradient(
      closest-side,
      rgba(255, 255, 255, 0.9),
      rgba(255, 255, 255, 0.55) 34%,
      rgba(250, 252, 255, 0.22) 64%,
      rgba(250, 252, 255, 0) 100%
    );
    opacity: var(--reality-mix, 1);
  }
  .sun-d {
    background: radial-gradient(
      closest-side,
      rgba(255, 244, 232, 0.9),
      rgba(250, 226, 210, 0.5) 34%,
      rgba(240, 214, 205, 0.2) 64%,
      rgba(236, 210, 205, 0) 100%
    );
    opacity: calc(1 - var(--reality-mix, 1));
  }

  /* ── 问句：唯一的字。一种颜色、一个字号 ──
     横排两行，放左侧天空，对齐页头 42rem 中栏左沿 */
  .qset {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: calc(1 - clamp(0, calc((var(--p) - 0.04) / 0.2), 1));
  }
  /* 题记：字号与页头站名同级（1.05rem）、字距拉开、次墨 —— 站名仍是唯一的重心，画面交给线景 */
  .q {
    --f: clamp(1rem, 1.1vw, 1.12rem);
    position: absolute;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--f);
    line-height: 2.2;
    letter-spacing: 0.2em;
    color: var(--fg);
    white-space: nowrap;
  }
  .q {
    left: var(--g);
    top: 17svh;
  }
  .q .ql:first-child {
    display: block;
  }
  .q .c {
    display: inline-block;
    opacity: 0;
  }
  /* 逐字微错位与零星失焦：每字随序号带一点高低与倾角，零星几个失焦、压淡 ——
     像刚醒时还没对准焦的字。都是静态值（落定后不再变），不增加逐帧开销 */
  .q .c:nth-child(5n + 2) {
    --cy: 0.06em;
  }
  .q .c:nth-child(7n + 3) {
    --cy: -0.05em;
    --cr: 0.6deg;
  }
  .q .c:nth-child(9n + 6) {
    --cr: -0.8deg;
  }
  .q .c:nth-child(7n + 5) {
    --cb: 0.55px;
    --co: 0.78;
  }
  .q .c:nth-child(13n + 9) {
    --cx: 0.06em;
    --cb: 0.35px;
  }
  html.booted .q .c {
    animation: q-drip 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(0.9s + var(--i) * 40ms);
  }
  /* 关键帧写进各字自己的错位 / 失焦量：both 的停留态才不会把静态偏移抹平 */
  @keyframes q-drip {
    from {
      opacity: 0;
      transform: translate(var(--cx, 0px), calc(-0.45em + var(--cy, 0px))) rotate(var(--cr, 0deg));
      filter: blur(calc(3px + var(--cb, 0px)));
    }
    to {
      opacity: var(--co, 1);
      transform: translate(var(--cx, 0px), var(--cy, 0px)) rotate(var(--cr, 0deg));
      filter: blur(var(--cb, 0px));
    }
  }

  @keyframes q-rise {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* ── 等高线标注：地形图的惯例 —— 线在此断开一小段（Worker 断开；地平线那条在另一张画布上，
     用一块底色小晕把它遮出一个口），写上数字，字沿线方向。--x / --y / --rot 由脚本写入 ── */
  .ls-marks,
  .ls-pins {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: calc(1 - var(--fadeP));
    visibility: hidden;
  }
  html.ls-placed .ls-marks {
    visibility: visible;
  }
  html.ls-placed .ls-pins {
    visibility: visible;
  }
  html.ls-folded .ls-marks,
  html.ls-folded .ls-pins {
    visibility: hidden;
  }
  .cmark {
    position: absolute;
    left: var(--x, 0px);
    top: var(--y, 0px);
    transform: translate(-50%, -50%) rotate(var(--rot, 14deg));
    font-family: var(--font-mono);
    font-size: 9.5px;
    line-height: 1;
    letter-spacing: 0.14em;
    color: var(--ls-mark, var(--umber));
    white-space: nowrap;
    opacity: 0;
  }
  .cmark-h {
    padding: 13px 14px;
    background: radial-gradient(
      closest-side,
      var(--ls-hz, var(--bg)) 58%,
      color-mix(in srgb, var(--ls-hz, var(--bg)) 70%, transparent) 78%,
      transparent
    );
  }
  html.booted .cmark {
    animation: mark-in 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) 2.2s both;
  }
  html.booted .cmark:not(.cmark-h) {
    animation-delay: 3.4s;
  }
  @keyframes mark-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.8;
    }
  }

  /* ── 测量点：一粒点 + 一行很小的标签，钉在某条等高线上（--x / --y / --rot 由脚本写入）。
     hover / 键盘焦点 / 点按（.open）时，floatwin 式的半透明小窗从点上浮起（只动 opacity / transform）。
     窗以点为轴站位，左右夹在视口内 ── */
  .pin {
    --w: 248px;
    position: absolute;
    left: var(--x, 0px);
    top: var(--y, 0px);
    width: 0;
    height: 0;
    opacity: 0;
  }
  html.booted .pin {
    animation: q-rise 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) 3.6s both;
  }
  .pin-dot {
    position: absolute;
    left: -10px;
    top: -10px;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 20px;
    padding: 0 6px 0 0;
    border: 0;
    background: none;
    color: var(--fg);
    cursor: pointer;
    pointer-events: auto;
    transform-origin: 10px 10px;
    transform: rotate(var(--rot, 14deg));
    font: inherit;
  }
  .pin-dot i {
    display: block;
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, var(--ls-mark, var(--umber)) 0 2.2px, transparent 2.7px),
      radial-gradient(
        closest-side,
        transparent 0 5.4px,
        color-mix(in srgb, var(--ls-mark, var(--umber)) 40%, transparent) 5.7px 6.3px,
        transparent 6.7px
      );
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .pin-l {
    display: flex;
    align-items: baseline;
    gap: 6px;
    /* 标签浮在线上方一点，不压线 */
    transform: translateY(-9px);
    font-family: var(--font-display);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    color: color-mix(in srgb, var(--fg) 82%, transparent);
    white-space: nowrap;
  }
  .pin-dot:focus-visible {
    outline: 1px solid var(--fg);
    outline-offset: 3px;
    border-radius: 10px;
  }
  .pin.open .pin-dot i,
  .pin-dot:focus-visible i {
    transform: scale(1.3);
  }

  /* 小窗：同 floatwin 的树脂薄片（醒面冷白、梦面微暖），从点上方浮起 */
  .pw {
    --tint: color-mix(in srgb, #ffffff calc(var(--reality-mix, 1) * 100%), #f8e9e3);
    position: absolute;
    bottom: 62px;
    left: clamp(calc(12px - var(--x, 0px)), calc(var(--w) / -2), calc(100vw - 12px - var(--x, 0px) - var(--w)));
    width: var(--w);
    display: block;
    padding: 13px 16px 11px;
    border-radius: 2px;
    color: var(--fg);
    text-decoration: none;
    background:
      linear-gradient(118deg, rgba(255, 255, 255, 0.36), rgba(255, 255, 255, 0) 42%),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--tint) 95%, transparent),
        color-mix(in srgb, var(--tint) 90%, transparent)
      );
    border: 1px solid transparent;
    border-top-color: color-mix(in srgb, var(--tint) 92%, transparent);
    border-left-color: color-mix(in srgb, var(--tint) 70%, transparent);
    border-bottom-color: color-mix(in srgb, var(--fg) 5%, transparent);
    border-right-color: color-mix(in srgb, var(--tint) 30%, transparent);
    box-shadow: 0 22px 46px -22px rgba(36, 44, 60, 0.2);
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
      visibility 0s 0.55s;
  }
  .pin.open,
  .pin:focus-within {
    z-index: 2;
  }
  /* 吊线：从点的外环顶上垂到窗底（先垂下、窗再浮起）；端点一粒极小的结 */
  .pin::before {
    content: '';
    position: absolute;
    left: -0.5px;
    bottom: 7px;
    width: 1px;
    height: 56px;
    background: linear-gradient(to top, color-mix(in srgb, var(--ls-mark, var(--umber)) 70%, transparent), color-mix(in srgb, var(--ls-mark, var(--umber)) 30%, transparent));
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  .pin.open::before,
  .pin:focus-within::before {
    transform: none;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .pin.open .pw,
  .pin:focus-within .pw {
    transition-delay: 0.12s;
  }
  /* 激活的点：中心实、外环收紧（窗关着时的悬停只放大不变实） */
  .pin.open .pin-dot i {
    background:
      radial-gradient(closest-side, var(--ls-mark, var(--umber)) 0 3.2px, transparent 3.7px),
      radial-gradient(
        closest-side,
        transparent 0 5.4px,
        color-mix(in srgb, var(--ls-mark, var(--umber)) 70%, transparent) 5.7px 6.5px,
        transparent 6.9px
      );
  }
  .pin.open .pin-l {
    color: var(--fg);
  }
  /* 一扇窗打开时，其余的点退成淡影（窄屏上窗会盖住别的标签，不让它们从窗里透出来） */
  .pin-l {
    transition: opacity 0.4s ease;
  }
  .pin-dot i {
    transition:
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.4s ease;
  }
  .ls-pins:has(.pin.open) .pin:not(.open) .pin-l,
  .ls-pins:has(.pin.open) .pin:not(.open) .pin-dot i {
    opacity: 0.3;
  }
  @media (max-width: 760px) {
    .ls-pins:has(.pin.open) .pin:not(.open) .pin-l {
      opacity: 0;
    }
  }
  .pin.open .pw,
  .pin:focus-within .pw {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
      visibility 0s;
