---
/* 寻找：三处全部的条目，一行一条；输入在左下工具栏的「寻找」里，就地筛（scripts/site.ts 的 find）。
   没有输入时就是全部存目。别的页回车 / 点标签、年月会带着 ?q= 来这里 */
import Base from '../../layouts/Base.astro';
import Hits from '../../components/Hits.astro';
import { allEntries } from '../../lib/entries';
import { pad } from '../../lib/text';

const list = await allEntries();
---

<Base title="寻找" place="find">
  <section class="list list--find" id="find">
    <header class="lh lh--plain">
      <div>
        <h1>寻找</h1>
        <p class="mono"><span class="find-n">{pad(list.length)}</span> / {pad(list.length)}<span class="find-q"></span></p>
      </div>
    </header>
    <Hits list={list} hay />
    <p class="find-none" hidden>这里没有。</p>
  </section>
</Base>
